[Unit]
Description=CompatAir staging MCP server for failure drills
After=network.target

[Service]
Type=simple
User=compatair-deploy
Group=compatair-deploy
WorkingDirectory=/var/www/html/compatair-staging/current
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8788
Environment=MCP_ALLOWED_ORIGINS=https://compatair-staging.invalid
Environment=COMPAT_AIR_CATALOG=/var/www/html/compatair-staging/current/data/catalog.json
Environment=COMPAT_AIR_OFFERS=/var/www/html/compatair-staging/current/data/offers.json
Environment=COMPAT_AIR_VERDICTS=/var/www/html/compatair-staging/current/data/verdicts.json
Environment=COMPAT_AIR_DEMAND_AGGREGATES=/var/lib/compatair-staging/demand-aggregates.json
Environment=COMPAT_AIR_PRODUCT_FUNNEL_AGGREGATES=/var/lib/compatair-staging/product-funnel-aggregates.json
Environment=COMPAT_AIR_PROXY_MANAGES_API_HEADERS=1
StateDirectory=compatair-staging
StateDirectoryMode=0700
ExecStart=/opt/compatair/node/bin/node /var/www/html/compatair-staging/current/_server/mcp-server.mjs
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
KeyringMode=private
RemoveIPC=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4
IPAddressDeny=::/128 64:ff9b::/96 64:ff9b:1::/48 100::/64 2001:2::/48 2001:10::/28 2001:db8::/32 fc00::/7 fe80::/10 ff00::/8
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:8788
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
