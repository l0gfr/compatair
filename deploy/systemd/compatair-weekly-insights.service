[Unit]
Description=Generate the private weekly CompatAir demand and acquisition report
After=compatair-mcp.service
ConditionPathExists=/var/www/html/compatair/current/_ops/generate-private-weekly-report.mjs

[Service]
Type=oneshot
User=compatair-deploy
Group=compatair-deploy
WorkingDirectory=/var/www/html/compatair/current
Environment=COMPAT_AIR_DEMAND_AGGREGATES=/var/lib/compatair/demand-aggregates.json
Environment=COMPAT_AIR_PRODUCT_FUNNEL_AGGREGATES=/var/lib/compatair/product-funnel-aggregates.json
Environment=COMPAT_AIR_ACQUISITION_AGGREGATES=/var/lib/compatair/acquisition-aggregates.json
Environment=COMPAT_AIR_CATALOG=/var/www/html/compatair/current/data/catalog.json
Environment=COMPAT_AIR_VERDICTS=/var/www/html/compatair/current/data/verdicts.json
Environment=COMPAT_AIR_PRIVATE_REPORTS=/var/lib/compatair/reports
StateDirectory=compatair
StateDirectoryMode=0700
ExecStart=/opt/compatair/node/bin/node /var/www/html/compatair/current/_ops/generate-private-weekly-report.mjs
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
KeyringMode=private
RemoveIPC=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/compatair
MemoryMax=256M
TasksMax=32
