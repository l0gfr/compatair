<VirtualHost *:80>
    ServerName compatair.fr
    ServerAlias www.compatair.fr
    DocumentRoot /var/www/html/compatair/current

    <Directory /var/www/html/compatair/current>
        Options -Indexes -ExecCGI
        AllowOverride None
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/compatair-error.log
    CustomLog ${APACHE_LOG_DIR}/compatair-access.log combined

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/
    RewriteRule ^ https://compatair.fr%{REQUEST_URI} [R=301,L,NE]

</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName compatair.fr
    ServerAlias www.compatair.fr
    DocumentRoot /var/www/html/compatair/current

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/compatair.fr/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/compatair.fr/privkey.pem
	LimitRequestLine 2048
	LimitRequestFields 50
	LimitRequestFieldSize 8190

    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^compatair\.fr$ [NC]
    RewriteRule ^ https://compatair.fr%{REQUEST_URI} [R=301,L,NE]

	ErrorDocument 404 /404.html
	ErrorDocument 410 /410/

	ProxyPreserveHost On
	# Migration des anciennes pages quadratiques. Le service valide les deux
	# slugs contre le catalogue, redirige les couples connus et répond 410 sinon.
	ProxyPass /compatibilite/ http://127.0.0.1:8787/compatibilite/ timeout=5 connectiontimeout=2
	ProxyPassReverse /compatibilite/ http://127.0.0.1:8787/compatibilite/
	RewriteRule ^compatibilite$ - [R=410,L]
	ProxyPass /api/v1/compatibility http://127.0.0.1:8787/api/v1/compatibility timeout=8 connectiontimeout=2
	ProxyPassReverse /api/v1/compatibility http://127.0.0.1:8787/api/v1/compatibility
	ProxyPass /api/v1/search http://127.0.0.1:8787/api/v1/search timeout=8 connectiontimeout=2
	ProxyPassReverse /api/v1/search http://127.0.0.1:8787/api/v1/search
	ProxyPass /api/v1/evidence http://127.0.0.1:8787/api/v1/evidence timeout=8 connectiontimeout=2
	ProxyPassReverse /api/v1/evidence http://127.0.0.1:8787/api/v1/evidence
	ProxyPass /api/v1/changefeed http://127.0.0.1:8787/api/v1/changefeed timeout=8 connectiontimeout=2
	ProxyPassReverse /api/v1/changefeed http://127.0.0.1:8787/api/v1/changefeed
	ProxyPass /api/ucp/v1/compatibility/evaluate http://127.0.0.1:8787/api/ucp/v1/compatibility/evaluate timeout=8 connectiontimeout=2
	ProxyPassReverse /api/ucp/v1/compatibility/evaluate http://127.0.0.1:8787/api/ucp/v1/compatibility/evaluate
	ProxyPass /events http://127.0.0.1:8787/events timeout=5 connectiontimeout=2
	ProxyPassReverse /events http://127.0.0.1:8787/events
	ProxyPass /go/ http://127.0.0.1:8787/go/ timeout=5 connectiontimeout=2
	ProxyPassReverse /go/ http://127.0.0.1:8787/go/
	ProxyPass /mcp-health http://127.0.0.1:8787/health timeout=5 connectiontimeout=2
	ProxyPassReverse /mcp-health http://127.0.0.1:8787/health
	ProxyPass /mcp http://127.0.0.1:8787/mcp timeout=15 connectiontimeout=3
	ProxyPassReverse /mcp http://127.0.0.1:8787/mcp

	Alias /stats/ /var/www/html/compatair-stats/
	<Directory /var/www/html/compatair-stats>
		Options -Indexes -ExecCGI
		AllowOverride None
		AuthType Basic
		AuthName "CompatAir private statistics"
		AuthBasicProvider file
		AuthUserFile /etc/apache2/compatair-stats.htpasswd
		Require valid-user
	</Directory>
	<Location "/stats/">
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "private, no-store, max-age=0"
		Header always set X-Robots-Tag "noindex, nofollow, noarchive"
		Header onsuccess unset Content-Security-Policy
		Header always unset Content-Security-Policy
		Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	</Location>
	<Location "/mcp">
		LimitRequestBody 65536
	</Location>
	<Location "/events">
		LimitRequestBody 65536
	</Location>
	<Location "/api/v1/compatibility/receipts/verify">
		LimitRequestBody 65536
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "no-store"
	</Location>
	<Location "/api/ucp/v1/compatibility/evaluate">
		LimitRequestBody 65536
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "no-store"
	</Location>
	<LocationMatch "^/go/">
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "no-store"
		Header onsuccess unset Referrer-Policy
		Header always unset Referrer-Policy
		Header always set Referrer-Policy "no-referrer"
		Header onsuccess unset X-Robots-Tag
		Header always unset X-Robots-Tag
		Header always set X-Robots-Tag "noindex, nofollow"
	</LocationMatch>
	<LocationMatch "^/compatibilite/">
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "public, max-age=86400"
	</LocationMatch>
	<LocationMatch "^/api/v1/(?:compatibility|search|evidence|changefeed)$">
		# Normalize headers already emitted by the Node service. Without the
		# explicit unsets, Apache appends a second value and browsers reject the
		# otherwise valid cross-origin response.
		Header always unset Access-Control-Allow-Origin
		Header always set Access-Control-Allow-Origin "*"
		Header always unset Cross-Origin-Resource-Policy
		Header always set Cross-Origin-Resource-Policy "cross-origin"
	</LocationMatch>
	<LocationMatch "^/widget/(?:v1|v1\.0\.0)/compatair-widget\.js$">
		Header always set Access-Control-Allow-Origin "*"
		Header always set Cross-Origin-Resource-Policy "cross-origin"
	</LocationMatch>
	<LocationMatch "^/(?:_server)(?:/|$)">
		Require all denied
	</LocationMatch>
	<LocationMatch "^(?!/\.well-known/(?:security\.txt|ucp)$).*\/\.">
		Require all denied
	</LocationMatch>

    <Directory /var/www/html/compatair/current>
        Options -Indexes -ExecCGI
        AllowOverride None
        Require all granted
    </Directory>

    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header onsuccess unset X-Content-Type-Options
	Header always unset X-Content-Type-Options
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header onsuccess unset X-XSS-Protection
	Header always unset X-XSS-Protection
	Header always set X-XSS-Protection "0"
	Header always set X-Permitted-Cross-Domain-Policies "none"
	Header always set Cross-Origin-Opener-Policy "same-origin"
	Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
	Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; media-src 'none'; worker-src 'none'; upgrade-insecure-requests" "expr=%{REQUEST_URI} !~ m#^/stats/#"
	Header onsuccess unset Cache-Control
	Header always unset Cache-Control
	Header always set Cache-Control "no-cache"

	<LocationMatch "^/(?:_assets/[^/]+|widget/v1\.0\.0/compatair-widget\.js)$">
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "public, max-age=31536000, immutable"
	</LocationMatch>
	<LocationMatch "^/(?:images/products/|social/|favicon\.(?:svg|ico)$)">
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
	</LocationMatch>
	<LocationMatch "^/widget/v1/compatair-widget\.js$">
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "no-cache"
	</LocationMatch>
	<LocationMatch "^/(?:data/[^/]+\.(?:json|jsonld|ndjson)|openapi/[^/]+\.json|openrpc/[^/]+\.json|schemas/[^/]+\.json|\.well-known/ucp)$">
		Header onsuccess unset X-Robots-Tag
		Header always unset X-Robots-Tag
		Header always set X-Robots-Tag "noindex"
		Header always unset Access-Control-Allow-Origin
		Header always set Access-Control-Allow-Origin "*"
		Header always unset Cross-Origin-Resource-Policy
		Header always set Cross-Origin-Resource-Policy "cross-origin"
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "public, max-age=300"
	</LocationMatch>
	<LocationMatch "^/data/release\.json$">
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "no-store"
	</LocationMatch>
	<LocationMatch "^/data/(?:catalog|offers)\.json$">
		Header onsuccess unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "public, max-age=300"
	</LocationMatch>

    ErrorLog ${APACHE_LOG_DIR}/compatair-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/compatair-ssl-access.log combined
</VirtualHost>
</IfModule>
