{
  "name": "compatair",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm check && pnpm test && pnpm build",
    "security:audit": "pnpm audit --prod --audit-level high",
    "data:validate": "node scripts/validate-snapshot.mjs dist/data/catalog.json && node scripts/validate-snapshot.mjs dist/data/offers.json",
    "data:import-offers": "node scripts/import-offers.mjs",
	"audit:dist": "node scripts/audit-dist.mjs",
	"lint:source": "node scripts/lint-source.mjs",
	"lighthouse": "lhci autorun",
    "validate:full": "pnpm validate && pnpm data:validate",
    "preview": "astro preview",
    "mcp:start": "node server/mcp-server.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "astro": "^7.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "0.15.1",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    }
  }
}
