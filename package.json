{
  "name": "compatair",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/prepare-indexation.mjs && astro build",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:check": "node --test contracts/mcp/tests/verify-contracts.mjs contracts/ucp/tests/verify-contracts.mjs",
    "validate": "pnpm catalog:check && pnpm audit:editorial && pnpm contracts:check && pnpm benchmark:mcp-manifest && pnpm check && pnpm test && pnpm build",
    "security:audit": "node scripts/audit-supply-chain.mjs --advisories",
    "security:supply-chain": "node scripts/audit-supply-chain.mjs",
    "security:registry": "node scripts/audit-supply-chain.mjs --registry",
    "data:validate": "node scripts/validate-snapshot.mjs dist/data/catalog.json && node scripts/validate-snapshot.mjs dist/data/runtime-catalog.json && node scripts/validate-snapshot.mjs dist/data/offers.json && node scripts/validate-snapshot.mjs dist/data/verdicts.json && node scripts/validate-snapshot.mjs dist/data/evidence-history.json && node scripts/validate-snapshot.mjs dist/data/transparency-barometer.json && node scripts/validate-snapshot.mjs dist/data/document-quality-observatory.json && node scripts/validate-snapshot.mjs dist/data/contradiction-radar.json && node scripts/validate-snapshot.mjs dist/data/freshness.json",
    "data:import-offers": "node scripts/import-offers.mjs",
    "data:rank-demand": "node scripts/rank-demand.mjs",
    "data:report-funnel": "node scripts/report-product-funnel.mjs",
    "data:report-acquisition": "node scripts/report-acquisition.mjs",
    "data:report-affiliate-readiness": "node scripts/report-affiliate-readiness.mjs",
    "benchmark:evaluate": "node scripts/evaluate-agent-fidelity.mjs",
    "benchmark:mcp-manifest": "node scripts/verify-mcp-manifest-budget.mjs",
    "benchmark:mcp-startup": "node --max-old-space-size=128 --max-semi-space-size=4 scripts/verify-mcp-startup.mjs",
    "benchmark:mcp-agent": "node scripts/evaluate-mcp-agent-selection.mjs",
    "registry:verify": "node scripts/verify-mcp-registry.mjs",
    "contracts:export-public": "node scripts/export-public-contract-repo.mjs",
    "data:sign": "node scripts/sign-data-snapshots.mjs",
    "data:verify-signatures": "node scripts/verify-data-signatures.mjs",
    "catalog:check": "node scripts/catalog.mjs check",
    "catalog:index": "node scripts/catalog.mjs index",
    "catalog:add": "node scripts/catalog.mjs add",
    "catalog:history": "node scripts/append-catalog-evidence.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "audit:editorial": "node scripts/audit-editorial-sources.mjs",
    "sources:check": "node scripts/check-source-links.mjs",
    "archive:verify": "bash scripts/verify-source-archive.sh",
    "seo:verify-live": "node scripts/verify-live-seo.mjs",
    "seo:prepare": "node scripts/prepare-indexation.mjs",
    "lint:source": "node scripts/lint-source.mjs",
    "lighthouse": "lhci autorun",
    "lighthouse:production": "lhci autorun",
    "lighthouse:summary": "node scripts/summarize-lighthouse.mjs",
    "crux:report": "node scripts/fetch-crux.mjs",
    "validate:full": "pnpm validate && pnpm data:validate && pnpm benchmark:mcp-startup",
    "validate:main": "pnpm lint:source && pnpm validate:full && pnpm audit:dist && pnpm archive:verify && pnpm lighthouse",
    "preview": "astro preview",
    "mcp:start": "node server/mcp-server.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.2.8",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@lhci/cli": "0.15.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
