{
  "schemaVersion": "1.0.0",
  "benchmarkId": "compatair-mcp-agent-selection",
  "benchmarkVersion": "2026-07-20",
  "caseCount": 50,
  "targets": {
    "minimumModels": 2,
    "calculableSuccessRate": 0.8,
    "coreManifestMaximumBytes": 50000,
    "tokenMeasurement": "Record the exact tokenizer and manifest token count reported by each target client; bytes divided by four is not accepted."
  },
  "cases": [
