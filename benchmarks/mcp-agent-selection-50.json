    { "case_id": "orient-01", "prompt": "Oriente-moi vers le bon tool pour identifier une référence, sans lancer encore la recherche.", "calculable": true, "expected": { "profile": "core", "tool": "orient_decision", "arguments": { "goal": "identify" } } }
