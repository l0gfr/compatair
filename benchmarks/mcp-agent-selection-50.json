    { "case_id": "build-08", "prompt": "Propose un compresseur pour la visseuse Metabo DS 14.", "calculable": true, "expected": { "profile": "core", "tool": "build_complete_air_system", "arguments": { "toolIds": ["metabo-ds-14"] } } },

