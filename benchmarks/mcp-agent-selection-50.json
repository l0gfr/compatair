    { "case_id": "evidence-02", "prompt": "Je veux la preuve pression-débit pour l'ABAC ATF 5.5 et la CP785.", "calculable": true, "expected": { "profile": "extended", "tool": "get_compatibility_evidence", "arguments": { "compressorId": "abac-atf-5-5-270d", "toolId": "chicago-pneumatic-cp785" } } },
