    { "case_id": "changes-01", "prompt": "Quelles données CompatAir ont changé depuis 2026-07-15 ?", "calculable": true, "expected": { "profile": "extended", "tool": "get_changefeed", "arguments": { "since": "2026-07-15" } } },
