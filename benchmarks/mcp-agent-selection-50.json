    { "case_id": "identify-03", "prompt": "Quel produit correspond à l'EAN 4007430227911 ?", "calculable": true, "expected": { "profile": "core", "tool": "identify_product", "arguments": { "ean": "4007430227911" } } },
    { "case_id": "identify-04", "prompt": "Retrouve le compresseur portant la référence 4010393.", "calculable": true, "expected": { "profile": "core", "tool": "identify_product", "arguments": { "reference": "4010393" } } },
    { "case_id": "identify-05", "prompt": "À quoi correspond ca:tool:einhell-tc-pe-150 ?", "calculable": true, "expected": { "profile": "core", "tool": "identify_product", "arguments": { "reference": "ca:tool:einhell-tc-pe-150" } } },
