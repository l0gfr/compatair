    { "case_id": "offers-02", "prompt": "Donne les prix actuels du KAESER EPC 840-100.", "calculable": false, "missing_reason": "Une absence d'offre fraîche doit rester explicite.", "expected": { "profile": "core", "tool": "get_current_offers", "arguments": { "productIds": ["kaeser-eurocomp-epc-840-100"] } } },
