    { "case_id": "evaluate-04", "prompt": "Même configuration, mais les deux outils sont utilisés successivement.", "calculable": true, "expected": { "profile": "core", "tool": "evaluate_air_compatibility", "arguments": { "compressorId": "kaeser-eurocomp-epc-840-100", "toolIds": ["einhell-tc-pe-150", "einhell-tc-pp-220"], "mode": "successive" } } },
