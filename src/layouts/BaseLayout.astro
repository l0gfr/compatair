---
import '@fontsource-variable/manrope/index.css';
import '@fontsource-variable/newsreader/index.css';
import manropeLatinWghtUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import newsreaderLatinWghtUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SiteSearch from '../components/SiteSearch.astro';
import UiIcon from '../components/UiIcon.astro';
import BrandMark from '../components/BrandMark.astro';
import JourneyContextBar from '../components/JourneyContextBar.astro';
import AcquisitionTelemetry from '../components/AcquisitionTelemetry.astro';
import CalculatorAcquisitionTelemetry from '../components/CalculatorAcquisitionTelemetry.astro';
import CommercialIntentTelemetry from '../components/CommercialIntentTelemetry.astro';
import McpCanonicalTelemetry from '../components/McpCanonicalTelemetry.astro';
import { compressors, tools } from '../data/catalog';
import { resolveDocumentTitle } from '../domain/metadata';
import { socialCardKey } from '../domain/social-card';
import { serializeJsonLd } from '../domain/structured-data';

type Props = {
	title: string;
	editorialTitle?: string;
	description: string;
	lang?: 'fr' | 'en';
	canonicalPath?: string;
	alternates?: Array<{ hreflang: string; path: string }>;
	noindex?: boolean;
	pageType?: 'website' | 'article' | 'product';
	imagePath?: string;
	imageAlt?: string;
	preloadImagePath?: string;
	issueDate?: Date;
	modifiedDate?: Date;
	breadcrumbs?: Array<{ name: string; path: string }>;
};

const {
	title,
	editorialTitle,
	description,
	lang = 'fr',
	canonicalPath = Astro.url.pathname,
	alternates = [],
	noindex = false,
	pageType = 'website',
	imagePath,
	imageAlt,
	preloadImagePath,
	issueDate,
	modifiedDate,
	breadcrumbs = [],
} = Astro.props;
const resolvedTitle = resolveDocumentTitle(title, editorialTitle);
const documentTitle = resolvedTitle.title;
const canonical = new URL(canonicalPath, Astro.site);
const alternateLinks = alternates.length
	? alternates.map((item) => ({ hreflang: item.hreflang, href: new URL(item.path, Astro.site).toString() }))
	: [
		{ hreflang: lang === 'en' ? 'en' : 'fr', href: canonical.toString() },
		{ hreflang: 'x-default', href: canonical.toString() },
	];
const socialImage = new URL(imagePath ?? `/social/${socialCardKey(canonical.pathname)}.png`, Astro.site);
const currentPath = Astro.url.pathname;
const commercialIntentTelemetryEnabled = currentPath === '/' || ['/compresseurs/', '/outils-pneumatiques/', '/guides/', '/offres/', '/comparatifs/'].some((path) => currentPath.startsWith(path));
const currentYear = new Date().getFullYear();
const catalogReferenceCount = compressors.length + tools.length;
const isCurrent = (href: string) => currentPath.startsWith(href);
type DecisionStep = { id: string; label: string; short: string; href: string; state: 'completed' | 'current' | 'available' };
const journeySteps = [
	{ id: 'identify', label: 'Identifier', short: 'Identifier', href: '/scanner/' },
	{ id: 'size', label: 'Dimensionner', short: 'Besoin', href: '/calculateur/' },
	{ id: 'compare', label: 'Comparer', short: 'Comparer', href: '/comparateur/' },
	{ id: 'prepare', label: 'Préparer', short: 'Préparer', href: '/passeport/' },
	{ id: 'verify', label: 'Vérifier sur le terrain', short: 'Terrain', href: '/mise-en-service/' },
] as const;
const actionIndex = currentPath.startsWith('/scanner/') ? 0
	: currentPath.startsWith('/calculateur/') ? 1
		: currentPath.startsWith('/comparateur/') ? 2
			: currentPath.startsWith('/passeport/') ? 3
				: ['/mise-en-service/', '/suivi-exploitation/', '/diagnostic-intervention/', '/maintenance-preventive/'].some((path) => currentPath.startsWith(path)) ? 4
					: -1;
const completeJourneyIsRelevant = actionIndex >= 0 || ['/professionnels/', '/guides/professionnels/', '/guides/metiers/'].some((path) => currentPath.startsWith(path));
const frenchSteps = (completeJourneyIsRelevant ? journeySteps : journeySteps.slice(0, 3)).map((step, index): DecisionStep => ({
	...step,
	state: actionIndex < 0 ? 'available' : index < actionIndex ? 'completed' : index === actionIndex ? 'current' : 'available',
}));
const decisionRail = lang === 'en'
	? {
		label: 'CompatAir decision line',
		name: 'CA / PNEUMATIC DECISION',
		steps: [
			{ id: 'identify', label: 'Identify', short: 'Identify', href: '/scanner/', state: 'available' },
			{ id: 'size', label: 'Size', short: 'Need', href: '/calculateur/', state: 'available' },
			{ id: 'compare', label: 'Compare', short: 'Compare', href: '/comparateur/', state: 'available' },
		] satisfies DecisionStep[],
		next: { label: 'Start with a reference', href: '/scanner/' },
	}
	: {
		label: 'Ligne de décision CompatAir',
		name: completeJourneyIsRelevant ? 'CA / PARCOURS DE DÉCISION' : 'CA / DÉCISION PNEUMATIQUE',
		steps: frenchSteps,
		next: actionIndex === 0 ? { label: 'Étape actuelle · identifier', href: '#contenu' }
			: actionIndex === 1 ? { label: 'Étape actuelle · dimensionner', href: '#contenu' }
				: actionIndex === 2 ? { label: 'Étape actuelle · comparer', href: '#contenu' }
					: actionIndex === 3 ? { label: 'Étape actuelle · préparer', href: '#contenu' }
						: actionIndex === 4 ? { label: 'Étape actuelle · terrain', href: '#contenu' }
							: { label: 'Commencer · identifier', href: '/scanner/' },
	};
const exploreItems = [
	{ href: '/compresseurs/', label: 'Compresseurs', detail: 'Débits et sources documentés' },
	{ href: '/outils-pneumatiques/', label: 'Outils pneumatiques', detail: 'Besoins publiés par usage' },
	{ href: '/marques/', label: 'Marques', detail: 'Couverture des catalogues' },
	{ href: '/glossaire/', label: 'Glossaire', detail: 'Définitions techniques sourcées' },
];
const exploreIsCurrent = exploreItems.some((item) => isCurrent(item.href));
const journeyContextIsRelevant = ['/scanner/', '/calculateur/', '/comparateur/'].some((path) => currentPath.startsWith(path));
const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': 'https://compatair.fr/#organization',
			name: 'CompatAir',
			alternateName: 'CompatAir.fr',
			url: 'https://compatair.fr/',
			logo: 'https://compatair.fr/favicon-512.png',
			description: 'Service indépendant de vérification de compatibilité entre compresseurs et outils pneumatiques.',
			email: 'contact@l0g.fr',
			sameAs: ['https://github.com/l0gfr/compatair'],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://compatair.fr/#website',
			url: 'https://compatair.fr/',
			name: 'CompatAir',
			description: 'Outil indépendant pour vérifier quels compresseurs peuvent alimenter quels outils pneumatiques à partir de données constructeur identifiées.',
			inLanguage: 'fr-FR',
			publisher: { '@id': 'https://compatair.fr/#organization' },
		},
	],
};
const breadcrumbJsonLd = breadcrumbs.length ? {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://compatair.fr/' },
		...breadcrumbs.map((item, index) => ({
			'@type': 'ListItem',
			position: index + 2,
			name: item.name,
			item: new URL(item.path, Astro.site).toString(),
		})),
	],
} : undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="application-name" content="CompatAir" />
		<meta name="author" content="CompatAir" />
		<meta name="compatair:title-source" content={resolvedTitle.source} />
		<meta name="theme-color" content="#11251c" />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
		<link rel="canonical" href={canonical} />
		{alternateLinks.map((item) => <link rel="alternate" hreflang={item.hreflang} href={item.href} />)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="preload" href={manropeLatinWghtUrl} as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href={newsreaderLatinWghtUrl} as="font" type="font/woff2" crossorigin="anonymous" />
		{preloadImagePath && <link rel="preload" href={preloadImagePath} as="image" fetchpriority="high" />}
		<meta property="og:type" content={pageType} />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'fr_FR'} />
		<meta property="og:site_name" content="CompatAir" />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={imageAlt ?? documentTitle} />
		<meta name="twitter:image" content={socialImage} />
		{issueDate && <meta property="article:published_time" content={issueDate.toISOString()} />}
		{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={description} />
		<script is:inline type="application/ld+json" set:html={serializeJsonLd(websiteJsonLd)} />
		{breadcrumbJsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbJsonLd)} />}
		<title>{documentTitle}</title>
		<McpCanonicalTelemetry />
	</head>
	<body>
		<a class="skip-link" href="#contenu">{lang === 'en' ? 'Skip to content' : 'Aller au contenu'}</a>
		<header class="site-header">
			<nav class="container nav" aria-label="Navigation principale">
				<div class="brand-cluster">
					<a class="brand" href="/" aria-label="CompatAir, accueil"><BrandMark /><span class="brand-name"><span class="brand-wordmark"><span>Compat</span><strong>Air</strong></span><small>Quel compresseur pour vos outils&nbsp;?</small></span></a>
					<span class="brand-corpus" aria-label={`${catalogReferenceCount} références documentées`}><small>Corpus</small><strong>{catalogReferenceCount}</strong><i>réf.</i></span>
				</div>
				<div class="desktop-nav">
					<div class="nav-links nav-task-links">
						<a class:list={['nav-cta', isCurrent('/scanner/') && 'active']} href="/scanner/" aria-current={isCurrent('/scanner/') ? 'page' : undefined}>Identifier</a>
						<a href="/calculateur/" class:list={{ active: isCurrent('/calculateur/') }} aria-current={isCurrent('/calculateur/') ? 'page' : undefined}>Vérifier un besoin</a>
						<details class:list={['nav-explorer', exploreIsCurrent && 'active']}>
							<summary>Explorer <span aria-hidden="true">⌄</span></summary>
							<div class="nav-explorer-panel">{exploreItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><strong>{item.label}</strong><small>{item.detail}</small></a>)}</div>
						</details>
						<a href="/guides/" class:list={{ active: isCurrent('/guides/') }} aria-current={isCurrent('/guides/') ? 'page' : undefined}>Guides</a>
						<a href="/professionnels/" class:list={{ active: isCurrent('/professionnels/') }} aria-current={isCurrent('/professionnels/') ? 'page' : undefined}>Professionnels</a>
					</div>
					<SiteSearch />
				</div>
				<details class="mobile-menu">
					<summary>Menu <span aria-hidden="true"></span></summary>
					<div class="mobile-menu-panel">
						<div class="mobile-menu-priority" aria-label="Commencer">
							<a href="/scanner/"><strong>Identifier une référence</strong><small>MPN, EAN/GTIN ou SKU sourcé</small></a>
							<a href="/calculateur/"><strong>Vérifier un besoin</strong><small>Outil, usage et compresseur</small></a>
						</div>
						<a href="/guides/" aria-current={isCurrent('/guides/') ? 'page' : undefined}>Guides</a>
						<a class="mobile-pro-link" href="/professionnels/" aria-current={isCurrent('/professionnels/') ? 'page' : undefined}><strong>Professionnels</strong><small>Catalogues, distribution et ateliers</small></a>
						<details class="mobile-explore"><summary>Explorer le corpus</summary><div>{exploreItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}</div></details>
						<a href="/recherche/">Rechercher sur le site</a>
						<a href="/methodologie/">Méthode et fiabilité</a>
						<a href="/passeport/" aria-current={isCurrent('/passeport/') ? 'page' : undefined}>Conserver une configuration</a>
					</div>
				</details>
			</nav>
			<nav class:list={['decision-rail', completeJourneyIsRelevant && 'is-complete-journey']} aria-label={decisionRail.label} data-decision-rail>
				<div class="container decision-rail-inner">
					<strong class="decision-rail-name">{decisionRail.name}</strong>
					<ol>{decisionRail.steps.map((step, index) => <li data-decision-step={step.id} data-state={step.state}><a href={step.href} aria-current={step.state === 'current' ? 'step' : undefined}><span>0{index + 1}</span><b class="decision-rail-full">{step.label}</b><b class="decision-rail-short">{step.short}</b></a></li>)}</ol>
					<a class="decision-rail-status" data-decision-next href={decisionRail.next.href}><i aria-hidden="true"></i><span>{decisionRail.next.label}</span></a>
				</div>
			</nav>
		</header>
		{journeyContextIsRelevant && <JourneyContextBar />}
		<main id="contenu" tabindex="-1"><slot /></main>
		<footer class="site-footer" aria-label="Pied de page">
			<div class="container footer-shell">
				<div class="footer-topline">
					<a class="footer-identity" href="/">
						<BrandMark class="footer-mark" />
						<span><strong><span>Compat</span><b>Air</b></strong><small>Quel compresseur pour vos outils&nbsp;?</small></span>
					</a>
					<div class="footer-statement"><span>Décision technique / source vérifiable</span><p>Une référence exacte, un besoin publié, une réponse traçable.</p></div>
					<nav class="footer-quick-routes" aria-label="Accès rapides"><a href="/scanner/"><small>01</small><span>Identifier</span></a><a href="/calculateur/"><small>02</small><span>Dimensionner</span></a><a href="/comparateur/"><small>03</small><span>Comparer</span></a></nav>
					<div class="footer-assurances" aria-label="Principes CompatAir">
						<span><UiIcon name="check" size={16} /> Données sourcées</span>
						<span><UiIcon name="shield" size={16} /> Aucune donnée inventée</span>
						<span><UiIcon name="scale" size={16} /> Résultat indépendant</span>
					</div>
				</div>

				<nav class="footer-directory footer-directory-primary" aria-label="Navigation principale du pied de page">
					<section class="footer-block">
						<header><h2>Explorer</h2></header>
						<a href="/compresseurs/"><span>Compresseurs</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/outils-pneumatiques/"><span>Outils pneumatiques</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/marques/"><span>Marques documentées</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/guides/"><span>Guides techniques</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/professionnels/"><span>Professionnels</span><span class="footer-arrow" aria-hidden="true">→</span></a>
					</section>
					<section class="footer-block">
						<header><h2>Décider</h2></header>
						<a href="/scanner/"><span>Identifier une référence</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/calculateur/"><span>Vérifier une configuration</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/comparateur/"><span>Comparer des modèles</span><span class="footer-arrow" aria-hidden="true">→</span></a>
					</section>
					<section class="footer-block">
						<header><h2>Confiance</h2></header>
						<a href="/confiance/"><span>Centre de confiance</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/methodologie/"><span>Comment fonctionne CompatAir</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/affiliation/"><span>Affiliation et indépendance</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/contact/"><span>Signaler une donnée</span><span class="footer-arrow" aria-hidden="true">→</span></a>
					</section>
					<section class="footer-block">
						<header><h2>API &amp; MCP</h2></header>
						<a href="/agents/#statistiques"><span>Statistiques MCP</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/mcp-documentation/"><span>Documentation MCP</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/api/"><span>Documentation API</span><span class="footer-arrow" aria-hidden="true">→</span></a>
						<a href="/ucp/"><span>Documentation UCP</span><span class="footer-arrow" aria-hidden="true">→</span></a>
					</section>
				</nav>
				<div class="footer-resource-drawers">
					<details><summary>Ressources complémentaires <span>+</span></summary><div><a href="/glossaire/">Glossaire</a><a href="/corrections/">Journal des corrections</a></div></details>
				</div>

				<div class="footer-bottomline">
					<p>CompatAir © {currentYear} · sans compte · sans publicité ciblée</p>
					<div><a href="/mentions-legales/">Mentions légales</a><a href="/cookies/">Cookies</a><a href="/sitemap-index.xml">Sitemap</a></div>
				</div>
			</div>
		</footer>
		{currentPath.startsWith('/calculateur/') ? <CalculatorAcquisitionTelemetry /> : <AcquisitionTelemetry />}
		{commercialIntentTelemetryEnabled && <CommercialIntentTelemetry />}
	</body>
</html>
