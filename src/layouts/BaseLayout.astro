---
import '@fontsource-variable/manrope/index.css';
import '@fontsource-variable/newsreader/index.css';
import manropeLatinWghtUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import newsreaderLatinWghtUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SiteSearch from '../components/SiteSearch.astro';
import UiIcon from '../components/UiIcon.astro';
import { resolveDocumentTitle } from '../domain/metadata';
import { socialCardKey } from '../domain/social-card';

type Props = {
	title: string;
	editorialTitle?: string;
	description: string;
	canonicalPath?: string;
	noindex?: boolean;
	pageType?: 'website' | 'article' | 'product';
	imagePath?: string;
	imageAlt?: string;
	issueDate?: Date;
	modifiedDate?: Date;
	breadcrumbs?: Array<{ name: string; path: string }>;
};

const {
	title,
	editorialTitle,
	description,
	canonicalPath = Astro.url.pathname,
	noindex = false,
	pageType = 'website',
	imagePath,
	imageAlt,
	issueDate,
	modifiedDate,
	breadcrumbs = [],
} = Astro.props;
const resolvedTitle = resolveDocumentTitle(title, editorialTitle);
const documentTitle = resolvedTitle.title;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(imagePath ?? `/social/${socialCardKey(canonical.pathname)}.png`, Astro.site);
const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();
const navItems = [
	{ href: '/guides/', label: 'Guides' },
	{ href: '/glossaire/', label: 'Glossaire' },
	{ href: '/compresseurs/', label: 'Compresseurs' },
	{ href: '/outils-pneumatiques/', label: 'Outils' },
	{ href: '/scanner/', label: 'Scanner' },
	{ href: '/methodologie/', label: 'Comment ça marche' },
];
const isCurrent = (href: string) => currentPath.startsWith(href);
const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': 'https://compatair.fr/#organization',
			name: 'CompatAir',
			url: 'https://compatair.fr/',
			email: 'admin@toonux.com',
		},
		{
			'@type': 'WebSite',
			'@id': 'https://compatair.fr/#website',
			url: 'https://compatair.fr/',
			name: 'CompatAir',
			description: 'Outil indépendant pour vérifier quels compresseurs peuvent alimenter quels outils pneumatiques à partir de données constructeur identifiées.',
			inLanguage: 'fr-FR',
			publisher: { '@id': 'https://compatair.fr/#organization' },
		},
	],
};
const breadcrumbJsonLd = breadcrumbs.length ? {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://compatair.fr/' },
		...breadcrumbs.map((item, index) => ({
			'@type': 'ListItem',
			position: index + 2,
			name: item.name,
			item: new URL(item.path, Astro.site).toString(),
		})),
	],
} : undefined;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="application-name" content="CompatAir" />
		<meta name="author" content="CompatAir" />
		<meta name="compatair:title-source" content={resolvedTitle.source} />
		<meta name="theme-color" content="#11251c" />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="fr-FR" href={canonical} />
		<link rel="alternate" hreflang="x-default" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href={manropeLatinWghtUrl} as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href={newsreaderLatinWghtUrl} as="font" type="font/woff2" crossorigin="anonymous" />
		<meta property="og:type" content={pageType} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="CompatAir" />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={imageAlt ?? documentTitle} />
		<meta name="twitter:image" content={socialImage} />
		{issueDate && <meta property="article:published_time" content={issueDate.toISOString()} />}
		{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={description} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
		{breadcrumbJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
		<title>{documentTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		<header class="site-header">
			<nav class="container nav" aria-label="Navigation principale">
				<a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><span class="brand-arc"></span><span class="brand-needle"></span></span><span class="brand-name">CompatAir<small>Quel compresseur pour vos outils&nbsp;?</small></span></a>
				<div class="desktop-nav">
					<div class="nav-links">{navItems.map((item) => <a href={item.href} class:list={{ active: isCurrent(item.href) }} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}</div>
					<SiteSearch />
					<a class:list={['nav-cta', isCurrent('/calculateur/') && 'active']} href="/calculateur/">Vérifier mon besoin <span aria-hidden="true">→</span></a>
				</div>
				<details class="mobile-menu">
					<summary>Menu <span aria-hidden="true"></span></summary>
					<div class="mobile-menu-panel">{navItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}<a href="/recherche/">Recherche</a><a href="/calculateur/">Vérifier mon besoin</a><a href="/passeport/" aria-current={isCurrent('/passeport/') ? 'page' : undefined}>Conserver une configuration</a><a href="/observatoire-qualite-documentaire/">Observatoire documentaire</a><a href="/affiliation/">Affiliation</a><a href="/contact/">Signaler une donnée</a></div>
				</details>
			</nav>
		</header>
		<main id="contenu"><slot /></main>
		<footer class="site-footer" aria-label="Pied de page">
			<div class="container footer-shell">
				<div class="footer-topline">
					<a class="footer-identity" href="/">
						<span class="brand-mark footer-mark" aria-hidden="true"><span class="brand-arc"></span><span class="brand-needle"></span></span>
						<span><strong>CompatAir</strong><small>Quel compresseur pour vos outils&nbsp;?</small></span>
					</a>
					<p>CompatAir vérifie quel compresseur peut alimenter vos outils à partir de données constructeur clairement identifiées.</p>
					<div class="footer-assurances" aria-label="Principes CompatAir">
						<span><UiIcon name="check" size={16} /> Données sourcées</span>
						<span><UiIcon name="shield" size={16} /> Aucune donnée inventée</span>
						<span><UiIcon name="scale" size={16} /> Résultat indépendant</span>
					</div>
				</div>

				<nav class="footer-directory" aria-label="Navigation du pied de page">
					<section class="footer-block">
						<header><span class="footer-icon"><UiIcon name="compass" /></span><h2>Explorer</h2></header>
						<a href="/compresseurs/"><span>Compresseurs</span><UiIcon name="arrow" size={15} /></a>
						<a href="/outils-pneumatiques/"><span>Outils pneumatiques</span><UiIcon name="arrow" size={15} /></a>
						<a href="/guides/"><span>Guides techniques</span><UiIcon name="arrow" size={15} /></a>
						<a href="/glossaire/"><span>Glossaire sourcé</span><UiIcon name="arrow" size={15} /></a>
					</section>
					<section class="footer-block">
						<header><span class="footer-icon"><UiIcon name="calculator" /></span><h2>Choisir et vérifier</h2></header>
						<a href="/calculateur/"><span>Vérifier une configuration</span><UiIcon name="arrow" size={15} /></a>
						<a href="/passeport/"><span>Conserver une configuration</span><UiIcon name="arrow" size={15} /></a>
						<a href="/scanner/"><span>Identifier un modèle</span><UiIcon name="arrow" size={15} /></a>
						<a href="/comparateur/"><span>Comparer des modèles</span><UiIcon name="arrow" size={15} /></a>
						<a href="/comparatifs/"><span>Comparer les données utiles</span><UiIcon name="arrow" size={15} /></a>
						<a href="/recherche/"><span>Rechercher sur le site</span><UiIcon name="arrow" size={15} /></a>
					</section>
					<section class="footer-block">
						<header><span class="footer-icon"><UiIcon name="database" /></span><h2>Comment nous vérifions</h2></header>
						<a href="/methodologie/"><span>Comment fonctionne CompatAir</span><UiIcon name="arrow" size={15} /></a>
						<a href="/sources-fiabilite/"><span>Sources et fiabilité</span><UiIcon name="arrow" size={15} /></a>
						<a href="/preuves/"><span>Documents et dates vérifiés</span><UiIcon name="arrow" size={15} /></a>
						<a href="/radar-contradictions/"><span>Radar des contradictions</span><UiIcon name="arrow" size={15} /></a>
						<a href="/graphe-preuve/"><span>Graphe de preuve</span><UiIcon name="arrow" size={15} /></a>
						<a href="/observatoire-qualite-documentaire/"><span>Observatoire documentaire</span><UiIcon name="arrow" size={15} /></a>
						<a href="/barometre-transparence/"><span>Baromètre de transparence</span><UiIcon name="arrow" size={15} /></a>
						<a href="/corrections/"><span>Journal des corrections</span><UiIcon name="arrow" size={15} /></a>
					</section>
					<section class="footer-block">
						<header><span class="footer-icon"><UiIcon name="shield" /></span><h2>Confiance</h2></header>
						<a href="/affiliation/"><span>Affiliation et indépendance</span><UiIcon name="arrow" size={15} /></a>
						<a href="/contact/"><span>Signaler une donnée</span><UiIcon name="arrow" size={15} /></a>
						<a href="/securite/"><span>Signaler une vulnérabilité</span><UiIcon name="arrow" size={15} /></a>
						<a href="/confidentialite/"><span>Confidentialité</span><UiIcon name="arrow" size={15} /></a>
						<a href="/professionnels/"><span>Solutions professionnelles</span><UiIcon name="arrow" size={15} /></a>
					</section>
				</nav>

				<div class="footer-bottomline">
					<p>CompatAir © {currentYear} · sans compte · sans publicité ciblée</p>
					<div><a href="/mentions-legales/">Mentions légales</a><a href="/cookies/">Cookies</a><a href="/sitemap-index.xml">Sitemap</a></div>
				</div>
			</div>
		</footer>
	</body>
</html>
