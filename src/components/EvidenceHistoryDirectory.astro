---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryPagination from './DirectoryPagination.astro';
import { evidenceHistory } from '../data/evidence-history';
import { evidenceHistoryDirectory } from '../data/evidence-history-directory';
import { evidenceHistoryKindLabel } from '../domain/evidence-history';
import { paginate } from '../domain/pagination';

interface Props { currentPage: number }
const { currentPage } = Astro.props;
const directory = paginate(evidenceHistoryDirectory, currentPage);
const formatDate = (date: string) => new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
const title = currentPage === 1 ? 'Documents et dates vérifiés | CompatAir' : `Documents vérifiés – page ${currentPage} | CompatAir`;
const description = currentPage === 1
	? 'Retrouvez les documents techniques utilisés par CompatAir, leur date de consultation et les corrections apportées.'
	: `Historique public des documents CompatAir, page ${currentPage} sur ${directory.totalPages}, classé par importance des changements et date.`;
const breadcrumbs = [{ name: 'Documents vérifiés', path: '/preuves/' }, ...(currentPage > 1 ? [{ name: `Page ${currentPage}`, path: `/preuves/page/${currentPage}/` }] : [])];
---
<BaseLayout title={title} description={description} imagePath="/social/preuves.png" breadcrumbs={breadcrumbs}>
	<section class="page-hero compact"><div class="container"><p class="eyebrow">Documents vérifiés et dates de consultation</p><h1>Retrouver les sources de chaque produit</h1><p class="lead">{evidenceHistory.events.length} vérifications sont conservées pour {evidenceHistoryDirectory.length} produits. Les corrections et retraits passent avant les ajouts, les revérifications et les premières vérifications.</p></div></section>
	{currentPage === 1 && <section class="section"><div class="container history-intro">
		<div class="callout"><h2>Un point de départ déclaré, pas un passé reconstruit</h2><p>L’historique public commence le {formatDate(evidenceHistory.startedAt)}. Les sources présentes ce jour-là sont marquées «&nbsp;première vérification&nbsp;». CompatAir ne fabrique pas rétroactivement des modifications antérieures. Toute évolution suivante ajoute une entrée sans effacer les précédentes.</p></div>
		<p><a class="button secondary" href="/sources-fiabilite/">Comprendre comment les sources sont utilisées</a></p>
	</div></section>}
	<section class="section history-section"><div class="container"><div class="split-head"><div><p class="eyebrow">Historique non réécrit</p><h2>{currentPage === 1 ? 'Les changements utiles en premier' : `Suite de l’historique · page ${currentPage}`}</h2></div><p>Dans chaque groupe, la vérification la plus récente passe en premier, puis les produits sont classés par marque et modèle.</p></div>
		<div class="directory-order" aria-label="Ordre de classement"><span class="kind-withdrawn">Source retirée</span><span class="kind-corrected">Correction</span><span class="kind-added">Ajout</span><span class="kind-verified">Revérification</span><span class="kind-baseline">Première vérification</span></div>
		<DirectoryPagination basePath="/preuves/" currentPage={currentPage} totalPages={directory.totalPages} firstItem={directory.firstItem} lastItem={directory.lastItem} totalItems={directory.totalItems} itemLabel="produits" />
		<div class="history-list">{directory.items.map(({ product, type, href, events, significantEvent }) => <article id={product.id} class="history-product">
			<header><div><p class="guide-meta">{type === 'compressor' ? 'Compresseur' : 'Outil'} · {product.brand}</p><h3><a href={href}>{product.model}</a></h3></div><div class="history-product-summary"><span class:list={['history-kind', `kind-${significantEvent.kind}`]}>{evidenceHistoryKindLabel[significantEvent.kind]}</span><strong>{events.length} vérification{events.length > 1 ? 's' : ''}</strong></div></header>
			<ol>{events.map((event) => <li class={`kind-${event.kind}`}><div><span class:list={['history-kind', `kind-${event.kind}`]}>{evidenceHistoryKindLabel[event.kind]}</span><time datetime={event.occurredAt}>{formatDate(event.occurredAt)}</time></div><h4>{event.snapshot.sourceLabel}</h4><p>{event.summary}</p><p class="history-meta">Consultée le {formatDate(event.snapshot.retrievedAt)} · fiabilité {event.snapshot.confidence}</p><a href={event.snapshot.sourceUrl} rel="nofollow noopener" target="_blank">Consulter la source</a></li>)}</ol>
		</article>)}</div>
		<DirectoryPagination basePath="/preuves/" currentPage={currentPage} totalPages={directory.totalPages} firstItem={directory.firstItem} lastItem={directory.lastItem} totalItems={directory.totalItems} itemLabel="produits" />
	</div></section>
</BaseLayout>
