---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryPagination from './DirectoryPagination.astro';
import { sourceDirectory, sourceDirectoryCounts, sourceRoleCounts, sourceRoleLabel, sourceTypeLabel } from '../data/source-directory';
import { paginate } from '../domain/pagination';
import { CATALOG_VERIFIED_AT, compressors, tools } from '../data/catalog';
import { createCatalogQualityReport, DATA_FRESHNESS_SLA } from '../domain/data-governance';
import { sourceRoleForEvidence } from '../domain/catalog-normalization';

interface Props { currentPage: number }
const { currentPage } = Astro.props;
const directory = paginate(sourceDirectory, currentPage);
const title = currentPage === 1 ? 'Sources et niveaux de fiabilité | CompatAir' : `Sources et fiabilité – page ${currentPage} | CompatAir`;
const description = currentPage === 1
	? 'Origine des données CompatAir, critères des niveaux A à D, dates de vérification et traitement des informations manquantes.'
	: `Répertoire des sources CompatAir, page ${currentPage} sur ${directory.totalPages}, classé par niveau de fiabilité, nature et date de consultation.`;
const breadcrumbs = [{ name: 'Sources et fiabilité', path: '/sources-fiabilite/' }, ...(currentPage > 1 ? [{ name: `Page ${currentPage}`, path: `/sources-fiabilite/page/${currentPage}/` }] : [])];
const formatDate = (date: string) => date.split('-').reverse().join('/');
const quality = createCatalogQualityReport(compressors, tools, CATALOG_VERIFIED_AT);
const formatPercent = (value: number | null) => value === null ? 'non mesuré' : `${value.toLocaleString('fr-FR')} %`;
const formatMaximumAge = (policy: typeof DATA_FRESHNESS_SLA[number]) => 'maximumAgeHours' in policy ? `${policy.maximumAgeHours} h` : `${policy.maximumAgeDays} j`;
---
<BaseLayout title={title} description={description} imagePath="/social/sources-fiabilite.png" breadcrumbs={breadcrumbs}>
	<div class="source-page">
	<section class:list={['page-hero', currentPage > 1 && 'compact', 'source-hero']}><div class:list={['container', currentPage === 1 && 'source-hero-grid']}><div><p class="eyebrow">Origine des informations</p><h1>{currentPage === 1 ? 'Savoir ce que vaut chaque source' : `Sources et fiabilité, page ${currentPage}`}</h1><p class="lead">{sourceDirectory.length} documents distincts étayent les fiches actuelles. Le niveau visible traduit la qualité de la documentation disponible, pas la réputation commerciale d’une marque.</p>{currentPage === 1 && <div class="hero-actions"><a class="button primary" href="#documents">Voir les documents</a><a class="button secondary" href="/preuves/">Voir leur historique</a></div>}</div>
		{currentPage === 1 && <div class="source-confidence-model" data-source-confidence-visual aria-label="Échelle de qualité des données de A à D"><header><span><i></i> Qualité documentaire</span><strong>4 NIVEAUX EXPLICITES</strong></header><div>{(['A', 'B', 'C', 'D'] as const).map((confidence) => <div data-confidence={confidence}><strong>{confidence}</strong><span>{confidence === 'A' ? 'Source constructeur complète' : confidence === 'B' ? 'Source constructeur partielle' : confidence === 'C' ? 'Source insuffisante pour conclure' : 'Source non confirmée'}</span><small>{sourceDirectoryCounts[confidence]} document{sourceDirectoryCounts[confidence] > 1 ? 's' : ''}</small></div>)}</div><footer>Le grade technique reste accessible dans le détail.</footer></div>}
	</div></section>
	{currentPage === 1 && <section class="source-answer"><div class="container">{(['A', 'B', 'C', 'D'] as const).map((confidence) => <div><span>{sourceDirectoryCounts[confidence]}</span><small>{confidence === 'A' ? 'Sources constructeur complètes' : confidence === 'B' ? 'Sources constructeur partielles' : confidence === 'C' ? 'Sources insuffisantes' : 'Sources non confirmées'}</small></div>)}</div></section>}
	{currentPage === 1 ? <><section class="section source-scale-section"><div class="container"><div class="split-head"><div><p class="eyebrow">Lire la qualité</p><h2>Une lettre technique, un libellé humain</h2></div><p>Le niveau indique jusqu’où une donnée peut soutenir un verdict. Une donnée faible n’est jamais promue par une estimation silencieuse.</p></div><dl class="confidence-scale source-confidence-scale"><div><dt>A</dt><dd><strong>Source constructeur complète.</strong> La documentation du fabricant indique clairement la valeur et ses conditions d’utilisation.</dd></div><div><dt>B</dt><dd><strong>Source constructeur partielle.</strong> La source officielle est incomplète ou demande un calcul entre deux points publiés, appelé <a href="/glossaire/#interpolation">interpolation</a>.</dd></div><div><dt>C</dt><dd><strong>Source insuffisante pour conclure.</strong> La donnée est ambiguë, difficile à comparer ou ne permet pas de confirmer une compatibilité.</dd></div><div><dt>D</dt><dd><strong>Source non confirmée.</strong> L’information n’est pas confirmée par le fabricant et ne suffit pas à produire un résultat positif.</dd></div></dl></div></section>
		<section class="section source-role-section"><div class="container"><div class="split-head"><div><p class="eyebrow">Rôle de la preuve</p><h2>Primaire ne veut pas dire corroborée</h2></div><p>Le rôle décrit l’origine de la preuve. Le grade A à D décrit séparément sa capacité à soutenir le champ ou le verdict.</p></div><div class="observatory-definitions"><article><span>P</span><h3>Source primaire</h3><p>{quality.source_roles.definitions.primary}</p><strong>{sourceRoleCounts.primary} document{sourceRoleCounts.primary > 1 ? 's' : ''}</strong></article><article><span>C</span><h3>Corroboration indépendante</h3><p>{quality.source_roles.definitions.independent_corroboration}</p><strong>{sourceRoleCounts.independent_corroboration} document{sourceRoleCounts.independent_corroboration > 1 ? 's' : ''}</strong></article><article><span>S</span><h3>Source secondaire</h3><p>{quality.source_roles.definitions.secondary}</p><strong>{sourceRoleCounts.secondary} document{sourceRoleCounts.secondary > 1 ? 's' : ''}</strong></article></div></div></section>
		<section class="section source-coverage-section" id="couverture"><div class="container"><div class="split-head"><div><p class="eyebrow">Couverture champ par champ</p><h2>Mesurer ce qui est présent, sourcé et corroboré</h2></div><p>Chaque ligne publie son propre dénominateur. La source explicite exige un lien vers le champ concerné ; un document simplement attaché à la fiche ne suffit pas.</p></div><div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>Champ</th><th>Population</th><th>Présent</th><th>Source explicite</th><th>Source primaire</th><th>Corroboration indépendante</th></tr></thead><tbody>{quality.field_coverage.map((row) => <tr><th>{row.label}<small><code>{row.field}</code></small></th><td>{row.eligible_count}</td><td>{row.populated_count}/{row.eligible_count}<small>{formatPercent(row.population_coverage_percent)}</small></td><td>{row.explicitly_sourced_count}/{row.populated_count}<small>{formatPercent(row.explicit_source_coverage_percent)}</small></td><td>{row.primary_source_count}/{row.populated_count}<small>{formatPercent(row.primary_source_coverage_percent)}</small></td><td>{row.independently_corroborated_count}/{row.populated_count}<small>{formatPercent(row.independent_corroboration_coverage_percent)}</small></td></tr>)}</tbody></table></div><ul>{quality.limitations.map((limitation) => <li>{limitation}</li>)}</ul><p><a href="/data/catalog.json">Télécharger le rapport calculé dans le snapshot catalogue</a>.</p></div></section>
		<section class="section source-sla-section" id="sla-fraicheur"><div class="container"><div class="split-head"><div><p class="eyebrow">SLA public de fraîcheur</p><h2>Un âge maximal par type de donnée</h2></div><p>Il s’agit d’un engagement de revue ou de retrait des données, distinct d’un SLA de disponibilité de l’API.</p></div><div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>Type de donnée</th><th>Âge maximal</th><th>Déclencheur de mise à jour</th><th>Comportement au dépassement</th></tr></thead><tbody>{DATA_FRESHNESS_SLA.map((policy) => <tr><th>{policy.label}<small><code>{policy.id}</code></small></th><td>{formatMaximumAge(policy)}</td><td>{policy.refreshTrigger}</td><td>{policy.breachBehavior}</td></tr>)}</tbody></table></div><p>Le manifeste machine <a href="/data/freshness.json"><code>/data/freshness.json</code></a> publie pour chaque jeu de données la date observée, son âge, le seuil applicable et le statut <code>current</code>, <code>stale</code> ou <code>unavailable</code>.</p></div></section>
		<section class="section source-rules"><div class="container"><div class="split-head"><div><p class="eyebrow">Règles de publication</p><h2>De la source au résultat, sans raccourci</h2></div><p>Cinq règles empêchent une donnée séduisante mais inadaptée de devenir un verdict technique.</p></div><ol><li><span>01</span><p>Le <a href="/glossaire/#debit-aspire">débit aspiré</a> ne remplace jamais le <a href="/glossaire/#debit-restitue">débit restitué</a>.</p></li><li><span>02</span><p>L’<a href="/glossaire/#interpolation">interpolation</a> reste limitée à l’intervalle compris entre deux points documentés.</p></li><li><span>03</span><p>Une valeur de prix ou de disponibilité n’est publiée qu’avec sa date de collecte.</p></li><li><span>04</span><p>Une correction modifiant un résultat doit être relue et testée avant publication.</p></li><li><span>05</span><p>Une source marchande peut documenter une offre, mais pas remplacer une source technique plus adaptée.</p></li></ol></div></section></> : <section class="section source-return"><div class="container"><p class="directory-return"><a href="/sources-fiabilite/">← Revenir aux critères de fiabilité et aux règles de publication</a></p></div></section>}
	<section class="section source-directory" id="documents"><div class="container"><div class="split-head"><div><p class="eyebrow">Répertoire public</p><h2>{currentPage === 1 ? 'Documents consultés pour les fiches actuelles' : `Documents consultés · page ${currentPage}`}</h2></div><p>Le classement commence par la qualité des données, puis la nature du document et enfin la date de consultation.</p></div>
		<div class="source-directory-summary" aria-label="Répartition des documents par fiabilité">{(['A', 'B', 'C', 'D'] as const).map((confidence) => <span data-confidence={confidence}><strong>{sourceDirectoryCounts[confidence]}</strong> fiabilité {confidence}</span>)}</div>
		<p class="directory-sort-note">Ordre affiché : fiabilité A à D, documentation constructeur avant les autres natures, puis consultation la plus récente.</p>
		<DirectoryPagination basePath="/sources-fiabilite/" currentPage={currentPage} totalPages={directory.totalPages} firstItem={directory.firstItem} lastItem={directory.lastItem} totalItems={directory.totalItems} itemLabel="documents" />
		<div class="source-register" data-source-register>{directory.items.map((source) => <article><div class="source-register-heading"><span class="source-confidence" data-confidence={source.confidence}>{source.confidence === 'A' ? 'Source constructeur complète' : source.confidence === 'B' ? 'Source constructeur partielle' : source.confidence === 'C' ? 'Source insuffisante' : 'Source non confirmée'} <small>· grade {source.confidence}</small></span><span>{sourceTypeLabel[source.sourceType]} · {sourceRoleLabel[sourceRoleForEvidence(source)]}</span></div><strong>{source.sourceLabel}</strong><span>Consultée le {formatDate(source.retrievedAt)}</span><a href={source.sourceUrl} rel="nofollow noopener" target="_blank">Consulter la source</a></article>)}</div>
		<DirectoryPagination basePath="/sources-fiabilite/" currentPage={currentPage} totalPages={directory.totalPages} firstItem={directory.firstItem} lastItem={directory.lastItem} totalItems={directory.totalItems} itemLabel="documents" />
	</div></section>
	{currentPage === 1 && <section class="section source-correction"><div class="container"><div><p class="eyebrow">Contradiction ou source plus récente</p><h2>Une correction doit être identifiable et testable</h2><p>Le signalement doit identifier le modèle, la caractéristique et le document concerné.</p></div><a class="button primary inverse" href="/contact/">Proposer une correction</a></div></section>}
	</div>
</BaseLayout>

<style>
	.source-page .compare-table th small,
	.source-page .compare-table td small {
		display: block;
		margin-top: .28rem;
		color: var(--muted);
		font-size: .72rem;
		font-weight: 500;
		line-height: 1.35;
	}

	.source-page .compare-table th small code {
		font-size: .68rem;
	}
</style>
