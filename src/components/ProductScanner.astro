---
import ContextHelp from './ContextHelp.astro';
---

<div class="scanner" data-scanner data-decision-visual="identify" data-ui-state="idle">
	<form class="scanner-form" id="scanner-form" data-scanner-form aria-describedby="scanner-status scanner-error">
		<header class="scanner-form-head"><span>01</span><div><p>Référence exacte</p><strong>Un numéro, aucune catégorie à choisir</strong></div><small>Mode recommandé</small></header>
		<div class="scanner-confirmation">
			<div class="field">
				<label for="scanner-identifier">Numéro indiqué sur l’étiquette</label>
				<input id="scanner-identifier" data-identifier type="text" maxlength="160" autocomplete="off" placeholder="Ex. 4010393 ou 4006825597295" aria-describedby="scanner-identifier-help" required />
				<small id="scanner-identifier-help" data-candidate-origin>Saisissez la référence fabricant, le MPN, l’EAN ou le GTIN.</small>
			</div>
			<button class="button primary" type="submit" data-scanner-submit>Identifier la référence</button>
		</div>

		<details class="scanner-photo-details">
			<summary>Utiliser une photo</summary>
			<div class="scanner-photo">
				<div class="scanner-preview" data-preview>
					<span>Photo locale</span>
					<strong>Aucune plaque chargée</strong>
				</div>
				<div>
					<label class="button" for="scanner-photo">Photographier ou choisir une image</label>
					<input id="scanner-photo" data-photo type="file" accept="image/jpeg,image/png,image/webp,image/gif" capture="environment" />
					<button class="button subtle" type="button" data-read-photo disabled>Lire le numéro</button>
					<p class="scanner-local-note">L’image reste dans ce navigateur. Elle n’est ni envoyée, ni enregistrée.</p>
				</div>
			</div>
		</details>
		<p class="scanner-status" id="scanner-status" role="status" aria-live="polite" aria-atomic="true" data-status></p>
		<p class="form-error" id="scanner-error" role="alert" aria-atomic="true" data-error hidden></p>
		<section class="scanner-recovery" data-recovery aria-labelledby="scanner-recovery-title" hidden>
			<div><p>Référence non reconnue</p><h3 id="scanner-recovery-title" data-recovery-title>Retrouvez le bon numéro sans deviner le produit.</h3><small>Vérifiez le MPN, la référence fabricant, l’EAN ou le GTIN indiqué sur l’étiquette.</small></div>
			<div class="scanner-recovery-actions">
				<button class="button" type="button" data-recovery-photo>Utiliser une photo</button>
				<a class="button" data-recovery-search href="/recherche/">Rechercher par marque ou modèle</a>
				<a class="button" href="/calculateur/">Décrire mon usage</a>
				<a class="text-link" href="/contact/#signaler-donnee">Signaler une référence absente</a>
			</div>
		</section>
	</form>

	<section class="scanner-result" id="scanner-answer" data-result hidden>
		<header class="scanner-result-head">
			<div>
				<p class="eyebrow">Produit reconnu</p>
				<h2 data-product-name></h2>
				<div class="scanner-quality-line">
					<span class="scanner-match-badge" data-match-badge>Correspondance exacte par référence fabricant</span>
					<span data-source-verified></span>
				</div>
				<p data-match-detail></p>
			</div>
			<a class="button" data-product-link href="/">Voir la fiche et ses sources</a>
		</header>

		<nav class="result-local-nav" aria-label="Navigation dans la réponse">
			<a href="#scanner-answer" data-result-scroll="scanner-answer" aria-current="location"><span>01</span> Réponse</a>
			<a href="#scanner-selection" data-result-scroll="scanner-selection"><span>02</span> Sélection</a>
			<a href="#scanner-limits" data-result-scroll="scanner-limits" data-expand-results><span>03</span> Limites</a>
			<a href="#scanner-sources" data-result-scroll="scanner-sources" data-expand-results data-open-sources><span>04</span> Sources</a>
		</nav>

		<div class="scanner-decision">
			<div class="scanner-published-need">
				<p class="eyebrow" data-published-label>Besoin publié</p>
				<strong data-published-value></strong>
			</div>
			<dl class="scanner-counts" aria-label="Résumé des résultats">
				<div><dt data-compatible-count>0</dt><dd data-compatible-label>Compatibles</dd></div>
				<div><dt data-incompatible-count>0</dt><dd data-incompatible-label>Incompatibles</dd></div>
				<div><dt data-insufficient-count>0</dt><dd>À compléter</dd></div>
			</dl>
			<div class="scanner-resolution-note" data-resolution-note hidden>
				<strong data-resolution-note-title></strong>
				<p data-resolution-note-detail></p>
				<a class="button primary" data-resolution-note-action href="/calculateur/">Débloquer le calcul</a>
			</div>
			<section class="scanner-top-results" id="scanner-selection">
				<p class="eyebrow">Décision immédiate</p>
				<h3 data-primary-title>Trois meilleurs résultats compatibles</h3>
				<p class="scanner-ranking-note" data-ranking-note hidden></p>
				<div class="scanner-result-cards" data-primary-results></div>
			</section>
			<div class="scanner-result-actions">
				<a class="button primary" data-compare href="/comparateur/" hidden>Comparer les trois compresseurs compatibles</a>
				<a class="button" data-refine href="/calculateur/">Affiner avec ma durée d’utilisation, mon flexible ou plusieurs outils</a>
				<button class="button subtle" type="button" data-toggle-all aria-expanded="false">Voir tous les résultats</button>
			</div>
		</div>

		<div class="scanner-all-results" data-all-results hidden>
			<section class="scanner-result-panel can"><span data-can-label>Compatibles</span><h3 data-can-title></h3><div class="scanner-result-cards compact" data-can></div></section>
			<section class="scanner-result-panel cannot"><span data-cannot-label>Incompatibles</span><h3 data-cannot-title></h3><div class="scanner-result-cards compact" data-cannot></div></section>
			<section class="scanner-result-panel uncertain" id="scanner-limits"><span>À compléter</span><h3>La donnée minimale pour conclure</h3><div class="scanner-result-cards compact" data-insufficient></div></section>
			<section class="scanner-unlocks" data-unlocks-section>
				<p class="eyebrow">Solutions possibles</p>
				<h3>Un tuyau adapté ou un autre compresseur</h3>
				<div data-unlocks></div>
			</section>
			<details class="scanner-evidence" id="scanner-sources"><summary>Sources du modèle identifié</summary><ContextHelp topic="sourceQuality" compact /><div data-evidence></div></details>
		</div>
	</section>
	<aside class="mobile-primary-action" data-scanner-mobile-action aria-label="Action principale">
		<button class="button primary" type="submit" form="scanner-form" data-scanner-submit data-scanner-mobile-submit>Identifier la référence</button>
		<a class="button primary" href="#scanner-selection" data-result-scroll="scanner-selection" data-scanner-mobile-result hidden>Voir la sélection</a>
	</aside>
</div>

<script>
	import type { Compressor, ToolProfile } from '../domain/catalog';
	import type { CompatibilityResult } from '../domain/compatibility';
	import { explainDecisionDataGap } from '../domain/decision-resolution';
	import { isImageWithinPixelBudget, readImageDimensions, type ImageDimensions } from '../domain/image-dimensions';
	import { JOURNEY_CONTEXT_EVENT } from '../domain/journey-context';
	import { encodePassportConfiguration } from '../domain/passport';
	import { compressorCapabilities, identifyProducts, toolCompatibleCompressors } from '../domain/product-identification';
	import { scannerComparisonHref, scannerConfigurationForTool, scannerReferenceFromHash, scannerReferenceUrl } from '../domain/scanner-journey';
	import { sourceQualityDetail, sourceQualityLabel } from '../domain/source-quality';

	type DetectorResult = { rawValue?: string };
	type Detector = { detect(source: ImageBitmap): Promise<DetectorResult[]> };
	type DetectorConstructor = new (options?: { formats?: string[] }) => Detector;
	type DetectionWindow = Window & typeof globalThis & { BarcodeDetector?: DetectorConstructor; TextDetector?: DetectorConstructor };
	type ResultProduct = Compressor | ToolProfile;
	type ResultCard = { product: ResultProduct; type: 'compressor' | 'tool'; result: CompatibilityResult; requiredPressureBar?: number; qualityGrade?: ResultProduct['confidence'] };

	const root = document.querySelector<HTMLElement>('[data-scanner]');
	const form = root?.querySelector<HTMLFormElement>('[data-scanner-form]');
	const photo = root?.querySelector<HTMLInputElement>('[data-photo]');
	const readPhoto = root?.querySelector<HTMLButtonElement>('[data-read-photo]');
	const identifier = root?.querySelector<HTMLInputElement>('[data-identifier]');
	const mobileSubmit = root?.querySelector<HTMLButtonElement>('[data-scanner-mobile-submit]');
	const mobileResult = root?.querySelector<HTMLAnchorElement>('[data-scanner-mobile-result]');
	const submitButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-scanner-submit]') ?? [])];
	let compressors: Compressor[] = [];
	let tools: ToolProfile[] = [];
	let catalogPromise: Promise<void> | undefined;
	let photoBitmap: ImageBitmap | undefined;
	let photoGeneration = 0;

	const query = <T extends Element>(selector: string) => root?.querySelector<T>(selector);
	const setText = (selector: string, value: string) => { const element = query<HTMLElement>(selector); if (element) element.textContent = value; };
	function setScannerUiState(state: 'idle' | 'loading' | 'success' | 'error', message = '') {
		if (root) root.dataset.uiState = state;
		form?.setAttribute('aria-busy', String(state === 'loading'));
		for (const button of submitButtons) { button.disabled = state === 'loading'; button.textContent = state === 'loading' ? 'Recherche en cours…' : 'Identifier la référence'; }
		if (identifier) {
			if (state === 'error') { identifier.setAttribute('aria-invalid', 'true'); identifier.setAttribute('aria-errormessage', 'scanner-error'); }
			else { identifier.removeAttribute('aria-invalid'); identifier.removeAttribute('aria-errormessage'); }
		}
		if (message) setText('[data-status]', message);
	}
	const linkFor = (type: 'compressor' | 'tool', slug: string) => type === 'compressor' ? `/compresseurs/${slug}/` : `/outils-pneumatiques/${slug}/`;
	const verdictLabel = (verdict: CompatibilityResult['verdict']) => verdict === 'continuous' ? 'Compatible en continu' : verdict === 'intermittent' ? 'Compatible par intermittence' : verdict === 'incompatible' ? 'Incompatible' : 'Données insuffisantes';
	const confidenceRank = { A: 0, B: 1, C: 2, D: 3 } as const;
	const resultRank = { continuous: 0, intermittent: 1, incompatible: 2, insufficient_data: 3 } as const;

	function loadCatalog() {
		catalogPromise ??= fetch('/data/catalog.json', { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(async (response) => {
			if (!response.ok) throw new Error('catalog_unavailable');
			const catalog = await response.json() as { compressors?: Compressor[]; tools?: ToolProfile[] };
			if (!Array.isArray(catalog.compressors) || !Array.isArray(catalog.tools)) throw new Error('catalog_invalid');
			compressors = catalog.compressors;
			tools = catalog.tools;
		});
		return catalogPromise;
	}

	function formatNumber(value: number) { return value.toLocaleString('fr-FR', { maximumFractionDigits: 1 }); }
	function productName(product: ResultProduct) { return 'label' in product ? product.label : `${product.brand} ${product.model}`; }
	function resultPressure(product: ResultProduct) { return 'workingPressureBar' in product ? product.workingPressureBar.typical : undefined; }
	function pairGrade(first: ResultProduct['confidence'], second: ResultProduct['confidence']) { return confidenceRank[first] >= confidenceRank[second] ? first : second; }
	function renderResultCard({ product, type, result, requiredPressureBar, qualityGrade = product.confidence }: ResultCard) {
		const article = document.createElement('article'); article.className = `scanner-result-card verdict-${result.verdict}`;
		const head = document.createElement('div'); head.className = 'scanner-card-head';
		const title = document.createElement('h4'); const link = document.createElement('a'); link.href = linkFor(type, product.slug); link.textContent = productName(product); title.append(link);
		const badge = document.createElement('span'); badge.className = 'verdict-badge'; badge.textContent = verdictLabel(result.verdict); head.append(title, badge);
		const pressure = resultPressure(product) ?? requiredPressureBar;
		const flow = document.createElement('p');
		flow.textContent = result.verdict === 'insufficient_data' && result.warnings.length
			? result.warnings[0]
			: result.availableFadLpm === undefined
			? `Débit disponible non vérifiable${pressure !== undefined ? ` à ${formatNumber(pressure)} bar` : ''}.`
			: `${formatNumber(result.availableFadLpm)} L/min disponibles${pressure !== undefined ? ` à ${formatNumber(pressure)} bar` : ''}.`;
		const quality = document.createElement('details'); quality.className = 'scanner-card-quality';
		const summary = document.createElement('summary'); summary.textContent = sourceQualityLabel(qualityGrade);
		const detail = document.createElement('span'); detail.textContent = `${sourceQualityDetail(qualityGrade)} pour le couple vérifié. Le détail des sources reste disponible sur les fiches.`;
		quality.append(summary, detail); article.append(head, flow, quality); return article;
	}
	function renderCards(selector: string, cards: ResultCard[], empty: string) {
		const target = query<HTMLElement>(selector); if (!target) return;
		if (!cards.length) { const message = document.createElement('p'); message.className = 'decision-empty'; message.textContent = empty; target.replaceChildren(message); return; }
		target.replaceChildren(...cards.map(renderResultCard));
	}
	function sortCompatible(cards: ResultCard[]) {
		return [...cards].sort((a, b) => resultRank[a.result.verdict] - resultRank[b.result.verdict]
			|| confidenceRank[a.qualityGrade ?? a.product.confidence] - confidenceRank[b.qualityGrade ?? b.product.confidence]
			|| Math.abs((a.result.availableFadLpm ?? Number.POSITIVE_INFINITY) - (a.result.requiredFadLpm ?? 0)) - Math.abs((b.result.availableFadLpm ?? Number.POSITIVE_INFINITY) - (b.result.requiredFadLpm ?? 0)));
	}
	function setResolutionNote(title?: string, detail?: string, href = '/calculateur/', action = 'Débloquer le calcul') {
		const note = query<HTMLElement>('[data-resolution-note]');
		if (!note) return;
		note.hidden = !title;
		if (!title) return;
		setText('[data-resolution-note-title]', title);
		setText('[data-resolution-note-detail]', detail ?? '');
		const link = query<HTMLAnchorElement>('[data-resolution-note-action]');
		if (link) { link.href = href; link.textContent = action; }
	}
	function publishedNeed(product: ResultProduct, type: 'compressor' | 'tool') {
		if (type === 'compressor') {
			const compressor = product as Compressor;
			const value = compressor.fadCurve.length ? compressor.fadCurve.map((point) => `${formatNumber(point.litersPerMinute)} L/min à ${formatNumber(point.pressureBar)} bar`).join(' · ') : 'Aucun débit restitué exploitable publié.';
			setText('[data-published-label]', 'Capacité publiée');
			setText('[data-published-value]', value);
			return value;
		}
		const tool = product as ToolProfile;
		let value: string;
		setText('[data-published-label]', 'Besoin publié');
		if (tool.demandModel === 'fixed-flow') value = `${formatNumber(tool.airflowLpm.typical)} L/min à ${formatNumber(tool.workingPressureBar.typical)} bar · cible de classement ${formatNumber(tool.airflowLpm.typical * 1.25)} L/min avec 25 % de réserve.`;
		else if (tool.demandModel === 'per-action') value = `${formatNumber(tool.airPerActionLiters)} L par ${tool.actionLabel} à ${formatNumber(tool.workingPressureBar.typical)} bar ; cadence à préciser.`;
		else value = `${tool.demandExplanation} Pression maximale publiée : ${formatNumber(tool.workingPressureBar.max)} bar.`;
		setText('[data-published-value]', value);
		return value;
	}

	async function inspectImage(file: File) {
		const header = new Uint8Array(await file.slice(0, 1_048_576).arrayBuffer());
		return readImageDimensions(header);
	}
	function resizedDimensions(dimensions: ImageDimensions, maximumEdge = 2_048) {
		const scale = Math.min(1, maximumEdge / Math.max(dimensions.width, dimensions.height));
		return { width: Math.max(1, Math.round(dimensions.width * scale)), height: Math.max(1, Math.round(dimensions.height * scale)) };
	}

	photo?.addEventListener('change', async () => {
		const generation = ++photoGeneration;
		const file = photo.files?.[0];
		photoBitmap?.close(); photoBitmap = undefined;
		if (!file || !['image/jpeg', 'image/png', 'image/webp', 'image/gif'].includes(file.type) || file.size > 15_000_000) {
			setText('[data-status]', file ? 'Image refusée : JPEG, PNG, WebP ou GIF et taille maximale de 15 Mo requis.' : '');
			if (readPhoto) readPhoto.disabled = true;
			return;
		}
		if (readPhoto) readPhoto.disabled = true;
		setText('[data-status]', 'Contrôle local des dimensions en cours…');
		try {
			const dimensions = await inspectImage(file);
			if (!dimensions) throw new Error('dimensions_unknown');
			if (!isImageWithinPixelBudget(dimensions)) throw new Error('dimensions_excessive');
			const resized = resizedDimensions(dimensions);
			const bitmap = await createImageBitmap(file, { resizeWidth: resized.width, resizeHeight: resized.height, resizeQuality: 'high' });
			if (generation !== photoGeneration) { bitmap.close(); return; }
			photoBitmap = bitmap;
			const preview = query<HTMLElement>('[data-preview]');
			if (preview) {
				const canvas = document.createElement('canvas'); canvas.width = bitmap.width; canvas.height = bitmap.height;
				canvas.setAttribute('role', 'img'); canvas.setAttribute('aria-label', 'Aperçu local réduit de la plaque à lire');
				canvas.getContext('2d')?.drawImage(bitmap, 0, 0); preview.replaceChildren(canvas);
			}
			if (readPhoto) readPhoto.disabled = false;
			setText('[data-status]', `Image ${dimensions.width} × ${dimensions.height} px contrôlée puis réduite localement pour la lecture.`);
		} catch (error) {
			if (generation !== photoGeneration) return;
			const excessive = error instanceof Error && error.message === 'dimensions_excessive';
			setText('[data-status]', excessive ? 'Image refusée : maximum 8 192 px par côté et 32 mégapixels.' : 'Image refusée : dimensions impossibles à contrôler de façon sûre. Utilisez un JPEG, PNG, WebP ou GIF standard.');
		}
	});

	readPhoto?.addEventListener('click', async () => {
		const bitmap = photoBitmap;
		if (!bitmap || !identifier || !readPhoto) return;
		readPhoto.disabled = true; setText('[data-status]', 'Lecture locale en cours…');
		try {
			await loadCatalog();
			const detectionWindow = window as DetectionWindow;
			const proposals: Array<{ value: string; origin: 'code-barres' | 'OCR local' }> = [];
			if (detectionWindow.BarcodeDetector) {
				const detector = new detectionWindow.BarcodeDetector({ formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128'] });
				for (const result of await detector.detect(bitmap)) if (result.rawValue) proposals.push({ value: result.rawValue, origin: 'code-barres' });
			}
			if (!proposals.length && detectionWindow.TextDetector) {
				const detector = new detectionWindow.TextDetector();
				const text = (await detector.detect(bitmap)).map((item) => item.rawValue ?? '').join(' ');
				const tokens = text.toUpperCase().match(/[A-Z0-9][A-Z0-9._/-]{3,23}/g) ?? [];
				const candidate = tokens.find((token) => identifyProducts(token, compressors, tools).length > 0);
				if (candidate) proposals.push({ value: candidate, origin: 'OCR local' });
			}
			const proposal = proposals.find((item) => identifyProducts(item.value, compressors, tools).length > 0) ?? proposals[0];
			if (proposal) {
				identifier.value = proposal.value;
				setText('[data-candidate-origin]', `Proposition issue de ${proposal.origin}, non validée. Vérifiez l’étiquette puis confirmez.`);
				setText('[data-status]', 'Un numéro a été proposé. Aucun modèle n’est validé tant que vous ne cliquez pas sur « Identifier la référence ».');
			} else setText('[data-status]', 'Aucune référence lisible n’a été trouvée. Saisissez le numéro visible sur l’étiquette.');
		} catch { setText('[data-status]', 'La lecture automatique locale n’est pas disponible pour cette image. Saisissez l’identifiant visible.'); }
		finally { readPhoto.disabled = false; }
	});

	query<HTMLButtonElement>('[data-toggle-all]')?.addEventListener('click', () => {
		const target = query<HTMLElement>('[data-all-results]'); const button = query<HTMLButtonElement>('[data-toggle-all]'); if (!target || !button) return;
		const expanded = button.getAttribute('aria-expanded') === 'true'; target.hidden = expanded; button.setAttribute('aria-expanded', String(!expanded)); button.textContent = expanded ? 'Voir tous les résultats' : 'Réduire les résultats';
	});
	query<HTMLButtonElement>('[data-recovery-photo]')?.addEventListener('click', () => {
		const details = query<HTMLDetailsElement>('.scanner-photo-details');
		if (details) { details.open = true; details.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' }); }
	});
	for (const link of root?.querySelectorAll<HTMLAnchorElement>('[data-result-scroll]') ?? []) link.addEventListener('click', (event) => {
		const targetId = link.dataset.resultScroll ?? '';
		if (link.pathname !== location.pathname || link.hash !== `#${targetId}`) return;
		if (link.hasAttribute('data-expand-results')) {
			const allResults = query<HTMLElement>('[data-all-results]');
			const toggle = query<HTMLButtonElement>('[data-toggle-all]');
			if (allResults) allResults.hidden = false;
			if (toggle) { toggle.setAttribute('aria-expanded', 'true'); toggle.textContent = 'Réduire les résultats'; }
		}
		if (link.hasAttribute('data-open-sources')) { const sources = query<HTMLDetailsElement>('#scanner-sources'); if (sources) sources.open = true; }
		const target = document.getElementById(targetId);
		if (!target) return;
		event.preventDefault();
		target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const error = query<HTMLElement>('[data-error]'); if (error) error.hidden = true;
		const recovery = query<HTMLElement>('[data-recovery]'); if (recovery) recovery.hidden = true;
		setScannerUiState('loading', 'Recherche de la référence exacte dans le catalogue vérifié…');
		try { await loadCatalog(); }
		catch { if (error) { error.hidden = false; error.textContent = 'Le catalogue technique est momentanément indisponible. Réessayez dans quelques instants.'; } setScannerUiState('error', 'Recherche interrompue.'); return; }
		const matches = identifyProducts(identifier?.value ?? '', compressors, tools);
		if (matches.length !== 1) {
			if (error) { error.hidden = false; error.textContent = matches.length > 1 ? 'Identifiant ambigu : vérifiez la marque et le modèle sur l’étiquette.' : 'Aucun modèle ne correspond exactement à cet identifiant.'; }
			if (recovery) recovery.hidden = false;
			setText('[data-recovery-title]', matches.length > 1 ? 'Plusieurs fiches utilisent cet identifiant : ajoutez la marque ou le modèle.' : 'Retrouvez le bon numéro sans deviner le produit.');
			const search = query<HTMLAnchorElement>('[data-recovery-search]');
			if (search) search.href = `/recherche/?q=${encodeURIComponent(identifier?.value.trim() ?? '')}#recherche-technique`;
			query<HTMLElement>('[data-result]')?.setAttribute('hidden', '');
			if (mobileSubmit) mobileSubmit.hidden = false;
			if (mobileResult) mobileResult.hidden = true;
			setScannerUiState('error', matches.length > 1 ? 'Plusieurs correspondances demandent une précision.' : 'Référence absente du catalogue vérifié.');
			return;
		}
		const match = matches[0]; const product = match.product;
		const scannerHref = scannerReferenceUrl(location.pathname, identifier?.value ?? match.matchedValue);
		history.replaceState(null, '', scannerHref);
		setResolutionNote();
		const rankingNote = query<HTMLElement>('[data-ranking-note]'); if (rankingNote) rankingNote.hidden = true;
		setText('[data-product-name]', `${product.brand} ${product.model}`);
		setText('[data-match-badge]', match.matchedBy === 'ean' || match.matchedBy === 'gtin' ? 'Correspondance exacte par code produit fabricant' : 'Correspondance exacte par référence fabricant');
		setText('[data-match-detail]', `${match.matchedBy.toUpperCase()} ${match.matchedValue} · ${sourceQualityLabel(product.confidence)}.`);
		const sourceDates = product.evidence.filter((source) => source.sourceType === 'manufacturer' || source.sourceType === 'manual').map((source) => source.retrievedAt).sort();
		const verifiedAt = sourceDates.at(-1) ?? product.evidence.map((source) => source.retrievedAt).sort().at(-1);
		setText('[data-source-verified]', verifiedAt ? `Source constructeur vérifiée le ${new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(new Date(`${verifiedAt}T12:00:00Z`))}` : 'Date de vérification indisponible');
		query<HTMLAnchorElement>('[data-product-link]')?.setAttribute('href', linkFor(match.type, product.slug));
		const publishedNeedLabel = publishedNeed(product, match.type);
		let journeyCompressorIds: string[] = [];
		let journeyConfiguration: string | undefined;
		let journeyContinueHref = linkFor(match.type, product.slug);

		let compatibleCards: ResultCard[] = []; let incompatibleCards: ResultCard[] = []; let insufficientCards: ResultCard[] = [];
		if (match.type === 'compressor') {
			const result = compressorCapabilities(product as Compressor, compressors, tools);
			compatibleCards = result.compatible.map(({ tool, result }) => ({ product: tool, type: 'tool', result, qualityGrade: pairGrade(product.confidence, tool.confidence) }));
			incompatibleCards = result.incompatible.map(({ tool, result }) => ({ product: tool, type: 'tool', result, qualityGrade: pairGrade(product.confidence, tool.confidence) }));
			insufficientCards = result.insufficient.map(({ tool, result }) => ({ product: tool, type: 'tool', result, qualityGrade: pairGrade(product.confidence, tool.confidence) }));
			setText('[data-can-label]', 'Outils alimentables'); setText('[data-cannot-label]', 'Outils incompatibles');
			setText('[data-compatible-label]', 'Outils alimentables'); setText('[data-incompatible-label]', 'Outils incompatibles');
			setText('[data-primary-title]', 'Trois outils alimentables en priorité');
			const unlockSection = query<HTMLElement>('[data-unlocks-section]'); if (unlockSection) unlockSection.hidden = false;
			const unlocks = query<HTMLElement>('[data-unlocks]');
			if (unlocks) unlocks.replaceChildren(...result.unlocks.map((unlock) => {
				const article = document.createElement('article'); const title = document.createElement('strong'); title.textContent = unlock.toolLabel;
				const hose = document.createElement('p'); hose.textContent = unlock.hoseAdvice;
				const alternatives = document.createElement('p'); alternatives.textContent = unlock.alternativeCompressors.length ? `Compresseurs documentés qui débloquent l’usage : ${unlock.alternativeCompressors.map((item) => item.label).join(', ')}.` : 'Aucun compresseur alternatif concluant dans le catalogue actuel.';
				article.append(title, hose, alternatives); return article;
			}));
			const compare = query<HTMLAnchorElement>('[data-compare]'); if (compare) compare.hidden = true;
			const calculatorHref = `/calculateur/#compresseur=${encodeURIComponent(product.id)}`;
			journeyContinueHref = calculatorHref;
			query<HTMLAnchorElement>('[data-refine]')?.setAttribute('href', calculatorHref);
			if (!compatibleCards.length && insufficientCards.length) {
				const sample = insufficientCards[0]?.result;
				const samplePressure = tools.find((tool) => tool.demandModel === 'fixed-flow')?.workingPressureBar.typical ?? 6;
				const gap = sample ? explainDecisionDataGap(product as Compressor, samplePressure, sample) : undefined;
				setResolutionNote(
					'Ce compresseur ne peut pas être dimensionné avec les données publiées',
					`${gap?.detail ?? 'Son débit réellement restitué exploitable manque.'} Choisissez maintenant l’outil à alimenter : le calculateur conservera ce modèle comme non vérifiable et proposera les compresseurs documentés qui couvrent réellement le besoin.`,
					calculatorHref,
					'Choisir mon outil et trouver des alternatives',
				);
			}
		} else {
			const result = toolCompatibleCompressors(product as ToolProfile, compressors);
			const requiredPressureBar = (product as ToolProfile).workingPressureBar.typical;
			compatibleCards = result.compatible.map(({ compressor, result }) => ({ product: compressor, type: 'compressor', result, requiredPressureBar, qualityGrade: pairGrade(product.confidence, compressor.confidence) }));
			incompatibleCards = result.incompatible.map(({ compressor, result }) => ({ product: compressor, type: 'compressor', result, requiredPressureBar, qualityGrade: pairGrade(product.confidence, compressor.confidence) }));
			insufficientCards = result.insufficient.map(({ compressor, result }) => ({ product: compressor, type: 'compressor', result, requiredPressureBar, qualityGrade: pairGrade(product.confidence, compressor.confidence) }));
			setText('[data-can-label]', 'Compresseurs compatibles'); setText('[data-cannot-label]', 'Compresseurs incompatibles');
			setText('[data-compatible-label]', 'Compresseurs compatibles'); setText('[data-incompatible-label]', 'Compresseurs incompatibles');
			setText('[data-primary-title]', 'Trois compresseurs compatibles les plus proches du besoin');
			const section = query<HTMLElement>('[data-unlocks-section]'); if (section) section.hidden = true;
			const compare = query<HTMLAnchorElement>('[data-compare]'); const topIds = sortCompatible(compatibleCards).slice(0, 3).map(({ product }) => product.id);
			const comparisonConfiguration = scannerConfigurationForTool(product as ToolProfile);
			journeyCompressorIds = topIds;
			journeyConfiguration = comparisonConfiguration ? encodePassportConfiguration(comparisonConfiguration) : undefined;
			if (compare) {
				compare.hidden = topIds.length < 2 || !comparisonConfiguration;
				compare.textContent = topIds.length >= 3 ? 'Comparer les trois compresseurs compatibles' : 'Comparer les deux compresseurs compatibles';
				if (topIds.length >= 2 && comparisonConfiguration) compare.href = scannerComparisonHref(topIds, comparisonConfiguration);
			}
			const calculatorHref = `/calculateur/#outil=${encodeURIComponent(product.id)}`;
			journeyContinueHref = compare && !compare.hidden ? compare.getAttribute('href') ?? calculatorHref : calculatorHref;
			query<HTMLAnchorElement>('[data-refine]')?.setAttribute('href', calculatorHref);
			const tool = product as ToolProfile;
			if (rankingNote && tool.demandModel === 'fixed-flow') {
				rankingNote.hidden = false;
				rankingNote.textContent = `Ordre technique : compatibilité, qualité des données, couverture de la cible de ${formatNumber(tool.airflowLpm.typical * 1.25)} L/min avec 25 % de réserve, puis proximité du débit. Ce n’est pas un classement commercial.`;
			}
			if (tool.demandModel === 'per-action') setResolutionNote(
				'Une cadence réelle suffit à débloquer la sélection',
				`La source publie ${formatNumber(tool.airPerActionLiters)} L par ${tool.actionLabel}, mais pas votre rythme d’usage. Saisissez les ${tool.actionLabel}s par minute : CompatAir calculera le besoin puis n’affichera comme solutions que les compresseurs vérifiables.`,
				calculatorHref,
				'Saisir ma cadence et voir les solutions',
			);
			else if (tool.demandModel === 'variable-volume') setResolutionNote(
				'Volume, pression et temps cible débloquent la sélection',
				'La consommation dépend du volume réellement gonflé et du temps souhaité. Ces valeurs d’usage ne sont pas inventées : une fois saisies, les compresseurs sont recalculés avec leur FAD documenté.',
				calculatorHref,
				'Décrire mon usage et voir les solutions',
			);
		}

		compatibleCards = sortCompatible(compatibleCards);
		if (match.type === 'compressor') setText('[data-primary-title]', compatibleCards.length >= 3 ? 'Trois outils alimentables en priorité' : compatibleCards.length === 0 && insufficientCards.length ? 'Choisissez votre outil pour obtenir des alternatives vérifiées' : compatibleCards.length === 0 ? 'Aucun outil alimentable confirmé' : `${compatibleCards.length} outil${compatibleCards.length > 1 ? 's' : ''} alimentable${compatibleCards.length > 1 ? 's' : ''}`);
		else {
			const tool = product as ToolProfile;
			setText('[data-primary-title]', compatibleCards.length >= 3
				? 'Trois compresseurs compatibles les plus proches du besoin'
				: compatibleCards.length === 0 && tool.demandModel === 'per-action' ? 'Précisez votre cadence pour obtenir des compresseurs valides'
					: compatibleCards.length === 0 && tool.demandModel === 'variable-volume' ? 'Décrivez le volume à gonfler pour obtenir des compresseurs valides'
						: compatibleCards.length === 0 ? 'Aucun compresseur compatible confirmé'
							: `${compatibleCards.length} compresseur${compatibleCards.length > 1 ? 's' : ''} compatible${compatibleCards.length > 1 ? 's' : ''}`);
		}
		setText('[data-compatible-count]', String(compatibleCards.length)); setText('[data-incompatible-count]', String(incompatibleCards.length)); setText('[data-insufficient-count]', String(insufficientCards.length));
		setText('[data-can-title]', `${compatibleCards.length} résultat(s) confirmé(s)`); setText('[data-cannot-title]', `${incompatibleCards.length} incompatibilité(s) confirmée(s)`);
		renderCards('[data-primary-results]', compatibleCards.slice(0, 3), 'Aucun résultat compatible ne peut être confirmé avec les données publiées.');
		renderCards('[data-can]', compatibleCards, 'Aucun résultat compatible confirmé.');
		renderCards('[data-cannot]', incompatibleCards, 'Aucune incompatibilité confirmée.');
		renderCards('[data-insufficient]', insufficientCards, 'Aucun résultat indéterminé.');

		const evidence = query<HTMLElement>('[data-evidence]');
		if (evidence) evidence.replaceChildren(...product.evidence.map((source) => {
			const link = document.createElement('a'); link.href = source.sourceUrl; link.rel = 'noreferrer'; link.textContent = `${source.sourceLabel} · vérifiée le ${source.retrievedAt} · ${sourceQualityDetail(source.confidence)}`; return link;
		}));
		const allResults = query<HTMLElement>('[data-all-results]'); if (allResults) allResults.hidden = true;
		const toggle = query<HTMLButtonElement>('[data-toggle-all]'); if (toggle) { toggle.setAttribute('aria-expanded', 'false'); toggle.textContent = 'Voir tous les résultats'; }
		query<HTMLElement>('[data-result]')?.removeAttribute('hidden');
		if (mobileSubmit) mobileSubmit.hidden = true;
		if (mobileResult) {
			mobileResult.hidden = false;
			const compare = query<HTMLAnchorElement>('[data-compare]');
			const resolutionAction = query<HTMLAnchorElement>('[data-resolution-note-action]');
			mobileResult.href = compare && !compare.hidden ? compare.href : resolutionAction && !resolutionAction.closest<HTMLElement>('[data-resolution-note]')?.hidden ? resolutionAction.href : '#scanner-selection';
			mobileResult.textContent = compare && !compare.hidden ? 'Comparer les solutions' : resolutionAction && !resolutionAction.closest<HTMLElement>('[data-resolution-note]')?.hidden ? resolutionAction.textContent ?? 'Continuer' : 'Voir la sélection';
		}
		window.dispatchEvent(new CustomEvent(JOURNEY_CONTEXT_EVENT, { detail: {
			stage: 'identified',
			reference: match.matchedValue,
			product: { id: product.id, label: `${product.brand} ${product.model}`, type: match.type },
			needLabel: publishedNeedLabel.replace(/[.;]\s*$/, ''),
			configuration: journeyConfiguration ?? null,
			compressorIds: journeyCompressorIds.length ? journeyCompressorIds : null,
			retainedCompressorId: null,
			continueHref: journeyContinueHref,
			editHref: scannerHref,
		} }));
		setScannerUiState('success', `Référence reconnue : ${product.brand} ${product.model}. La réponse est affichée.`);
		query<HTMLElement>('[data-result]')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
	});

	window.addEventListener('pagehide', () => photoBitmap?.close(), { once: true });

	function restoreScannerResult() {
		const reference = scannerReferenceFromHash(location.hash);
		const result = query<HTMLElement>('[data-result]');
		if (!reference || !identifier || !form || !result?.hasAttribute('hidden')) return;
		identifier.value = reference;
		form.requestSubmit();
	}

	queueMicrotask(restoreScannerResult);
	window.addEventListener('pageshow', restoreScannerResult);
</script>
