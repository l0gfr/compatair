---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryBrowser from './DirectoryBrowser.astro';
import { brandDirectory as brands, brandDirectoryTotalPages, BRAND_DIRECTORY_PAGE_SIZE } from '../data/brand-directory';
import DirectoryPagination from './DirectoryPagination.astro';
import { paginate } from '../domain/pagination';

interface Props { currentPage?: number }
const { currentPage = 1 } = Astro.props;
const directory = paginate(brands, currentPage, BRAND_DIRECTORY_PAGE_SIZE);
const title = currentPage === 1 ? 'Marques de compresseurs et outils pneumatiques | CompatAir' : `Marques documentées : page ${currentPage} | CompatAir`;
const description = `Annuaire des marques de compresseurs et d’outils pneumatiques : modèles, débits FAD, références MPN/EAN et sources techniques disponibles par fabricant.${currentPage > 1 ? ` Page ${currentPage} sur ${brandDirectoryTotalPages}.` : ''}`;
const breadcrumbs = [{ name: 'Marques', path: '/marques/' }, ...(currentPage > 1 ? [{ name: `Page ${currentPage}`, path: `/marques/page/${currentPage}/` }] : [])];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} noindex={currentPage > 1} imagePath="/social/marques.png">
	<section class="brand-directory essential-entry brand-directory-entry" id="annuaire-marques" data-discovery-hub="marques" data-primary-surface="brands" data-directory-browser data-page-size={BRAND_DIRECTORY_PAGE_SIZE}>
		<div class="container">
			<header class="essential-entry-head"><div><p class="product-decision-index">{brands.length} fabricants documentés</p><h1>{currentPage === 1 ? 'Marques de compresseurs et d’outils' : `Marques documentées, page ${currentPage}`}</h1></div><a class="essential-entry-link" href="/barometre-transparence/">Baromètre de transparence</a></header>
			<div class="directory-controls brand-controls"><div class="field directory-search"><label for="brand-search">Rechercher dans cette page</label><input id="brand-search" type="search" placeholder="Ex. Einhell" data-directory-search /></div><div class="field"><label for="brand-sort">Trier cette page</label><select id="brand-sort" data-directory-sort><option value="name">Nom</option><option value="primary-desc">Nombre de références</option></select></div><button class="inline-action" type="button" data-directory-reset>Réinitialiser</button></div><p class="directory-count" data-directory-count>{directory.items.length} résultats sur cette page</p><p><a href="/recherche/">Rechercher dans tout le catalogue</a></p><div class="brand-card-grid" data-directory-grid>{directory.items.map((item, index) => <a class="brand-data-card" href={`/marques/${item.slug}/`} data-directory-card data-search={item.brand} data-sort-name={item.brand} data-sort-confidence="A" data-sort-primary={item.total}><span>{String(directory.firstItem + index).padStart(2, '0')}</span><p>Fabricant documenté</p><h2>{item.brand}</h2><dl><div><dt>Compresseurs</dt><dd>{item.compressors}</dd></div><div><dt>Outils</dt><dd>{item.tools}</dd></div><div><dt>FAD publiés</dt><dd>{item.documentedFad}/{item.compressors}</dd></div></dl><strong>Voir les références →</strong></a>)}</div><DirectoryPagination basePath="/marques/" currentPage={currentPage} totalPages={directory.totalPages} firstItem={directory.firstItem} lastItem={directory.lastItem} totalItems={directory.totalItems} itemLabel="marques" /><p><a href="/scanner/">Identifier un modèle</a> · <a href="/observatoire-qualite-documentaire/">Qualité des données</a> · <a href="/professionnels/">Espace professionnels</a></p>
		</div>
	</section>
	<DirectoryBrowser />
</BaseLayout>
