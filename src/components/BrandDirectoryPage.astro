---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogSignalVisual from './CatalogSignalVisual.astro';
import DirectoryBrowser from './DirectoryBrowser.astro';
import UiIcon from './UiIcon.astro';
import { compressors, tools } from '../data/catalog';
import { brandDirectory as brands, brandDirectoryTotalPages, BRAND_DIRECTORY_PAGE_SIZE } from '../data/brand-directory';
import DirectoryPagination from './DirectoryPagination.astro';
import { paginate } from '../domain/pagination';

interface Props { currentPage?: number }
const { currentPage = 1 } = Astro.props;
const directory = paginate(brands, currentPage, BRAND_DIRECTORY_PAGE_SIZE);
const title = currentPage === 1 ? 'Marques documentées | CompatAir' : `Marques documentées : page ${currentPage} | CompatAir`;
const description = `Fabricants de compresseurs et d’outils documentés, avec débits FAD et identifiants sourcés.${currentPage > 1 ? ` Page ${currentPage} sur ${brandDirectoryTotalPages}.` : ''}`;
const breadcrumbs = [{ name: 'Marques', path: '/marques/' }, ...(currentPage > 1 ? [{ name: `Page ${currentPage}`, path: `/marques/page/${currentPage}/` }] : [])];
const brandPaths = [
	{ icon: 'tools', label: 'MPN, EAN/GTIN ou SKU', title: 'Identifier une référence', detail: 'Retrouver le produit exact avant d’interpréter la couverture de sa marque.', href: '/scanner/' },
	{ icon: 'database', label: 'Qualité du catalogue', title: 'Lire l’observatoire', detail: 'Comparer la présence des données nécessaires sans noter la qualité des produits.', href: '/observatoire-qualite-documentaire/' },
	{ icon: 'shield', label: 'Fabricant ou distributeur', title: 'Améliorer un catalogue', detail: 'Relier références, documents et caractéristiques utiles au choix final.', href: '/professionnels/' },
] as const;
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} noindex={currentPage > 1} imagePath="/social/marques.png">
	<section class="page-hero compact catalog-hero" data-discovery-hub="marques"><div class="container catalog-hero-grid"><div><p class="product-decision-index">Index documentaire / Fabricants</p><p class="eyebrow">Marques documentées</p><h1>{currentPage === 1 ? 'Mesurer la qualité des catalogues, marque par marque' : `Marques documentées, page ${currentPage}`}</h1><p class="lead">Une marque apparaît uniquement lorsqu’au moins une référence repose sur une source identifiée. La quantité de fiches ne vaut pas automatiquement qualité documentaire.</p><div class="hero-actions"><a class="button primary" href="#annuaire-marques">Rechercher une marque</a><a class="button" href="/barometre-transparence/">Voir le baromètre</a></div></div><CatalogSignalVisual mode="brands" count={brands.length} secondaryCount={compressors.length + tools.length} title="fabricants suivis" /></div></section>
	<section class="catalog-summary-band"><div class="container"><div><strong>{brands.length}</strong><span>fabricants documentés</span></div><div><strong>{compressors.length}</strong><span>compresseurs suivis</span></div><div><strong>{tools.length}</strong><span>outils suivis</span></div><div><strong>{compressors.filter((item) => item.fadCurve.length > 0).length}</strong><span>FAD documentés</span></div></div></section>
	<section class="section hub-intent-section brand-orientation"><div class="container"><div class="section-head split-head"><div><p class="eyebrow">Lire l’index correctement</p><h2>Une marque n’est pas un verdict</h2></div><p>CompatAir mesure uniquement ce qui est documenté dans son corpus. Ces trois chemins évitent de confondre couverture, performance produit et relation commerciale.</p></div><div class="hub-intent-grid is-three">{brandPaths.map((path, index) => <a href={path.href}><span class="hub-intent-index">0{index + 1}</span><UiIcon name={path.icon} size={28} /><p>{path.label}</p><h3>{path.title}</h3><small>{path.detail}</small><strong>Continuer →</strong></a>)}</div></div></section>
	<section class="section brand-directory" id="annuaire-marques" data-directory-browser data-page-size={BRAND_DIRECTORY_PAGE_SIZE}><div class="container"><header class="product-section-head"><div><p class="product-decision-index">Explorer le corpus</p><h2>Comparer la couverture, pas la notoriété</h2></div><p>L’annuaire suit l’ordre alphabétique. La recherche et le tri portent sur les marques de cette page ; les nombres décrivent uniquement leur présence dans CompatAir.</p></header><div class="directory-controls brand-controls"><div class="field directory-search"><label for="brand-search">Rechercher dans cette page</label><input id="brand-search" type="search" placeholder="Ex. Einhell" data-directory-search /></div><div class="field"><label for="brand-sort">Trier cette page</label><select id="brand-sort" data-directory-sort><option value="name">Nom</option><option value="primary-desc">Nombre de références</option></select></div><button class="inline-action" type="button" data-directory-reset>Réinitialiser</button></div><p class="directory-count" data-directory-count>{directory.items.length} résultats sur cette page</p><p><a href="/recherche/">Rechercher dans tout le catalogue</a></p><div class="brand-card-grid" data-directory-grid>{directory.items.map((item, index) => <a class="brand-data-card" href={`/marques/${item.slug}/`} data-directory-card data-search={item.brand} data-sort-name={item.brand} data-sort-confidence="A" data-sort-primary={item.total}><span>{String(directory.firstItem + index).padStart(2, '0')}</span><p>Fabricant documenté</p><h2>{item.brand}</h2><dl><div><dt>Compresseurs</dt><dd>{item.compressors}</dd></div><div><dt>Outils</dt><dd>{item.tools}</dd></div><div><dt>FAD publiés</dt><dd>{item.documentedFad}/{item.compressors}</dd></div></dl><strong>Voir la couverture →</strong></a>)}</div><DirectoryPagination basePath="/marques/" currentPage={currentPage} totalPages={directory.totalPages} firstItem={directory.firstItem} lastItem={directory.lastItem} totalItems={directory.totalItems} itemLabel="marques" /></div></section>
	<DirectoryBrowser />
</BaseLayout>
