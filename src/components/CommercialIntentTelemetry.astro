<script>
	if (location.hostname === 'compatair.fr' || location.hostname === 'www.compatair.fr') {
		let channel = 'direct';
		try { channel = sessionStorage.getItem('ca:acquisition') ?? channel; } catch {}
		const path = location.pathname;
		const template = path === '/' ? 'home'
			: path.startsWith('/compresseurs/') ? 'compressor'
				: path.startsWith('/outils-pneumatiques/') ? 'tool'
					: path.startsWith('/guides/') ? 'guide'
						: path.startsWith('/offres/') ? 'offers' : 'other';
		const sent = new Set<string>();
		const record = (action: 'calculator_intent' | 'merchant_interest') => {
			if (sent.has(action) || !navigator.sendBeacon) return false;
			const payload = { event: 'acquisition_aggregate', schemaVersion: '1.0.0', channel, template, action, outcome: 'unknown' };
			const recorded = navigator.sendBeacon('/events', new Blob([JSON.stringify(payload)], { type: 'application/json' }));
			if (recorded) sent.add(action);
			return recorded;
		};
		document.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;
			const interest = event.target.closest<HTMLElement>('[data-merchant-interest]');
			if (interest) {
				if (!record('merchant_interest')) return;
				interest.setAttribute('aria-pressed', 'true');
				if (interest instanceof HTMLButtonElement) interest.disabled = true;
				const status = interest.parentElement?.querySelector<HTMLElement>('[data-merchant-interest-status]');
				if (status) status.textContent = 'Merci. Signal anonyme envoyé.';
				return;
			}
			const anchor = event.target.closest<HTMLAnchorElement>('a[href]');
			if (anchor?.origin === location.origin && anchor.pathname === '/calculateur/') record('calculator_intent');
		});
	}
</script>
