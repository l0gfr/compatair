<section class="passport-shell" data-passport-root aria-live="polite">
	<div class="passport-loading" data-passport-loading>
		<p class="eyebrow">Ouverture sur votre appareil</p>
		<h2>Ouverture de la fiche…</h2>
		<p>Le dossier est ouvert et contrôlé dans ce navigateur.</p>
	</div>

	<div class="passport-empty" data-passport-empty hidden>
		<p class="eyebrow">Aucune installation chargée</p>
		<h2>Créez d’abord une configuration</h2>
		<p data-passport-error>Cette page attend un lien créé depuis le calculateur CompatAir.</p>
		<a class="button primary" href="/calculateur/">Ouvrir le calculateur</a>
	</div>

	<article class="passport-document" data-passport-document hidden>
		<header class="passport-head">
			<div>
				<p class="eyebrow">Fiche de configuration CompatAir</p>
				<h2 data-compressor></h2>
				<p class="passport-verdict" data-verdict></p>
			</div>
			<dl class="passport-identity">
				<div><dt>Numéro du dossier</dt><dd data-id></dd></div>
				<div><dt>Données vérifiées le</dt><dd data-catalog-date></dd></div>
			</dl>
		</header>
		<div class="passport-version-choice" data-version-choice hidden>
			<div><strong>Données affichées</strong><p data-version-note></p></div>
			<button class="button" type="button" data-show-original>Voir le rapport original</button>
			<button class="button" type="button" data-show-current disabled>Calculer avec les données actuelles</button>
		</div>

		<div class="passport-actions">
			<a class="button primary" href="/mise-en-service/" data-commission>Valider sur site</a>
			<button class="button" type="button" data-download>Télécharger le dossier PDF</button>
			<button class="button" type="button" data-print-plan>Imprimer la checklist</button>
			<button class="button" type="button" data-copy>Copier le lien</button>
			<a class="button" href="/calculateur/" data-edit>Modifier</a>
			<span role="status" data-action-status></span>
		</div>

		<section class="passport-commissioning-summary" data-passport-commissioning hidden>
			<div><p class="eyebrow">Recette terrain enregistrée</p><h3 data-commissioning-verdict></h3><p data-commissioning-finding></p></div>
			<dl>
				<div><dt>Date du relevé</dt><dd data-commissioning-date></dd></div>
				<div><dt>Pression au poste</dt><dd data-commissioning-pressure></dd></div>
				<div><dt>Fuite intégrée</dt><dd data-commissioning-leak></dd></div>
				<div><dt>Contrôles renseignés</dt><dd data-commissioning-count></dd></div>
			</dl>
		</section>

		<section class="passport-section passport-installation-plan" data-installation-plan>
			<header><span>01</span><div><p class="eyebrow">Du choix à la mise en service</p><h3>Plan d’installation contextualisé</h3></div></header>
			<div class="installation-plan-answer">
				<div><small>Principale réserve</small><strong data-plan-reserve></strong></div>
				<dl>
					<div><dt>Confirmés par une source</dt><dd data-plan-source-count></dd></div>
					<div><dt>Mesures terrain renseignées</dt><dd data-plan-site-count></dd></div>
					<div><dt>Non documentés</dt><dd data-plan-undocumented-count></dd></div>
				</dl>
			</div>
			<div class="installation-plan-legend" aria-label="Légende des statuts">
				<span data-plan-status="source-confirmed">Confirmé par une source</span>
				<span data-plan-status="site-measurement">À mesurer sur site</span>
				<span data-plan-status="undocumented">Non documenté</span>
			</div>
			<div class="installation-plan-phases">
				<section aria-labelledby="plan-before-purchase"><header><span>Avant achat</span><h4 id="plan-before-purchase">Valider la machine et ses interfaces</h4></header><div data-plan-before-purchase></div></section>
				<section aria-labelledby="plan-before-commissioning"><header><span>Avant première utilisation</span><h4 id="plan-before-commissioning">Contrôler l’installation réelle</h4></header><div data-plan-before-commissioning></div></section>
			</div>
			<p class="installation-plan-boundary">Une case cochée correspond soit à une caractéristique reliée à sa source, soit à une mesure déjà renseignée dans le calculateur. Elle ne constitue pas une certification de l’installation.</p>
		</section>

		<section class="passport-section passport-calculations">
			<header><span>02</span><h3>Calculs et marges</h3></header>
			<dl class="passport-metrics">
				<div><dt>Débit de pointe</dt><dd data-peak></dd></div>
				<div><dt>Débit moyen</dt><dd data-average></dd></div>
				<div><dt>Débit restitué recommandé</dt><dd data-recommended></dd></div>
				<div><dt>Débit restitué disponible</dt><dd data-available></dd></div>
				<div><dt>Marge disponible sur le besoin publié</dt><dd data-nominal-margin></dd></div>
				<div><dt>Marge indicative demandée</dt><dd data-safety-margin></dd></div>
			</dl>
			<p class="passport-confidence" data-confidence></p>
		</section>

		<div class="passport-two-columns">
			<section class="passport-section">
				<header><span>03</span><h3>Installation déclarée</h3></header>
				<dl class="passport-details">
					<div><dt>Outils</dt><dd data-tools></dd></div>
					<div><dt>Organisation</dt><dd data-mode></dd></div>
					<div><dt>Profil</dt><dd data-usage></dd></div>
						<div><dt>Flexible</dt><dd data-hose></dd></div>
						<div><dt>Chute mesurée en charge</dt><dd data-pressure-drop></dd></div>
						<div><dt>Débit de fuite mesuré</dt><dd data-leak></dd></div>
						<div><dt>Pression disponible</dt><dd data-supply-pressure></dd></div>
					<div><dt>Distance totale</dt><dd data-distance></dd></div>
					<div><dt>Raccords</dt><dd data-fittings></dd></div>
					<div><dt>Traitement d’air</dt><dd data-filtration></dd></div>
				</dl>
			</section>

			<section class="passport-section passport-watch">
				<header><span>04</span><h3>Points de vigilance</h3></header>
				<ul data-warnings></ul>
			</section>
		</div>

		<div class="passport-two-columns">
			<section class="passport-section">
				<header><span>05</span><h3>Évolutions possibles</h3></header>
				<ul data-upgrades></ul>
			</section>
			<section class="passport-section passport-missing">
				<header><span>06</span><h3>Données manquantes</h3></header>
				<ul data-missing></ul>
			</section>
		</div>

		<section class="passport-section">
			<header><span>07</span><h3>Sources liées</h3></header>
			<div class="passport-sources" data-sources></div>
		</section>

		<footer class="passport-notice">
			<strong>Périmètre du document</strong>
			<p>Cette fiche décrit la configuration déclarée et les données disponibles à sa date de création. Elle ne remplace ni une mesure en charge, ni une notice constructeur, ni une vérification réglementaire.</p>
			<p>Le contrôle du dossier permet de détecter si son contenu a changé, mais ne prouve pas que CompatAir en est l’auteur.</p>
		</footer>
	</article>
</section>

<script>
	import { assessCommissioning, commissioningVerdictLabel } from '../domain/commissioning';
	import { createPassportReport, decodePassportConfiguration, decodePassportEnvelope, encodePassportConfiguration, passportVerdictLabel, reportFromPassportEnvelope, type PassportReport } from '../domain/passport';

	const root = document.querySelector<HTMLElement>('[data-passport-root]');
	const query = <T extends Element>(selector: string) => root?.querySelector<T>(selector);
	const setText = (selector: string, value: string) => { const element = query<HTMLElement>(selector); if (element) element.textContent = value; };
	const format = (value: number, digits = 1) => value.toLocaleString('fr-FR', { maximumFractionDigits: digits });
	const valueOrMissing = (value: number | undefined, unit: string) => value === undefined ? 'Non renseigné' : `${format(value)} ${unit}`;
	const usageLabels = { occasional: 'Occasionnel', intermittent: 'Intermittent', sustained: 'Soutenu', mixed: 'Mixte' } as const;
	const fittingLabels = { unknown: 'Non renseigné', 'euro-7.2': 'Euro 7,2 mm', 'iso-6150-b': 'ISO 6150-B', other: 'Autre standard' } as const;
	const filtrationLabels = { unknown: 'Non renseigné', none: 'Aucune déclarée', particle: 'Filtration particulaire', 'water-separator': 'Séparateur d’eau', coalescing: 'Filtration coalescente', dryer: 'Sécheur' } as const;
	type RuntimeCatalog = import('../domain/runtime-catalog').RuntimeCatalog;
	let currentCatalogPromise: Promise<RuntimeCatalog> | undefined;
	function loadCurrentCatalog() {
		currentCatalogPromise ??= import('../domain/runtime-catalog').then(({ loadRuntimeCatalog }) => loadRuntimeCatalog());
		return currentCatalogPromise;
	}

	function renderList(selector: string, values: string[], emptyMessage: string) {
		const list = query<HTMLUListElement>(selector);
		if (!list) return;
		list.replaceChildren();
		for (const value of values.length ? values : [emptyMessage]) {
			const item = document.createElement('li');
			item.textContent = value;
			list.append(item);
		}
	}

	function renderInstallationPlan(report: PassportReport) {
		const plan = report.installationPlan;
		setText('[data-plan-reserve]', plan.primaryReserve);
		setText('[data-plan-source-count]', String(plan.counts.sourceConfirmed));
		setText('[data-plan-site-count]', `${plan.counts.siteCompleted}/${plan.counts.siteMeasurements}`);
		setText('[data-plan-undocumented-count]', String(plan.counts.undocumented));
		const sourceByRef = new Map(report.sources.map((source) => [`${source.productId}:${source.id}`, source]));
		const statusLabel = (item: typeof plan.items[number]) => item.status === 'source-confirmed'
			? 'Confirmé par une source'
			: item.status === 'undocumented'
				? 'Non documenté'
				: item.completed ? 'Mesure renseignée' : 'À mesurer sur site';
		const renderPhase = (selector: string, phase: typeof plan.items[number]['phase']) => {
			const target = query<HTMLElement>(selector);
			if (!target) return;
			target.replaceChildren();
			for (const item of plan.items.filter((entry) => entry.phase === phase)) {
				const article = document.createElement('article');
				article.className = 'installation-plan-item';
				article.dataset.planStatus = item.status;
				article.dataset.planCompleted = String(item.completed);
				const checkbox = document.createElement('input');
				checkbox.type = 'checkbox'; checkbox.checked = item.completed; checkbox.disabled = true;
				checkbox.setAttribute('aria-label', item.completed ? `${item.title} : contrôle renseigné` : `${item.title} : contrôle restant`);
				const body = document.createElement('div');
				const head = document.createElement('header');
				const title = document.createElement('h5'); title.textContent = item.title;
				const badge = document.createElement('span'); badge.textContent = statusLabel(item); badge.dataset.planStatus = item.status;
				head.append(title, badge);
				const summary = document.createElement('p'); summary.textContent = item.summary;
				const action = document.createElement('p'); action.className = 'installation-plan-action'; const actionLabel = document.createElement('strong'); actionLabel.textContent = 'Action'; action.append(actionLabel, ` ${item.action}`);
				const links = document.createElement('footer');
				for (const sourceRef of item.sourceRefs) {
					const source = sourceByRef.get(sourceRef); if (!source) continue;
					const link = document.createElement('a'); link.href = source.url; link.rel = 'noreferrer'; link.textContent = `Source · ${source.productLabel}`; links.append(link);
				}
				if (item.guidePath && item.guideLabel) { const guide = document.createElement('a'); guide.href = item.guidePath; guide.textContent = item.guideLabel; links.append(guide); }
				body.append(head, summary, action); if (links.childElementCount) body.append(links);
				article.append(checkbox, body); target.append(article);
			}
		};
		renderPhase('[data-plan-before-purchase]', 'before-purchase');
		renderPhase('[data-plan-before-commissioning]', 'before-commissioning');
	}

	function renderPassport(report: PassportReport, currentUrl: string, scenarioId?: string) {
			renderInstallationPlan(report);
			const commissioningPanel = query<HTMLElement>('[data-passport-commissioning]');
			const commissioning = report.configuration.commissioning;
			if (commissioningPanel) commissioningPanel.hidden = !commissioning;
			if (commissioning) {
				const assessment = assessCommissioning(report, commissioning);
				commissioningPanel?.setAttribute('data-status', assessment.verdict);
				setText('[data-commissioning-verdict]', commissioningVerdictLabel(assessment.verdict));
				setText('[data-commissioning-finding]', assessment.primaryFinding);
				setText('[data-commissioning-date]', commissioning.observedOn);
				setText('[data-commissioning-pressure]', commissioning.toolPressureBar === undefined ? 'Non renseignée' : `${format(commissioning.toolPressureBar, 2)} bar`);
				setText('[data-commissioning-leak]', commissioning.measuredLeakLpm === undefined ? 'Non mesurée' : `${format(commissioning.measuredLeakLpm)} L/min`);
				setText('[data-commissioning-count]', `${assessment.counts.completed}/${assessment.counts.total}`);
			}
			setText('[data-compressor]', report.compressorLabel);
			setText('[data-verdict]', passportVerdictLabel(report.result));
			query<HTMLElement>('[data-verdict]')?.setAttribute('data-status', report.result.verdict);
			setText('[data-id]', report.passportId.slice(0, 16));
			query<HTMLElement>('[data-id]')?.setAttribute('title', report.passportId);
			setText('[data-catalog-date]', report.catalogVerifiedAt);
			setText('[data-peak]', `${format(report.result.peakFlowLpm)} L/min`);
			setText('[data-average]', `${format(report.result.averageFlowLpm)} L/min`);
			setText('[data-recommended]', `${format(report.result.recommendedFadLpm)} L/min à ${format(report.result.requiredPressureBar)} bar`);
			setText('[data-available]', report.availableFadLpm === undefined ? 'Donnée insuffisante' : `${format(report.availableFadLpm)} L/min`);
			setText('[data-nominal-margin]', report.nominalMarginPercent === undefined ? 'Non calculable' : `${format(report.nominalMarginPercent)} %`);
			setText('[data-safety-margin]', `${Math.round(report.configuration.safetyMargin * 100)} % · ${report.compatAirMarginCovered === undefined ? 'couverture indéterminable' : report.compatAirMarginCovered ? 'couverte' : 'non couverte'}`);
			setText('[data-confidence]', `Fiabilité du résultat : ${report.result.confidence === 'high' ? 'élevée' : report.result.confidence === 'medium' ? 'moyenne' : 'faible'}.`);
			setText('[data-tools]', report.toolLabels.join(', '));
			setText('[data-mode]', report.configuration.mode === 'simultaneous' ? 'Utilisation simultanée' : 'Utilisation successive');
			setText('[data-usage]', `${usageLabels[report.configuration.usageProfile]} · session ${report.configuration.sessionMinutes} min`);
				setText('[data-hose]', `${valueOrMissing(report.configuration.hoseLengthMeters, 'm')} · diamètre intérieur ${valueOrMissing(report.configuration.hoseInnerDiameterMm, 'mm')}`);
				setText('[data-pressure-drop]', valueOrMissing(report.configuration.measuredPressureDropBar, 'bar'));
				setText('[data-leak]', valueOrMissing(report.configuration.measuredLeakLpm, 'L/min'));
				setText('[data-supply-pressure]', valueOrMissing(report.configuration.supplyPressureBar, 'bar'));
			setText('[data-distance]', valueOrMissing(report.configuration.networkDistanceMeters, 'm'));
			setText('[data-fittings]', `${fittingLabels[report.configuration.fittingStandard]} · ${report.configuration.fittingCount ?? 'nombre non renseigné'}`);
			setText('[data-filtration]', filtrationLabels[report.configuration.filtration]);
			renderList('[data-warnings]', report.warnings, 'Aucun point de vigilance supplémentaire.');
			renderList('[data-upgrades]', report.possibleUpgrades, 'Aucune évolution proposée.');
			renderList('[data-missing]', report.missingData, 'Aucune donnée manquante identifiée dans le périmètre actuel.');

			const sourcesPanel = query<HTMLElement>('[data-sources]');
			if (sourcesPanel) {
				sourcesPanel.replaceChildren();
				for (const source of report.sources) {
					const article = document.createElement('article');
					const link = document.createElement('a');
					const meta = document.createElement('span');
					link.href = source.url;
					link.rel = 'noreferrer';
					link.textContent = `${source.productLabel} · ${source.label}`;
					meta.textContent = `Consultée le ${source.retrievedAt} · fiabilité ${source.confidence}`;
					article.append(link, meta);
					sourcesPanel.append(article);
				}
				if (!report.sources.length) sourcesPanel.textContent = 'Aucune source constructeur liée à cette configuration.';
			}

		query<HTMLAnchorElement>('[data-edit]')?.setAttribute('href', `/calculateur/#config=${encodePassportConfiguration(report.configuration)}${scenarioId ? `&scenario=${encodeURIComponent(scenarioId)}` : ''}`);
			const commissioningLink = query<HTMLAnchorElement>('[data-commission]');
			if (commissioningLink) {
				commissioningLink.href = currentUrl.replace('/passeport/#', '/mise-en-service/#');
				commissioningLink.textContent = commissioning ? 'Reprendre la recette terrain' : 'Valider sur site';
			}
			const copyButton = query<HTMLButtonElement>('[data-copy]');
			if (copyButton) copyButton.onclick = async () => {
				await navigator.clipboard.writeText(currentUrl);
				setText('[data-action-status]', 'Lien copié.');
			};
			const downloadButton = query<HTMLButtonElement>('[data-download]');
			if (downloadButton) downloadButton.onclick = async () => {
				downloadButton.disabled = true;
				setText('[data-action-status]', 'Préparation locale du PDF…');
				try {
					const { createPassportPdf } = await import('../domain/passport-pdf');
					const blob = new Blob([createPassportPdf(report, currentUrl)], { type: 'application/pdf' });
					const objectUrl = URL.createObjectURL(blob);
					const link = document.createElement('a');
					link.href = objectUrl;
					link.download = `passeport-compatair-${report.passportId.slice(0, 16)}.pdf`;
					link.click();
					setTimeout(() => URL.revokeObjectURL(objectUrl), 1_000);
					setText('[data-action-status]', 'PDF généré localement.');
				} catch {
					setText('[data-action-status]', 'La création du PDF a échoué. La fiche reste disponible dans cette page.');
				} finally {
					downloadButton.disabled = false;
				}
			};
			const printButton = query<HTMLButtonElement>('[data-print-plan]');
			if (printButton) printButton.onclick = () => window.print();
	}

	async function loadPassport() {
		const empty = query<HTMLElement>('[data-passport-empty]');
		const documentPanel = query<HTMLElement>('[data-passport-document]');
		const loading = query<HTMLElement>('[data-passport-loading]');
		const fragment = new URLSearchParams(location.hash.slice(1));
		const encoded = fragment.get('passport');
		const rawScenarioId = fragment.get('scenario');
		const scenarioId = rawScenarioId && /^[a-z0-9-]{1,160}$/.test(rawScenarioId) ? rawScenarioId : undefined;
		const envelope = encoded ? decodePassportEnvelope(encoded) : undefined;
		const legacyConfiguration = encoded && !envelope ? decodePassportConfiguration(encoded) : undefined;
		if ((!envelope && !legacyConfiguration) || !encoded) {
			if (encoded) setText('[data-passport-error]', 'Cette URL est invalide, incomplète ou utilise un format non reconnu.');
			if (loading) loading.hidden = true;
			if (empty) empty.hidden = false;
			return;
		}

		try {
			const currentUrl = `${location.origin}/passeport/#passport=${encoded}${scenarioId ? `&scenario=${encodeURIComponent(scenarioId)}` : ''}`;
			if (envelope) {
				const original = await reportFromPassportEnvelope(envelope);
				const choice = query<HTMLElement>('[data-version-choice]');
				if (choice) choice.hidden = false;
				const showOriginal = () => { renderPassport(original, currentUrl, scenarioId); setText('[data-version-note]', `Rapport original du ${original.generatedAt.slice(0, 10)}, catalogue ${original.catalogVerifiedAt}.`); };
				const originalButton = query<HTMLButtonElement>('[data-show-original]');
				const currentButton = query<HTMLButtonElement>('[data-show-current]');
				if (originalButton) originalButton.onclick = showOriginal;
				showOriginal();
				if (loading) loading.hidden = true;
				if (documentPanel) documentPanel.hidden = false;
				if (currentButton) {
					currentButton.disabled = false;
					currentButton.onclick = async () => {
						currentButton.disabled = true;
						setText('[data-version-note]', 'Chargement du catalogue actuel et recalcul local…');
						try {
							const { catalogVerifiedAt, compressors, tools } = await loadCurrentCatalog();
							const current = await createPassportReport(envelope.configuration, compressors, tools, catalogVerifiedAt);
							renderPassport(current, currentUrl, scenarioId);
							setText('[data-version-note]', `Simulation actuelle, catalogue ${current.catalogVerifiedAt}. L’URL originale n’est pas modifiée.`);
							currentButton.disabled = false;
						} catch {
							currentButton.disabled = true;
							currentButton.title = 'Simulation actuelle indisponible : une référence du Passeport n’existe plus dans le catalogue courant.';
							setText('[data-version-note]', `Rapport original du ${original.generatedAt.slice(0, 10)}, catalogue ${original.catalogVerifiedAt}. Simulation actuelle indisponible.`);
						}
					};
				}
			} else {
				const { catalogVerifiedAt, compressors, tools } = await loadCurrentCatalog();
				const current = await createPassportReport(legacyConfiguration, compressors, tools, catalogVerifiedAt);
				renderPassport(current, currentUrl, scenarioId);
				const choice = query<HTMLElement>('[data-version-choice]');
				if (choice) choice.hidden = false;
				setText('[data-version-note]', 'Ancien format : seule la configuration était conservée. Ce rapport est recalculé avec le catalogue actuel.');
				const originalButton = query<HTMLButtonElement>('[data-show-original]');
				const currentButton = query<HTMLButtonElement>('[data-show-current]');
				if (originalButton) originalButton.hidden = true;
				if (currentButton) currentButton.hidden = true;
			}
			if (loading) loading.hidden = true;
			if (documentPanel) documentPanel.hidden = false;
		} catch (error) {
			setText('[data-passport-error]', error instanceof Error ? error.message : 'La fiche ne peut pas être recalculée.');
			if (loading) loading.hidden = true;
			if (empty) empty.hidden = false;
		}
	}

	void loadPassport();
</script>
