---
import { getCollection } from 'astro:content';
import { GUIDE_DIRECTORY_PAGE_SIZE, paginate } from '../domain/pagination';

interface Props { page?: number; }
const { page = 1 } = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideDirectory from './GuideDirectory.astro';
import GuideSeriesCallout from './GuideSeriesCallout.astro';
import HubSignalVisual from './HubSignalVisual.astro';
import MetierIcon from './MetierIcon.astro';
import UiIcon from './UiIcon.astro';
import { guideAudienceIds, guideAudiences, guideMetierIds, guideMetiers } from '../domain/editorial-taxonomy';
import { serializeJsonLd } from '../domain/structured-data';

const guides = (await getCollection('guides')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pagination = paginate(guides, page, GUIDE_DIRECTORY_PAGE_SIZE);
const maintenanceSeriesCount = guides.filter((guide) => guide.data.series === 'audit-suivi-maintenance-air-comprime').length;
const startingGuideIds = [
	'guide-complet-dimensionner-compresseur-air',
	'debit-restitue-fad-vs-debit-aspire',
	'installer-reseau-air-comprime-atelier',
];
const startingGuides = startingGuideIds.map((id) => guides.find((guide) => guide.id === id)).filter((guide): guide is (typeof guides)[number] => Boolean(guide));
const decisionPaths = [
	{ icon: 'tools', eyebrow: 'J’ai une étiquette', title: 'Identifier une référence', detail: 'Saisissez un MPN ou un EAN pour retrouver exactement un outil ou un compresseur.', href: '/scanner/', action: 'Ouvrir le scanner' },
	{ icon: 'calculator', eyebrow: 'J’ai un ou plusieurs outils', title: 'Dimensionner mon besoin', detail: 'Reliez le débit demandé au débit restitué disponible à la pression de travail.', href: '/calculateur/', action: 'Ouvrir le calculateur' },
	{ icon: 'scale', eyebrow: 'J’hésite entre des modèles', title: 'Comparer les mêmes données', detail: 'Placez deux ou trois compresseurs côte à côte sans palmarès commercial imposé.', href: '/comparatifs/', action: 'Choisir une comparaison' },
	{ icon: 'book', eyebrow: 'Je rencontre un terme', title: 'Comprendre avant de conclure', detail: 'Retrouvez une définition sourcée puis revenez au guide ou à la décision concernée.', href: '/glossaire/', action: 'Consulter le glossaire' },
] as const;
const guideListJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Guides techniques CompatAir',
	itemListElement: pagination.items.map((guide, index) => ({ '@type': 'ListItem', position: pagination.firstItem + index, name: guide.data.title, url: `https://compatair.fr/guides/${guide.id}/` })),
};
---

<BaseLayout imagePath="/social/guides.png" title={page === 1 ? "Guides compresseur et outils pneumatiques | CompatAir" : `Guides compresseur et outils : page ${page} | CompatAir`} description={`Choisissez et utilisez un compresseur avec des guides sourcés sur le débit FAD, la cuve, le flexible, le bruit et les besoins des outils pneumatiques.${page > 1 ? ` Page ${page} sur ${pagination.totalPages}.` : ''}`} breadcrumbs={[{ name: 'Guides', path: '/guides/' }]}>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(guideListJsonLd)} />
	<section class="page-hero compact hub-hero" data-discovery-hub="guides"><div class="container hub-hero-grid"><div><p class="eyebrow">Conseils pour choisir et utiliser</p><h1>Comprendre avant d’acheter{page > 1 ? ` : page ${page}` : ''}</h1><p class="lead">Des guides sourcés pour choisir un compresseur, alimenter vos outils et repérer les chiffres commerciaux qui ne répondent pas à votre besoin.</p><div class="actions"><a class="button primary" href={page === 1 ? "#parcours" : "#bibliotheque"}>{page === 1 ? "Choisir mon point de départ" : "Parcourir cette page"}</a><a class="button" href="/guides/professionnels/">Parcours professionnels</a><a class="button subtle" href="#bibliotheque">Parcourir les {guides.length} guides</a></div></div><HubSignalVisual mode="guides" count={guides.length} title="guides canoniques" secondary={`${guideMetierIds.length} parcours métiers`} /></div></section>
	{page === 1 && <>
	<section class="section hub-intent-section" id="parcours"><div class="container"><div class="section-head split-head"><div><p class="eyebrow">Une question, une porte d’entrée</p><h2>Commencer par la décision à prendre</h2></div><p>Chaque parcours rejoint ensuite les mêmes fiches, sources et calculs. Le point de départ change, pas les exigences de preuve.</p></div><div class="hub-intent-grid">{decisionPaths.map((path, index) => <a href={path.href}><span class="hub-intent-index">0{index + 1}</span><UiIcon name={path.icon} size={28} /><p>{path.eyebrow}</p><h3>{path.title}</h3><small>{path.detail}</small><strong>{path.action} →</strong></a>)}</div></div></section>
	<section class="section editorial-gateway">
		<div class="container">
			<div class="section-head split-head"><div><p class="eyebrow">Choisir son parcours</p><h2>Partir de votre usage, pas d’une catégorie commerciale</h2></div><p>Les parcours classent les mêmes guides canoniques. Ils n’ajoutent aucune consommation moyenne et ne transforment pas un métier en profil technique supposé.</p></div>
			<div class="audience-grid">{guideAudienceIds.map((audience) => <a href={`/guides/${guideAudiences[audience].label.toLocaleLowerCase('fr-FR')}/`}><span>{guides.filter((guide) => guide.data.audiences.includes(audience)).length} guides</span><strong>{guideAudiences[audience].label}</strong><small>{guideAudiences[audience].description}</small></a>)}</div>
			<div class="editorial-path-grid">{guideMetierIds.map((metier) => <a href={`/guides/metiers/${metier}/`}><MetierIcon metier={metier} /><span>Métier · {guides.filter((guide) => guide.data.metiers.includes(metier)).length} guides</span><strong>{guideMetiers[metier].label}</strong><small>{guideMetiers[metier].description}</small></a>)}</div>
		</div>
	</section>
	<section class="section pillar-section">
		<div class="container">
			<div class="section-head split-head"><div><p class="eyebrow">Trois points de départ</p><h2>Du besoin réel à l’installation</h2></div><p>Une méthode générale, la distinction qui évite le plus d’erreurs et le dossier réseau qui prolonge la décision jusqu’au poste.</p></div>
			<div class="pillar-grid hub-starter-grid">{startingGuides.map((guide, index) => <article class:list={["pillar-card", { lead: index === 0 }]}><div class="pillar-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div><div><p class="guide-meta">{guide.data.category} · {guide.data.readingTime} min</p><h2><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h2><p>{guide.data.description}</p><a class="text-link" href={`/guides/${guide.id}/`}>Lire le dossier complet</a></div></article>)}</div>
		</div>
	</section>
	<GuideSeriesCallout guideCount={maintenanceSeriesCount} />
	</>}
	<GuideDirectory guides={pagination.items} pagination={pagination} basePath="/guides/" pageSize={GUIDE_DIRECTORY_PAGE_SIZE} title={`${guides.length} guides techniques, classés par usage`} description="Parcourez les dossiers par page, puis filtrez par étape ou public. Chaque guide possède sa propre URL et ses sources." />
</BaseLayout>
