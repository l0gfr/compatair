---
import { pcpKindLabels, type PcpReference } from '../data/pcp';
interface Props { reference: PcpReference; }
const { reference } = Astro.props;
---
<article class="pcp-reference-card">
	<p class="eyebrow">{pcpKindLabels[reference.kind]}</p>
	<h3><a href={`/pcp/${reference.slug}/`}>{reference.brand} {reference.model}</a></h3>
	<p>{reference.summary}</p>
	<p class="pcp-reference-source">Documentation constructeur · {reference.facts.length} caractéristiques sourcées</p>
	<a class="pcp-reference-link" href={`/pcp/${reference.slug}/`}>Lire la fiche <span aria-hidden="true">→</span></a>
</article>
<style>
	.pcp-reference-card { display: flex; flex-direction: column; min-width: 0; padding: clamp(1.25rem, 3vw, 1.8rem); border: 1px solid var(--line); border-radius: var(--radius-panel); background: var(--panel); }
	.pcp-reference-card .eyebrow { margin-bottom: .75rem; font-size: .65rem; }
	.pcp-reference-card h3 { margin: 0 0 .8rem; font-size: 1.65rem; font-weight: 500; line-height: 1.2; }
	.pcp-reference-card h3 a { text-decoration: none; }
	.pcp-reference-card h3 a:hover { text-decoration: underline; text-underline-offset: .18em; }
	.pcp-reference-card p { margin-top: 0; color: var(--muted); }
	.pcp-reference-card .pcp-reference-source { margin-top: auto; padding-top: .5rem; font-size: .78rem; }
	.pcp-reference-link { display: inline-flex; align-items: center; gap: .7rem; min-height: 44px; color: var(--brand-dark); text-underline-offset: .2em; }
</style>
