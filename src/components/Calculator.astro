	function optionById(list: HTMLDataListElement | null, id: string) { return [...(list?.options ?? [])].find((option) => option.dataset.id === id); }
	function optionByInput(list: HTMLDataListElement | null, value: string) {
		const options = [...(list?.options ?? [])];
		const id = resolveExactCatalogSearch(value, options.map((option) => ({
			id: option.dataset.id ?? '',
			value: option.value,
			identifiers: JSON.parse(option.dataset.identifiers ?? '[]') as string[],
		})));
		return id ? options.find((option) => option.dataset.id === id) : undefined;
	}
