---
import { compressors, tools } from '../data/catalog';
import { catalogSearchIdentifiers } from '../domain/catalog-search';
import { compressorDisplayName } from '../domain/product-display';
import { toolDemandLabel, toolPressureLabel } from '../domain/tool-demand';
import { activeOffers, merchants } from '../data/offers';
import { serializeJsonLd } from '../domain/structured-data';
import ContextHelp from './ContextHelp.astro';
import UiIcon from './UiIcon.astro';

const commercialOffers = activeOffers
	.filter((offer) => offer.availability === 'in_stock' || offer.availability === 'preorder')
	.map((offer) => ({
		id: offer.id,
		productId: offer.productId,
		merchantName: merchants.find((merchant) => merchant.id === offer.merchantId)?.name ?? 'Vendeur vérifié',
		priceEur: offer.priceEur,
		collectedAt: offer.collectedAt,
	}));
---

<div class="calculator calculator-v2" data-calculator data-ui-state="idle">
	<script is:inline type="application/json" data-commercial-offers set:html={serializeJsonLd(commercialOffers)} />
	<aside class="calculator-scenario-context" data-scenario-context hidden>
		<div class="calculator-scenario-context-head">
			<span><UiIcon name="compass" size={24} /></span>
			<div><p class="eyebrow">Scénario métier prérempli</p><h2 data-scenario-title></h2><p>La référence vient du catalogue vérifié. Les valeurs d’usage ci-dessous sont des hypothèses de départ modifiables, jamais des données constructeur silencieuses.</p></div>
		</div>
		<div class="calculator-scenario-context-meta" data-scenario-meta></div>
		<ul data-scenario-assumptions></ul>
		<footer><a class="text-link" data-scenario-back href="/guides/professionnels/">Revenir au guide métier</a><a href="/calculateur/">Repartir d’une configuration vide</a></footer>
	</aside>
	<form class="calculator-form" id="calculator-form" data-calculator-form aria-describedby="calculator-form-status calculator-form-error">
		<div class="calculator-form-head">
			<div><p class="eyebrow">Configuration simple</p><h2>Décrire le besoin réel</h2><small>Commencez par un outil. Le reste est facultatif.</small></div>
			<span class="version-chip">Réponse expliquée</span>
		</div>

		<fieldset class="calculator-fieldset">
			<legend><span>01</span> Outils utilisés</legend>
			<div data-demand-rows></div>
			<button class="inline-action" type="button" data-add-tool>+ Ajouter un outil</button>
		</fieldset>

		<div class="field-row">
			<div class="field" data-mode-field hidden><label for="mode">Organisation</label><select id="mode" name="mode"><option value="successive">Utilisation successive</option><option value="simultaneous">Utilisation simultanée</option></select></div>
			<div class="field"><div class="field-label-help"><label for="session">Durée de session</label><ContextHelp topic="duration" compact /></div><div class="input-unit"><input id="session" name="session" type="number" min="1" max="1440" value="30" /><span>min</span></div></div>
		</div>

		<details class="calculator-details">
			<summary>Options avancées : marge, flexible et réseau</summary>
			<p class="calculator-details-intro details-body">Ces valeurs affinent la réponse sans être inventées. Laissez vide ce que vous n’avez pas mesuré : la limite restera visible.</p>
			<div class="margin-control details-body"><div class="field-label-help"><label for="margin">Réserve de débit souhaitée</label><ContextHelp topic="margin" compact /></div><output data-margin-output>25 %</output><input id="margin" name="margin" type="range" min="0" max="50" step="5" value="25" /></div>
			<div class="field-row details-body"><div class="field"><div class="field-label-help"><label for="hose-length">Longueur du flexible</label><ContextHelp topic="hose" compact /></div><div class="input-unit"><input id="hose-length" name="hoseLength" type="number" min="0" max="500" step="0.5" value="10" /><span>m</span></div></div><div class="field"><label for="hose-diameter">Diamètre intérieur</label><div class="input-unit"><input id="hose-diameter" name="hoseDiameter" type="number" min="1" max="100" step="0.5" value="9" /><span>mm</span></div></div></div>
			<div class="field-row details-body"><div class="field"><div class="field-label-help"><label for="measured-pressure-drop">Chute de pression mesurée en charge</label><ContextHelp topic="loadedPressure" compact /></div><div class="input-unit"><input id="measured-pressure-drop" name="measuredPressureDrop" type="number" min="0" max="50" step="0.01" inputmode="decimal" /><span>bar</span></div></div><div class="field"><label for="measured-leak">Débit de fuite mesuré</label><div class="input-unit"><input id="measured-leak" name="measuredLeak" type="number" min="0" max="10000" step="0.1" inputmode="decimal" /><span>L/min</span></div><small>À renseigner uniquement depuis une mesure du réseau.</small></div></div>
			<div class="field details-body"><div class="field-label-help"><label for="supply-pressure">Pression réglée ou mesurée disponible</label><ContextHelp topic="loadedPressure" compact /></div><div class="input-unit"><input id="supply-pressure" name="supplyPressure" type="number" min="0.1" max="50" step="0.01" inputmode="decimal" /><span>bar</span></div><small>Mesurez en charge. La recommandation ne dépassera jamais la pression maximale publiée de la machine.</small></div>
			<div class="field-row details-body"><div class="field"><label for="network-distance">Distance totale jusqu’au point d’usage</label><div class="input-unit"><input id="network-distance" name="networkDistance" type="number" min="0" max="2000" step="0.5" /><span>m</span></div></div><div class="field"><label for="usage-profile">Profil global d’utilisation</label><select id="usage-profile" name="usageProfile"><option value="occasional">Occasionnel</option><option value="intermittent">Intermittent</option><option value="sustained">Soutenu</option><option value="mixed" selected>Mixte</option></select></div></div>
			<div class="field-row details-body"><div class="field"><label for="fitting-standard">Standard des raccords</label><select id="fitting-standard" name="fittingStandard"><option value="unknown">Non renseigné</option><option value="euro-7.2">Euro 7,2 mm</option><option value="iso-6150-b">ISO 6150-B</option><option value="other">Autre</option></select></div><div class="field"><label for="fitting-count">Nombre de raccords et restrictions</label><input id="fitting-count" name="fittingCount" type="number" min="0" max="200" step="1" /></div></div>
			<div class="field details-body"><label for="filtration">Filtration ou séchage déclaré</label><select id="filtration" name="filtration"><option value="unknown">Non renseigné</option><option value="none">Aucun traitement déclaré</option><option value="particle">Filtration particulaire</option><option value="water-separator">Séparateur d’eau</option><option value="coalescing">Filtration coalescente</option><option value="dryer">Sécheur</option></select></div>
		</details>

		<fieldset class="calculator-fieldset calculator-context-fieldset">
			<legend><span>02</span> Votre contexte</legend>
			<p class="context-filter-intro">Ces critères filtrent les trois solutions prioritaires. Ils ne modifient jamais le verdict technique.</p>
			<div class="context-filter-grid">
				<div class="field"><label for="buyer-profile">Profil</label><select id="buyer-profile" name="buyerProfile" data-buyer-profile><option value="particular" selected>Particulier</option><option value="professional">Atelier / professionnel</option></select></div>
				<div class="field"><label for="power-supply">Alimentation</label><select id="power-supply" name="powerSupply"><option value="single-phase-230v" selected>230 V monophasé uniquement</option><option value="any">Toutes, triphasé compris</option></select></div>
				<div class="field"><label for="mobility-filter">Mobilité</label><select id="mobility-filter" name="mobilityFilter"><option value="portable-or-mobile" selected>Portable ou mobile</option><option value="portable">Portable uniquement</option><option value="any">Indifférent, fixe compris</option></select></div>
				<div class="field"><label for="maximum-budget">Budget maximal <small>facultatif</small></label><div class="input-unit"><input id="maximum-budget" name="maximumBudget" type="number" min="1" max="1000000" step="1" inputmode="numeric" /><span>€</span></div></div>
			</div>
			<small class="context-filter-note">Un budget n’écarte une référence que si CompatAir dispose d’une offre datée et vérifiée. Sans offre, aucun prix n’est supposé.</small>
		</fieldset>

		<fieldset class="calculator-fieldset calculator-compressor-fieldset">
			<legend><span>03</span> Compresseur à vérifier <small>facultatif</small></legend>
			<div class="field autocomplete-field"><label for="compressor-search">Rechercher par marque, modèle, MPN, EAN/GTIN ou SKU</label><input id="compressor-search" data-compressor-search type="search" list="calculator-compressors" autocomplete="off" placeholder="Ex. Metabo Basic 250, 601532000…" /><input data-compressor-id name="compressor" type="hidden" value="" /><small data-compressor-selection-note>Une référence brute est acceptée. Laissez vide pour calculer seulement le besoin.</small></div>
			<div class="custom-compressor" data-custom-compressor hidden>
				<div class="field-row"><div class="field"><label for="custom-pressure">Pression maximale</label><div class="input-unit"><input id="custom-pressure" name="customPressure" type="number" min="0.1" max="50" step="0.1" value="8" /><span>bar</span></div></div><div class="field"><div class="field-label-help"><label for="custom-fad">Débit réellement restitué à la pression demandée</label><ContextHelp topic="fad" compact /></div><div class="input-unit"><input id="custom-fad" name="customFad" type="number" min="1" max="20000" step="1" /><span>L/min</span></div></div></div>
				<div class="field-row"><div class="field"><label for="custom-tank">Volume de cuve</label><div class="input-unit"><input id="custom-tank" name="customTank" type="number" min="0" max="20000" step="1" /><span>L</span></div></div><div class="field"><div class="field-label-help"><label for="custom-duty">Temps maximal de fonctionnement publié</label><ContextHelp topic="dutyCycle" compact /></div><div class="input-unit"><input id="custom-duty" name="customDuty" type="number" min="1" max="100" step="1" value="100" /><span>%</span></div></div></div>
				<div class="field-row"><div class="field"><label for="custom-cut-in">Pression de réenclenchement</label><div class="input-unit"><input id="custom-cut-in" name="customCutIn" type="number" min="0" max="50" step="0.1" /><span>bar</span></div></div><div class="field"><label for="custom-cut-out">Pression d’arrêt</label><div class="input-unit"><input id="custom-cut-out" name="customCutOut" type="number" min="0.1" max="50" step="0.1" /><span>bar</span></div></div></div>
			</div>
		</fieldset>

		<p class="form-disclaimer">La fréquence d’utilisation vient de vos réponses. CompatAir signale les pertes possibles dans les tuyaux et les raccords, mais ne les invente pas lorsqu’aucune mesure n’est disponible.</p>
		<p class="calculation-status" id="calculator-form-status" role="status" aria-live="polite" aria-atomic="true" data-calculation-status></p>
		<p class="form-error" id="calculator-form-error" role="alert" aria-atomic="true" data-form-error hidden></p>
		<button class="button primary calculator-submit" type="submit" data-calculator-submit><span>Obtenir ma réponse</span><b aria-hidden="true">→</b></button>
	</form>

	<div class="calculator-output" id="calculator-answer" aria-live="polite" data-calculator-output hidden>
		<fieldset class="result-mode-switch"><legend>Affichage</legend><label><input type="radio" name="resultDetail" value="essential" data-result-mode="essential" checked /> Essentiel</label><label><input type="radio" name="resultDetail" value="expert" data-result-mode="expert" /> Expert</label></fieldset>
		<div class="report-header" aria-hidden="true"><div><strong>CompatAir</strong><span>Vérification de votre configuration</span></div><div><span>Calcul CompatAir</span><span data-report-date></span></div></div>
		<div class="result-summary" data-decision-answer-first>
			<div><p class="eyebrow">Réponse</p><span class="verdict-large" data-verdict></span></div>
			<strong data-required-flow></strong><p data-result-context></p>
			<dl class="answer-first-grid">
				<div><dt data-answer-model-label>Modèle vérifié</dt><dd data-answer-model></dd></div>
				<div><dt>Besoin</dt><dd data-answer-need></dd></div>
				<div><dt data-answer-available-label>Débit disponible</dt><dd data-answer-available></dd></div>
				<div><dt>Marge</dt><dd data-answer-margin></dd></div>
				<div class="answer-reserve"><dt>Principale réserve</dt><dd data-answer-reserve></dd></div>
			</dl>
		</div>
		<nav class="result-local-nav result-expert-only" aria-label="Navigation dans la réponse">
			<a href="#calculator-answer" data-calculator-scroll="calculator-answer" aria-current="location"><span>01</span> Réponse</a>
			<a href="#calculator-selection" data-calculator-scroll="calculator-selection"><span>02</span> Sélection</a>
			<a href="#calculator-limits" data-calculator-scroll="calculator-limits"><span>03</span> Limites</a>
			<a href="#calculator-sources" data-calculator-scroll="calculator-sources"><span>04</span> Sources</a>
		</nav>
		<div class="result-section recommendation-section" id="calculator-selection" data-resolution-section>
			<p class="eyebrow" data-resolution-eyebrow>Aide à la décision</p>
			<h3 data-resolution-title>Trois solutions adaptées à votre contexte</h3>
			<p data-resolution-summary>Compatibilité, contraintes d’installation et présence d’une offre vérifiée structurent cette sélection.</p>
			<div class="resolution-gap" data-resolution-gap hidden><strong data-resolution-gap-title></strong><p data-resolution-gap-detail></p></div>
			<p class="resolution-proof">Sélection stricte : verdict concluant, FAD exploitable à la pression demandée et source technique de grade A ou B.</p>
			<p data-result-coverage></p>
			<div class="priority-list" data-priority-list></div>
			<a class="button primary recommendation-compare-cta" data-contextual-compare href="/comparateur/" hidden>Comparer ces trois compresseurs pour ce besoin</a>
		</div>
		<nav class="calculator-scenario-result-links result-expert-only" data-scenario-result-links aria-label="Continuer le parcours métier" hidden>
			<a class="button primary" data-scenario-result-back href="/guides/professionnels/">Relire le scénario métier</a>
			<a class="button" data-scenario-result-proof href="/graphe-preuve/">Voir les preuves de l’outil</a>
		</nav>
		<details class="result-section result-disclosure result-expert-only"><summary>Configuration analysée</summary><div class="configuration-summary" data-configuration-summary></div></details>
		<details class="result-section result-disclosure result-expert-only"><summary>Métriques détaillées</summary><div class="result-metrics" data-result-metrics></div></details>
		<div class="result-section result-expert-only" data-evaluated-result></div>
		<div class="result-section counterfactual-section result-expert-only" data-counterfactual><p class="eyebrow">Recommandation contrefactuelle</p><h3>Le plus petit changement vérifié</h3><div data-counterfactual-result></div><p class="counterfactual-boundary" data-counterfactual-boundary></p></div>
		<details class="result-section result-disclosure result-expert-only"><summary>Accessoires et raccordement</summary><ul data-accessories></ul></details>
		<details class="result-section result-inventory result-expert-only">
			<summary>Explorer les {compressors.length} compresseurs documentés</summary>
			<p>Les modèles sont regroupés selon le résultat, la réserve disponible et la fiabilité des données. Une information absente reste signalée comme telle.</p>
			<div class="result-filters" role="group" aria-label="Filtrer les compresseurs par résultat">
				<button type="button" data-result-filter="all" aria-pressed="true">Tous <span data-result-count="all">0</span></button>
				<button type="button" data-result-filter="continuous" aria-pressed="false">Continu <span data-result-count="continuous">0</span></button>
				<button type="button" data-result-filter="intermittent" aria-pressed="false">Intermittent <span data-result-count="intermittent">0</span></button>
				<button type="button" data-result-filter="insufficient_data" aria-pressed="false">Données insuffisantes <span data-result-count="insufficient_data">0</span></button>
				<button type="button" data-result-filter="incompatible" aria-pressed="false">Incompatible <span data-result-count="incompatible">0</span></button>
			</div>
			<p class="filter-empty" data-filter-empty hidden>Aucun compresseur dans cette catégorie.</p>
			<div class="result-list" data-result-list></div>
		</details>
		<details class="result-section result-disclosure result-expert-only" id="calculator-limits"><summary>Hypothèses et avertissements</summary><ul data-assumptions></ul></details>
		<details class="result-section result-disclosure result-source-guide result-expert-only" id="calculator-sources"><summary>Sources et qualité documentaire</summary><div><ContextHelp topic="sourceQuality" /><p>Chaque carte de résultat affiche un libellé humain. Le grade technique et la date de vérification restent accessibles dans le détail de la fiche.</p><a class="text-link" href="/sources-fiabilite/">Consulter les sources et leur fiabilité →</a></div></details>
		<div class="merchant-interest-control calculator-merchant-interest"><button class="button" type="button" data-calculator-merchant-interest aria-pressed="false">Je veux des options d’achat vérifiées</button><small aria-live="polite">Signal anonyme, sans référence produit ni donnée du calcul.</small></div>
		<label class="demand-contribution result-expert-only">
			<input type="checkbox" data-demand-contribution />
			<span><strong>Aider à choisir les prochaines références étudiées</strong><small>Après lecture du résultat, vous pouvez partager uniquement les outils choisis et des tranches larges de débit, pression et durée. Aucun texte libre, valeur personnalisée exacte, cookie, adresse IP ou configuration complète n’est conservé.</small></span>
		</label>
		<div class="passport-readiness-note"><strong>Avant la recette terrain</strong><span>Prévoyez un manomètre et un essai avec l’outil en charge ; la pression et les fuites devront être mesurées, pas estimées.</span></div>
		<div class="share-row"><a class="button primary" href="/passeport/" data-create-passport>Préparer mon installation</a><button class="button result-expert-only" type="button" data-share>Copier le lien</button><button class="button result-expert-only" type="button" data-copy-summary>Copier la synthèse</button><button class="button result-expert-only" type="button" data-print>Imprimer le calcul</button><span role="status" data-share-status></span></div>
		<p class="calculator-note result-expert-only">Le lien copié contient votre configuration, mais celle-ci n’est ni envoyée ni enregistrée sur le serveur CompatAir.</p>
	</div>
	<aside class="mobile-primary-action" data-calculator-mobile-action aria-label="Action principale">
		<button class="button primary" type="submit" form="calculator-form" data-calculator-submit data-calculator-mobile-submit>Obtenir ma réponse</button>
		<a class="button primary" href="#calculator-selection" data-calculator-scroll="calculator-selection" data-calculator-mobile-result hidden>Voir les solutions</a>
	</aside>
</div>

	<template data-demand-template>
		<div class="demand-row demand-card">
		<div class="field demand-tool autocomplete-field"><label data-label="outil">Rechercher l’outil par marque, modèle, MPN, EAN/GTIN ou SKU</label><input data-tool-search type="search" list="calculator-tools" autocomplete="off" placeholder="Ex. Einhell TC-PW 340…" /><input data-tool type="hidden" /></div>
		<div class="field"><label data-label="nombre">Nombre</label><input data-quantity type="number" min="1" max="20" value="1" /></div>
		<button type="button" class="remove-demand" data-remove-tool aria-label="Supprimer cet outil">×</button>
		<div class="demand-parameters" data-demand-parameters>
			<div class="field" data-fixed-fields><div class="field-label-help"><label data-label="frequence">Fréquence</label><ContextHelp topic="frequency" compact /></div><select data-duty><option value="0.1">Rare, 10 %</option><option value="0.3">Intermittente, 30 %</option><option value="0.6">Fréquente, 60 %</option><option value="1" selected>Continue, 100 %</option></select></div>
			<div class="field" data-action-fields hidden><label data-label="cadence">Cadence réelle</label><div class="input-unit"><input data-cadence type="number" min="0.1" max="10000" step="0.1" inputmode="decimal" /><span>tirs/min</span></div></div>
			<div class="inflation-fields" data-inflation-fields hidden>
				<div class="field"><label data-label="volume">Volume interne unitaire</label><div class="input-unit"><input data-volume type="number" min="0.1" max="100000" step="0.1" inputmode="decimal" /><span>L</span></div></div>
				<div class="field"><label data-label="initiale">Pression initiale</label><div class="input-unit"><input data-initial-pressure type="number" min="0" max="50" step="0.1" inputmode="decimal" /><span>bar</span></div></div>
				<div class="field"><label data-label="cible">Pression cible</label><div class="input-unit"><input data-target-pressure type="number" min="0.1" max="50" step="0.1" inputmode="decimal" /><span>bar</span></div></div>
				<div class="field"><label data-label="duree">Temps cible</label><div class="input-unit"><input data-duration-seconds type="number" min="1" max="86400" step="1" inputmode="numeric" /><span>s</span></div></div>
			</div>
			<p class="demand-note" data-demand-note></p>
		</div>
	</div>
</template>

<datalist id="calculator-tools">
	{tools.map((tool) => <option value={`${tool.brand} ${tool.model}${tool.mpn ? ` · MPN ${tool.mpn}` : ''}${tool.ean ? ` · EAN ${tool.ean}` : ''}`} data-id={tool.id} data-identifiers={JSON.stringify(catalogSearchIdentifiers(tool.brand, tool.model, [tool.label, tool.id, tool.mpn, tool.ean, tool.gtin, ...tool.distributorSkus.map((identifier) => identifier.sku), ...tool.identifierAliases.map((alias) => alias.value)]))} data-demand-model={tool.demandModel} data-airflow={tool.demandModel === 'fixed-flow' ? tool.airflowLpm.typical : undefined} data-pressure={tool.workingPressureBar.typical} data-air-per-action={tool.demandModel === 'per-action' ? tool.airPerActionLiters : undefined} data-action-label={tool.demandModel === 'per-action' ? tool.actionLabel : undefined}>{tool.label} · {toolDemandLabel(tool)} · {toolPressureLabel(tool)}</option>)}
</datalist>
<datalist id="calculator-compressors">
	<option value="Caractéristiques personnalisées" data-id="custom" data-identifiers={JSON.stringify(['custom'])}>Saisie personnalisée</option>
	{compressors.map((compressor) => <option value={`${compressor.brand} ${compressor.model}${compressor.mpn ? ` · MPN ${compressor.mpn}` : ''}${compressor.ean ? ` · EAN ${compressor.ean}` : ''}`} data-id={compressor.id} data-identifiers={JSON.stringify(catalogSearchIdentifiers(compressor.brand, compressor.model, [compressorDisplayName(compressor), compressor.id, compressor.mpn, compressor.ean, compressor.gtin, ...compressor.distributorSkus.map((identifier) => identifier.sku), ...compressor.identifierAliases.map((alias) => alias.value)]))}>{compressorDisplayName(compressor)}</option>)}
</datalist>

<script>
	import { resolveExactCatalogSearch } from '../domain/catalog-search';
	import { createDecisionResolution, explainDecisionDataGap, filterDecisionCandidatesByContext, rankDecisionCandidates } from '../domain/decision-resolution';
	import { JOURNEY_CONTEXT_EVENT } from '../domain/journey-context';
	import { sourceQualityDetail, sourceQualityLabel } from '../domain/source-quality';
	import { getTradeScenarioPreset } from '../domain/trade-scenario-prefill';

	type Compressor = import('../domain/runtime-catalog').RuntimeCompressor;
	type ToolProfile = import('../domain/runtime-catalog').RuntimeToolProfile;
	type PassportConfiguration = import('../domain/passport').PassportConfiguration;
	type SizingResult = import('../domain/sizing').SizingResult;
	type CounterfactualReport = import('../domain/counterfactual').CounterfactualReport;
	type CounterfactualCandidate = import('../domain/counterfactual').CounterfactualCandidate;
	type CounterfactualKind = import('../domain/counterfactual').CounterfactualKind;
	type CounterfactualMachine = import('../domain/counterfactual').CounterfactualMachine;
	type DecisionResolutionStatus = import('../domain/decision-resolution').DecisionResolutionStatus;
	type DecisionContext = import('../domain/decision-resolution').DecisionContext;
	type CommercialOffer = { id: string; productId: string; merchantName: string; priceEur: number; collectedAt: string };
	let CATALOG_VERIFIED_AT = '';
	let CALCULATION_VERSION = '';
	let compressors: Compressor[] = [];
	let tools: ToolProfile[] = [];
	let resolveAvailableFad: typeof import('../domain/compatibility').resolveAvailableFad;
