		const note = root?.querySelector<HTMLElement>('[data-compressor-selection-note]'); if (note) note.textContent = option ? `Référence reconnue directement : ${option.textContent?.trim() || option.value}.` : 'Une référence brute est acceptée. Laissez vide pour calculer seulement le besoin.';
		return id === '' || Boolean(option);
