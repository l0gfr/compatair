---
import { compressors, tools } from '../data/catalog';
import { compressorDisplayName } from '../domain/product-display';
import { toolDemandLabel, toolPressureLabel } from '../domain/tool-demand';
---

<div class="calculator calculator-v2" data-calculator>
	<form class="calculator-form" data-calculator-form>
		<div class="calculator-form-head">
			<div><p class="eyebrow">Configuration</p><h2>Décrire le besoin réel</h2></div>
			<span class="version-chip">Calcul expliqué</span>
		</div>

		<fieldset class="calculator-fieldset">
			<legend>Outils utilisés</legend>
			<div data-demand-rows></div>
			<button class="inline-action" type="button" data-add-tool>+ Ajouter un outil</button>
		</fieldset>

		<div class="field-row">
			<div class="field" data-mode-field hidden><label for="mode">Organisation</label><select id="mode" name="mode"><option value="successive">Utilisation successive</option><option value="simultaneous">Utilisation simultanée</option></select></div>
			<div class="field"><label for="session">Durée de session</label><div class="input-unit"><input id="session" name="session" type="number" min="1" max="1440" value="30" /><span>min</span></div></div>
		</div>

		<details class="calculator-details">
			<summary>Options avancées : marge, flexible et réseau</summary>
			<label class="margin-control details-body" for="margin"><span>Réserve de débit souhaitée</span><output data-margin-output>25 %</output><input id="margin" name="margin" type="range" min="0" max="50" step="5" value="25" /></label>
			<div class="field-row details-body"><div class="field"><label for="hose-length">Longueur du flexible</label><div class="input-unit"><input id="hose-length" name="hoseLength" type="number" min="0" max="500" step="0.5" value="10" /><span>m</span></div></div><div class="field"><label for="hose-diameter">Diamètre intérieur</label><div class="input-unit"><input id="hose-diameter" name="hoseDiameter" type="number" min="1" max="100" step="0.5" value="9" /><span>mm</span></div></div></div>
			<div class="field-row details-body"><div class="field"><label for="measured-pressure-drop">Chute de pression mesurée en charge</label><div class="input-unit"><input id="measured-pressure-drop" name="measuredPressureDrop" type="number" min="0" max="50" step="0.01" inputmode="decimal" /><span>bar</span></div></div><div class="field"><label for="measured-leak">Débit de fuite mesuré</label><div class="input-unit"><input id="measured-leak" name="measuredLeak" type="number" min="0" max="10000" step="0.1" inputmode="decimal" /><span>L/min</span></div></div></div>
			<div class="field details-body"><label for="supply-pressure">Pression réglée ou mesurée disponible</label><div class="input-unit"><input id="supply-pressure" name="supplyPressure" type="number" min="0.1" max="50" step="0.01" inputmode="decimal" /><span>bar</span></div><small>Mesurez en charge. La recommandation ne dépassera jamais la pression maximale publiée de la machine.</small></div>
			<div class="field-row details-body"><div class="field"><label for="network-distance">Distance totale jusqu’au point d’usage</label><div class="input-unit"><input id="network-distance" name="networkDistance" type="number" min="0" max="2000" step="0.5" /><span>m</span></div></div><div class="field"><label for="usage-profile">Profil global d’utilisation</label><select id="usage-profile" name="usageProfile"><option value="occasional">Occasionnel</option><option value="intermittent">Intermittent</option><option value="sustained">Soutenu</option><option value="mixed" selected>Mixte</option></select></div></div>
			<div class="field-row details-body"><div class="field"><label for="fitting-standard">Standard des raccords</label><select id="fitting-standard" name="fittingStandard"><option value="unknown">Non renseigné</option><option value="euro-7.2">Euro 7,2 mm</option><option value="iso-6150-b">ISO 6150-B</option><option value="other">Autre</option></select></div><div class="field"><label for="fitting-count">Nombre de raccords et restrictions</label><input id="fitting-count" name="fittingCount" type="number" min="0" max="200" step="1" /></div></div>
			<div class="field details-body"><label for="filtration">Filtration ou séchage déclaré</label><select id="filtration" name="filtration"><option value="unknown">Non renseigné</option><option value="none">Aucun traitement déclaré</option><option value="particle">Filtration particulaire</option><option value="water-separator">Séparateur d’eau</option><option value="coalescing">Filtration coalescente</option><option value="dryer">Sécheur</option></select></div>
		</details>

		<fieldset class="calculator-fieldset">
			<legend>Compresseur à vérifier</legend>
			<div class="field autocomplete-field"><label for="compressor-search">Rechercher par marque, modèle, MPN ou EAN</label><input id="compressor-search" data-compressor-search type="search" list="calculator-compressors" autocomplete="off" placeholder="Ex. Metabo Basic 250, 601532000…" /><input data-compressor-id name="compressor" type="hidden" value="" /><small>Laissez vide pour calculer seulement le besoin.</small></div>
			<div class="custom-compressor" data-custom-compressor hidden>
				<div class="field-row"><div class="field"><label for="custom-pressure">Pression maximale</label><div class="input-unit"><input id="custom-pressure" name="customPressure" type="number" min="0.1" max="50" step="0.1" value="8" /><span>bar</span></div></div><div class="field"><label for="custom-fad">Débit réellement restitué à la pression demandée</label><div class="input-unit"><input id="custom-fad" name="customFad" type="number" min="1" max="20000" step="1" /><span>L/min</span></div></div></div>
				<div class="field-row"><div class="field"><label for="custom-tank">Volume de cuve</label><div class="input-unit"><input id="custom-tank" name="customTank" type="number" min="0" max="20000" step="1" /><span>L</span></div></div><div class="field"><label for="custom-duty">Temps maximal de fonctionnement publié</label><div class="input-unit"><input id="custom-duty" name="customDuty" type="number" min="1" max="100" step="1" value="100" /><span>%</span></div></div></div>
				<div class="field-row"><div class="field"><label for="custom-cut-in">Pression de réenclenchement</label><div class="input-unit"><input id="custom-cut-in" name="customCutIn" type="number" min="0" max="50" step="0.1" /><span>bar</span></div></div><div class="field"><label for="custom-cut-out">Pression d’arrêt</label><div class="input-unit"><input id="custom-cut-out" name="customCutOut" type="number" min="0.1" max="50" step="0.1" /><span>bar</span></div></div></div>
			</div>
		</fieldset>

		<p class="form-disclaimer">La fréquence d’utilisation vient de vos réponses. CompatAir signale les pertes possibles dans les tuyaux et les raccords, mais ne les invente pas lorsqu’aucune mesure n’est disponible.</p>
		<p class="form-error" role="alert" data-form-error hidden></p>
		<button class="button primary" type="submit">Vérifier la configuration</button>
	</form>

	<div class="calculator-output" aria-live="polite" data-calculator-output hidden>
		<div class="report-header" aria-hidden="true"><div><strong>CompatAir</strong><span>Vérification de votre configuration</span></div><div><span>Calcul CompatAir</span><span data-report-date></span></div></div>
		<div class="result-summary">
			<div><p class="eyebrow">Réponse</p><span class="verdict-large" data-verdict></span></div>
			<strong data-required-flow></strong><p data-result-context></p>
			<dl class="answer-first-grid">
				<div><dt>Modèle vérifié</dt><dd data-answer-model></dd></div>
				<div><dt>Besoin</dt><dd data-answer-need></dd></div>
				<div><dt>Débit disponible</dt><dd data-answer-available></dd></div>
				<div><dt>Marge</dt><dd data-answer-margin></dd></div>
				<div class="answer-reserve"><dt>Principale réserve</dt><dd data-answer-reserve></dd></div>
			</dl>
		</div>
		<details class="result-section result-disclosure"><summary>Configuration analysée</summary><div class="configuration-summary" data-configuration-summary></div></details>
		<details class="result-section result-disclosure"><summary>Métriques détaillées</summary><div class="result-metrics" data-result-metrics></div></details>
		<div class="result-section" data-evaluated-result></div>
		<div class="result-section counterfactual-section" data-counterfactual><p class="eyebrow">Recommandation contrefactuelle</p><h3>Le plus petit changement vérifié</h3><div data-counterfactual-result></div><p class="counterfactual-boundary" data-counterfactual-boundary></p></div>
		<details class="result-section result-disclosure"><summary>Accessoires et raccordement</summary><ul data-accessories></ul></details>
		<div class="result-section recommendation-section"><p class="eyebrow">Aide à la décision</p><h3>Recommandations prioritaires</h3><p data-result-coverage></p><div class="priority-list" data-priority-list></div></div>
		<details class="result-section result-inventory">
			<summary>Explorer les {compressors.length} compresseurs documentés</summary>
			<p>Les modèles sont regroupés selon le résultat, la réserve disponible et la fiabilité des données. Une information absente reste signalée comme telle.</p>
			<div class="result-filters" role="group" aria-label="Filtrer les compresseurs par résultat">
				<button type="button" data-result-filter="all" aria-pressed="true">Tous <span data-result-count="all">0</span></button>
				<button type="button" data-result-filter="continuous" aria-pressed="false">Continu <span data-result-count="continuous">0</span></button>
				<button type="button" data-result-filter="intermittent" aria-pressed="false">Intermittent <span data-result-count="intermittent">0</span></button>
				<button type="button" data-result-filter="insufficient_data" aria-pressed="false">Données insuffisantes <span data-result-count="insufficient_data">0</span></button>
				<button type="button" data-result-filter="incompatible" aria-pressed="false">Incompatible <span data-result-count="incompatible">0</span></button>
			</div>
			<p class="filter-empty" data-filter-empty hidden>Aucun compresseur dans cette catégorie.</p>
			<div class="result-list" data-result-list></div>
		</details>
		<details class="result-section result-disclosure"><summary>Hypothèses et avertissements</summary><ul data-assumptions></ul></details>
		<label class="demand-contribution">
			<input type="checkbox" data-demand-contribution />
			<span><strong>Aider à choisir les prochaines références étudiées</strong><small>Après lecture du résultat, vous pouvez partager uniquement les outils choisis et des tranches larges de débit, pression et durée. Aucun texte libre, valeur personnalisée exacte, cookie, adresse IP ou configuration complète n’est conservé.</small></span>
		</label>
		<div class="share-row"><a class="button primary" href="/passeport/" data-create-passport>Créer une fiche partageable</a><button class="button" type="button" data-share>Copier le lien</button><button class="button" type="button" data-copy-summary>Copier la synthèse</button><button class="button" type="button" data-print>Imprimer le calcul</button><span role="status" data-share-status></span></div>
		<p class="calculator-note">Le lien copié contient votre configuration, mais celle-ci n’est ni envoyée ni enregistrée sur le serveur CompatAir.</p>
	</div>
</div>

	<template data-demand-template>
		<div class="demand-row demand-card">
		<div class="field demand-tool autocomplete-field"><label data-label="outil">Rechercher l’outil par marque, modèle, MPN ou EAN</label><input data-tool-search type="search" list="calculator-tools" autocomplete="off" placeholder="Ex. Einhell TC-PW 340…" /><input data-tool type="hidden" /></div>
		<div class="field"><label data-label="nombre">Nombre</label><input data-quantity type="number" min="1" max="20" value="1" /></div>
		<button type="button" class="remove-demand" data-remove-tool aria-label="Supprimer cet outil">×</button>
		<div class="demand-parameters" data-demand-parameters>
			<div class="field" data-fixed-fields><label data-label="frequence">Fréquence</label><select data-duty><option value="0.1">Rare, 10 %</option><option value="0.3">Intermittente, 30 %</option><option value="0.6">Fréquente, 60 %</option><option value="1" selected>Continue, 100 %</option></select></div>
			<div class="field" data-action-fields hidden><label data-label="cadence">Cadence réelle</label><div class="input-unit"><input data-cadence type="number" min="0.1" max="10000" step="0.1" inputmode="decimal" /><span>tirs/min</span></div></div>
			<div class="inflation-fields" data-inflation-fields hidden>
				<div class="field"><label data-label="volume">Volume interne unitaire</label><div class="input-unit"><input data-volume type="number" min="0.1" max="100000" step="0.1" inputmode="decimal" /><span>L</span></div></div>
				<div class="field"><label data-label="initiale">Pression initiale</label><div class="input-unit"><input data-initial-pressure type="number" min="0" max="50" step="0.1" inputmode="decimal" /><span>bar</span></div></div>
				<div class="field"><label data-label="cible">Pression cible</label><div class="input-unit"><input data-target-pressure type="number" min="0.1" max="50" step="0.1" inputmode="decimal" /><span>bar</span></div></div>
				<div class="field"><label data-label="duree">Temps cible</label><div class="input-unit"><input data-duration-seconds type="number" min="1" max="86400" step="1" inputmode="numeric" /><span>s</span></div></div>
			</div>
			<p class="demand-note" data-demand-note></p>
		</div>
	</div>
</template>

<datalist id="calculator-tools">
	{tools.map((tool) => <option value={`${tool.brand} ${tool.model}${tool.mpn ? ` · MPN ${tool.mpn}` : ''}${tool.ean ? ` · EAN ${tool.ean}` : ''}`} data-id={tool.id} data-demand-model={tool.demandModel} data-airflow={tool.demandModel === 'fixed-flow' ? tool.airflowLpm.typical : undefined} data-pressure={tool.workingPressureBar.typical} data-air-per-action={tool.demandModel === 'per-action' ? tool.airPerActionLiters : undefined} data-action-label={tool.demandModel === 'per-action' ? tool.actionLabel : undefined}>{tool.label} · {toolDemandLabel(tool)} · {toolPressureLabel(tool)}</option>)}
</datalist>
<datalist id="calculator-compressors">
	<option value="Caractéristiques personnalisées" data-id="custom">Saisie personnalisée</option>
	{compressors.map((compressor) => <option value={`${compressor.brand} ${compressor.model}${compressor.mpn ? ` · MPN ${compressor.mpn}` : ''}${compressor.ean ? ` · EAN ${compressor.ean}` : ''}`} data-id={compressor.id}>{compressorDisplayName(compressor)}</option>)}
</datalist>

<script>
	type Compressor = import('../domain/runtime-catalog').RuntimeCompressor;
	type ToolProfile = import('../domain/runtime-catalog').RuntimeToolProfile;
	type PassportConfiguration = import('../domain/passport').PassportConfiguration;
	type SizingResult = import('../domain/sizing').SizingResult;
	type CounterfactualReport = import('../domain/counterfactual').CounterfactualReport;
	type CounterfactualCandidate = import('../domain/counterfactual').CounterfactualCandidate;
	type CounterfactualKind = import('../domain/counterfactual').CounterfactualKind;
	type CounterfactualMachine = import('../domain/counterfactual').CounterfactualMachine;
	let CATALOG_VERIFIED_AT = '';
	let CALCULATION_VERSION = '';
	let compressors: Compressor[] = [];
	let tools: ToolProfile[] = [];
	let interpolateFad: typeof import('../domain/compatibility').interpolateFad;
	let createPassportEnvelope: typeof import('../domain/passport').createPassportEnvelope;
	let decodePassportConfiguration: typeof import('../domain/passport').decodePassportConfiguration;
	let encodePassportConfiguration: typeof import('../domain/passport').encodePassportConfiguration;
	let encodePassportEnvelope: typeof import('../domain/passport').encodePassportEnvelope;
	let parsePassportConfiguration: typeof import('../domain/passport').parsePassportConfiguration;
	let sizeConfiguration: typeof import('../domain/sizing').sizeConfiguration;
	let createCounterfactualRecommendation: typeof import('../domain/counterfactual').createCounterfactualRecommendation;
	let runtimePromise: Promise<void> | undefined;

	function loadCalculatorRuntime() {
		runtimePromise ??= Promise.all([
			import('../domain/runtime-catalog').then(({ loadRuntimeCatalog }) => loadRuntimeCatalog()),
			import('../domain/compatibility'),
			import('../domain/passport'),
			import('../domain/sizing'),
			import('../domain/counterfactual'),
		]).then(([catalog, compatibility, passport, sizing, counterfactual]) => {
			CATALOG_VERIFIED_AT = catalog.catalogVerifiedAt;
			CALCULATION_VERSION = sizing.CALCULATION_VERSION;
			compressors = catalog.compressors;
			tools = catalog.tools;
			interpolateFad = compatibility.interpolateFad;
			createPassportEnvelope = passport.createPassportEnvelope;
			decodePassportConfiguration = passport.decodePassportConfiguration;
			encodePassportConfiguration = passport.encodePassportConfiguration;
			encodePassportEnvelope = passport.encodePassportEnvelope;
			parsePassportConfiguration = passport.parsePassportConfiguration;
			sizeConfiguration = sizing.sizeConfiguration;
			createCounterfactualRecommendation = counterfactual.createCounterfactualRecommendation;
		});
		return runtimePromise;
	}

	const root = document.querySelector<HTMLElement>('[data-calculator]');
	const form = root?.querySelector<HTMLFormElement>('[data-calculator-form]');
	const rows = root?.querySelector<HTMLElement>('[data-demand-rows]');
	const template = document.querySelector<HTMLTemplateElement>('[data-demand-template]');
	const output = root?.querySelector<HTMLElement>('[data-calculator-output]');
	const list = root?.querySelector<HTMLElement>('[data-result-list]');
	const priorityList = root?.querySelector<HTMLElement>('[data-priority-list]');
	const evaluated = root?.querySelector<HTMLElement>('[data-evaluated-result]');
	const toolDatalist = document.querySelector<HTMLDataListElement>('#calculator-tools');
	const compressorDatalist = document.querySelector<HTMLDataListElement>('#calculator-compressors');
	const setText = (selector: string, value: string) => { const element = root?.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
	const labels = { continuous: 'Compatible en continu', intermittent: 'Compatible par intermittence', incompatible: 'Incompatible', insufficient_data: 'Données insuffisantes' } as const;
	const rank = { continuous: 0, intermittent: 1, insufficient_data: 2, incompatible: 3 } as const;
	const dataQualityLabel = (grade: 'A' | 'B' | 'C' | 'D') => grade === 'A' ? 'Source constructeur complète' : grade === 'B' ? 'Source constructeur partielle' : grade === 'C' ? 'Source insuffisante pour conclure' : 'Source non confirmée';
	const responseQualityLabel = (quality: SizingResult['confidence']) => quality === 'high' ? 'Réponse étayée' : quality === 'medium' ? 'Réponse à confirmer' : 'Réponse limitée';
	type Candidate = { compressor: (typeof compressors)[number]; result: SizingResult; availableFadLpm?: number; marginCovered: boolean };
	let demandIndex = 0;
	let currentFilter: keyof typeof labels | 'all' = 'all';
	let lastSummary = '';
	const recordedFunnelSteps = new Set<'started' | 'completed'>();
	const recordedCounterfactualSteps = new Set<string>();
	let pendingCounterfactualFamily: CounterfactualKind | undefined;
	let lastContribution: { config: NonNullable<ReturnType<typeof configFromForm>>; result: SizingResult } | undefined;

	function optionById(list: HTMLDataListElement | null, id: string) { return [...(list?.options ?? [])].find((option) => option.dataset.id === id); }
	function optionByValue(list: HTMLDataListElement | null, value: string) { const normalized = value.trim().toLocaleLowerCase('fr-FR'); return [...(list?.options ?? [])].find((option) => option.value.trim().toLocaleLowerCase('fr-FR') === normalized); }
	function syncSingleToolUi() {
		const single = (rows?.children.length ?? 0) <= 1;
		const modeField = root?.querySelector<HTMLElement>('[data-mode-field]'); if (modeField) modeField.hidden = single;
		if (single) { const mode = form?.elements.namedItem('mode'); if (mode instanceof HTMLSelectElement) mode.value = 'successive'; }
	}
	function setCompressorSelection(id: string) {
		const hidden = form?.querySelector<HTMLInputElement>('[data-compressor-id]'); const search = form?.querySelector<HTMLInputElement>('[data-compressor-search]');
		if (!hidden || !search) return false;
		const option = id ? optionById(compressorDatalist, id) : undefined;
		hidden.value = option?.dataset.id ?? ''; search.value = option?.value ?? '';
		const custom = root?.querySelector<HTMLElement>('[data-custom-compressor]'); if (custom) custom.hidden = hidden.value !== 'custom';
		return id === '' || Boolean(option);
	}
	function syncCompressorSearch() {
		const hidden = form?.querySelector<HTMLInputElement>('[data-compressor-id]'); const search = form?.querySelector<HTMLInputElement>('[data-compressor-search]'); if (!hidden || !search) return;
		const option = optionByValue(compressorDatalist, search.value); hidden.value = option?.dataset.id ?? '';
		const custom = root?.querySelector<HTMLElement>('[data-custom-compressor]'); if (custom) custom.hidden = hidden.value !== 'custom';
	}

	function recordFunnelStep(step: 'started' | 'completed') {
		if (recordedFunnelSteps.has(step) || !navigator.sendBeacon) return;
		if (navigator.sendBeacon('/events', new Blob([JSON.stringify({ event: 'calculator_funnel_aggregate', schemaVersion: '2.0.0', step })], { type: 'application/json' }))) recordedFunnelSteps.add(step);
	}

	function recordCounterfactualStep(step: 'recommendation_displayed' | 'recommendation_selected' | 'recalculation_succeeded', family: CounterfactualKind) {
		const key = `${step}:${family}`;
		if (recordedCounterfactualSteps.has(key) || !navigator.sendBeacon) return;
		if (navigator.sendBeacon('/events', new Blob([JSON.stringify({ event: 'calculator_funnel_aggregate', schemaVersion: '2.0.0', step, family })], { type: 'application/json' }))) recordedCounterfactualSteps.add(key);
	}

	function resultLabel(result: SizingResult) {
		if (result.flowBasis === 'documented-continuous') return labels[result.verdict];
		return result.verdict === 'continuous' ? 'Débit moyen couvert' : result.verdict === 'intermittent' ? 'Débit moyen couvert avec réserve' : labels[result.verdict];
	}

	function updateDemandMode(row: HTMLElement) {
		const selected = row.querySelector<HTMLInputElement>('[data-tool]')!;
		const demandModel = selected.dataset.demandModel;
		row.querySelector<HTMLElement>('[data-fixed-fields]')!.hidden = demandModel !== 'fixed-flow';
		row.querySelector<HTMLElement>('[data-action-fields]')!.hidden = demandModel !== 'per-action';
		row.querySelector<HTMLElement>('[data-inflation-fields]')!.hidden = demandModel !== 'variable-volume';
		const note = row.querySelector<HTMLElement>('[data-demand-note]')!;
		note.textContent = !demandModel
			? 'Commencez à saisir puis choisissez une référence exacte dans les suggestions.'
			: demandModel === 'fixed-flow'
			? `${selected.dataset.airflow} L/min documentés à ${selected.dataset.pressure} bar.`
			: demandModel === 'per-action'
				? `${Number(selected.dataset.airPerAction).toLocaleString('fr-FR')} L par ${selected.dataset.actionLabel} à ${selected.dataset.pressure} bar. La cadence est obligatoire et reste une saisie utilisateur.`
				: `Aucun volume de pneumatique n’est déduit du modèle. Volume, pressions et temps doivent être saisis.`;
	}
	function syncToolSearch(row: HTMLElement) {
		const search = row.querySelector<HTMLInputElement>('[data-tool-search]')!; const hidden = row.querySelector<HTMLInputElement>('[data-tool]')!;
		const option = optionByValue(toolDatalist, search.value);
		hidden.value = option?.dataset.id ?? '';
		for (const key of ['demandModel', 'airflow', 'pressure', 'airPerAction', 'actionLabel'] as const) {
			const value = option?.dataset[key]; if (value === undefined) delete hidden.dataset[key]; else hidden.dataset[key] = value;
		}
		updateDemandMode(row);
	}

	function addDemand(toolId?: string, quantity = 1, saved: any = {}) {
		if (!rows || !template || rows.children.length >= 8) return;
		const fragment = template.content.cloneNode(true) as DocumentFragment;
		const row = fragment.querySelector<HTMLElement>('.demand-row')!;
		const search = row.querySelector<HTMLInputElement>('[data-tool-search]')!;
		const selectedTool = row.querySelector<HTMLInputElement>('[data-tool]')!;
		const quantityInput = row.querySelector<HTMLInputElement>('[data-quantity]')!;
		const dutySelect = row.querySelector<HTMLSelectElement>('[data-duty]')!;
		const rowIndex = demandIndex++;
		const controls = [
			[search, 'outil'], [quantityInput, 'nombre'], [dutySelect, 'frequence'],
			[row.querySelector<HTMLInputElement>('[data-cadence]')!, 'cadence'],
			[row.querySelector<HTMLInputElement>('[data-volume]')!, 'volume'],
			[row.querySelector<HTMLInputElement>('[data-initial-pressure]')!, 'initiale'],
			[row.querySelector<HTMLInputElement>('[data-target-pressure]')!, 'cible'],
			[row.querySelector<HTMLInputElement>('[data-duration-seconds]')!, 'duree'],
		] as const;
		for (const [control, suffix] of controls) {
			control.id = `demande-${rowIndex}-${suffix}`;
			row.querySelector<HTMLLabelElement>(`label[data-label="${suffix}"]`)!.htmlFor = control.id;
		}
		const toolOption = toolId ? optionById(toolDatalist, toolId) : undefined;
		search.value = toolOption?.value ?? '';
		quantityInput.value = String(quantity);
		dutySelect.value = String(saved.dutyFactor ?? 1);
		row.querySelector<HTMLInputElement>('[data-cadence]')!.value = saved.actionsPerMinute ?? '';
		row.querySelector<HTMLInputElement>('[data-volume]')!.value = saved.volumeLiters ?? '';
		row.querySelector<HTMLInputElement>('[data-initial-pressure]')!.value = saved.initialPressureBar ?? '';
		row.querySelector<HTMLInputElement>('[data-target-pressure]')!.value = saved.targetPressureBar ?? '';
		row.querySelector<HTMLInputElement>('[data-duration-seconds]')!.value = saved.targetMinutes ? String(saved.targetMinutes * 60) : '';
		search.addEventListener('input', () => syncToolSearch(row));
		search.addEventListener('change', () => syncToolSearch(row));
		row.querySelector('[data-remove-tool]')?.addEventListener('click', () => { if (rows.children.length > 1) { row.remove(); syncSingleToolUi(); } });
		if (toolOption) { selectedTool.value = toolOption.dataset.id ?? ''; syncToolSearch(row); } else updateDemandMode(row);
		rows.append(fragment);
		syncSingleToolUi();
	}

	function readNumber(data: FormData, key: string) {
		const raw = data.get(key);
		if (typeof raw !== 'string' || raw.trim() === '') return undefined;
		const value = Number(raw);
		return Number.isFinite(value) ? value : undefined;
	}
	function requireRange(value: number | undefined, minimum: number, maximum: number, label: string, optional = false) {
		if (value === undefined && optional) return undefined;
		if (value === undefined || !Number.isFinite(value) || value < minimum || value > maximum) throw new Error(`${label} doit être compris entre ${minimum} et ${maximum}.`);
		return value;
	}

	function configFromForm() {
		if (!form || !rows) return undefined;
		const data = new FormData(form);
		const demands = [...rows.querySelectorAll<HTMLElement>('.demand-row')].map((row) => {
			const id = row.querySelector<HTMLInputElement>('[data-tool]')!.value;
			const tool = tools.find((item) => item.id === id);
			if (!tool) throw new Error('Sélectionnez une référence d’outil dans les suggestions.');
			const quantity = Number(row.querySelector<HTMLInputElement>('[data-quantity]')!.value);
			if (!Number.isInteger(quantity) || quantity < 1 || quantity > 20) throw new Error('Le nombre d’outils doit être compris entre 1 et 20.');
			if (tool.demandModel === 'fixed-flow') { const dutyFactor = Number(row.querySelector<HTMLSelectElement>('[data-duty]')!.value); if (![.1, .3, .6, 1].includes(dutyFactor)) throw new Error('La fréquence sélectionnée est invalide.'); return { model: 'fixed-flow' as const, id, flowLpm: tool.airflowLpm.typical, pressureBar: tool.workingPressureBar.typical, quantity, dutyFactor }; }
			if (tool.demandModel === 'per-action') {
				const actionsPerMinute = Number(row.querySelector<HTMLInputElement>('[data-cadence]')!.value);
				if (!Number.isFinite(actionsPerMinute) || actionsPerMinute <= 0 || actionsPerMinute > 10_000) throw new Error(`Saisissez une cadence valide pour ${tool.label}.`);
				return { model: 'per-action' as const, id, litersPerAction: tool.airPerActionLiters, actionsPerMinute, pressureBar: tool.workingPressureBar.typical, quantity };
			}
			const volumeLiters = Number(row.querySelector<HTMLInputElement>('[data-volume]')!.value);
			const initialPressureBar = Number(row.querySelector<HTMLInputElement>('[data-initial-pressure]')!.value);
			const targetPressureBar = Number(row.querySelector<HTMLInputElement>('[data-target-pressure]')!.value);
			const durationSeconds = Number(row.querySelector<HTMLInputElement>('[data-duration-seconds]')!.value);
			if (!Number.isFinite(volumeLiters) || volumeLiters <= 0 || volumeLiters > 100_000) throw new Error('Saisissez un volume interne unitaire valide.');
			if (!Number.isFinite(initialPressureBar) || initialPressureBar < 0 || initialPressureBar > 50) throw new Error('Saisissez une pression initiale valide.');
			if (!Number.isFinite(targetPressureBar) || targetPressureBar <= initialPressureBar) throw new Error('La pression cible doit être supérieure à la pression initiale.');
			if (targetPressureBar > (tool.workingPressureBar.max ?? 50)) throw new Error(`La pression cible dépasse la pression maximale publiée de ${tool.workingPressureBar.max} bar pour ${tool.label}.`);
			if (!Number.isFinite(durationSeconds) || durationSeconds <= 0 || durationSeconds > 86_400) throw new Error('Saisissez un temps cible valide.');
			return { model: 'inflation' as const, id, volumeLiters, initialPressureBar, targetPressureBar, targetMinutes: durationSeconds / 60, quantity };
		});
		const mode = String(data.get('mode')); if (!['successive', 'simultaneous'].includes(mode)) throw new Error('Le mode d’utilisation est invalide.');
		const safetyMargin = requireRange(Number(data.get('margin')) / 100, 0, .5, 'La marge');
		const sessionMinutes = requireRange(Number(data.get('session')), 1, 1_440, 'La durée de session');
		const hoseLengthMeters = requireRange(readNumber(data, 'hoseLength'), 0, 500, 'La longueur du flexible', true);
		const hoseInnerDiameterMm = requireRange(readNumber(data, 'hoseDiameter'), 1, 100, 'Le diamètre du flexible', true);
		const measuredPressureDropBar = requireRange(readNumber(data, 'measuredPressureDrop'), 0, 50, 'La chute de pression mesurée', true);
		const measuredLeakLpm = requireRange(readNumber(data, 'measuredLeak'), 0, 10_000, 'Le débit de fuite mesuré', true);
		const supplyPressureBar = requireRange(readNumber(data, 'supplyPressure'), .1, 50, 'La pression disponible', true);
		const networkDistanceMeters = requireRange(readNumber(data, 'networkDistance'), 0, 2_000, 'La distance totale', true);
		const fittingStandard = String(data.get('fittingStandard')); if (!['unknown', 'euro-7.2', 'iso-6150-b', 'other'].includes(fittingStandard)) throw new Error('Le standard de raccord est invalide.');
		const fittingCount = requireRange(readNumber(data, 'fittingCount'), 0, 200, 'Le nombre de raccords', true);
		if (fittingCount !== undefined && !Number.isInteger(fittingCount)) throw new Error('Le nombre de raccords doit être entier.');
		const filtration = String(data.get('filtration')); if (!['unknown', 'none', 'particle', 'water-separator', 'coalescing', 'dryer'].includes(filtration)) throw new Error('La filtration sélectionnée est invalide.');
		const usageProfile = String(data.get('usageProfile')); if (!['occasional', 'intermittent', 'sustained', 'mixed'].includes(usageProfile)) throw new Error('Le profil d’utilisation est invalide.');
		const selectedCompressor = String(data.get('compressor') ?? '');
		const compressorSearch = form.querySelector<HTMLInputElement>('[data-compressor-search]');
		if (compressorSearch?.value.trim() && !selectedCompressor) throw new Error('Sélectionnez une référence de compresseur dans les suggestions.');
		if (!['', 'custom', ...compressors.map((item) => item.id)].includes(selectedCompressor)) throw new Error('Le compresseur sélectionné est invalide.');
		const custom = selectedCompressor === 'custom' ? { maxPressureBar: requireRange(readNumber(data, 'customPressure'), .1, 50, 'La pression maximale personnalisée'), availableFadLpm: requireRange(readNumber(data, 'customFad'), 1, 20_000, 'Le débit réellement restitué', true), tankLiters: requireRange(readNumber(data, 'customTank'), 0, 20_000, 'Le volume personnalisé', true), dutyCycle: requireRange((readNumber(data, 'customDuty') ?? 100) / 100, .01, 1, 'Le temps maximal de fonctionnement'), cutInPressureBar: requireRange(readNumber(data, 'customCutIn'), 0, 50, 'La pression de réenclenchement', true), cutOutPressureBar: requireRange(readNumber(data, 'customCutOut'), .1, 50, 'La pression d’arrêt', true) } : {};
		if (custom.cutInPressureBar !== undefined && custom.cutOutPressureBar !== undefined && custom.cutInPressureBar >= custom.cutOutPressureBar) throw new Error('La pression de réenclenchement doit être inférieure à la pression d’arrêt.');
		return parsePassportConfiguration({ demands, mode, safetyMargin, sessionMinutes, hoseLengthMeters, hoseInnerDiameterMm, measuredPressureDropBar, measuredLeakLpm, supplyPressureBar, networkDistanceMeters, fittingStandard, fittingCount, filtration, usageProfile, selectedCompressor, custom }, new Set(compressors.map((item) => item.id)), new Set(tools.map((item) => item.id)));
	}

	function compressorInput(config: ReturnType<typeof configFromForm>, requiredPressureBar: number) {
		if (!config?.selectedCompressor) return undefined;
		if (config.selectedCompressor === 'custom') return config.custom.maxPressureBar ? config.custom : undefined;
		const compressor = compressors.find((item) => item.id === config.selectedCompressor);
		if (!compressor) return undefined;
		return { maxPressureBar: compressor.maxPressureBar, availableFadLpm: interpolateFad(compressor, requiredPressureBar), tankLiters: compressor.tankLiters, dutyCycle: compressor.dutyCycle };
	}

	function counterfactualMachine(config: NonNullable<ReturnType<typeof configFromForm>>, requiredPressureBar: number): CounterfactualMachine | undefined {
		if (!config.selectedCompressor) return undefined;
		if (config.selectedCompressor === 'custom') return config.custom.maxPressureBar === undefined ? undefined : {
			id: 'custom', label: 'Compresseur personnalisé', maxPressureBar: config.custom.maxPressureBar,
			availableFadLpm: config.custom.availableFadLpm, documentedFadPressureBar: requiredPressureBar,
			tankLiters: config.custom.tankLiters, dutyCycle: config.custom.dutyCycle,
		};
		const compressor = compressors.find((item) => item.id === config.selectedCompressor);
		return compressor ? { id: compressor.id, label: `${compressor.brand} ${compressor.model}`, maxPressureBar: compressor.maxPressureBar, confidence: compressor.confidence, fadCurve: compressor.fadCurve, tankLiters: compressor.tankLiters, dutyCycle: compressor.dutyCycle } : undefined;
	}

	function renderMetrics(result: SizingResult) {
		const metrics = root?.querySelector<HTMLElement>('[data-result-metrics]');
		if (!metrics) return;
		const values = [
			[result.flowBasis === 'documented-continuous' ? 'Besoin maximal' : 'Besoin moyen calculé', `${result.peakFlowLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min`],
			['Débit moyen', `${result.averageFlowLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min`],
			['Débit restitué recommandé', `${result.recommendedFadLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min`],
			['Pression requise à l’outil', `${(result.toolPressureBar ?? result.requiredPressureBar).toLocaleString('fr-FR')} bar`],
			['Chute mesurée ajoutée', result.measuredPressureDropBar !== undefined ? `${result.measuredPressureDropBar.toLocaleString('fr-FR')} bar` : 'Non mesurée'],
			['Pression requise au compresseur', `${result.requiredPressureBar.toLocaleString('fr-FR')} bar`],
			['Pression disponible', result.availablePressureBar !== undefined ? `${result.availablePressureBar.toLocaleString('fr-FR')} bar` : 'Données insuffisantes'],
			['Fuite mesurée incluse', result.measuredLeakLpm !== undefined ? `${result.measuredLeakLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min` : 'Non mesurée'],
			['Cuve recommandée', result.recommendedTankLiters !== undefined ? `${Math.round(result.recommendedTankLiters)} L` : 'Non déterminable sans durée de rafale'],
			['Qualité de la réponse', responseQualityLabel(result.confidence)],
			['Facteur limitant', result.limitingFactor === 'flow' ? 'Débit' : result.limitingFactor === 'pressure' ? 'Pression' : result.limitingFactor === 'duty_cycle' ? 'Cycle du compresseur' : result.limitingFactor === 'data' ? 'Données manquantes' : 'Aucun identifié'],
			...(result.usableTankAirLiters !== undefined ? [['Réserve utile', `${Math.round(result.usableTankAirLiters)} L d’air libre`]] : []),
			...(result.estimatedWorkMinutes !== undefined ? [['Travail estimé', `${result.estimatedWorkMinutes.toFixed(1)} min`]] : []),
			...(result.estimatedRecoveryMinutes !== undefined ? [['Récupération estimée', `${result.estimatedRecoveryMinutes.toFixed(1)} min`]] : []),
		];
		metrics.replaceChildren(...values.map(([label, value]) => { const div = document.createElement('div'); const small = document.createElement('small'); const strong = document.createElement('strong'); small.textContent = label; strong.textContent = value; div.append(small, strong); return div; }));
	}
	function renderAnswerFirst(config: NonNullable<ReturnType<typeof configFromForm>>, base: SizingResult, result: SizingResult) {
		const compressor = config.selectedCompressor && config.selectedCompressor !== 'custom' ? compressors.find((item) => item.id === config.selectedCompressor) : undefined;
		const available = config.selectedCompressor === 'custom' ? config.custom.availableFadLpm : compressor ? interpolateFad(compressor, base.requiredPressureBar) : undefined;
		const model = config.selectedCompressor === 'custom' ? 'Compresseur personnalisé' : compressor ? `${compressor.brand} ${compressor.model} · ${dataQualityLabel(compressor.confidence)}` : 'Aucun compresseur sélectionné';
		const marginCovered = available !== undefined && available >= base.recommendedFadLpm;
		const reserve = !config.selectedCompressor ? 'Sélectionnez un compresseur pour obtenir un verdict sur une machine.'
			: available !== undefined && !marginCovered && (result.verdict === 'continuous' || result.verdict === 'intermittent') ? `Le besoin nominal passe, mais la marge de ${Math.round(config.safetyMargin * 100)} % n’est pas entièrement couverte.`
			: result.limitingFactor === 'pressure' ? 'La pression disponible ou maximale est insuffisante.'
				: result.limitingFactor === 'flow' ? 'Le débit restitué disponible est insuffisant.'
					: result.limitingFactor === 'duty_cycle' ? 'Le cycle de fonctionnement limite la durée possible.'
						: result.limitingFactor === 'data' ? 'Le débit restitué n’est pas documenté à la pression demandée.'
							: result.verdict === 'intermittent' ? 'Usage couvert uniquement par intermittence.' : 'Aucune réserve bloquante dans les données déclarées.';
		setText('[data-answer-model]', model);
		setText('[data-answer-need]', `${base.recommendedFadLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min à ${base.requiredPressureBar.toLocaleString('fr-FR')} bar`);
		setText('[data-answer-available]', available === undefined ? `Non vérifiable à ${base.requiredPressureBar.toLocaleString('fr-FR')} bar` : `${available.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min à ${base.requiredPressureBar.toLocaleString('fr-FR')} bar`);
		setText('[data-answer-margin]', `${Math.round(config.safetyMargin * 100)} % demandée · ${available === undefined ? 'couverture indéterminée' : marginCovered ? 'couverte' : 'non couverte'}`);
		setText('[data-answer-reserve]', reserve);
	}

	function applyCounterfactual(candidate: CounterfactualCandidate) {
		if (!form) return false;
		const setField = (name: string, value: string | number) => {
			const field = form.elements.namedItem(name);
			if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) return false;
			field.value = String(value);
			return true;
		};
		if (candidate.kind === 'pressure') return setField('supplyPressure', candidate.afterValue);
		if (candidate.kind === 'flexible') return setField('measuredPressureDrop', candidate.afterValue);
		if (candidate.kind === 'simultaneity') return setField('mode', candidate.afterValue);
		if (candidate.kind === 'leak') return setField('measuredLeak', candidate.afterValue);
		if (candidate.kind === 'cadence') {
			const row = [...(rows?.querySelectorAll<HTMLElement>('.demand-row') ?? [])].find((item) => item.querySelector<HTMLInputElement>('[data-tool]')?.value === candidate.demandId);
			const cadence = row?.querySelector<HTMLInputElement>('[data-cadence]');
			if (!cadence) return false;
			cadence.value = String(candidate.afterValue);
			return true;
		}
		const selected = candidate.machineId ?? String(candidate.afterValue);
		return setCompressorSelection(selected);
	}

	function renderCounterfactual(report: CounterfactualReport) {
		const section = root?.querySelector<HTMLElement>('[data-counterfactual]');
		const target = root?.querySelector<HTMLElement>('[data-counterfactual-result]');
		const boundary = root?.querySelector<HTMLElement>('[data-counterfactual-boundary]');
		if (!target || !boundary) return;
		if (report.status === 'already_possible') {
			if (section) section.hidden = true;
			target.replaceChildren(); boundary.textContent = ''; return;
		}
		if (section) section.hidden = false;
		const candidate = report.recommendation;
		if (!candidate) {
			const message = document.createElement('p'); message.className = 'decision-empty'; message.textContent = 'Aucun changement unique n’est démontré suffisant avec les données disponibles. CompatAir ne combine pas plusieurs hypothèses et ne transforme pas une mesure absente en conseil.';
			target.replaceChildren(message);
		} else {
			recordCounterfactualStep('recommendation_displayed', candidate.kind);
			const title = document.createElement('strong'); title.className = 'counterfactual-action';
			if (candidate.kind === 'pressure') title.textContent = `Porter la pression disponible de ${Number(candidate.beforeValue).toLocaleString('fr-FR')} à ${Number(candidate.afterValue).toLocaleString('fr-FR')} bar, sans dépasser la plaque machine.`;
			else if (candidate.kind === 'flexible') title.textContent = `Ramener la chute mesurée du flexible et du réseau de ${Number(candidate.beforeValue).toLocaleString('fr-FR')} à ${Number(candidate.afterValue).toLocaleString('fr-FR')} bar ou moins.`;
			else if (candidate.kind === 'simultaneity') title.textContent = 'Passer d’une utilisation simultanée à une utilisation successive.';
			else if (candidate.kind === 'leak') title.textContent = `Ramener le débit de fuite mesuré de ${Number(candidate.beforeValue).toLocaleString('fr-FR')} à ${Number(candidate.afterValue).toLocaleString('fr-FR')} L/min ou moins.`;
			else if (candidate.kind === 'cadence') { const tool = tools.find((item) => item.id === candidate.demandId); title.textContent = `Ramener la cadence de ${tool?.label ?? candidate.demandId ?? 'l’outil'} de ${Number(candidate.beforeValue).toLocaleString('fr-FR')} à ${Number(candidate.afterValue).toLocaleString('fr-FR')} actions/min ou moins.`; }
			else {
				const compressor = compressors.find((item) => item.id === candidate.machineId);
				const link = document.createElement('a'); link.href = compressor ? `/compresseurs/${compressor.slug}/` : '#'; link.textContent = candidate.machineLabel ?? String(candidate.afterValue);
				title.append('Choisir la plus proche machine documentée qui passe : ', link, '.');
			}
			const proof = document.createElement('p'); proof.className = 'counterfactual-proof'; proof.textContent = `Après recalcul : ${resultLabel(candidate.result)}, ${candidate.result.peakFlowLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min requis à ${candidate.result.requiredPressureBar.toLocaleString('fr-FR')} bar. Une seule variable a changé.`;
			const alternatives = document.createElement('p'); alternatives.textContent = report.alternatives.length ? `${report.alternatives.length} autre(s) changement(s) unique(s) vérifié(s), classés après celui-ci.` : 'Aucune autre modification unique vérifiée ne passe.';
			const apply = document.createElement('button'); apply.type = 'button'; apply.className = 'button'; apply.textContent = 'Appliquer et recalculer';
			apply.addEventListener('click', () => {
				if (!applyCounterfactual(candidate)) return;
				recordCounterfactualStep('recommendation_selected', candidate.kind);
				pendingCounterfactualFamily = candidate.kind;
				form?.requestSubmit();
			});
			target.replaceChildren(title, proof, alternatives, apply);
		}
		const labels: Record<string, string> = { pressure: 'réglage de pression', flexible: 'flexible/réseau', simultaneity: 'simultanéité', leak: 'fuites', cadence: 'cadence', machine: 'machine' };
		const unavailable = report.untested.map((kind) => labels[kind]).join(', ');
		boundary.textContent = `${report.definition}${unavailable ? ` Non testable faute de données explicites : ${unavailable}.` : ''}`;
	}

	function renderWarnings(result: SizingResult) {
		const target = root?.querySelector<HTMLElement>('[data-assumptions]');
		if (!target) return;
		target.replaceChildren(...[...result.hypotheses, ...result.warnings].map((message) => { const li = document.createElement('li'); li.textContent = message; return li; }));
	}
	function renderAccessories(config: ReturnType<typeof configFromForm>) {
		const target = root?.querySelector<HTMLElement>('[data-accessories]'); if (!target || !config) return;
		const messages = config.demands.map((demand) => tools.find((item) => item.id === demand.id)).filter(Boolean).map((tool) => tool!.connectorSize ? `${tool!.label} : ${tool!.connectorSize}.` : `${tool!.label} : raccord et exigences de traitement non documentés dans la source actuelle.`);
		messages.push('Prévoir des raccords compatibles avec les filetages et passages internes réellement présents. CompatAir ne propose aucune référence commerciale sans flux vérifié.');
		target.replaceChildren(...messages.map((message) => { const li = document.createElement('li'); li.textContent = message; return li; }));
	}

	function demandDescription(demand: NonNullable<ReturnType<typeof configFromForm>>['demands'][number]) {
		const tool = tools.find((item) => item.id === demand.id)!;
		if (demand.model === 'fixed-flow') return `${demand.quantity} × ${tool.label} · fréquence ${Math.round(demand.dutyFactor * 100)} % · ${demand.flowLpm} L/min à ${demand.pressureBar} bar`;
		if (demand.model === 'per-action') { const actionLabel = tool.demandModel === 'per-action' ? tool.actionLabel : 'action'; return `${demand.quantity} × ${tool.label} · ${demand.actionsPerMinute.toLocaleString('fr-FR')} ${actionLabel}/min · ${demand.litersPerAction.toLocaleString('fr-FR')} L/${actionLabel}`; }
		return `${demand.quantity} × ${tool.label} · ${demand.volumeLiters.toLocaleString('fr-FR')} L de ${demand.initialPressureBar} à ${demand.targetPressureBar} bar en ${(demand.targetMinutes * 60).toLocaleString('fr-FR', { maximumFractionDigits: 0 })} s`;
	}

	function renderConfiguration(config: NonNullable<ReturnType<typeof configFromForm>>) {
		const target = root?.querySelector<HTMLElement>('[data-configuration-summary]'); if (!target) return;
		const heading = document.createElement('h3'); heading.textContent = 'Configuration analysée';
		const items = document.createElement('ul'); items.className = 'configuration-items';
		items.replaceChildren(...config.demands.map((demand) => { const li = document.createElement('li'); li.textContent = demandDescription(demand); return li; }));
		const details = [
			config.mode === 'simultaneous' ? 'Outils simultanés' : 'Outils successifs',
			`session ${config.sessionMinutes} min`,
			`marge ${Math.round((config.safetyMargin ?? .25) * 100)} %`,
			...(config.hoseLengthMeters !== undefined ? [`flexible ${config.hoseLengthMeters} m`] : []),
			...(config.hoseInnerDiameterMm !== undefined ? [`diamètre intérieur ${config.hoseInnerDiameterMm} mm`] : []),
			...(config.measuredPressureDropBar !== undefined ? [`chute mesurée ${config.measuredPressureDropBar} bar`] : []),
			...(config.measuredLeakLpm !== undefined ? [`fuite mesurée ${config.measuredLeakLpm} L/min`] : []),
			...(config.supplyPressureBar !== undefined ? [`pression disponible ${config.supplyPressureBar} bar`] : []),
			...(config.networkDistanceMeters !== undefined ? [`distance totale ${config.networkDistanceMeters} m`] : []),
			`profil ${config.usageProfile}`,
		];
		const meta = document.createElement('p'); meta.className = 'configuration-meta'; meta.textContent = details.join(' · ');
		target.replaceChildren(heading, items, meta);
		const reportDate = root?.querySelector<HTMLElement>('[data-report-date]');
		if (reportDate) reportDate.textContent = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(new Date());
	}

	function renderResultCard(compressor: (typeof compressors)[number], result: SizingResult, proofToolId?: string) {
		const article = document.createElement('article'); article.className = `result-card verdict-${result.verdict}`; article.dataset.verdict = result.verdict;
		const head = document.createElement('div'); head.className = 'result-card-head';
		const title = document.createElement('h4'); const link = document.createElement('a'); link.href = `/compresseurs/${compressor.slug}/`; link.textContent = `${compressor.brand} ${compressor.model}`; title.append(link);
		const badge = document.createElement('span'); badge.className = 'verdict-badge'; badge.textContent = resultLabel(result); head.append(title, badge);
		const detail = document.createElement('p'); detail.textContent = result.verdict === 'insufficient_data' ? `Débit réellement restitué non vérifiable à ${result.requiredPressureBar} bar · ${dataQualityLabel(compressor.confidence)}.` : `${interpolateFad(compressor, result.requiredPressureBar)?.toFixed(0) ?? 'Débit inconnu'} L/min disponibles à ${result.requiredPressureBar} bar · ${dataQualityLabel(compressor.confidence)}.`;
		const quality = document.createElement('details'); quality.className = 'result-card-quality'; const qualitySummary = document.createElement('summary'); qualitySummary.textContent = 'Détail qualité'; const qualityDetail = document.createElement('span'); qualityDetail.textContent = `Grade technique ${compressor.confidence}.`;
		quality.append(qualitySummary, qualityDetail); article.append(head, detail, quality);
		if (proofToolId) { const proofLink = document.createElement('a'); proofLink.className = 'result-proof-link'; proofLink.href = `/graphe-preuve/#compresseur=${encodeURIComponent(compressor.id)}&outil=${encodeURIComponent(proofToolId)}`; proofLink.textContent = 'Remonter aux preuves'; article.append(proofLink); }
		return article;
	}

	function setResultFilter(filter: keyof typeof labels | 'all') {
		currentFilter = filter;
		for (const button of root?.querySelectorAll<HTMLButtonElement>('[data-result-filter]') ?? []) button.setAttribute('aria-pressed', String(button.dataset.resultFilter === filter));
		let visible = 0;
		for (const card of list?.querySelectorAll<HTMLElement>('.result-card') ?? []) { card.hidden = filter !== 'all' && card.dataset.verdict !== filter; if (!card.hidden) visible += 1; }
		const empty = root?.querySelector<HTMLElement>('[data-filter-empty]'); if (empty) empty.hidden = visible > 0;
	}

	function renderCandidateResults(candidates: Candidate[], proofToolId?: string) {
		if (!list || !priorityList) return;
		const counts: Record<keyof typeof labels, number> = { continuous: 0, intermittent: 0, incompatible: 0, insufficient_data: 0 };
		for (const candidate of candidates) counts[candidate.result.verdict] += 1;
		for (const [key, count] of Object.entries({ all: candidates.length, ...counts })) root?.querySelector<HTMLElement>(`[data-result-count="${key}"]`)?.replaceChildren(String(count));
		const coverage = root?.querySelector<HTMLElement>('[data-result-coverage]');
		if (coverage) coverage.textContent = `${counts.continuous} en continu · ${counts.intermittent} par intermittence · ${counts.insufficient_data} en données insuffisantes · ${counts.incompatible} incompatibles.`;
		const priority = candidates.filter(({ result }) => result.verdict === 'continuous' || result.verdict === 'intermittent').slice(0, 3);
		if (priority.length) priorityList.replaceChildren(...priority.map(({ compressor, result }) => renderResultCard(compressor, result, proofToolId)));
		else { const message = document.createElement('p'); message.className = 'decision-empty'; message.textContent = 'Aucun compresseur actuellement étudié ne peut être recommandé pour cette configuration. Une information manquante n’est jamais transformée en recommandation.'; priorityList.replaceChildren(message); }
		list.replaceChildren(...candidates.map(({ compressor, result }) => renderResultCard(compressor, result, proofToolId)));
		setResultFilter(currentFilter);
	}

	function buildSummary(config: NonNullable<ReturnType<typeof configFromForm>>, result: SizingResult, candidates: Candidate[]) {
		const priority = candidates.filter(({ result: candidateResult }) => candidateResult.verdict === 'continuous' || candidateResult.verdict === 'intermittent').slice(0, 3);
		return [
			'CompatAir : vérification de la configuration',
			...config.demands.map(demandDescription),
			`Organisation : ${config.mode === 'simultaneous' ? 'simultanée' : 'successive'} · marge ${Math.round((config.safetyMargin ?? .25) * 100)} %`,
			`Besoin : ${result.peakFlowLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min à ${result.requiredPressureBar.toLocaleString('fr-FR')} bar`,
			`Débit restitué recommandé : ${result.recommendedFadLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min`,
			priority.length ? 'Recommandations documentées :' : 'Recommandation : aucune référence concluante dans le catalogue actuel.',
			...priority.map(({ compressor, result: candidateResult }) => `- ${compressor.brand} ${compressor.model} : ${resultLabel(candidateResult)}`),
			`Simulation : ${location.href}`,
		].join('\n');
	}

	function validateSharedConfig(config: unknown) {
		try { return parsePassportConfiguration(config, new Set(compressors.map((item) => item.id)), new Set(tools.map((item) => item.id))); } catch { return undefined; }
	}
	function restoreConfig(config: PassportConfiguration) {
		if (!form || !rows) return;
		rows.replaceChildren(); for (const demand of config.demands.slice(0, 8)) addDemand(demand.id, demand.quantity, demand);
		for (const [name, value] of Object.entries({ mode: config.mode, margin: config.safetyMargin * 100, session: config.sessionMinutes, hoseLength: config.hoseLengthMeters, hoseDiameter: config.hoseInnerDiameterMm, measuredPressureDrop: config.measuredPressureDropBar, measuredLeak: config.measuredLeakLpm, supplyPressure: config.supplyPressureBar, networkDistance: config.networkDistanceMeters, fittingStandard: config.fittingStandard, fittingCount: config.fittingCount, filtration: config.filtration, usageProfile: config.usageProfile, customPressure: config.custom?.maxPressureBar, customFad: config.custom?.availableFadLpm, customTank: config.custom?.tankLiters, customDuty: config.custom?.dutyCycle ? config.custom.dutyCycle * 100 : undefined, customCutIn: config.custom?.cutInPressureBar, customCutOut: config.custom?.cutOutPressureBar })) { const field = form.elements.namedItem(name); if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = value === undefined ? '' : String(value); }
		setCompressorSelection(config.selectedCompressor ?? '');
		root?.querySelector<HTMLOutputElement>('[data-margin-output]')!.replaceChildren(`${Math.round(config.safetyMargin * 100)} %`);
		syncSingleToolUi();
	}

	function flowBucket(value: number) {
		if (value < 100) return 'lt-100';
		if (value < 200) return '100-199';
		if (value < 400) return '200-399';
		if (value < 700) return '400-699';
		return '700-plus';
	}
	function pressureBucket(value: number) {
		if (value < 4) return 'lt-4';
		if (value < 6) return '4-5.9';
		if (value < 8) return '6-7.9';
		return '8-plus';
	}
	function sessionBucket(value: number) {
		if (value < 15) return 'lt-15';
		if (value < 60) return '15-59';
		return '60-plus';
	}
	function contributeDemand(config: NonNullable<ReturnType<typeof configFromForm>>, result: SizingResult) {
		if (!root?.querySelector<HTMLInputElement>('[data-demand-contribution]')?.checked || !navigator.sendBeacon) return;
		const event = {
			event: 'calculator_demand_aggregate',
			schemaVersion: '1.0.0',
			calculationVersion: CALCULATION_VERSION,
			toolIds: [...new Set(config.demands.map((demand) => demand.id))],
			mode: config.mode,
			flowBucket: flowBucket(result.recommendedFadLpm),
			pressureBucket: pressureBucket(result.requiredPressureBar),
			sessionBucket: sessionBucket(config.sessionMinutes ?? 30),
			compressorSelection: config.selectedCompressor === 'custom' ? 'custom' : config.selectedCompressor ? 'catalog' : 'none',
		};
		navigator.sendBeacon('/events', new Blob([JSON.stringify(event)], { type: 'application/json' }));
	}

	root?.querySelector('[data-add-tool]')?.addEventListener('click', () => addDemand());
	form?.addEventListener('input', () => recordFunnelStep('started'), { once: true });
	form?.addEventListener('change', () => recordFunnelStep('started'), { once: true });
	form?.querySelector<HTMLInputElement>('[data-compressor-search]')?.addEventListener('input', syncCompressorSearch);
	form?.querySelector<HTMLInputElement>('[data-compressor-search]')?.addEventListener('change', syncCompressorSearch);
	form?.querySelector<HTMLInputElement>('[name="margin"]')?.addEventListener('input', (event: Event) => { root!.querySelector<HTMLOutputElement>('[data-margin-output]')!.value = `${(event.target as HTMLInputElement).value} %`; });

	const legacyParameters = new URLSearchParams(window.location.search);
	const fragmentParameters = window.location.hash.startsWith('#config=') ? new URLSearchParams() : new URLSearchParams(window.location.hash.slice(1));
	const hasFragmentPrefill = fragmentParameters.has('outil') || fragmentParameters.has('compresseur');
	const initialParameters = hasFragmentPrefill ? fragmentParameters : legacyParameters;
	const requestedTool = initialParameters.get('outil') ?? undefined;
	const requestedCompressor = initialParameters.get('compresseur') ?? undefined;
	const initialTool = requestedTool && optionById(toolDatalist, requestedTool) ? requestedTool : undefined;
	async function initializeCalculator() {
		if (window.location.hash.startsWith('#config=')) {
			await loadCalculatorRuntime();
			const hashConfig = validateSharedConfig(decodePassportConfiguration(window.location.hash.slice(8)));
			if (hashConfig) { restoreConfig(hashConfig); return; }
		}
		addDemand(initialTool);
		const initialCompressor = requestedCompressor && optionById(compressorDatalist, requestedCompressor) ? requestedCompressor : undefined;
		if (initialCompressor) setCompressorSelection(initialCompressor);
		if (!hasFragmentPrefill && (legacyParameters.has('outil') || legacyParameters.has('compresseur'))) {
			const normalized = new URLSearchParams();
			if (initialTool) normalized.set('outil', initialTool);
			if (initialCompressor) normalized.set('compresseur', initialCompressor);
			const fragment = normalized.toString();
			window.history.replaceState(null, '', `${window.location.pathname}${fragment ? `#${fragment}` : ''}`);
		}
	}
	void initializeCalculator();

	form?.addEventListener('submit', async (event) => {
		event.preventDefault(); if (!output || !list || !evaluated) return;
		const appliedCounterfactualFamily = pendingCounterfactualFamily;
		pendingCounterfactualFamily = undefined;
		recordFunnelStep('started');
		const errorTarget = root?.querySelector<HTMLElement>('[data-form-error]');
		try {
			await loadCalculatorRuntime();
			const config = configFromForm(); if (!config) return;
			if (errorTarget) { errorTarget.hidden = true; errorTarget.textContent = ''; }
			const base = sizeConfiguration(config as any);
			const selected = compressorInput(config, base.requiredPressureBar);
			const result = sizeConfiguration({ ...config, compressor: selected } as any);
			root?.querySelector<HTMLElement>('[data-verdict]')!.replaceChildren(resultLabel(result));
			root?.querySelector<HTMLElement>('[data-required-flow]')!.replaceChildren(`${result.recommendedFadLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min recommandés`);
			const hasInflation = config.demands.some((demand) => demand.model === 'inflation');
			root?.querySelector<HTMLElement>('[data-result-context]')!.replaceChildren(result.flowBasis === 'documented-continuous' ? `${Math.round(result.peakFlowLpm)} L/min de pointe, ${Math.round(result.averageFlowLpm)} L/min en moyenne, à ${result.requiredPressureBar} bar.` : hasInflation ? `${result.peakFlowLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min de besoin moyen idéalisé à ${result.requiredPressureBar.toLocaleString('fr-FR')} bar. Le temps réel et les restrictions ne sont pas modélisés.` : `${result.peakFlowLpm.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} L/min de besoin moyen calculé à ${result.requiredPressureBar.toLocaleString('fr-FR')} bar. La pointe instantanée n’est pas modélisée.`);
			renderAnswerFirst(config, base, result); renderConfiguration(config); renderMetrics(result); renderWarnings(result); renderAccessories(config);
			evaluated.replaceChildren();

			const confidenceRank = { A: 0, B: 1, C: 2, D: 3 } as const;
			const candidates: Candidate[] = compressors.map((compressor) => {
				const availableFadLpm = interpolateFad(compressor, base.requiredPressureBar);
				const candidateResult = sizeConfiguration({ ...config, compressor: { maxPressureBar: compressor.maxPressureBar, availableFadLpm, tankLiters: compressor.tankLiters, dutyCycle: compressor.dutyCycle } } as any);
				return { compressor, result: candidateResult, availableFadLpm, marginCovered: availableFadLpm !== undefined && availableFadLpm >= base.recommendedFadLpm };
			}).sort((a, b) => rank[a.result.verdict] - rank[b.result.verdict]
				|| Number(b.marginCovered) - Number(a.marginCovered)
				|| confidenceRank[a.compressor.confidence] - confidenceRank[b.compressor.confidence]
				|| Math.abs((a.availableFadLpm ?? Number.POSITIVE_INFINITY) - base.recommendedFadLpm) - Math.abs((b.availableFadLpm ?? Number.POSITIVE_INFINITY) - base.recommendedFadLpm));
			const counterfactual = createCounterfactualRecommendation({
				configuration: config,
				selectedMachine: counterfactualMachine(config, base.requiredPressureBar),
				machines: compressors.map((compressor) => ({ id: compressor.id, label: `${compressor.brand} ${compressor.model}`, maxPressureBar: compressor.maxPressureBar, confidence: compressor.confidence, fadCurve: compressor.fadCurve, tankLiters: compressor.tankLiters, dutyCycle: compressor.dutyCycle })),
			});
			renderCounterfactual(counterfactual);
			const proofToolId = config.demands.length === 1 && config.demands[0].model === 'fixed-flow' ? config.demands[0].id : undefined;
			currentFilter = 'all'; renderCandidateResults(candidates, proofToolId); lastSummary = buildSummary(config, result, candidates);
			const encodedConfig = encodePassportConfiguration(config);
			window.history.replaceState(null, '', `${window.location.pathname}#config=${encodedConfig}`);
			const envelope = await createPassportEnvelope(config, compressors, tools, CATALOG_VERIFIED_AT);
			root?.querySelector<HTMLAnchorElement>('[data-create-passport]')?.setAttribute('href', `/passeport/#passport=${encodePassportEnvelope(envelope)}`);
			lastContribution = { config, result: base }; contributeDemand(config, base);
			recordFunnelStep('completed');
			if (appliedCounterfactualFamily) recordCounterfactualStep('recalculation_succeeded', appliedCounterfactualFamily);
			output.hidden = false; output.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
		} catch (error) {
			if (!errorTarget) return;
			errorTarget.textContent = error instanceof Error ? error.message : 'La configuration contient une valeur invalide.';
			errorTarget.hidden = false;
			errorTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
		}
	});

	for (const button of root?.querySelectorAll<HTMLButtonElement>('[data-result-filter]') ?? []) button.addEventListener('click', () => setResultFilter(button.dataset.resultFilter as keyof typeof labels | 'all'));
	root?.querySelector<HTMLInputElement>('[data-demand-contribution]')?.addEventListener('change', (event) => { if ((event.target as HTMLInputElement).checked && lastContribution) contributeDemand(lastContribution.config, lastContribution.result); });
	root?.querySelector('[data-print]')?.addEventListener('click', () => window.print());
	root?.querySelector('[data-copy-summary]')?.addEventListener('click', async () => { if (!lastSummary) return; await navigator.clipboard.writeText(lastSummary); root!.querySelector<HTMLElement>('[data-share-status]')!.textContent = 'Synthèse copiée'; });
	root?.querySelector('[data-share]')?.addEventListener('click', async () => { await loadCalculatorRuntime(); const config = configFromForm(); if (!config) return; const url = `${location.origin}${location.pathname}#config=${encodePassportConfiguration(config)}`; await navigator.clipboard.writeText(url); root!.querySelector<HTMLElement>('[data-share-status]')!.textContent = 'Lien copié'; });
</script>
