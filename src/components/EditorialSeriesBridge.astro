---
type Stage = 'commissioning' | 'monitoring' | 'intervention' | 'maintenance';

type Props = { stage: Stage };

const { stage } = Astro.props;
const contextualGuides: Record<Stage, { eyebrow: string; title: string; description: string; href: string }> = {
	commissioning: {
		eyebrow: 'Préparer le point zéro',
		title: 'Construire un protocole de mesure reproductible',
		description: 'Définir périmètre, scénarios, instruments et conditions avant de figer la ligne de base.',
		href: '/guides/audit-reseau-air-comprime-protocole-mesures/',
	},
	monitoring: {
		eyebrow: 'Lire les contrôles',
		title: 'Choisir des indicateurs qui déclenchent une action',
		description: 'Suivre le service, la distribution, la production et la qualité des données sans score opaque.',
		href: '/guides/indicateurs-maintenance-air-comprime/',
	},
	intervention: {
		eyebrow: 'Fermer la boucle',
		title: 'Documenter l’avant, l’action et l’après',
		description: 'Conserver le signal, les faits, l’action réelle et la contre-mesure qui justifie le statut final.',
		href: '/guides/fiche-intervention-air-comprime/',
	},
	maintenance: {
		eyebrow: 'Prévenir sans supposer',
		title: 'Relier chaque échéance à sa source et à son résultat',
		description: 'Transformer les contrôles et interventions en plan reproductible sans calendrier universel.',
		href: '/guides/maintenance-preventive-reseau-air-comprime/',
	},
};
const guide = contextualGuides[stage];
---

<section class="section editorial-series-bridge" data-lifecycle-guides={stage}>
	<div class="container editorial-series-bridge-grid">
		<div><p class="eyebrow">Méthode et preuves</p><h2>Comprendre le protocole avant de remplir le dossier.</h2><p>Les outils locaux organisent les données. Le dossier éditorial explique ce qui rend une mesure comparable, un écart actionnable et une intervention réellement close.</p><a class="text-link" href="/guides/dossiers/audit-suivi-maintenance-air-comprime/">Voir le parcours audit, suivi et maintenance</a></div>
		<a class="editorial-series-feature" href={guide.href}><span>{guide.eyebrow}</span><strong>{guide.title}</strong><small>{guide.description}</small><b>Lire le guide →</b></a>
	</div>
</section>

<style>
	.editorial-series-bridge { background: #f1f5ef; border-top: 1px solid rgba(20,52,38,.1); }
	.editorial-series-bridge-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
	.editorial-series-bridge h2 { margin: .45rem 0 .8rem; }
	.editorial-series-bridge p { color: #56685e; }
	.editorial-series-feature { display: grid; gap: .7rem; padding: clamp(1.5rem, 3vw, 2.2rem); border-radius: 22px; background: #10281e; color: white; text-decoration: none; box-shadow: 0 22px 50px rgba(16,40,30,.15); }
	.editorial-series-feature span, .editorial-series-feature b { color: #d3eb56; font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
	.editorial-series-feature strong { font-family: var(--font-display); font-size: clamp(1.45rem, 2.5vw, 2.1rem); line-height: 1.1; }
	.editorial-series-feature small { color: #c8d7cf; font-size: .93rem; line-height: 1.6; }
	.editorial-series-feature:hover { transform: translateY(-2px); }
	@media (max-width: 760px) { .editorial-series-bridge-grid { grid-template-columns: 1fr; } }
</style>
