---
import SourceAvailabilityNotice from './SourceAvailabilityNotice.astro';
import { productImageDimensions } from '../domain/product-image-dimensions';

type ProductImage = { src: string; alt: string; sourceUrl: string; sourceLabel: string };
const { image, eager = false, compact = false } = Astro.props as { image: ProductImage; eager?: boolean; compact?: boolean };
// Generated technical cards and manufacturer photos retain their actual dimensions.
const { width, height } = productImageDimensions(image.src);
---
<figure class:list={['product-visual', compact && 'compact']}>
	<img src={image.src} alt={image.alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
	{!compact && <figcaption>Visuel : <a href={image.sourceUrl} rel="nofollow noopener" target="_blank">{image.sourceLabel}</a><SourceAvailabilityNotice sourceUrl={image.sourceUrl} /></figcaption>}
</figure>
