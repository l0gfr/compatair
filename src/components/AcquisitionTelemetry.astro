<script>
	const referrer = document.referrer;
	let referrerUrl: URL | undefined;
	try { if (referrer) referrerUrl = new URL(referrer); } catch {}
	const isProductionHost = location.hostname === 'compatair.fr' || location.hostname === 'www.compatair.fr';
	if (isProductionHost && (!referrerUrl || referrerUrl.origin !== location.origin)) {
		const host = referrerUrl?.hostname ?? '';
		const channel = !referrerUrl ? 'direct'
			: /(^|\.)(chatgpt\.com|claude\.ai|gemini\.google\.com|perplexity\.ai|copilot\.microsoft\.com)$/.test(host) ? 'agent_referral'
				: /(^|\.)(bing\.com|duckduckgo\.com|qwant\.com|ecosia\.org|search\.brave\.com)$|(^|\.)google\./.test(host) ? 'organic' : 'referral';
		try { sessionStorage.setItem('ca:acquisition', channel); } catch {}
		const segments = location.pathname.split('/').filter(Boolean);
		const templateBySegment: Record<string, string> = { calculateur: 'calculator', compresseurs: 'compressor', 'outils-pneumatiques': 'tool', guides: 'guide', 'mcp-documentation': 'mcp_docs', agents: 'mcp_docs', ucp: 'ucp_docs', api: 'api_docs', 'benchmark-agents': 'benchmark', 'recu-compatibilite': 'receipt', offres: 'offers' };
		const template = !segments.length ? 'home' : segments[0] === 'en'
			? ({ mcp: 'mcp_docs', ucp: 'ucp_docs', 'agent-fidelity-benchmark': 'benchmark', 'compatibility-receipt': 'receipt' }[segments[1]] ?? 'other')
			: templateBySegment[segments[0]] ?? 'other';
		const event = { event: 'acquisition_aggregate', schemaVersion: '1.0.0', channel, template, action: 'view', outcome: 'unknown' };
		const send = () => {
			if (navigator.sendBeacon) navigator.sendBeacon('/events', new Blob([JSON.stringify(event)], { type: 'application/json' }));
		};
		if (window.requestIdleCallback) window.requestIdleCallback(send, { timeout: 2_000 });
		else setTimeout(send, 0);
	}
</script>
