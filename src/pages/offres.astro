import BaseLayout from '../layouts/BaseLayout.astro'; import { activeOffers } from '../data/offers';
---
<BaseLayout title="Offres marchandes vérifiées | CompatAir" description="État des offres marchandes reliées aux produits CompatAir par un identifiant vérifié et un flux partenaire autorisé." noindex breadcrumbs={[{ name: 'Offres', path: '/offres/' }]}><article class="container content"><p class="eyebrow">Offres et disponibilité</p><h1>Offres marchandes vérifiées</h1>{activeOffers.length === 0 ? <div class="status-callout"><strong>Aucune offre publiée</strong><span>Les flux Amazon et ManoMano ne sont pas encore raccordés. CompatAir ne fabrique ni prix, ni disponibilité, ni lien marchand arbitraire.</span></div> : <p>{activeOffers.length} offres actives.</p>}<h2>Conditions de publication</h2><ul><li>association par EAN, GTIN ou MPN&nbsp;;</li><li>domaine marchand inscrit sur liste blanche&nbsp;;</li><li>date de collecte affichée&nbsp;;</li><li>désactivation après 48 heures sans actualisation&nbsp;;</li><li>classement technique indépendant de la commission.</li></ul><p>Consultez la page <a href="/affiliation/">Affiliation et indépendance</a> pour la règle de classement.</p></article></BaseLayout>
