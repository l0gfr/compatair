---
import BaseLayout from '../layouts/BaseLayout.astro';
import UiIcon from '../components/UiIcon.astro';
import { CATALOG_VERIFIED_AT, compressors, tools } from '../data/catalog';
import { toolTaxonomy } from '../data/taxonomy';
import { createCatalogSnapshot, createVerdictSnapshot } from '../domain/snapshots';

const totalProducts = compressors.length + tools.length;
const formatNumber = (value: number) => new Intl.NumberFormat('fr-FR').format(value);
const catalogSnapshot = createCatalogSnapshot({ compressors, tools, toolTaxonomy, verifiedAt: CATALOG_VERIFIED_AT });
const verdictSnapshot = createVerdictSnapshot({ compressors, tools, catalogVersion: catalogSnapshot.catalogVersion, verifiedAt: CATALOG_VERIFIED_AT });
const scope = verdictSnapshot.scope;
const identityCoverage = catalogSnapshot.quality.field_coverage.filter((row) => ['normalizedMpn', 'ean', 'gtin', 'distributorSku'].includes(row.field));
---

<BaseLayout
	title="Fabricants et distributeurs | CompatAir"
	description="CompatAir aide fabricants et distributeurs à transformer leurs documents techniques en catalogues fiables, vérifiables et utiles pour orienter le client final."
	canonicalPath="/professionnels/"
	imageAlt="CompatAir relie documents techniques, catalogue structuré et décisions de compatibilité"
	breadcrumbs={[{ name: 'Fabricants et distributeurs', path: '/professionnels/' }]}
>
	<div class="pro-page">
		<section class="pro-hero" data-professional-page>
			<div class="container pro-hero-grid">
				<div class="pro-hero-copy">
					<p class="pro-kicker">CompatAir pour les fabricants et distributeurs</p>
					<h1>Faire d’un catalogue technique un <em>outil de décision.</em></h1>
					<p class="pro-lead">CompatAir transforme des caractéristiques dispersées en informations structurées, sourcées et directement utiles au choix. Notre rôle&nbsp;: relier l’identité exacte d’un produit, ses documents, ses performances publiées et les besoins réels du client, sans confondre donnée technique, argument commercial et calcul.</p>
					<div class="pro-actions">
						<a class="button primary" href="mailto:contact@l0g.fr?subject=Collaboration%20professionnelle%20CompatAir">Parler de votre catalogue <UiIcon name="arrow" size={17} /></a>
						<a class="pro-text-link" href="#notre-apport">Découvrir notre apport</a>
					</div>
					<ul class="pro-hero-principles" aria-label="Principes de collaboration">
						<li><UiIcon name="check" size={17} /> Chaque donnée critique reliée à une source</li>
						<li><UiIcon name="shield" size={17} /> Aucune estimation silencieuse</li>
						<li><UiIcon name="scale" size={17} /> Verdict indépendant de la relation commerciale</li>
					</ul>
				</div>

				<div class="pro-system-map" id="chaine-confiance" data-pro-value-network>
					<header><span><i></i> Chaîne de confiance</span><strong>DOCUMENT → DÉCISION</strong></header>
					<svg viewBox="0 0 620 470" role="img" aria-labelledby="pro-map-title pro-map-description">
						<title id="pro-map-title">Du document constructeur à la décision client</title>
						<desc id="pro-map-description">Les documents, références et mesures alimentent un catalogue structuré, puis un moteur de compatibilité diffusé sur les fiches produit, les API et les assistants.</desc>
						<defs>
							<linearGradient id="pro-map-line" x1="0" x2="1"><stop stop-color="#d3eb56" /><stop offset="1" stop-color="#4ca77f" /></linearGradient>
							<filter id="pro-map-glow"><feGaussianBlur stdDeviation="4" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
						</defs>
						<g class="pro-map-grid"><path d="M20 95H600M20 190H600M20 285H600M20 380H600M120 25V445M240 25V445M360 25V445M480 25V445" /></g>
						<g class="pro-map-links"><path d="M145 100C220 100 222 205 292 205" /><path d="M145 215C220 215 225 205 292 205" /><path d="M145 330C220 330 222 205 292 205" /><path d="M390 205C455 205 450 100 500 100" /><path d="M390 205C455 205 450 215 500 215" /><path d="M390 205C455 205 450 330 500 330" /></g>
						<g class="pro-map-source"><rect x="34" y="65" width="112" height="70" rx="12" /><text x="50" y="90">01 / SOURCES</text><text class="pro-map-main" x="50" y="115">Documents</text></g>
						<g class="pro-map-source"><rect x="34" y="180" width="112" height="70" rx="12" /><text x="50" y="205">02 / IDENTITÉ</text><text class="pro-map-main" x="50" y="230">MPN · GTIN · SKU</text></g>
						<g class="pro-map-source"><rect x="34" y="295" width="112" height="70" rx="12" /><text x="50" y="320">03 / MESURES</text><text class="pro-map-main" x="50" y="345">Débit · bar</text></g>
						<g class="pro-map-core" filter="url(#pro-map-glow)"><circle cx="340" cy="205" r="74" /><circle cx="340" cy="205" r="51" /><text x="340" y="188" text-anchor="middle">COMPATAIR</text><text class="pro-map-core-main" x="340" y="216" text-anchor="middle">Catalogue</text><text class="pro-map-core-main" x="340" y="238" text-anchor="middle">vérifiable</text></g>
						<g class="pro-map-output"><rect x="500" y="65" width="88" height="70" rx="12" /><text x="544" y="91" text-anchor="middle">FICHE</text><text class="pro-map-main" x="544" y="116" text-anchor="middle">Produit</text></g>
						<g class="pro-map-output"><rect x="500" y="180" width="88" height="70" rx="12" /><text x="544" y="206" text-anchor="middle">SERVICE</text><text class="pro-map-main" x="544" y="231" text-anchor="middle">API</text></g>
						<g class="pro-map-output"><rect x="500" y="295" width="88" height="70" rx="12" /><text x="544" y="321" text-anchor="middle">CONSEIL</text><text class="pro-map-main" x="544" y="346" text-anchor="middle">Client</text></g>
						<g class="pro-map-status"><circle cx="53" cy="414" r="5" /><text x="68" y="419">Source, règle et limite restent visibles</text></g>
					</svg>
					<div class="pro-system-mobile" role="img" aria-label="Les documents, identifiants et mesures alimentent un catalogue CompatAir vérifiable, puis les fiches produit, les API et le conseil client.">
						<div><span>Documents</span><span>MPN · GTIN · SKU</span><span>Débit · bar</span></div>
						<b>Structurer et relier <i aria-hidden="true">↓</i></b>
						<strong><small>COMPATAIR</small> Catalogue vérifiable</strong>
						<b>Calculer sans inventer <i aria-hidden="true">↓</i></b>
						<div><span>Fiche produit</span><span>API</span><span>Conseil client</span></div>
					</div>
				</div>
			</div>
		</section>

		<section class="pro-metrics" aria-label="État du corpus CompatAir">
			<div class="container">
				<div><strong>{formatNumber(totalProducts)}</strong><span>références documentées</span></div>
				<div><strong>{formatNumber(scope.explorable_combination_count)}</strong><span>combinaisons explorables</span></div>
				<div><strong>{formatNumber(scope.fixed_verdict_count)}</strong><span>verdicts fixes audités</span></div>
				<div><strong>{formatNumber(scope.parametric_combination_count)}</strong><span>combinaisons paramétriques, calculées après saisie</span></div>
			</div>
		</section>

		<section class="pro-section pro-data-proof" aria-labelledby="pro-data-proof-title">
			<div class="container">
				<header class="pro-section-head pro-section-head-split"><div><p class="pro-index">Périmètre public vérifiable</p><h2 id="pro-data-proof-title">{formatNumber(scope.explorable_combination_count)} possibilités, dont {formatNumber(scope.fixed_verdict_count)} verdicts fixes.</h2></div><p>Les {scope.parametric_tool_count} outils restants ne reçoivent pas un verdict pré-calculé&nbsp;: leurs {formatNumber(scope.parametric_combination_count)} combinaisons exigent une cadence ou un volume et un temps cible. Le snapshot fixe est conclusif à {verdictSnapshot.conclusive.percentage.toLocaleString('fr-FR')}&nbsp;%.</p></header>
				<div class="pro-data-ledger">
					<article><span>Compatible en continu</span><strong>{formatNumber(verdictSnapshot.summary.continuous)}</strong></article>
					<article><span>Incompatible</span><strong>{formatNumber(verdictSnapshot.summary.incompatible)}</strong><small>Valeur de filtrage du corpus, pas mauvaise performance du moteur.</small></article>
					<article><span>Données insuffisantes</span><strong>{formatNumber(verdictSnapshot.summary.insufficient_data)}</strong></article>
				</div>
				<div class="pro-identity-coverage"><header><div><p class="pro-index">Identifiants marchands</p><h3>Couverture réellement publiée</h3></div><p>Le MPN est normalisé pour l’appariement exact. EAN, GTIN et SKU distributeur ne sont ajoutés qu’avec leur preuve.</p></header><div>{identityCoverage.map((row) => <article><span>{row.label}</span><strong>{row.populated_count}/{row.eligible_count}</strong><small>{row.population_coverage_percent?.toLocaleString('fr-FR') ?? 'non mesuré'} % du corpus · {row.independently_corroborated_count} corroboré{row.independently_corroborated_count > 1 ? 's' : ''} indépendamment</small></article>)}</div></div>
				<p class="pro-data-proof-links"><a href="/sources-fiabilite/#couverture">Couverture complète champ par champ</a><a href="/sources-fiabilite/#sla-fraicheur">SLA de fraîcheur par type de donnée</a><a href="/data/catalog.json">Snapshot catalogue JSON</a><a href="/data/verdicts.json">Snapshot de verdicts JSON</a></p>
			</div>
		</section>

		<section class="pro-section pro-intro" id="notre-apport">
			<div class="container pro-intro-grid">
				<header class="pro-section-head">
					<p class="pro-index">01 / Le problème que nous résolvons</p>
					<h2>Un bon catalogue ne contient pas seulement plus de données. Il permet de comprendre <em>ce qu’elles autorisent.</em></h2>
				</header>
				<div class="pro-intro-copy">
					<p>Une référence, un débit, une pression ou une capacité de cuve n’aident réellement le client que si le modèle est identifié sans ambiguïté, si la nature de la mesure est claire et si la valeur peut être rattachée au bon document. Or les informations utiles vivent souvent dans plusieurs fiches, notices, tableaux ou marchés, avec des unités et des niveaux de précision différents.</p>
					<p>CompatAir construit la couche qui manque entre la documentation et le choix&nbsp;: un référentiel technique où chaque produit, champ critique, source et règle de calcul restent reliés. Le catalogue devient alors exploitable par un conseiller, une fiche e-commerce, un outil de comparaison ou un assistant, sans perdre le contexte qui rend la réponse défendable.</p>
				</div>
				<div class="pro-friction-list">
					<article><span>01</span><h3>Identités ambiguës</h3><p>Variantes proches, noms commerciaux réutilisés, MPN ou EAN absents compliquent le rattachement à la bonne fiche.</p></article>
					<article><span>02</span><h3>Mesures non comparables</h3><p>Débit aspiré, débit restitué, pression de mesure et consommation d’outil ne décrivent pas la même réalité.</p></article>
					<article><span>03</span><h3>Silences documentaires</h3><p>Une valeur manquante ou contradictoire doit rester visible au lieu d’être remplacée par une moyenne ou une hypothèse cachée.</p></article>
					<article><span>04</span><h3>Conseil déconnecté</h3><p>Sans relation entre produit, besoin et preuve, la fiche informe mais n’aide pas à décider.</p></article>
				</div>
			</div>
		</section>

		<section class="pro-section pro-audiences" id="fabricants-distributeurs">
			<div class="container">
				<header class="pro-section-head pro-section-head-split">
					<div><p class="pro-index">02 / Deux métiers, un même enjeu</p><h2>Rendre la promesse technique lisible jusqu’au client final.</h2></div>
					<p>Fabricant et distributeur n’ont pas le même rôle. CompatAir organise leur information autour d’un langage commun, sans effacer l’origine de la donnée ni la responsabilité de chacun.</p>
				</header>
				<div class="pro-audience-grid">
					<article class="pro-audience-card manufacturer">
						<header><span><UiIcon name="gauge" size={25} /></span><p>Pour les fabricants</p><strong>Rendre la performance publiée exploitable</strong></header>
						<ul>
							<li>Relier chaque variante à son identité exacte, à sa source primaire et, lorsqu’elle existe, à une corroboration indépendante.</li>
							<li>Présenter les caractéristiques qui changent réellement le dimensionnement&nbsp;: débit restitué, pression, cycle de service et limites.</li>
							<li>Repérer les champs absents, les contradictions entre documents et les mélanges possibles entre marchés ou versions.</li>
							<li>Rendre une mise à jour traçable et identifier les décisions qui devront être recalculées.</li>
						</ul>
						<a href="/barometre-transparence/">Voir comment nous mesurons la transparence documentaire <UiIcon name="arrow" size={15} /></a>
					</article>
					<article class="pro-audience-card distributor">
						<header><span><UiIcon name="database" size={25} /></span><p>Pour les distributeurs</p><strong>Passer de la fiche produit à l’orientation</strong></header>
						<ul>
							<li>Rattacher les offres à la référence technique exacte grâce au MPN normalisé, à l’EAN/GTIN et au SKU distributeur sourcé.</li>
							<li>Ajouter à la fiche un verdict compréhensible, sa raison et les données qui le soutiennent.</li>
							<li>Distinguer clairement le prix et la disponibilité des caractéristiques qui déterminent la compatibilité.</li>
							<li>Diffuser la même logique dans le site, les outils internes, l’API ou les parcours agentiques.</li>
						</ul>
						<a href="/affiliation/">Comprendre la séparation entre offre et verdict <UiIcon name="arrow" size={15} /></a>
					</article>
				</div>
			</div>
		</section>

		<section class="pro-section pro-process" id="methode">
			<div class="container">
				<header class="pro-section-head pro-section-head-split">
					<div><p class="pro-index">03 / Notre méthode</p><h2>Du corpus documentaire à une réponse vérifiable.</h2></div>
					<p>Le traitement reste déterministe&nbsp;: une même configuration et une même version des données produisent le même résultat. Une lacune importante produit «&nbsp;données insuffisantes&nbsp;», jamais un chiffre inventé.</p>
				</header>
				<ol class="pro-process-track">
					<li><span>01</span><div><h3>Cadrer le portefeuille</h3><p>Marques, familles, variantes, marchés, identifiants et documents à couvrir sont définis avant l’intégration.</p></div></li>
					<li><span>02</span><div><h3>Cartographier les preuves</h3><p>Chaque donnée critique est reliée à sa source, sa date de consultation et son niveau de qualité.</p></div></li>
					<li><span>03</span><div><h3>Structurer sans extrapoler</h3><p>Unités, dénominations et champs sont harmonisés. Les absences et contradictions restent explicites.</p></div></li>
					<li><span>04</span><div><h3>Appliquer les règles</h3><p>Le besoin de l’outil est comparé au débit disponible à la pression demandée, avec méthode et limites publiées.</p></div></li>
					<li><span>05</span><div><h3>Publier et maintenir</h3><p>Widget, API, exports et registres utilisent le même noyau. Les corrections restent datées et consultables.</p></div></li>
				</ol>
				<div class="pro-process-links"><a href="/methodologie/">Lire la méthode de calcul</a><a href="/sources-fiabilite/">Examiner les niveaux de source</a><a href="/preuves/">Parcourir l’historique des preuves</a></div>
			</div>
		</section>

		<section class="pro-section pro-blueprint" id="architecture">
			<div class="container pro-blueprint-grid">
				<div class="pro-blueprint-copy">
					<p class="pro-index">04 / Une infrastructure, plusieurs usages</p>
					<h2>Un même référentiel technique pour tous les points de contact.</h2>
					<p>CompatAir ne produit pas une réponse différente pour le catalogue, le vendeur et l’assistant. Les mêmes identifiants, sources, versions et règles alimentent chaque canal. Cela limite la dérive entre une fiche mise à jour, un export ancien et un conseil donné ailleurs.</p>
					<ul>
						<li><UiIcon name="check" size={18} /><span><strong>Référentiel structuré&nbsp;:</strong> produits, variantes, champs et sources reliés.</span></li>
						<li><UiIcon name="check" size={18} /><span><strong>Moteur déterministe&nbsp;:</strong> verdict, besoin, débit disponible, marge et limites.</span></li>
						<li><UiIcon name="check" size={18} /><span><strong>Contrats publics&nbsp;:</strong> API, widget et formats machine documentés.</span></li>
						<li><UiIcon name="check" size={18} /><span><strong>Cycle de correction&nbsp;:</strong> historique, changement et impact conservés.</span></li>
					</ul>
				</div>
				<div class="pro-stack" aria-label="Architecture des services CompatAir">
					<div class="pro-stack-channels"><span>Fiche produit</span><span>Conseiller</span><span>API</span><span>Agent IA</span></div>
					<div class="pro-stack-layer decision"><small>COUCHE DE DÉCISION</small><strong>Compatibilité + explication + limites</strong><i></i></div>
					<div class="pro-stack-layer engine"><small>MOTEUR VERSIONNÉ</small><strong>Pression · débit · usage · marge</strong><i></i></div>
					<div class="pro-stack-layer data"><small>CATALOGUE DE PREUVE</small><strong>Identités · champs · sources · dates</strong><i></i></div>
					<footer><span>Fabricant</span><b>Documentation vérifiée</b><span>Distributeur</span></footer>
				</div>
			</div>
		</section>

		<section class="pro-section pro-outcomes" id="livrables">
			<div class="container">
				<header class="pro-section-head"><p class="pro-index">05 / Ce que la collaboration produit</p><h2>Des livrables utiles au catalogue, et une meilleure réponse pour l’acheteur.</h2></header>
				<div class="pro-outcome-grid">
					<article><span><UiIcon name="database" size={24} /></span><h3>Audit de couverture</h3><p>État des identifiants, sources, données indispensables, contradictions et niveaux de précision sur le périmètre convenu.</p></article>
					<article><span><UiIcon name="book" size={24} /></span><h3>Catalogue enrichi</h3><p>Fiches structurées où les caractéristiques critiques restent reliées aux documents qui les publient.</p></article>
					<article><span><UiIcon name="calculator" size={24} /></span><h3>Décisions intégrables</h3><p>Verdicts reproductibles pour une configuration précise, avec valeurs utilisées, règles et réserves.</p></article>
					<article><span><UiIcon name="compass" size={24} /></span><h3>Parcours d’orientation</h3><p>Réponses lisibles sur une fiche, dans un comparateur ou au sein d’un outil d’aide à la vente.</p></article>
					<article><span><UiIcon name="shield" size={24} /></span><h3>Suivi des corrections</h3><p>Évolution datée des données et identification des résultats qui dépendent d’une information modifiée.</p></article>
					<article><span><UiIcon name="scale" size={24} /></span><h3>Cadre de confiance</h3><p>Séparation explicite des données techniques, des offres commerciales et du verdict de compatibilité.</p></article>
				</div>
				<div class="pro-customer-result">
					<header><p class="pro-index">Côté client final</p><h3>Une réponse courte, mais vérifiable.</h3></header>
					<div><span>01</span><p><strong>Le produit exact</strong> est reconnu grâce à sa référence, pas seulement à un nom ressemblant.</p></div>
					<div><span>02</span><p><strong>Le verdict est expliqué</strong> par le besoin, la pression et le débit disponible.</p></div>
					<div><span>03</span><p><strong>La qualité de la réponse est visible</strong> avec ses sources, ses dates et ses limites.</p></div>
				</div>
			</div>
		</section>

		<section class="pro-section pro-demo" id="demonstration">
			<div class="container">
				<header class="pro-section-head pro-section-head-split">
					<div><p class="pro-index">06 / Voir la réponse en situation</p><h2>Un module directement sur la fiche produit.</h2></div>
					<p>Cette démonstration interroge le même service que l’intégration finale. Si le service est indisponible ou si les données ne suffisent pas, elle expose la limite au lieu de fabriquer une réponse.</p>
				</header>
				<div class="pro-demo-grid">
					<article class="pro-widget-card">
						<header><span><i></i> Démonstration en direct</span><strong>COMPRESSEUR × OUTIL</strong></header>
						<div id="merchant-widget-demo" class="widget-demo-live"></div>
						<script is:inline src="/widget/v1.1.0/compatair-widget.js" integrity="sha384-RNDfsRN7I47L6J+UJ+DY9tbkGqq4RaPm8qHCBoL74Qw3tEg7nv+ccAwYR8Vy9Yx7" crossorigin="anonymous" data-target="merchant-widget-demo" data-compressor-id="einhell-tc-ac-240-50-10-of" data-tool-id="einhell-tc-pe-150" defer></script>
					</article>
					<article class="pro-integration-card">
						<p class="pro-index">Intégration progressive</p>
						<h3>Commencer par le bon niveau.</h3>
						<ol><li><span>01</span><div><strong>Widget</strong><p>Ajouter une réponse visible sur une fiche avec peu de JavaScript.</p></div></li><li><span>02</span><div><strong>API</strong><p>Composer l’expérience dans votre propre interface et conserver les champs de preuve.</p></div></li><li><span>03</span><div><strong>Exports et suivi</strong><p>Synchroniser un périmètre de références et suivre les données qui évoluent.</p></div></li></ol>
						<div class="pro-integration-actions"><a class="button primary" href="/api/">Documentation API</a><a class="button" href="/mcp-documentation/">Accès pour agents</a></div>
					</article>
				</div>
			</div>
		</section>

		<section class="pro-section pro-boundary" id="independance">
			<div class="container pro-boundary-grid">
				<header><p class="pro-index">07 / Une coopération sans confusion des rôles</p><h2>Le partenaire améliore la donnée. Il ne choisit pas le verdict.</h2><p>Notre indépendance ne s’oppose pas à la collaboration&nbsp;: elle en fixe les règles pour que l’information reste crédible auprès du client final.</p></header>
				<div class="pro-role-columns">
					<section><span>Le partenaire apporte</span><ul><li>les identifiants et documents officiels&nbsp;;</li><li>la connaissance des variantes et marchés&nbsp;;</li><li>les mises à jour et corrections documentées&nbsp;;</li><li>le contexte d’intégration et les besoins de diffusion.</li></ul></section>
					<section><span>CompatAir conserve</span><ul><li>la structure du référentiel et les règles de calcul&nbsp;;</li><li>l’évaluation de la qualité et de la suffisance des sources&nbsp;;</li><li>le traitement public des contradictions et limites&nbsp;;</li><li>l’indépendance du verdict et de son classement technique.</li></ul></section>
				</div>
				<footer><UiIcon name="scale" size={22} /><p>Une rémunération peut financer l’intégration, le suivi, le support ou un niveau de service convenu. Elle n’achète jamais une valeur technique, un résultat favorable ou une place dans le classement.</p></footer>
			</div>
		</section>

		<section class="pro-section pro-collaboration" id="collaboration" data-pro-collaboration>
			<div class="container">
				<header class="pro-section-head pro-section-head-split"><div><p class="pro-index">08 / Travailler ensemble</p><h2>Partir d’un périmètre concret, puis industrialiser ce qui est prouvé.</h2></div><p>Une collaboration peut porter sur une gamme, un catalogue distributeur ou un canal précis. Le niveau de service, les volumes, les délais et les responsabilités sont définis dans le cadre convenu.</p></header>
				<div class="pro-collaboration-grid">
					<article><span>01</span><h3>Référencement documentaire</h3><p>Structurer une gamme, rattacher ses documents et rendre visibles les données manquantes avant toute promesse d’intégration.</p></article>
					<article><span>02</span><h3>Intégration catalogue</h3><p>Relier les références du partenaire au widget, à l’API ou à des exports adaptés à son parcours client.</p></article>
