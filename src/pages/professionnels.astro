---
import BaseLayout from '../layouts/BaseLayout.astro';
import UiIcon from '../components/UiIcon.astro';
import { CATALOG_VERIFIED_AT, compressors, tools } from '../data/catalog';
import { toolTaxonomy } from '../data/taxonomy';
import { createCatalogSnapshot } from '../domain/snapshots';
import { historicalVerdictAudit as verdictSnapshot, verdictPublication } from '../data/verdict-publication';

const totalProducts = compressors.length + tools.length;
const formatNumber = (value: number) => new Intl.NumberFormat('fr-FR').format(value);
const catalogSnapshot = createCatalogSnapshot({ compressors, tools, toolTaxonomy, verifiedAt: CATALOG_VERIFIED_AT });
const scope = catalogSnapshot.scope;
const identityCoverage = catalogSnapshot.quality.field_coverage.filter((row) => ['normalizedMpn', 'ean', 'gtin', 'distributorSku'].includes(row.field));
---

<BaseLayout
	title="Fabricants et distributeurs | CompatAir"
	description="Documenter vos références de compresseurs et d’outils, corriger leurs caractéristiques et intégrer les vérifications de compatibilité à votre catalogue."
	canonicalPath="/professionnels/"
	imageAlt="Catalogue et services CompatAir pour les fabricants et distributeurs"
	breadcrumbs={[{ name: 'Fabricants et distributeurs', path: '/professionnels/' }]}
>
	<div class="pro-page">
		<section class="pro-hero" data-professional-page>
			<div class="container">
				<p class="pro-kicker">Fabricants et distributeurs</p>
				<h1>Documenter et intégrer votre catalogue</h1>
				<p class="pro-lead">Ajoutez vos références, corrigez leurs caractéristiques ou intégrez la vérification de compatibilité à vos fiches produit.</p>
				<div class="pro-actions">
					<a class="button primary" href="mailto:contact@l0g.fr?subject=Collaboration%20professionnelle%20CompatAir">Nous contacter <UiIcon name="arrow" size={17} /></a>
					<a class="button" href="#demonstration">Voir le widget</a>
					<a class="pro-text-link" href="#dimensionnement-atelier">Équiper un atelier</a>
				</div>
			</div>
		</section>

		<section class="pro-section pro-audiences" id="fabricants-distributeurs" aria-label="Services pour votre catalogue">
			<div class="container pro-audience-grid" id="notre-apport">
				<article class="pro-card">
					<h2>Fabricants</h2>
					<ul>
						<li>Rattacher chaque modèle à sa notice et à ses identifiants.</li>
						<li>Documenter débit restitué, pression et cycle de fonctionnement.</li>
						<li>Signaler les corrections et les différences entre variantes.</li>
					</ul>
					<a href="/barometre-transparence/">Voir la couverture des marques <UiIcon name="arrow" size={15} /></a>
				</article>
				<article class="pro-card">
					<h2>Distributeurs</h2>
					<ul>
						<li>Relier vos offres aux références techniques du catalogue.</li>
						<li>Afficher un verdict de compatibilité et ses explications.</li>
						<li>Accéder aux produits et aux calculs par le widget ou l’API.</li>
					</ul>
					<a href="/api/">Consulter la documentation API <UiIcon name="arrow" size={15} /></a>
				</article>
			</div>
		</section>

		<section class="pro-section pro-demo" id="demonstration">
			<div class="container">
				<header class="pro-section-head"><h2>Tester le widget</h2><p>Exemple pour l’Einhell TC-AC 240/50/10 OF et la ponceuse TC-PE 150.</p></header>
				<div class="pro-demo-grid">
					<div class="pro-widget-card">
						<div id="merchant-widget-demo" class="widget-demo-live"></div>
						<script is:inline src="/widget/v1.1.0/compatair-widget.js" integrity="sha384-RNDfsRN7I47L6J+UJ+DY9tbkGqq4RaPm8qHCBoL74Qw3tEg7nv+ccAwYR8Vy9Yx7" crossorigin="anonymous" data-target="merchant-widget-demo" data-compressor-id="einhell-tc-ac-240-50-10-of" data-tool-id="einhell-tc-pe-150" defer></script>
					</div>
					<div class="pro-integration" id="architecture">
						<h3>Choisir une intégration</h3>
						<ul class="pro-doc-links">
							<li><a href="/api/">Widget et API</a><span>Produits, calculs et exemples d’intégration.</span></li>
							<li><a href="/mcp-documentation/">Serveur MCP</a><span>Accès depuis un assistant compatible.</span></li>
							<li><a href="/data/catalog.json">Catalogue JSON</a><span>Export des références et de leurs sources.</span></li>
						</ul>
						<p class="pro-note" id="methode">Le calcul utilise la pression, le débit et l’usage demandés. Une donnée critique manquante produit «&nbsp;données insuffisantes&nbsp;». <a href="/methodologie/">Méthode de calcul</a></p>
					</div>
				</div>
			</div>
		</section>

		<section class="pro-section pro-data-proof" aria-labelledby="pro-data-proof-title">
			<div class="container">
				<h2 id="pro-data-proof-title">Le catalogue actuel</h2>
				<dl class="pro-metrics" aria-label="Références du catalogue">
					<div><dt>Compresseurs</dt><dd>{formatNumber(compressors.length)}</dd></div>
					<div><dt>Outils</dt><dd>{formatNumber(tools.length)}</dd></div>
				</dl>
				<details class="pro-data-details">
					<summary>Périmètre des calculs et couverture documentaire</summary>
					<div class="pro-data-detail-body">
						<p>Les {formatNumber(totalProducts)} références forment {formatNumber(scope.explorable_combination_count)} combinaisons explorables.</p>
						<dl class="pro-scope-grid">
							<div><dt>Couples à débit fixe calculables</dt><dd>{formatNumber(scope.fixed_verdict_count)}</dd></div>
							<div><dt>Combinaisons paramétriques</dt><dd>{formatNumber(scope.parametric_combination_count)}</dd></div>
						</dl>
						<p>Pour les {formatNumber(scope.parametric_tool_count)} outils hors débit fixe, le calcul dépend de paramètres d’usage à saisir ou de données constructeur à compléter.</p>
						<p>L’audit historique du {verdictSnapshot.publishedAt.slice(0, 10)} portait sur {formatNumber(verdictSnapshot.scope.fixed_verdict_count)} couples. Il était conclusif à {verdictSnapshot.conclusive.percentage.toLocaleString('fr-FR')}&nbsp;%. Ses résultats concernent ce périmètre daté&nbsp;: {formatNumber(verdictSnapshot.summary.continuous)} compatibles en continu, {formatNumber(verdictSnapshot.summary.incompatible)} incompatibles et {formatNumber(verdictSnapshot.summary.insufficient_data)} avec données insuffisantes.</p>
						<h3>Identifiants documentés</h3>
						<ul class="pro-identity-coverage">
							{identityCoverage.map((row) => <li><strong>{row.label}</strong><span>{formatNumber(row.populated_count)} sur {formatNumber(row.eligible_count)} références éligibles, dont {formatNumber(row.independently_corroborated_count)} corroboré{row.independently_corroborated_count > 1 ? 's' : ''} indépendamment.</span></li>)}
						</ul>
						<div class="pro-data-links"><a href="/sources-fiabilite/#couverture">Couverture par champ</a><a href="/sources-fiabilite/#sla-fraicheur">Fraîcheur des données</a><a href={verdictPublication.legacyArchive.verdicts}>Audit historique signé</a><a href="/preuves/">Historique des corrections</a></div>
					</div>
				</details>
			</div>
		</section>

		<section class="pro-section pro-contact" id="collaboration" data-pro-collaboration>
			<div class="container pro-contact-grid">
				<div>
					<h2>Proposer votre catalogue</h2>
					<p>Envoyez les références concernées, leurs documents techniques et le type d’intégration souhaité.</p>
					<a class="button primary" href="mailto:contact@l0g.fr?subject=Collaboration%20professionnelle%20CompatAir">Contacter CompatAir <UiIcon name="arrow" size={17} /></a>
					<p class="pro-note" id="independance" data-pro-independence>Les verdicts techniques restent indépendants de toute rémunération. Une prestation peut couvrir l’intégration, la maintenance ou le support. <a href="/affiliation/">Conditions commerciales</a></p>
				</div>
				<div id="dimensionnement-atelier">
					<h2>Équiper un atelier</h2>
					<p>Précisez les outils, les utilisations simultanées, les pressions, les cadences, l’alimentation électrique et les contraintes de bruit ou de place.</p>
					<a class="button" href="mailto:contact@l0g.fr?subject=CompatAir%20-%20besoin%20atelier&amp;body=Outils%20et%20r%C3%A9f%C3%A9rences%20%3A%0AUtilisations%20simultan%C3%A9es%20%3A%0APressions%20et%20cadences%20%3A%0AAlimentation%20disponible%20%3A%0AContraintes%20de%20bruit%20et%20place%20%3A%0A">Décrire mon besoin d’atelier</a>
					<p class="pro-note">Votre demande arrive par courriel chez CompatAir. Un transfert à un vendeur nécessite votre accord. L’envoi ne garantit ni devis ni disponibilité.</p>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.pro-page { --pro-ink: #102a20; --pro-muted: #4e655a; --pro-line: rgba(16,42,32,.18); color: var(--pro-ink); background: #f7f5ee; }
	.pro-page :is(h1, h2, h3, p, li, a, dt, dd) { overflow-wrap: anywhere; }
	.pro-page :is(h2, h3) { margin-top: 0; }
	.pro-page p { color: var(--pro-muted); }
	.pro-hero { padding: clamp(2rem, 5vw, 4rem) 0; }
	.pro-kicker { margin: 0 0 .7rem; color: var(--brand); font-size: .75rem; font-weight: 800; }
	.pro-hero h1 { max-width: 850px; font-size: clamp(2.2rem, 4.5vw, 3.8rem); line-height: 1.05; }
	.pro-lead { max-width: 720px; margin: 1.1rem 0 0; font-size: 1.05rem; line-height: 1.6; }
	.pro-actions { display: flex; flex-wrap: wrap; gap: .8rem 1.2rem; align-items: center; margin-top: 1.5rem; }
	.pro-text-link { color: var(--brand-dark); font-size: .9rem; font-weight: 750; text-underline-offset: .2em; }
	.pro-section { padding-block: clamp(2rem, 4vw, 3.5rem); }
	.pro-page [id] { scroll-margin-top: calc(var(--sticky-header-height) + 1rem); }
	.pro-section h2 { margin-bottom: 1rem; font-size: clamp(1.7rem, 2.6vw, 2.35rem); }
	.pro-section-head { margin-bottom: 1.5rem; }
	.pro-section-head p { margin: 0; }
	.pro-audiences { padding-top: 0; }
	.pro-audience-grid, .pro-demo-grid, .pro-contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2rem); }
	.pro-audience-grid > *, .pro-demo-grid > *, .pro-contact-grid > * { min-width: 0; }
	.pro-card { padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--pro-line); background: #fdfcf8; }
	.pro-card ul { display: grid; gap: .7rem; margin: 0 0 1.3rem; padding-left: 1.2rem; color: var(--pro-muted); }
	.pro-card > a { display: inline-flex; gap: .45rem; align-items: center; color: var(--brand-dark); font-size: .86rem; font-weight: 750; text-underline-offset: .2em; }
	.pro-demo { border-block: 1px solid var(--pro-line); background: #eaf0e7; }
	.pro-widget-card { min-width: 0; padding: 1rem; border: 1px solid var(--pro-line); background: white; }
	.pro-integration h3 { margin-bottom: 1rem; font-size: 1.35rem; }
	.pro-doc-links { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
	.pro-doc-links li { display: grid; gap: .2rem; }
	.pro-doc-links a { color: var(--brand-dark); font-weight: 750; text-underline-offset: .2em; }
	.pro-doc-links span { color: var(--pro-muted); font-size: .9rem; }
	.pro-note { margin: 1.2rem 0 0; font-size: .85rem; line-height: 1.6; }
	.pro-note a { color: var(--brand-dark); }
	.pro-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0 0 1.25rem; border: 1px solid var(--pro-line); color: white; background: #102a20; }
	.pro-metrics > div { display: flex; min-width: 0; gap: .8rem; align-items: baseline; justify-content: space-between; flex-wrap: wrap; padding: clamp(1rem, 2.5vw, 1.5rem); }
	.pro-metrics > div + div { border-left: 1px solid rgba(255,255,255,.18); }
	.pro-metrics dt { color: #d1ddd5; font-size: .9rem; }
	.pro-metrics dd { margin: 0; color: var(--accent); font: 550 clamp(1.65rem, 3vw, 2.4rem)/1.15 'Newsreader Variable', serif; font-variant-numeric: tabular-nums; }
	.pro-data-details { border: 1px solid var(--pro-line); background: #fdfcf8; }
	.pro-data-details summary { padding: 1rem 1.2rem; color: var(--brand-dark); font-weight: 750; cursor: pointer; overflow-wrap: anywhere; }
	.pro-data-detail-body { padding: 0 1.2rem 1.2rem; }
	.pro-data-detail-body > p { font-size: .9rem; }
	.pro-scope-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.pro-scope-grid > div { min-width: 0; padding: 1rem; border: 1px solid var(--pro-line); }
	.pro-scope-grid dt { margin-bottom: .5rem; font-size: .85rem; }
	.pro-scope-grid dd { margin: 0; font-size: clamp(1.1rem, 2vw, 1.5rem); font-weight: 750; font-variant-numeric: tabular-nums; }
	.pro-data-detail-body h3 { margin-top: 1.5rem; font-size: 1.15rem; }
	.pro-identity-coverage { display: grid; gap: .65rem; padding: 0; list-style: none; }
	.pro-identity-coverage li { display: grid; grid-template-columns: minmax(0, .5fr) minmax(0, 1fr); gap: .5rem 1rem; font-size: .85rem; }
	.pro-identity-coverage span { color: var(--pro-muted); }
	.pro-data-links { display: flex; flex-wrap: wrap; gap: .65rem 1.2rem; margin-top: 1.5rem; font-size: .85rem; }
	.pro-data-links a { color: var(--brand-dark); text-underline-offset: .2em; }
	.pro-contact { border-top: 1px solid var(--pro-line); }
	.pro-contact-grid > div { padding-right: 1rem; }
	.pro-contact-grid p:not(.pro-note) { margin: 0 0 1.25rem; }
	.pro-contact-grid .button { max-width: 100%; }
	@media (max-width: 720px) {
		.pro-audience-grid, .pro-demo-grid, .pro-contact-grid { grid-template-columns: minmax(0, 1fr); }
		.pro-contact-grid { gap: 2rem; }
		.pro-contact-grid > div { padding-right: 0; }
		.pro-metrics > div { flex-direction: column; gap: .4rem; }
		.pro-scope-grid { grid-template-columns: minmax(0, 1fr); }
		.pro-identity-coverage li { grid-template-columns: minmax(0, 1fr); gap: .1rem; }
	}
	@media (max-width: 380px) {
		.pro-actions .button { width: 100%; }
		.pro-metrics { grid-template-columns: minmax(0, 1fr); }
		.pro-metrics > div { flex-direction: row; }
		.pro-metrics > div + div { border-top: 1px solid rgba(255,255,255,.18); border-left: 0; }
	}
</style>
