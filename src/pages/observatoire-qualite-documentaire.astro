---
import BaseLayout from '../layouts/BaseLayout.astro';
import { documentQualityObservatory as observatory } from '../data/document-quality-observatory';
import { compressors, tools } from '../data/catalog';
import { compressorDisplayName } from '../domain/product-display';
import { serializeJsonLd } from '../domain/structured-data';

const formatDate = (date: string) => new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
const correction = observatory.metrics.correctionLeadTime;
const fad = observatory.metrics.multiPressureFad;
const references = observatory.metrics.referenceStability;
const contradictions = observatory.metrics.contradictionResponses;
const program = observatory.measurementProgram;
const productsById = new Map([...compressors, ...tools].map((product) => [product.id, product]));
const datasetJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Dataset',
	name: 'Observatoire de la qualité documentaire CompatAir',
	description: observatory.scope,
	url: 'https://compatair.fr/observatoire-qualite-documentaire/',
	dateModified: observatory.publishedAt,
	version: observatory.observatoryVersion,
	inLanguage: 'fr-FR',
	isAccessibleForFree: true,
	creator: { '@type': 'Organization', '@id': 'https://compatair.fr/#organization', name: 'CompatAir', url: 'https://compatair.fr/' },
	distribution: [
		{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://compatair.fr/data/document-quality-observatory.json' },
		{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://compatair.fr/data/document-quality-observatory.csv' },
	],
};
---
<BaseLayout title="Observatoire qualité documentaire | CompatAir" description="Délais de correction, disponibilité du FAD multi-pression, stabilité des références et traitement public des contradictions dans le catalogue CompatAir." breadcrumbs={[{ name: 'Observatoire de la qualité documentaire', path: '/observatoire-qualite-documentaire/' }]}>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(datasetJsonLd)} />
	<section class="page-hero observatory-hero"><div class="container observatory-hero-grid">
		<div><p class="eyebrow">Mesurer notre propre documentation</p><h1>La qualité d’un catalogue se mesure dans le temps</h1><p class="lead">Quatre indicateurs suivent ce qui rend un catalogue technique vérifiable&nbsp;: corriger avec une date mesurable, disposer de plusieurs points FAD, conserver l’identité exacte des références et répondre publiquement aux contradictions.</p><div class="hero-actions"><a class="button primary" href="#indicateurs">Lire les indicateurs</a><a class="button secondary" href="/data/document-quality-observatory.json">Télécharger les données</a></div><p class="observatory-edition">Édition du {formatDate(observatory.publishedAt)} · corpus de {compressors.length + tools.length} produits · <a href="/data/document-quality-observatory.csv">export CSV</a></p></div>
		<div class="observatory-instrument" data-observatory-visual aria-label="Les quatre contrôles de la qualité documentaire"><header><span><i></i> Observatoire CompatAir</span><strong>ÉDITION {observatory.publishedAt}</strong></header><div class="observatory-instrument-core"><div><span>01</span><strong>Corriger</strong><small>avec une date mesurable</small></div><div><span>02</span><strong>Documenter</strong><small>le FAD à plusieurs pressions</small></div><div><span>03</span><strong>Identifier</strong><small>chaque référence exacte</small></div><div><span>04</span><strong>Arbitrer</strong><small>les contradictions publiquement</small></div></div><footer><span>Mesurer</span><b>→</b><span>Publier</span><b>→</b><span>Vérifier</span></footer></div>
	</div></section>

	<section class="observatory-answer" data-observatory-answer><div class="container"><div><span>{correction.medianDays === null ? 'Donnée encore insuffisante' : `${correction.medianDays} jours`}</span><small>Délai médian de correction</small></div><div><span>{fad.percentage} %</span><small>FAD multi-pression</small></div><div><span>{references.changeCount}</span><small>Mutation de référence observée</small></div><div><span>{contradictions.responseRate} %</span><small>Contradictions traitées</small></div></div></section>

	<section class="section observatory-overview" id="indicateurs"><div class="container">
		<div class="split-head observatory-answer-head"><div><p class="eyebrow">Lecture immédiate</p><h2>Quatre mesures, sans note globale artificielle</h2></div><p>Chaque résultat expose son dénominateur et sa limite. Une absence de données reste affichée comme telle.</p></div>
		<div class="observatory-metrics">
			<article class:list={['observatory-metric', correction.status === 'insufficient_data' && 'is-insufficient']}><p>01 · Délai de correction</p><strong>{correction.medianDays === null ? 'Non mesurable' : `${correction.medianDays} j`}</strong><span>{correction.measuredCount} correction avec ouverture datée · {correction.excludedLegacyCount} correction{correction.excludedLegacyCount > 1 ? 's' : ''} historique{correction.excludedLegacyCount > 1 ? 's' : ''} exclue{correction.excludedLegacyCount > 1 ? 's' : ''}</span></article>
			<article class="observatory-metric"><p>02 · FAD multi-pression</p><strong>{fad.percentage} %</strong><span>{fad.availableCount} compresseurs sur {fad.eligibleCount} avec au moins deux points documentés</span></article>
			<article class="observatory-metric"><p>03 · Stabilité des références</p><strong>{references.changeCount} mutation</strong><span>{references.monitoredCount} MPN sous surveillance depuis le {formatDate(references.observationStartedAt)}</span></article>
			<article class="observatory-metric"><p>04 · Contradictions traitées</p><strong>{contradictions.responseRate} %</strong><span>{contradictions.answeredCount} réponses publiées sur {contradictions.totalCount} contradictions recensées</span></article>
		</div>
		<div class="observatory-warning"><strong>Une ligne de base n’est pas encore une tendance</strong><p>Le suivi des MPN commence le {formatDate(references.observationStartedAt)}. Zéro mutation signifie qu’aucun changement n’est observé depuis cette date, pas que les références n’ont jamais changé auparavant. De même, le délai historique reste non mesurable tant que la date d’ouverture n’a pas été conservée.</p></div>
		<div class="observatory-definitions" data-observatory-program>
			<article><span>A</span><h3>Ligne de base</h3><p>Snapshot immuable de {program.baseline.period}, capturé le {formatDate(program.baseline.capturedAt)}. Il conserve les dénominateurs et résultats publiés au démarrage du suivi.</p></article>
			<article><span>B</span><h3>Tendance</h3><p>{program.trend.status === 'insufficient_data' ? `Tendance insuffisante : ${program.trend.periodCount} seule période publiée. Un deuxième snapshot mensuel est nécessaire.` : `Variation mesurée de ${program.trend.fromPeriod} à ${program.trend.toPeriod}.`}</p></article>
			<article><span>C</span><h3>Objectifs internes</h3><p>Lignes de base MPN {program.targets.referenceBaselineCoverage.targetPercent} % et réponses aux contradictions {program.targets.contradictionResponses.targetPercent} %. Les objectifs chiffrés de FAD et de délai attendent respectivement {program.targets.multiPressureFad.minimumPeriodCount} périodes et {program.targets.correctionLeadTime.minimumMeasuredCount} corrections mesurables.</p></article>
		</div>
	</div></section>

	<section class="section observatory-detail"><div class="container">
		<div class="split-head"><div><p class="eyebrow">Règles de calcul</p><h2>Ce que chaque indicateur prouve, et ce qu’il ne prouve pas</h2></div><p>Chaque chiffre expose son dénominateur. Les métriques portent sur le corpus CompatAir, pas sur l’ensemble du marché.</p></div>
		<div class="observatory-definitions">
			<article><span>01</span><h3>Délai de correction</h3><p>{correction.definition}</p><p>Les {correction.excludedLegacyCount} corrections antérieures au registre restent visibles dans le <a href="/corrections/">journal public</a>, mais aucune date d’ouverture ne leur est attribuée rétroactivement. Aucun délai chiffré n’est fixé avant {program.targets.correctionLeadTime.minimumMeasuredCount} corrections mesurables.</p></article>
			<article><span>02</span><h3>FAD à plusieurs pressions</h3><p>{fad.definition}</p><div class="score-track" aria-label={`${fad.percentage} % des compresseurs avec FAD multi-pression`}><span style={`width:${fad.percentage}%`}></span></div><p>{fad.availableCount} profils permettent une interpolation entre des points publiés. Les {fad.eligibleCount - fad.availableCount} autres ne sont jamais extrapolés silencieusement.</p></article>
			<article><span>03</span><h3>Stabilité des références</h3><p>{references.definition}</p><p>{references.stableCount} MPN correspondent à leur dernière observation publique, {references.changeCount} mutation est consignée et {references.missingBaselineCount} référence suivie manque de ligne de base.</p></article>
			<article><span>04</span><h3>Réponses aux contradictions</h3><p>{contradictions.definition}</p><p>Le délai médian de réponse documentaire est actuellement de {contradictions.medianResponseDays ?? 'non mesurable'} jour. Il décrit la décision de CompatAir, jamais le délai de réponse d’un fabricant.</p></article>
		</div>
	</div></section>

	<section class="section contradiction-section"><div class="container"><div class="split-head"><div><p class="eyebrow">Registre des arbitrages</p><h2>Contradictions documentaires recensées</h2></div><p>La contradiction reste visible même lorsqu’une valeur a été retenue. <a href="/radar-contradictions/">Comparer les valeurs source par source</a>.</p></div>
		<div class="contradiction-list">{observatory.contradictions.map((record) => {
			const product = productsById.get(record.productId);
			const href = product && 'tankLiters' in product ? `/compresseurs/${product.slug}/` : product ? `/outils-pneumatiques/${product.slug}/` : undefined;
			const productLabel = product && 'tankLiters' in product ? compressorDisplayName(product) : product?.label;
			return <article><header><span>{record.status === 'answered' ? 'Réponse publiée' : 'Ouverte'}</span><time datetime={record.observedAt}>Constatée le {formatDate(record.observedAt)}</time></header><h3>{record.subject}</h3><p><strong>Contradiction.</strong> {record.contradiction}</p><p><strong>Réponse CompatAir.</strong> {record.response ?? 'Aucun arbitrage publié à ce stade.'}</p>{productLabel && href && <a href={href}>{productLabel}</a>}</article>;
		})}</div>
	</div></section>

	<section class="section barometer-method"><div class="container"><p class="eyebrow">Limites publiées</p><h2>Pas de score global artificiel</h2><ul>{observatory.limitations.map((limitation) => <li>{limitation}</li>)}</ul><p>L’Observatoire ne transforme pas quatre mesures hétérogènes en une note unique. Consultez aussi le <a href="/barometre-transparence/">baromètre des données publiées par les fabricants</a>, l’<a href="/preuves/">historique des preuves</a> ou <a href="/contact/">signalez une contradiction</a>.</p></div></section>
</BaseLayout>
