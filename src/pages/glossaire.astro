---
import BaseLayout from '../layouts/BaseLayout.astro';
import { glossarySources, glossaryTerms } from '../data/glossary';

const letters = [...new Set(glossaryTerms.map((item) => item.term.normalize('NFD').replace(/[\u0300-\u036f]/g, '').charAt(0).toUpperCase()))];
const termSetJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTermSet',
	name: 'Glossaire CompatAir de l’air comprimé',
	description: 'Définitions sourcées des termes utilisés pour les compresseurs, les outils pneumatiques et les réseaux d’air comprimé.',
	url: 'https://compatair.fr/glossaire/',
	hasDefinedTerm: glossaryTerms.map((item) => ({
		'@type': 'DefinedTerm',
		name: item.term,
		description: item.definition,
		url: `https://compatair.fr/glossaire/#${item.slug}`,
		inDefinedTermSet: 'https://compatair.fr/glossaire/',
	})),
};
---

<BaseLayout title="Glossaire de l’air comprimé : FAD, bar, débit et pression | CompatAir" description="Définitions sourcées du FAD, débit restitué, pression, point de rosée, ISO 8573-1 et des principaux termes de l’air comprimé." breadcrumbs={[{ name: 'Glossaire', path: '/glossaire/' }]}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(termSetJsonLd)} />
	<section class="page-hero compact"><div class="container"><p class="eyebrow">{glossaryTerms.length} définitions sourcées</p><h1>Le glossaire de l’air comprimé</h1><p class="lead">Un vocabulaire précis pour comparer des compresseurs, lire une fiche technique et diagnostiquer un réseau sans confondre pression, débit et conditions de référence.</p></div></section>
	<div class="container glossary-layout">
		<nav class="glossary-index" aria-label="Index alphabétique"><strong>Accès rapide</strong><div>{letters.map((letter) => <a href={`#lettre-${letter}`}>{letter}</a>)}</div><p>Utilisez aussi la recherche de votre navigateur pour trouver un terme.</p></nav>
		<div class="glossary-main">
			{letters.map((letter) => <section class="glossary-letter" id={`lettre-${letter}`}><header><span>{letter}</span><h2>Termes en {letter}</h2></header><div class="glossary-grid">{glossaryTerms.filter((item) => item.term.normalize('NFD').replace(/[\u0300-\u036f]/g, '').charAt(0).toUpperCase() === letter).map((item) => { const source = glossarySources[item.source]; return <article class="glossary-card" id={item.slug}><h3>{item.term}</h3><p>{item.definition}</p><div class="glossary-links"><a href={source.url} rel={source.url.startsWith('http') ? 'noopener' : undefined} target={source.url.startsWith('http') ? '_blank' : undefined}>Source</a>{item.related && <a href={item.related.href}>{item.related.label}</a>}</div></article> })}</div></section>)}
			<section class="glossary-sources"><h2>Sources de référence</h2><ul>{Object.values(glossarySources).map((source) => <li><a href={source.url} rel={source.url.startsWith('http') ? 'noopener' : undefined} target={source.url.startsWith('http') ? '_blank' : undefined}>{source.label}</a></li>)}</ul></section>
		</div>
	</div>
</BaseLayout>
