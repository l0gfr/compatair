---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compressors, tools } from '../../data/catalog';
import { toolUseSeoTitle } from '../../data/product-seo-titles';
import { evaluateCompatibility } from '../../domain/compatibility';
import { isFixedFlowTool, toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const fixedFlow = isFixedFlowTool(tool);
const results = fixedFlow ? compressors.map((compressor) => ({ compressor, result: evaluateCompatibility(compressor, tool) })) : [];
const continuous = results.filter((item) => item.result.verdict === 'continuous');
const incompatible = results.filter((item) => item.result.verdict === 'incompatible');
const insufficient = results.filter((item) => item.result.verdict === 'insufficient_data');
const pageUrl = `/quel-compresseur-pour/${tool.slug}/`;
const demandLabel = toolDemandLabel(tool);
const pressureLabel = toolPressureLabel(tool);
const guideByCategory: Record<string, string> = {
	'Ponceuse pneumatique': '/guides/compresseur-pour-ponceuse-pneumatique/',
	'Meuleuse pneumatique': '/guides/compresseur-pour-meuleuse-pneumatique/',
	'Clé à chocs': '/guides/compresseur-pour-cle-a-chocs-pneumatique/',
	'Agrafeuse et cloueuse': '/guides/compresseur-pour-agrafeuse-cloueuse-pneumatique/',
	'Gonflage': '/guides/compresseur-pour-gonfler-pneus/',
	'Pistolet à peinture HVLP': '/guides/compresseur-pour-pistolet-peinture-hvlp/',
	'Clé à cliquet pneumatique': '/guides/compresseur-pour-cle-a-cliquet-pneumatique/',
	'Visseuse pneumatique': '/guides/compresseur-pour-visseuse-pneumatique/',
};
const relatedGuide = guideByCategory[tool.category] ?? '/guides/pression-travail-6-3-bar-outils-pneumatiques/';
---
<BaseLayout title={`Quel compresseur pour ${tool.model} ? | CompatAir`} editorialTitle={toolUseSeoTitle(tool.id)} description={`${tool.label} : ${demandLabel}, ${pressureLabel}. Compresseurs compatibles et informations manquantes clairement indiquées.`} imagePath="/social/compatibilite.png" imageAlt="Guide de compatibilité entre compresseurs et outils pneumatiques" breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }, { name: `Quel compresseur pour ${tool.model}`, path: pageUrl }]}>
	<article class="container content use-page"><p class="eyebrow">Choisir un compresseur pour cet outil</p><h1>Quel compresseur pour {tool.label}&nbsp;?</h1><p class="lead">La documentation indique {demandLabel.toLowerCase()} et {pressureLabel.toLowerCase()}. CompatAir utilise ces deux valeurs ensemble pour rechercher les compresseurs capables d’alimenter l’outil.</p>
		<h2>Données utilisées</h2><dl class="spec-table"><div><dt>Besoin publié</dt><dd>{demandLabel}</dd></div><div><dt><a href="/glossaire/#pression-travail">Pression d’utilisation</a></dt><dd>{pressureLabel}</dd></div><div><dt><a href="/glossaire/#debit-restitue">Débit restitué conseillé</a></dt><dd>{fixedFlow ? `${Math.round(tool.airflowLpm.typical * 1.25)} L/min avec la réserve CompatAir de 25 %` : 'Non calculable sans débit par minute documenté'}</dd></div><div><dt>Raccordement documenté</dt><dd>{tool.connectorSize ?? 'Non documenté dans la source consultée'}</dd></div></dl>
		{fixedFlow ? <><h2>Compresseurs capables d’alimenter cet outil</h2>{continuous.length ? <div class="compatibility-table">{continuous.map(({ compressor, result }) => <a href={`/calculateur/?outil=${encodeURIComponent(tool.id)}&compresseur=${encodeURIComponent(compressor.id)}`}><span><strong>{compressor.brand} {compressor.model}</strong><small>{Math.round(result.availableFadLpm!)} L/min documentés à la pression demandée</small></span><strong class="text-continuous">En continu</strong></a>)}</div> : <p>Aucun modèle actuellement étudié ne couvre le besoin avec des données suffisantes.</p>}{incompatible.length > 0 && <><h2>Compresseurs dont le débit est insuffisant</h2><div class="compatibility-table">{incompatible.map(({ compressor, result }) => <a href={`/calculateur/?outil=${encodeURIComponent(tool.id)}&compresseur=${encodeURIComponent(compressor.id)}`}><span><strong>{compressor.brand} {compressor.model}</strong><small>{result.availableFadLpm !== undefined ? `${Math.round(result.availableFadLpm)} L/min documentés à la pression demandée` : 'Pression maximale insuffisante'}</small></span><strong class="text-incompatible">Incompatible</strong></a>)}</div></>}<h2>Modèles pour lesquels une information manque</h2><p>Pour {insufficient.length} modèle{insufficient.length > 1 ? 's' : ''}, CompatAir ne peut pas conclure faute de débit réellement restitué à la pression demandée.</p></> : <><h2>Une information sur votre usage est nécessaire</h2><p>{tool.demandModel === 'per-action' ? `Indiquez le nombre de ${tool.actionLabel}s par minute. La consommation moyenne correspondra au volume publié par action multiplié par ce rythme, sans prétendre deviner le besoin exact au déclenchement.` : tool.demandExplanation}</p><div class="limit-box"><h3>Conclusion impossible pour l’instant</h3><p>Aucun compresseur n’est déclaré compatible ou incompatible à partir d’un débit que le fabricant ne publie pas.</p></div></>}
		<div class="actions">{fixedFlow && <a class="button primary" href={`/calculateur/?outil=${tool.id}`}>Vérifier votre configuration</a>}<a class="button" href={`/outils-pneumatiques/${tool.slug}/`}>Voir la fiche outil</a><a class="button" href={relatedGuide}>Lire le guide d’usage</a></div>
	</article>
</BaseLayout>
