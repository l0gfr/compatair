---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compressors, tools } from '../../data/catalog';
import { evaluateCompatibility } from '../../domain/compatibility';
import { isFixedFlowTool, toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const fixedFlow = isFixedFlowTool(tool);
const results = fixedFlow ? compressors.map((compressor) => ({ compressor, result: evaluateCompatibility(compressor, tool) })) : [];
const continuous = results.filter((item) => item.result.verdict === 'continuous');
const incompatible = results.filter((item) => item.result.verdict === 'incompatible');
const insufficient = results.filter((item) => item.result.verdict === 'insufficient_data');
const pageUrl = `/quel-compresseur-pour/${tool.slug}/`;
const demandLabel = toolDemandLabel(tool);
const pressureLabel = toolPressureLabel(tool);
---
<BaseLayout title={`Quel compresseur pour ${tool.model} ? | CompatAir`} description={`${tool.label} : ${demandLabel}, ${pressureLabel}. Méthode de dimensionnement et données manquantes explicites.`} breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }, { name: `Quel compresseur pour ${tool.model}`, path: pageUrl }]}>
	<article class="container content use-page"><p class="eyebrow">Dimensionnement par outil</p><h1>Quel compresseur pour {tool.label}&nbsp;?</h1><p class="lead">La documentation publie {demandLabel.toLowerCase()} et {pressureLabel.toLowerCase()}. CompatAir ne convertit ces valeurs que lorsqu’un débit minute et une pression de référence sont documentés ensemble.</p>
		<h2>Données à contrôler</h2><dl class="spec-table"><div><dt>Besoin publié</dt><dd>{demandLabel}</dd></div><div><dt>Pression publiée</dt><dd>{pressureLabel}</dd></div><div><dt>FAD conseillé</dt><dd>{fixedFlow ? `${Math.round(tool.airflowLpm.typical * 1.25)} L/min avec marge CompatAir de 25 %` : 'Non calculable sans débit minute documenté'}</dd></div><div><dt>Raccordement documenté</dt><dd>{tool.connectorSize ?? 'Non documenté dans la source consultée'}</dd></div></dl>
		{fixedFlow ? <><h2>Modèles dont le débit peut être comparé</h2>{continuous.length ? <div class="compatibility-table">{continuous.map(({ compressor, result }) => <a href={`/compatibilite/${compressor.slug}--${tool.slug}/`}><span><strong>{compressor.brand} {compressor.model}</strong><small>{Math.round(result.availableFadLpm!)} L/min documentés à la pression demandée</small></span><strong class="text-continuous">Continu</strong></a>)}</div> : <p>Aucun modèle du catalogue actuel ne couvre le débit nominal avec des données suffisantes.</p>}{incompatible.length > 0 && <><h2>Modèles documentés sous le besoin</h2><div class="compatibility-table">{incompatible.map(({ compressor, result }) => <a href={`/compatibilite/${compressor.slug}--${tool.slug}/`}><span><strong>{compressor.brand} {compressor.model}</strong><small>{result.availableFadLpm !== undefined ? `${Math.round(result.availableFadLpm)} L/min documentés à la pression demandée` : 'Pression maximale insuffisante'}</small></span><strong class="text-incompatible">Incompatible</strong></a>)}</div></>}<h2>Données qui ne permettent pas de conclure</h2><p>{insufficient.length} modèle{insufficient.length > 1 ? 's ne reçoivent' : ' ne reçoit'} aucun verdict positif ou négatif faute de FAD documenté à la pression demandée.</p></> : <><h2>Donnée supplémentaire nécessaire</h2><p>{tool.demandModel === 'per-action' ? `Le calcul demande un rythme de ${tool.actionLabel}s par minute. La consommation moyenne correspondra alors au volume publié par action multiplié par ce rythme, sans préjuger de la capacité de pointe.` : tool.demandExplanation}</p><div class="limit-box"><h3>Verdict suspendu</h3><p>Aucun compresseur n’est classé compatible ou incompatible à partir d’un débit que le fabricant ne publie pas.</p></div></>}
		<div class="actions">{fixedFlow && <a class="button primary" href={`/calculateur/?outil=${tool.id}`}>Ouvrir la configuration</a>}<a class="button" href={`/outils-pneumatiques/${tool.slug}/`}>Voir la fiche outil</a></div>
	</article>
</BaseLayout>
