---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import { compressors, tools } from '../../data/catalog';
import { activeOffers } from '../../data/offers';
import { toolUseSeoTitle } from '../../data/product-seo-titles';
import { toolGuidePath } from '../../data/tool-guide-links';
import { compressorDisplayName } from '../../domain/product-display';
import { createToolCompatibilitySummary } from '../../domain/seo-selection';
import { isFixedFlowTool, toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
import { compatibilityFadLabel } from '../../domain/compatibility';
import { sourceQualityLabel } from '../../domain/source-quality';

export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const fixedFlow = isFixedFlowTool(tool);
const availableProductIds = new Set(activeOffers.map((offer) => offer.productId));
const compatibility = fixedFlow ? createToolCompatibilitySummary(compressors, tool, { availableProductIds }) : undefined;
const pageUrl = `/quel-compresseur-pour/${tool.slug}/`;
const demandLabel = toolDemandLabel(tool);
const pressureLabel = toolPressureLabel(tool);
const relatedGuide = toolGuidePath(tool);
const targetFlow = fixedFlow ? Math.round(tool.airflowLpm.typical * 1.25) : undefined;
const comparisonIds = compatibility?.compatibleSelection.map(({ compressor }) => compressor.id).join(',') ?? '';
---

<BaseLayout title={`Quel compresseur pour ${tool.model} ? | CompatAir`} editorialTitle={toolUseSeoTitle(tool.id)} description={`${tool.label} : ${demandLabel}, ${pressureLabel}. Trois compresseurs proches du besoin, limites et méthode de sélection.`} imagePath="/social/compatibilite.png" imageAlt="Guide de compatibilité entre compresseurs et outils pneumatiques" breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }, { name: `Quel compresseur pour ${tool.model}`, path: pageUrl }]}>
	<article class="use-decision-page" data-use-decision-page>
		<section class="page-hero use-decision-hero">
			<div class="container use-decision-hero-grid">
				<div><p class="product-decision-index">Page d’usage / sélection technique</p><p class="eyebrow">Quel compresseur pour cet outil&nbsp;?</p><h1>{tool.label}</h1><p class="lead">La documentation indique <strong>{demandLabel.toLowerCase()}</strong> et <strong>{pressureLabel.toLowerCase()}</strong>. CompatAir rapproche ce besoin des débits réellement restitués publiés à la bonne pression.</p><div class="hero-actions"><a class="button primary" href={`/calculateur/#outil=${tool.id}`}>Affiner avec mon usage</a><a class="button" href={`/outils-pneumatiques/${tool.slug}/`}>Voir la fiche factuelle</a></div></div>
				<aside class="use-need-instrument" aria-label={`Besoin documenté pour ${tool.label}`}>
					<header><span><i></i> CompatAir / besoin</span><strong>{fixedFlow ? 'Calculable' : 'À préciser'}</strong></header>
					<div><span>Débit publié</span><strong>{demandLabel}</strong><i style={`--level:${fixedFlow ? Math.min(100, Math.max(12, tool.airflowLpm.typical / 4)) : 12}%`}></i></div>
					<div><span>Pression</span><strong>{pressureLabel}</strong><i style={`--level:${fixedFlow ? Math.min(100, tool.workingPressureBar.typical * 10) : 20}%`}></i></div>
					<div><span>Repère avec réserve</span><strong>{targetFlow ? `${targetFlow} L/min` : 'Usage requis'}</strong><i style={`--level:${targetFlow ? Math.min(100, Math.max(16, targetFlow / 4)) : 8}%`}></i></div>
					<footer>{sourceQualityLabel(tool.confidence)} <b>·</b> Référence {tool.mpn ?? 'non publiée'}</footer>
				</aside>
			</div>
		</section>

		{fixedFlow ? <>
			<section class="use-answer-strip" aria-label="Résumé de la réponse"><div class="container"><div><strong>{compatibility!.counts.compatible}</strong><span>compatibles</span></div><div><strong>{compatibility!.counts.incompatible}</strong><span>incompatibles</span></div><div><strong>{compatibility!.counts.insufficient}</strong><span>indéterminés</span></div><div><strong>{targetFlow}</strong><span>L/min avec réserve</span></div></div></section>
			<section class="section use-selection" data-static-compatibility-results data-result-count={compatibility!.compatibleSelection.length + compatibility!.incompatibleSelection.length}>
				<div class="container"><header class="product-section-head"><div><p class="product-decision-index">01 / Réponse</p><h2>Trois compresseurs compatibles les plus proches du besoin</h2></div><p>La sélection privilégie d’abord la compatibilité, puis la qualité des données et le débit suffisant le plus proche. Elle ne désigne pas un meilleur produit absolu.</p></header>
				<div class="use-selection-grid">{compatibility!.compatibleSelection.map(({ compressor, result }, index) => <article><div class="use-selection-rank">0{index + 1}</div><a class="use-selection-image" href={`/compresseurs/${compressor.slug}/`}><ProductImage image={compressor.image} compact /></a><p class="product-brand">{compressor.brand}</p><h3><a href={`/compresseurs/${compressor.slug}/`}>{compressorDisplayName(compressor)}</a></h3><span class="use-verdict">{result.verdict === 'continuous' ? 'Compatible en continu' : 'Compatible par intermittence'}</span><p>{compatibilityFadLabel(result, tool.workingPressureBar.typical)}</p><dl><div><dt>Cuve</dt><dd>{compressor.tankLiters} L</dd></div><div><dt>Source</dt><dd>{sourceQualityLabel(compressor.confidence)}</dd></div></dl><a class="button primary" href={`/calculateur/#outil=${encodeURIComponent(tool.id)}&compresseur=${encodeURIComponent(compressor.id)}`}>Vérifier ce modèle</a></article>)}</div>
				<div class="actions use-selection-actions"><a class="button primary" href={`/comparateur/#ids=${comparisonIds}`}>Comparer les trois compresseurs</a><a class="button" href={`/calculateur/#outil=${tool.id}`}>Voir tous les résultats dans le calculateur</a></div></div>
			</section>
			<section class="section use-method-section"><div class="container use-method-grid"><div><p class="product-decision-index">02 / Méthode</p><h2>Pourquoi ces modèles apparaissent ici</h2><p>Le seuil constructeur est de <strong>{tool.airflowLpm.typical} L/min à {tool.workingPressureBar.typical} bar</strong>. Le repère de {targetFlow} L/min ajoute une réserve de 25 % proposée par CompatAir. Cette réserve ne remplace pas les pertes réelles de votre flexible, de vos raccords ou de votre réseau.</p><ol><li><span>01</span><div><strong>Pression comparable</strong><p>Le débit doit être publié à la pression demandée, interpolable ou utilisable comme borne conservatrice.</p></div></li><li><span>02</span><div><strong>Débit réellement disponible</strong><p>Le débit aspiré est exclu du verdict, même lorsqu’il est le seul chiffre commercial visible.</p></div></li><li><span>03</span><div><strong>Proximité du besoin</strong><p>Un débit suffisant et proche est préféré à une machine fortement surdimensionnée.</p></div></li></ol></div><aside><h3>Données utilisées</h3><dl class="spec-table"><div><dt>Besoin publié</dt><dd>{demandLabel}</dd></div><div><dt>Pression</dt><dd>{pressureLabel}</dd></div><div><dt>Réserve CompatAir</dt><dd>{targetFlow} L/min</dd></div><div><dt>Raccordement</dt><dd>{tool.connectorSize ?? 'Non documenté'}</dd></div></dl><a href="/methodologie/">Lire la méthode complète</a></aside></div></section>
			{compatibility!.incompatibleSelection.length > 0 && <section class="section use-near-misses"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">03 / Limite</p><h2>Modèles proches mais encore incompatibles</h2></div><p>Ils sont affichés pour rendre le seuil concret, pas comme recommandations de repli.</p></header><div class="compatibility-table">{compatibility!.incompatibleSelection.map(({ compressor, result }) => <a href={`/calculateur/#outil=${tool.id}&compresseur=${compressor.id}`}><span><strong>{compressorDisplayName(compressor)}</strong><small>{compatibilityFadLabel(result, tool.workingPressureBar.typical)}</small></span><strong class="text-incompatible">Incompatible</strong></a>)}</div></div></section>}
		</> : <section class="section"><div class="container use-insufficient"><p class="product-decision-index">01 / Donnée manquante</p><h2>Une information sur votre usage est nécessaire.</h2><p>{tool.demandModel === 'per-action' ? `Indiquez le nombre de ${tool.actionLabel}s par minute. La consommation moyenne correspondra au volume publié par action multiplié par ce rythme, sans prétendre deviner le besoin exact au déclenchement.` : tool.demandExplanation}</p><p>Aucun compresseur n’est déclaré compatible ou incompatible à partir d’un débit que le fabricant ne publie pas.</p><div class="actions"><a class="button primary" href={`/calculateur/#outil=${tool.id}`}>Renseigner mon usage</a><a class="button" href={`/outils-pneumatiques/${tool.slug}/`}>Voir la fiche outil</a></div></div></section>}

		<section class="section use-next-step"><div class="container"><div><p class="product-decision-index">Approfondir</p><h2>Le calcul court ne remplace pas l’usage réel.</h2><p>Durée de session, diamètre du flexible, raccords, pertes de charge et utilisation simultanée peuvent modifier la réponse.</p></div><div class="actions"><a class="button primary" href={`/calculateur/#outil=${tool.id}`}>Affiner ma configuration</a><a class="button" href={relatedGuide}>Lire le guide métier associé</a></div></div></section>
	</article>
</BaseLayout>
