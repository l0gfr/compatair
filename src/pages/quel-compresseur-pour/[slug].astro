---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compressors, tools } from '../../data/catalog';
import { activeOffers } from '../../data/offers';
import { toolUseSeoTitle } from '../../data/product-seo-titles';
import { toolGuidePath } from '../../data/tool-guide-links';
import { compressorDisplayName } from '../../domain/product-display';
import { createToolCompatibilitySummary } from '../../domain/seo-selection';
import { isFixedFlowTool, toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const fixedFlow = isFixedFlowTool(tool);
const availableProductIds = new Set(activeOffers.map((offer) => offer.productId));
const compatibility = fixedFlow ? createToolCompatibilitySummary(compressors, tool, { availableProductIds }) : undefined;
const pageUrl = `/quel-compresseur-pour/${tool.slug}/`;
const demandLabel = toolDemandLabel(tool);
const pressureLabel = toolPressureLabel(tool);
const relatedGuide = toolGuidePath(tool);
---
<BaseLayout title={`Quel compresseur pour ${tool.model} ? | CompatAir`} editorialTitle={toolUseSeoTitle(tool.id)} description={`${tool.label} : ${demandLabel}, ${pressureLabel}. Compresseurs compatibles et informations manquantes clairement indiquées.`} imagePath="/social/compatibilite.png" imageAlt="Guide de compatibilité entre compresseurs et outils pneumatiques" breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }, { name: `Quel compresseur pour ${tool.model}`, path: pageUrl }]}>
	<article class="container content use-page"><p class="eyebrow">Choisir un compresseur pour cet outil</p><h1>Quel compresseur pour {tool.label}&nbsp;?</h1><p class="lead">La documentation indique {demandLabel.toLowerCase()} et {pressureLabel.toLowerCase()}. CompatAir utilise ces deux valeurs ensemble pour rechercher les compresseurs capables d’alimenter l’outil.</p>
		<h2>Données utilisées</h2><dl class="spec-table"><div><dt>Besoin publié</dt><dd>{demandLabel}</dd></div><div><dt><a href="/glossaire/#pression-travail">Pression d’utilisation</a></dt><dd>{pressureLabel}</dd></div><div><dt><a href="/glossaire/#debit-restitue">Débit restitué conseillé</a></dt><dd>{fixedFlow ? `${Math.round(tool.airflowLpm.typical * 1.25)} L/min avec la réserve CompatAir de 25 %` : 'Non calculable sans débit par minute documenté'}</dd></div><div><dt>Raccordement documenté</dt><dd>{tool.connectorSize ?? 'Non documenté dans la source consultée'}</dd></div></dl>
		{fixedFlow ? <div data-static-compatibility-results data-result-count={compatibility!.compatibleSelection.length + compatibility!.incompatibleSelection.length}><h2>Sélection de compresseurs capables d’alimenter cet outil</h2><p>{compatibility!.counts.compatible} résultats sont compatibles dans le catalogue. Les modèles affichés privilégient une alimentation cohérente avec un usage large, puis le plus petit débit réellement suffisant. L’exhaustivité reste disponible dans le calculateur et les données publiques.</p>{compatibility!.compatibleSelection.length ? <div class="compatibility-table">{compatibility!.compatibleSelection.map(({ compressor, result }) => <a href={`/calculateur/#outil=${encodeURIComponent(tool.id)}&compresseur=${encodeURIComponent(compressor.id)}`}><span><strong>{compressorDisplayName(compressor)}</strong><small>{Math.round(result.availableFadLpm!)} L/min documentés à la pression demandée</small></span><strong class={`text-${result.verdict}`}>{result.verdict === 'continuous' ? 'En continu' : 'Intermittent'}</strong></a>)}</div> : <p>Aucun modèle actuellement étudié ne couvre le besoin avec des données suffisantes.</p>}{compatibility!.counts.compatible > compatibility!.compatibleSelection.length && <p>{compatibility!.counts.compatible - compatibility!.compatibleSelection.length} autre(s) résultat(s) compatible(s) restent consultables dans le calculateur.</p>}{compatibility!.incompatibleSelection.length > 0 && <><h2>Incompatibilités utiles à comparer</h2><div class="compatibility-table">{compatibility!.incompatibleSelection.map(({ compressor, result }) => <a href={`/calculateur/#outil=${encodeURIComponent(tool.id)}&compresseur=${encodeURIComponent(compressor.id)}`}><span><strong>{compressorDisplayName(compressor)}</strong><small>{result.availableFadLpm !== undefined ? `${Math.round(result.availableFadLpm)} L/min documentés à la pression demandée` : 'Pression maximale insuffisante'}</small></span><strong class="text-incompatible">Incompatible</strong></a>)}</div></>}<h2>Modèles pour lesquels une information manque</h2><p>Pour {compatibility!.counts.insufficient} modèle{compatibility!.counts.insufficient > 1 ? 's' : ''}, CompatAir ne peut pas conclure faute de débit réellement restitué à la pression demandée.</p></div> : <><h2>Une information sur votre usage est nécessaire</h2><p>{tool.demandModel === 'per-action' ? `Indiquez le nombre de ${tool.actionLabel}s par minute. La consommation moyenne correspondra au volume publié par action multiplié par ce rythme, sans prétendre deviner le besoin exact au déclenchement.` : tool.demandExplanation}</p><div class="limit-box"><h3>Conclusion impossible pour l’instant</h3><p>Aucun compresseur n’est déclaré compatible ou incompatible à partir d’un débit que le fabricant ne publie pas.</p></div></>}
		<div class="actions"><a class="button primary" href={`/calculateur/#outil=${tool.id}`}>Vérifier votre configuration</a><a class="button" href={`/outils-pneumatiques/${tool.slug}/`}>Voir la fiche outil</a><a class="button" href={relatedGuide}>Lire le guide d’usage</a></div>
	</article>
</BaseLayout>
