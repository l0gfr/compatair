---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compressors, tools } from '../../data/catalog';
import { activeOffers } from '../../data/offers';
import { compatibilityFadLabel, evaluateCompatibility } from '../../domain/compatibility';
import { guideAudiences, guideMetiers } from '../../domain/editorial-taxonomy';
import { compressorDisplayName } from '../../domain/product-display';
import { rankCompatibleCompressors } from '../../domain/seo-selection';
import { serializeJsonLd } from '../../domain/structured-data';

export async function getStaticPaths() {
	const guides = await getCollection('guides');
	return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const allGuides = await getCollection('guides');
const relatedGuides = allGuides
	.filter((item) => item.id !== guide.id)
	.map((item) => ({
		item,
		score: item.data.metiers.filter((metier) => guide.data.metiers.includes(metier)).length * 4
			+ item.data.audiences.filter((audience) => guide.data.audiences.includes(audience)).length
			+ Number(item.data.category === guide.data.category),
	}))
	.filter(({ score }) => score > 0)
	.sort((a, b) => b.score - a.score || b.item.data.pubDate.valueOf() - a.item.data.pubDate.valueOf())
	.slice(0, 3)
	.map(({ item }) => item);
const relatedTool = guide.data.relatedCalculatorTool
	? tools.find((tool) => tool.id === guide.data.relatedCalculatorTool)
	: undefined;
const compatibleCompressors = relatedTool
	? rankCompatibleCompressors(compressors
			.map((compressor) => ({ compressor, result: evaluateCompatibility(compressor, relatedTool) }))
			.filter(({ result }) => result.verdict === 'continuous'), {
				audiences: guide.data.audiences,
				availableProductIds: new Set(activeOffers.map((offer) => offer.productId)),
			})
			.slice(0, 3)
	: [];
const published = guide.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const externallyReviewed = guide.data.reviewStatus === 'external';
const socialImageByCategory = {
	Comprendre: '/social/guides__comprendre.png',
	Choisir: '/social/guides__choisir.png',
	Installer: '/social/guides__installer.png',
	Utiliser: '/social/guides__utiliser.png',
} as const;
const socialImagePath = socialImageByCategory[guide.data.category];
const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: guide.data.title,
	description: guide.data.description,
	image: `https://compatair.fr${socialImagePath}`,
	datePublished: guide.data.pubDate.toISOString(),
	dateModified: (guide.data.updatedDate ?? guide.data.pubDate).toISOString(),
	mainEntityOfPage: `https://compatair.fr/guides/${guide.id}/`,
	url: `https://compatair.fr/guides/${guide.id}/`,
	inLanguage: 'fr-FR',
	articleSection: guide.data.category,
	timeRequired: `PT${guide.data.readingTime}M`,
	isAccessibleForFree: true,
	citation: guide.data.sources,
	audience: guide.data.audiences.map((audience) => ({ '@type': 'Audience', audienceType: guideAudiences[audience].label })),
	about: [
		...guide.data.metiers.map((metier) => ({ '@type': 'Thing', name: guideMetiers[metier].label, url: `https://compatair.fr/guides/metiers/${metier}/` })),
		...(relatedTool ? [{ '@type': 'Thing', name: relatedTool.label, url: `https://compatair.fr/outils-pneumatiques/${relatedTool.slug}/` }] : []),
	],
	author: { '@type': 'Organization', '@id': 'https://compatair.fr/#organization', name: 'CompatAir', url: 'https://compatair.fr/' },
	reviewedBy: externallyReviewed ? { '@type': 'Person', name: guide.data.reviewer, jobTitle: guide.data.reviewerRole } : undefined,
	publisher: { '@type': 'Organization', '@id': 'https://compatair.fr/#organization', name: 'CompatAir', url: 'https://compatair.fr/' },
};
---

<BaseLayout
	title={`${guide.data.title} | CompatAir`}
	editorialTitle={guide.data.seoTitle}
	description={guide.data.description}
	pageType="article"
	imagePath={socialImagePath}
	issueDate={guide.data.pubDate}
	modifiedDate={guide.data.updatedDate ?? guide.data.pubDate}
	breadcrumbs={[{ name: 'Guides', path: '/guides/' }, { name: guide.data.title, path: `/guides/${guide.id}/` }]}
>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(articleJsonLd)} />
	<article class="container editorial-layout" data-guide-audiences={guide.data.audiences.join(' ')} data-guide-metiers={guide.data.metiers.join(' ')}>
		<div class="editorial-main">
			<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/guides/">Guides</a><span>/</span><span>{guide.data.category}</span></nav>
			<header class="article-head"><p class="eyebrow">{guide.data.category}</p><div class="article-taxonomy" aria-label="Publics et métiers">{guide.data.audiences.map((audience) => <a href={`/guides/${guideAudiences[audience].label.toLocaleLowerCase('fr-FR')}/`}>{guideAudiences[audience].label}</a>)}{guide.data.metiers.map((metier) => <a href={`/guides/metiers/${metier}/`}>{guideMetiers[metier].label}</a>)}</div><h1>{guide.data.title}</h1><p class="lead">{guide.data.description}</p><p class="article-byline" data-review-status={guide.data.reviewStatus}>Publié le {published} · Lecture {guide.data.readingTime} minutes · Rédaction <a href="/gouvernance-editoriale/">{guide.data.author}</a> · {externallyReviewed ? <>Revue technique par {guide.data.reviewer}, {guide.data.reviewerRole}</> : <>Relecture éditoriale interne, sans validation professionnelle externe</>}</p></header>
			<div class="article-body"><Content /></div>
			<section class="guide-next-step" aria-labelledby="guide-next-step-title">
				<p class="eyebrow">Vérifier sur des données réelles</p>
				<h2 id="guide-next-step-title">Vérifier ce guide avec un outil réel</h2>
				{relatedTool ? (
					<>
						<p>Le profil publié de <strong>{relatedTool.label}</strong> est déjà disponible. Le calculateur compare son besoin au débit restitué documenté, avec la pression et la base de comparaison visibles.</p>
						<div class="actions">
							<a class="button primary" href={`/calculateur/#outil=${relatedTool.id}`}>Tester cet outil</a>
							<a class="button" href={`/outils-pneumatiques/${relatedTool.slug}/`}>Voir la fiche outil</a>
						</div>
						{compatibleCompressors.length > 0 ? (
							<div class="guide-compatible-results">
									<h3>Compresseurs déjà confirmés pour un usage continu</h3><p>La sélection privilégie l’audience du guide, une alimentation cohérente et le plus petit débit documenté réellement suffisant.</p>
								<div class="link-cards">
									{compatibleCompressors.map(({ compressor, result }) => (
										<a href={`/calculateur/#outil=${encodeURIComponent(relatedTool.id)}&compresseur=${encodeURIComponent(compressor.id)}`}>
												<strong>{compressorDisplayName(compressor)}</strong>
											<span>{compatibilityFadLabel(result, relatedTool.workingPressureBar.typical!)}</span>
										</a>
									))}
								</div>
							</div>
						) : (
							<p class="guide-no-match">Aucune fiche du catalogue ne permet actuellement de conclure à une compatibilité continue pour ce profil. <a href="/compresseurs/">Consulter les débits documentés</a>.</p>
						)}
					</>
				) : (
					<>
						<p>Choisissez un outil puis un compresseur pour vérifier le débit, la pression et les limites documentaires, sans convertir le débit aspiré en débit utile.</p>
						<div class="actions">
							<a class="button primary" href="/calculateur/">Ouvrir le calculateur</a>
							<a class="button" href="/outils-pneumatiques/">Choisir un outil</a>
							<a class="button" href="/compresseurs/">Voir les compresseurs</a>
						</div>
					</>
				)}
			</section>
			{relatedGuides.length > 0 && <section class="related-reading"><h2>Continuer sur ce sujet</h2><div class="link-cards">{relatedGuides.map((item) => <a href={`/guides/${item.id}/`}><strong>{item.data.title}</strong><span>{item.data.description}</span></a>)}</div></section>}
		</div>
		<aside class="article-aside" aria-label="Sommaire"><strong>Dans ce dossier</strong><ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol><a class="button primary" href="/calculateur/">Ouvrir le calculateur</a><a class="aside-secondary" href="/glossaire/">Consulter le glossaire</a></aside>
	</article>
</BaseLayout>
