---
import { getCollection } from 'astro:content';
import GuideLibraryPage from '../../../components/GuideLibraryPage.astro';
import { GUIDE_DIRECTORY_PAGE_SIZE } from '../../../domain/pagination';

export async function getStaticPaths() {
	const guides = await getCollection('guides');
	const totalPages = Math.ceil(guides.length / GUIDE_DIRECTORY_PAGE_SIZE);
	return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
		params: { page: String(index + 2) },
		props: { page: index + 2 },
	}));
}

const { page } = Astro.props;
---
<GuideLibraryPage page={page} />
