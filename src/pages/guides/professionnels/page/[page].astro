---
import { getCollection } from 'astro:content';
import GuideProfessionalLibraryPage from '../../../../components/GuideProfessionalLibraryPage.astro';
import { GUIDE_DIRECTORY_PAGE_SIZE } from '../../../../domain/pagination';

export async function getStaticPaths() {
	const guides = await getCollection('guides', ({ data }) => data.audiences.includes('professionnel'));
	const totalPages = Math.ceil(guides.length / GUIDE_DIRECTORY_PAGE_SIZE);
	return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
		params: { page: String(index + 2) },
		props: { page: index + 2 },
	}));
}

const { page } = Astro.props;
---
<GuideProfessionalLibraryPage page={page} />
