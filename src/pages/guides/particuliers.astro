---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideDirectory from '../../components/GuideDirectory.astro';
import HubSignalVisual from '../../components/HubSignalVisual.astro';
import UiIcon from '../../components/UiIcon.astro';
import { guideAudiences } from '../../domain/editorial-taxonomy';
import { serializeJsonLd } from '../../domain/structured-data';

const audience = 'particulier' as const;
const definition = guideAudiences[audience];
const guides = (await getCollection('guides', ({ data }) => data.audiences.includes(audience)))
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const startingPoints = [
	{ icon: 'tools', label: 'Référence connue', title: 'Identifier le produit exact', description: 'Le numéro de l’étiquette évite de partir d’un nom commercial ambigu.', href: '/scanner/' },
	{ icon: 'gauge', label: 'Outil connu', title: 'Vérifier le débit nécessaire', description: 'Le besoin publié de l’outil devient le point de départ du calcul.', href: '/calculateur/' },
	{ icon: 'book', label: 'Choix à comprendre', title: 'Lire la méthode complète', description: 'Pression, débit restitué, cuve et marge sont traités dans le bon ordre.', href: '/guides/guide-complet-dimensionner-compresseur-air/' },
] as const;
const itemListJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: definition.title,
	itemListElement: guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, name: guide.data.title, url: `https://compatair.fr/guides/${guide.id}/` })),
};
---

<BaseLayout title={definition.title} editorialTitle={definition.seoTitle} description={definition.description} imagePath="/social/guides.png" breadcrumbs={[{ name: 'Guides', path: '/guides/' }, { name: definition.label, path: '/guides/particuliers/' }]}>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(itemListJsonLd)} />
	<section class="page-hero compact audience-hero hub-hero" data-editorial-hub="particulier"><div class="container hub-hero-grid"><div><p class="eyebrow">Parcours par besoin</p><h1>{definition.title}</h1><p class="lead">{definition.description}</p><div class="actions"><a class="button primary" href="#parcours-particulier">Choisir mon point de départ</a><a class="button" href="/guides/professionnels/">Voir le parcours professionnel</a></div></div><HubSignalVisual mode="guides" count={guides.length} title="guides pour particuliers" secondary="sans profil d’usage supposé" /></div></section>
	<section class="section hub-intent-section" id="parcours-particulier"><div class="container"><div class="section-head split-head"><div><p class="eyebrow">Trois situations fréquentes</p><h2>Aller d’abord vers la réponse la plus courte</h2></div><p>Les paramètres avancés et les longs dossiers restent disponibles, mais ils ne précèdent pas l’identification ou le verdict utile.</p></div><div class="hub-intent-grid is-three">{startingPoints.map((path, index) => <a href={path.href}><span class="hub-intent-index">0{index + 1}</span><UiIcon name={path.icon} size={28} /><p>{path.label}</p><h3>{path.title}</h3><small>{path.description}</small><strong>Continuer →</strong></a>)}</div></div></section>
	<GuideDirectory guides={guides} context="particulier" title={`${guides.length} guides pour aller plus loin`} description="Filtrez par étape ou contexte, puis consultez une sélection paginée. Le même guide conserve sa source, sa date et son URL quel que soit le parcours." />
</BaseLayout>
