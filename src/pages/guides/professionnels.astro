---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideDirectory from '../../components/GuideDirectory.astro';
import GuideSeriesCallout from '../../components/GuideSeriesCallout.astro';
import HubSignalVisual from '../../components/HubSignalVisual.astro';
import MetierIcon from '../../components/MetierIcon.astro';
import { guideAudiences, guideMetierIds, guideMetiers } from '../../domain/editorial-taxonomy';
import { serializeJsonLd } from '../../domain/structured-data';

const audience = 'professionnel' as const;
const definition = guideAudiences[audience];
const guides = (await getCollection('guides', ({ data }) => data.audiences.includes(audience)))
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const maintenanceSeriesCount = guides.filter((guide) => guide.data.series === 'audit-suivi-maintenance-air-comprime').length;
const itemListJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: definition.title,
	itemListElement: guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, name: guide.data.title, url: `https://compatair.fr/guides/${guide.id}/` })),
};
---

<BaseLayout title={definition.title} editorialTitle={definition.seoTitle} description={definition.description} imagePath="/social/guides.png" breadcrumbs={[{ name: 'Guides', path: '/guides/' }, { name: definition.label, path: '/guides/professionnels/' }]}>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(itemListJsonLd)} />
	<section class="page-hero compact audience-hero hub-hero" data-editorial-hub="professionnel"><div class="container hub-hero-grid"><div><p class="eyebrow">Parcours professionnel</p><h1>{definition.title}</h1><p class="lead">{definition.description}</p><div class="actions"><a class="button primary" href="#metiers">Entrer par mon métier</a><a class="button" href="/professionnels/">Travailler avec CompatAir</a></div></div><HubSignalVisual mode="guides" count={guides.length} title="guides professionnels" secondary={`${guideMetierIds.length} contextes métiers`} /></div></section>
	<section class="section metier-gateway" id="metiers"><div class="container"><div class="section-head"><p class="eyebrow">Entrer par le métier</p><h2>{guideMetierIds.length} contextes, les mêmes règles de preuve</h2><p>Ces pages regroupent les guides utiles à un contexte de travail. Elles ne remplacent jamais la notice de la référence réellement utilisée.</p></div><div class="editorial-path-grid">{guideMetierIds.map((metier) => <a href={`/guides/metiers/${metier}/`}><MetierIcon metier={metier} /><span>{guides.filter((guide) => guide.data.metiers.includes(metier)).length} guides</span><strong>{guideMetiers[metier].label}</strong><small>{guideMetiers[metier].description}</small></a>)}</div></div></section>
	<GuideSeriesCallout guideCount={maintenanceSeriesCount} compact />
	<GuideDirectory guides={guides} context="professionnel" title={`${guides.length} guides professionnels, filtrables par métier`} description="Les sujets transversaux et les dossiers métiers sont réunis sans copie éditoriale ni URL concurrente. Neuf guides sont affichés à la fois." />
</BaseLayout>
