---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compressors, tools } from '../../data/catalog';
import { evaluateCompatibility } from '../../domain/compatibility';
import { isFixedFlowTool } from '../../domain/tool-demand';
import { formatFrenchDate, latestEvidenceDate } from '../../domain/provenance';

export function getStaticPaths() {
	return compressors.flatMap((compressor) => tools.flatMap((tool) => {
		const result = evaluateCompatibility(compressor, tool);
		return result.verdict === 'insufficient_data' ? [] : [{ params: { pair: `${compressor.slug}--${tool.slug}` }, props: { compressor, tool, result } }];
	}));
}
const { compressor, tool, result } = Astro.props;
if (!isFixedFlowTool(tool)) throw new Error('Une page de compatibilité exige un profil à débit fixe.');
const labels = { continuous: 'compatible en continu', intermittent: 'compatible par intermittence', incompatible: 'incompatible', insufficient_data: 'données insuffisantes' };
const title = `${compressor.brand} ${compressor.model} et ${tool.model} : ${labels[result.verdict]}`;
const pageUrl = `/compatibilite/${compressor.slug}--${tool.slug}/`;
const verifiedAt = latestEvidenceDate(compressor, tool);
---
<BaseLayout title={`${title} | CompatAir`} description={`Compatibilité vérifiée entre ${compressor.brand} ${compressor.model} et ${tool.label}, avec débit, pression, limites et sources.`} noindex={true} imagePath="/social/compatibilite.png" imageAlt={`Compatibilité ${compressor.brand} ${compressor.model} et ${tool.model}`} modifiedDate={new Date(verifiedAt)} breadcrumbs={[{ name: 'Compatibilité', path: '/calculateur/' }, { name: title, path: pageUrl }]}>
	<article class="container content compatibility-page"><p class="eyebrow">Verdict moteur {result.calculationVersion} · sources vérifiées jusqu’au {formatFrenchDate(verifiedAt)}</p><h1>{compressor.brand} {compressor.model} avec {tool.model}</h1><div class:list={['compatibility-verdict', `verdict-${result.verdict}`]}><strong>{labels[result.verdict]}</strong><span>Niveau de confiance {result.confidence === 'high' ? 'élevé' : result.confidence === 'medium' ? 'moyen' : 'faible'}</span></div>
		<h2>Valeurs comparées</h2><dl class="spec-table"><div><dt>Besoin de l’outil</dt><dd>{tool.airflowLpm.typical} L/min à {tool.workingPressureBar.typical} bar</dd></div><div><dt>FAD recommandé</dt><dd>{Math.round(result.requiredFadLpm!)} L/min avec la marge CompatAir</dd></div><div><dt>FAD documenté</dt><dd>{result.availableFadLpm !== undefined ? `${Math.round(result.availableFadLpm)} L/min à ${tool.workingPressureBar.typical} bar` : 'Non disponible à cette pression'}</dd></div><div><dt>Facteur limitant</dt><dd>{result.limitingFactor === 'flow' ? 'Débit' : result.limitingFactor === 'pressure' ? 'Pression' : result.limitingFactor ?? 'Aucun au débit nominal'}</dd></div></dl>
		<h2>Interprétation</h2>{result.verdict === 'continuous' ? <p>Le débit restitué documenté couvre la consommation nominale publiée de l’outil à la pression demandée. {result.availableFadLpm! < result.requiredFadLpm! ? 'La marge indicative de 25 % n’est toutefois pas atteinte.' : 'La marge indicative de 25 % est également couverte.'}</p> : <p>Le compresseur ne couvre pas la condition déterminante indiquée. Une cuve plus grande ne transforme pas à elle seule un déficit permanent de débit ou de pression en compatibilité continue.</p>}
		{result.warnings.length > 0 && <div class="limit-box"><h3>Réserves</h3><ul>{result.warnings.map((warning) => <li>{warning}</li>)}</ul></div>}
		<div class="actions"><a class="button primary" href={`/calculateur/?outil=${tool.id}`}>Modifier la simulation</a><a class="button" href={`/compresseurs/${compressor.slug}/`}>Fiche compresseur</a><a class="button" href={`/outils-pneumatiques/${tool.slug}/`}>Fiche outil</a></div>
		<h2>Sources</h2><p><a href={compressor.evidence[0].sourceUrl} rel="nofollow noopener" target="_blank">{compressor.evidence[0].sourceLabel}</a></p><p><a href={tool.evidence[0].sourceUrl} rel="nofollow noopener" target="_blank">{tool.evidence[0].sourceLabel}</a></p>
	</article>
</BaseLayout>
