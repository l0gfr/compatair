---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compressors, tools } from '../../data/catalog';
import { evaluateCompatibility } from '../../domain/compatibility';
import { isFixedFlowTool } from '../../domain/tool-demand';
import { formatFrenchDate, latestEvidenceDate } from '../../domain/provenance';

export function getStaticPaths() {
	return compressors.flatMap((compressor) => tools.flatMap((tool) => {
		const result = evaluateCompatibility(compressor, tool);
		return result.verdict === 'insufficient_data' ? [] : [{ params: { pair: `${compressor.slug}--${tool.slug}` }, props: { compressor, tool, result } }];
	}));
}
const { compressor, tool, result } = Astro.props;
if (!isFixedFlowTool(tool)) throw new Error('Une page de compatibilité exige un profil à débit fixe.');
const labels = { continuous: 'compatible en continu', intermittent: 'compatible par intermittence', incompatible: 'incompatible', insufficient_data: 'données insuffisantes' };
const title = `${compressor.model} + ${tool.model} : ${labels[result.verdict]}`;
const pageUrl = `/compatibilite/${compressor.slug}--${tool.slug}/`;
const verifiedAt = latestEvidenceDate(compressor, tool);
---
<BaseLayout title={`${title} | CompatAir`} description={`Compatibilité vérifiée entre ${compressor.brand} ${compressor.model} et ${tool.label}, avec débit, pression, limites et sources.`} noindex={true} imagePath="/social/compatibilite.png" imageAlt={`Compatibilité ${compressor.brand} ${compressor.model} et ${tool.model}`} modifiedDate={new Date(verifiedAt)} breadcrumbs={[{ name: 'Compatibilité', path: '/calculateur/' }, { name: title, path: pageUrl }]}>
	<article class="container content compatibility-page"><p class="eyebrow">Compatibilité calculée · sources vérifiées jusqu’au {formatFrenchDate(verifiedAt)}</p><h1>{compressor.brand} {compressor.model} avec {tool.model}</h1><div class:list={['compatibility-verdict', `verdict-${result.verdict}`]}><strong>{labels[result.verdict]}</strong><span>Fiabilité du résultat {result.confidence === 'high' ? 'élevée' : result.confidence === 'medium' ? 'moyenne' : 'faible'}</span></div>
		<h2>Données utilisées pour ce résultat</h2><dl class="spec-table"><div><dt>Besoin de l’outil</dt><dd>{tool.airflowLpm.typical} L/min à {tool.workingPressureBar.typical} bar</dd></div><div><dt><a href="/glossaire/#debit-restitue">Débit restitué recommandé</a></dt><dd>{Math.round(result.requiredFadLpm!)} L/min avec la réserve CompatAir</dd></div><div><dt>Débit restitué documenté</dt><dd>{result.availableFadLpm !== undefined ? `${Math.round(result.availableFadLpm)} L/min à ${tool.workingPressureBar.typical} bar` : 'Non disponible à cette pression'}</dd></div><div><dt>Ce qui limite l’utilisation</dt><dd>{result.limitingFactor === 'flow' ? 'Le débit' : result.limitingFactor === 'pressure' ? 'La pression' : result.limitingFactor ?? 'Aucune limite avec la consommation publiée'}</dd></div></dl>
		<h2>Ce que cela signifie</h2>{result.verdict === 'continuous' ? <p>Le débit réellement disponible couvre la consommation publiée de l’outil à la pression demandée. {result.availableFadLpm! < result.requiredFadLpm! ? 'La réserve proposée de 25 % n’est toutefois pas atteinte.' : 'La réserve proposée de 25 % est également couverte.'}</p> : <p>Le compresseur ne couvre pas le débit ou la pression nécessaire. Une cuve plus grande ne peut pas compenser durablement ce manque.</p>}
		{result.warnings.length > 0 && <div class="limit-box"><h3>Réserves</h3><ul>{result.warnings.map((warning) => <li>{warning}</li>)}</ul></div>}
		<div class="actions"><a class="button primary" href={`/calculateur/?outil=${tool.id}`}>Vérifier une autre configuration</a><a class="button" href={`/compresseurs/${compressor.slug}/`}>Fiche compresseur</a><a class="button" href={`/outils-pneumatiques/${tool.slug}/`}>Fiche outil</a></div>
		<h2>Sources</h2><p><a href={compressor.evidence[0].sourceUrl} rel="nofollow noopener" target="_blank">{compressor.evidence[0].sourceLabel}</a></p><p><a href={tool.evidence[0].sourceUrl} rel="nofollow noopener" target="_blank">{tool.evidence[0].sourceLabel}</a></p>
	</article>
</BaseLayout>
