---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compressors } from '../../data/catalog';
import { brandSlug } from '../../domain/brand';
import { serializeJsonLd } from '../../domain/structured-data';

const brandGroups = [...new Set(compressors.map((item) => item.brand))]
	.sort((left, right) => left.localeCompare(right, 'fr'))
	.map((brand) => {
		const items = compressors.filter((item) => item.brand === brand);
		return {
			brand,
			count: items.length,
			documentedFad: items.filter((item) => item.fadCurve.length > 0).length,
			multipleFad: items.filter((item) => item.fadCurve.length > 1).length,
			highConfidence: items.filter((item) => item.confidence === 'A' || item.confidence === 'B').length,
		};
	});
const documentedFadCount = compressors.filter((item) => item.fadCurve.length > 0).length;
const multipleFadCount = compressors.filter((item) => item.fadCurve.length > 1).length;
const brandListJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Compresseurs documentés classés par fabricant',
	itemListElement: brandGroups.map((group, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: `Compresseurs ${group.brand}`,
		url: `https://compatair.fr/marques/${brandSlug(group.brand)}/`,
	})),
};
---

<BaseLayout
	title="Compresseurs d’air par marque | CompatAir"
	description={`Explorez ${compressors.length} compresseurs classés par fabricant : débit restitué, pression, cuve, identifiants et données manquantes reliés à leurs sources.`}
	breadcrumbs={[{ name: 'Compresseurs', path: '/compresseurs/' }]}
>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(brandListJsonLd)} />
	<section class="page-hero compact catalog-hero">
		<div class="container catalog-hero-grid">
			<div>
				<p class="product-decision-index">Catalogue</p>
				<h1>Compresseurs par marque</h1>
				<p class="lead">Retrouvez un modèle, son débit restitué, sa pression et les documents du fabricant.</p>
				<form class="directory-controls brand-controls" action="/recherche/" method="get">
					<div class="field directory-search"><label for="compressor-directory-search">Marque, modèle, MPN, EAN/GTIN ou SKU</label><input id="compressor-directory-search" name="q" type="search" placeholder="Ex. 601532000 ou EPC 840" required minlength="2" /></div>
					<button class="button primary" type="submit">Rechercher la référence</button>
				</form>
				<div class="hero-actions"><a class="button" href="/calculateur/">Vérifier avec mes outils</a><a class="button" href="/comparatifs/compresseurs-debit-restitue/">Comparer les débits FAD</a></div>
			</div>
		</div>
	</section>

	<section class="catalog-summary-band">
		<div class="container">
			<div><strong>{documentedFadCount}</strong><span>débits FAD documentés</span></div>
			<div><strong>{compressors.length - documentedFadCount}</strong><span>références à compléter</span></div>
			<div><strong>{brandGroups.length}</strong><span>fabricants suivis</span></div>
			<div><strong>{multipleFadCount}</strong><span>FAD à plusieurs pressions</span></div>
		</div>
	</section>

	<section class="section catalog-directory" data-directory-hub="compressors-by-brand">
		<div class="container">
			<header class="product-section-head">
				<div><h2>Marques de compresseurs</h2></div>
			</header>

			<div class="hub-intent-grid">
				{brandGroups.map((group, index) => (
					<a href={`/marques/${brandSlug(group.brand)}/`}>
						<span class="hub-intent-index">{String(index + 1).padStart(2, '0')}</span>
						<p>{group.count} modèle{group.count > 1 ? 's' : ''} documenté{group.count > 1 ? 's' : ''}</p>
						<h3>{group.brand}</h3>
						<small>{group.documentedFad}/{group.count} avec FAD · {group.multipleFad} avec plusieurs pressions · {group.highConfidence} source{group.highConfidence > 1 ? 's' : ''} de grade A ou B.</small>
						<strong>Voir les modèles →</strong>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
