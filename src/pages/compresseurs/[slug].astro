---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDecisionHero from '../../components/ProductDecisionHero.astro';
import ProductEvidenceDossier from '../../components/ProductEvidenceDossier.astro';
import DecisionComparisonLinks from '../../components/DecisionComparisonLinks.astro';
import { assertDecisionPageValue, compressorFlowAnswer, explainCompatibility } from '../../domain/decision-dossier';
import { purchaseLinksForProduct } from '../../data/direct-purchase-links';
import { compressors, tools } from '../../data/catalog';
import { evidenceHistoryProductHref } from '../../data/evidence-history-directory';
import { productSeoDescription, productSeoTitle } from '../../data/product-seo-titles';
import { toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
import { activeOffers, merchants } from '../../data/offers';
import { latestEvidenceDate } from '../../domain/provenance';
import { offerJsonLd } from '../../domain/product-structured-data';
import { brandSlug } from '../../domain/brand';
import { compressorDisplayName } from '../../domain/product-display';
import { createCompressorCompatibilitySummary } from '../../domain/seo-selection';
import { serializeJsonLd } from '../../domain/structured-data';
import { compatibilityFadLabel } from '../../domain/compatibility';
import { sourceQualityLabel } from '../../domain/source-quality';
import { normalizeMpn, sourceRoleForEvidence } from '../../domain/catalog-normalization';
import { sourceRoleLabel } from '../../data/source-directory';

export function getStaticPaths() {
	return compressors.map((compressor) => { assertDecisionPageValue(compressor); return { params: { slug: compressor.slug }, props: { compressor } }; });
}

const { compressor } = Astro.props;
const displayName = compressorDisplayName(compressor);
const historyHref = evidenceHistoryProductHref(compressor.id);
const verifiedAt = latestEvidenceDate(compressor);
const compatibility = createCompressorCompatibilitySummary(compressor, tools);
const staticCompatibilityResultCount = compatibility.compatibleExamples.slice(0, 3).length + compatibility.incompatibleExamples.length;
const productOffers = activeOffers.filter((offer) => offer.productId === compressor.id);
const directLinks = purchaseLinksForProduct(compressor.id);
const focusMatches = compatibility.matches.filter(({ tool }) => ['einhell-tc-pw-340', 'metabo-dsx-150'].includes(tool.id));
const alternatives = compressors.filter((item) => item.id !== compressor.id && (item.confidence === 'A' || item.confidence === 'B') && item.fadCurve.length > 0).sort((a, b) => (Math.abs(a.tankLiters - compressor.tankLiters) + Math.abs(a.maxPressureBar - compressor.maxPressureBar) * 10) - (Math.abs(b.tankLiters - compressor.tankLiters) + Math.abs(b.maxPressureBar - compressor.maxPressureBar) * 10)).slice(0, 3);
const verifiedDateLabel = verifiedAt.split('-').reverse().join('/');
const fadSummary = compressor.fadCurve.length
	? `${compressor.fadCurve[0].litersPerMinute} L/min à ${compressor.fadCurve[0].pressureBar} bar${compressor.fadCurve.length > 1 ? ` + ${compressor.fadCurve.length - 1} autre${compressor.fadCurve.length > 2 ? 's' : ''} point${compressor.fadCurve.length > 2 ? 's' : ''}` : ''}`
	: 'Non documenté';
const productJsonLd = productOffers.length ? {
	'@context': 'https://schema.org', '@type': 'Product', name: displayName,
	image: `https://compatair.fr${compressor.image.src}`, brand: { '@type': 'Brand', name: compressor.brand },
	model: compressor.model, ...(compressor.mpn ? { mpn: compressor.mpn } : {}),
	description: compressor.editorial.overview, url: `https://compatair.fr/compresseurs/${compressor.slug}/`,
	category: 'Compresseur d’air',
	additionalProperty: [
		{ '@type': 'PropertyValue', name: 'Volume de cuve', value: `${compressor.tankLiters} L` },
		{ '@type': 'PropertyValue', name: 'Pression maximale', value: `${compressor.maxPressureBar} bar` },
		...(compressor.fadCurve.length ? [{ '@type': 'PropertyValue', name: 'Débit restitué documenté', value: compressor.fadCurve.map((point) => `${point.litersPerMinute} L/min à ${point.pressureBar} bar`).join(', ') }] : []),
		...compressor.specifications.map((specification) => ({ '@type': 'PropertyValue', name: specification.label, value: specification.value })),
	],
	offers: productOffers.map((offer) => offerJsonLd(offer, merchants, `https://compatair.fr/compresseurs/${compressor.slug}/`)),
} : undefined;
---

<BaseLayout
	title={`${compressor.brand} ${compressor.model} : débit et compatibilité | CompatAir`}
	editorialTitle={productSeoTitle(compressor.id)}
	description={productSeoDescription(compressor.id, `Analyse du ${displayName} : cuve ${compressor.tankLiters} L, pression ${compressor.maxPressureBar} bar et débit restitué sourcé.`)}
	pageType="product"
	imagePath="/social/compresseurs.png"
	imageAlt="Catalogue des compresseurs documentés par CompatAir"
	preloadImagePath={compressor.image.src}
	modifiedDate={new Date(verifiedAt)}
	breadcrumbs={[
		{ name: 'Compresseurs', path: '/compresseurs/' },
		{ name: compressor.brand, path: `/marques/${brandSlug(compressor.brand)}/` },
		{ name: displayName, path: `/compresseurs/${compressor.slug}/` },
	]}
>
	{productJsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(productJsonLd)} />}
	<article class="container product-detail" data-product-brand={compressor.brand} data-product-model={compressor.model} data-product-mpn={compressor.mpn ?? ''}>
		<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/compresseurs/">Compresseurs</a><span>/</span><a data-product-brand-link href={`/marques/${brandSlug(compressor.brand)}/`}>{compressor.brand}</a><span>/</span><span>{displayName}</span></nav>
		<ProductDecisionHero
			kind="Compresseur"
			eyebrow="Débit, pression et usages vérifiés"
			title={displayName}
			lead={compressor.editorial.overview}
			reference={`Référence ${compressor.mpn ?? 'non renseignée'} · ${compressor.oilType === 'oil-free' ? 'sans huile' : 'lubrifié'}`}
			image={compressor.image}
			qualityLabel={sourceQualityLabel(compressor.confidence)}
			verifiedDate={verifiedDateLabel}
			metrics={[
				{ label: 'Débit restitué documenté', value: fadSummary },
				{ label: 'Pression maximale', value: `${compressor.maxPressureBar} bar`, detail: `${compressor.tankLiters} L de cuve` },
				{ label: 'Outils compatibles', value: String(compatibility.counts.compatible), detail: `${compatibility.counts.incompatible} incompatibles · ${compatibility.counts.insufficient} indéterminés` },
				{ label: 'Qualité des données', value: sourceQualityLabel(compressor.confidence), detail: `Grade technique ${compressor.confidence}` },
			]}
			actions={[
				{ href: `/calculateur/#compresseur=${compressor.id}`, label: 'Vérifier avec mon outil', primary: true },
				{ href: `/comparateur/#ids=${compressor.id},${alternatives[0].id}`, label: 'Comparer ce modèle' },
			]}
		/>

		<section class="product-decision-section" data-product-decision data-static-compatibility-results data-result-count={staticCompatibilityResultCount}>
			<header class="product-section-head"><div><p class="product-decision-index">01 / Réponse utile</p><h2>Ce compresseur peut-il couvrir vos outils&nbsp;?</h2></div><p>Les résultats ci-dessous utilisent uniquement le débit restitué disponible à la pression demandée. Le débit aspiré n’entre jamais dans le verdict.</p></header>
			<div class="product-verdict-counts" aria-label="Résumé des compatibilités"><div><strong>{compatibility.counts.compatible}</strong><span>outils compatibles</span></div><div><strong>{compatibility.counts.incompatible}</strong><span>outils incompatibles</span></div><div><strong>{compatibility.counts.insufficient}</strong><span>résultats à documenter</span></div></div>
			{compatibility.counts.compatible === 0 && <div class="product-resolution-callout"><strong>{compatibility.counts.incompatible > 0 ? 'Aucun outil du catalogue n’est compatible dans les scénarios de référence.' : 'Les données disponibles ne permettent pas de conclure pour les outils du catalogue.'}</strong><p>{compatibility.counts.incompatible > 0 ? `Le moteur conclut à une incompatibilité pour ${compatibility.counts.incompatible} outils. Les ${compatibility.counts.insufficient} autres résultats demandent des données techniques ou des paramètres d’usage complémentaires. Un verdict défavorable ne signifie pas que le débit publié est absent.` : 'La pression documentée, la qualité de la source ou les paramètres d’usage ne permettent pas de rendre un verdict concluant. Le débit aspiré ne remplace pas ces informations.'} Pour un usage par impulsions, indiquez votre cadence réelle dans le calculateur.</p><a class="button primary" href={`/calculateur/#compresseur=${compressor.id}`}>Choisir mon outil et trouver des alternatives</a></div>}
			<h3>{compatibility.compatibleExamples.length ? 'Quelques usages représentatifs compatibles' : 'Préciser l’usage ou chercher un autre compresseur'}</h3>
			<div class="product-decision-cards">{compatibility.compatibleExamples.slice(0, 3).map(({ tool, result }, index) => <article><span>0{index + 1}</span><div><strong>{tool.label}</strong><small>{toolDemandLabel(tool)} · {toolPressureLabel(tool)}</small><p>{compatibilityFadLabel(result, tool.workingPressureBar.typical!)}</p></div><a href={`/calculateur/#outil=${tool.id}&compresseur=${compressor.id}`}>Vérifier cette configuration</a></article>)}</div>
			<div class="actions"><a class="button primary" href={`/calculateur/#compresseur=${compressor.id}`}>Trouver trois solutions pour mon contexte</a><a class="button" href="#donnees-techniques">Voir toutes les données techniques</a></div>
		</section>

		<section class="editorial-section" id="avis-technique" data-product-use-answers data-static-compatibility-results data-result-count={focusMatches.length}>
			<h2>Avis technique : quels outils peut alimenter {compressor.model}&nbsp;?</h2><p>{compressorFlowAnswer(compressor)}</p>
			{focusMatches.map(({ tool, result }) => <section class="editorial-section"><h3>{tool.categoryId === 'cle-a-chocs' ? 'Ce compresseur suffit-il pour une clé à chocs ?' : 'Peut-il alimenter une ponceuse pneumatique ?'}</h3><p><strong>{tool.brand} {tool.model} : {result.verdict === 'continuous' ? 'débit nominal couvert' : result.verdict === 'intermittent' ? 'usage intermittent' : result.verdict === 'incompatible' ? 'débit ou pression insuffisant pour le scénario étudié' : 'données insuffisantes'}.</strong> {explainCompatibility(compressor, tool, result)}</p><p>La réponse vaut pour cette référence précise, utilisée seule au débit publié. Une autre clé, une autre ponceuse ou une cadence différente demande un nouveau calcul.</p><div class="actions"><a href={`/quel-compresseur-pour/${tool.slug}/`}>Compresseurs adaptés à {tool.brand} {tool.model}</a><a href={`/outils-pneumatiques/${tool.slug}/`}>Sources du besoin de cet outil</a><a href={`/calculateur/#outil=${tool.id}&compresseur=${compressor.id}`}>Vérifier ma cadence réelle</a></div></section>)}
			<DecisionComparisonLinks productId={compressor.id} />
		</section>

		<section class="spec-panel" id="donnees-techniques"><p class="product-decision-index">02 / Données techniques</p><h2>Caractéristiques vérifiées</h2><dl class="spec-table"><div><dt>Référence fabricant</dt><dd>{compressor.mpn ?? 'Non documentée'}</dd></div><div><dt>MPN normalisé</dt><dd>{compressor.mpn ? normalizeMpn(compressor.mpn) : 'Non documenté'}</dd></div><div><dt>EAN/GTIN</dt><dd>{compressor.ean ?? compressor.gtin ?? 'Non documenté'}</dd></div><div><dt>SKU distributeur</dt><dd>{compressor.distributorSkus.length ? compressor.distributorSkus.map((identifier) => `${identifier.distributorId} : ${identifier.sku}`).join(' · ') : 'Non documenté'}</dd></div><div><dt><a href="/glossaire/#cuve">Cuve</a></dt><dd>{compressor.tankLiters} L</dd></div><div><dt><a href="/glossaire/#pression-maximale">Pression maximale</a></dt><dd>{compressor.maxPressureBar} bar</dd></div><div><dt><a href="/glossaire/#debit-aspire">Débit aspiré</a></dt><dd>{compressor.intakeFlowLpm ? `${compressor.intakeFlowLpm} L/min, non utilisé pour le résultat` : 'Non publié'}</dd></div><div><dt><a href="/glossaire/#debit-restitue">Débit réellement restitué</a></dt><dd>{compressor.fadCurve.length ? compressor.fadCurve.map((point) => `${point.litersPerMinute} L/min à ${point.pressureBar} bar`).join(' · ') : 'Donnée insuffisante'}</dd></div><div><dt><a href="/glossaire/#cycle-service">Temps maximal de fonctionnement publié</a></dt><dd>{compressor.dutyCycle ? `${Math.round(compressor.dutyCycle * 100)} %` : 'Non documenté'}</dd></div><div><dt>Puissance</dt><dd>{compressor.powerKw ? `${compressor.powerKw} kW` : 'Non documentée'}</dd></div><div><dt>Alimentation</dt><dd>{compressor.voltage ?? 'Non documentée'}{compressor.phase ? ` · ${compressor.phase === 'single-phase' ? 'monophasé' : 'triphasé'}` : ''}</dd></div><div><dt>Mobilité</dt><dd>{compressor.mobility === 'portable' ? 'Portable' : compressor.mobility === 'mobile' ? 'Mobile' : compressor.mobility === 'fixed' ? 'Fixe' : 'Non documentée'}</dd></div><div><dt>Poids</dt><dd>{compressor.weightKg ? `${compressor.weightKg} kg` : 'Non documenté'}</dd></div><div><dt>Niveau sonore publié</dt><dd>{compressor.noiseDb ? `${compressor.noiseDb} dB, indicateur à vérifier dans la source` : 'Non documenté'}</dd></div>{compressor.specifications.map((specification) => <div><dt>{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl></section>

		<ProductEvidenceDossier product={compressor} />

		<section class="editorial-section"><h2>Lire le débit de ce compresseur</h2>{compressor.fadCurve.length ? <><p>Les points ci-dessous sont ceux publiés dans la source. CompatAir interpole entre deux points documentés. Pour un besoin inférieur au premier point, ce point peut servir de borne conservatrice, clairement signalée ; au-dessus du dernier point, le résultat reste indéterminé.</p><div class="curve-table" role="table" aria-label="Points de débit restitué"><div class="curve-row head" role="row"><span role="columnheader">Pression</span><span role="columnheader">Débit restitué</span></div>{compressor.fadCurve.map((point) => <div class="curve-row" role="row"><span role="cell">{point.pressureBar} bar</span><strong role="cell">{point.litersPerMinute} L/min</strong></div>)}</div></> : <p>Aucun débit restitué à une pression de travail n’est publié dans la source consultée. Le débit aspiré ne le remplace pas.</p>}</section>

		<section class="editorial-section"><h2>Couverture par catégorie d’outil</h2><p>Cette synthèse décrit le corpus CompatAir, pas tous les outils du marché. L’exhaustivité des calculs reste dans le calculateur et les données publiques.</p><dl class="spec-table">{compatibility.categorySummary.map((category) => <div><dt>{category.category}</dt><dd>{category.compatible} compatible{category.compatible > 1 ? 's' : ''} · {category.incompatible} incompatible{category.incompatible > 1 ? 's' : ''} · {category.insufficient} indéterminé{category.insufficient > 1 ? 's' : ''}</dd></div>)}</dl>{compatibility.incompatibleExamples.length > 0 && <><h3>Exemples proches mais incompatibles</h3><div class="compatibility-table">{compatibility.incompatibleExamples.map(({ tool, result }) => <a href={`/calculateur/#outil=${tool.id}&compresseur=${compressor.id}`}><span><strong>{tool.label}</strong><small>{toolDemandLabel(tool)} · {toolPressureLabel(tool)} · {compatibilityFadLabel(result, tool.workingPressureBar.typical!)}</small></span><strong class="text-incompatible">Incompatible</strong></a>)}</div></>}<div class="actions"><a class="button primary" href={`/calculateur/#compresseur=${compressor.id}`}>Tester tous les outils dans le calculateur</a></div></section>

		<section class="related-reading"><h2>Approfondir avant de choisir</h2><div class="link-cards">{compressor.phase === 'three-phase' && <a href="/guides/compresseur-triphase-ou-monophase-atelier/"><strong>Triphasé ou monophasé</strong><span>Vérifier l’alimentation de l’atelier sans la confondre avec le débit disponible.</span></a>}<a href="/guides/debit-restitue-fad-vs-debit-aspire/"><strong>Quel débit faut-il regarder&nbsp;?</strong><span>Distinguer le débit réellement disponible du chiffre commercial aspiré.</span></a><a href="/guides/choisir-volume-cuve-24-50-90-litres/"><strong>Comprendre le rôle de la cuve</strong><span>Distinguer stockage d’air et capacité de production.</span></a><a href="/methodologie/"><strong>Comment CompatAir calcule le résultat</strong><span>Voir les données utilisées et les limites du calcul.</span></a></div></section>
		<section class="editorial-section"><h2 id="ou-acheter">Où acheter {compressor.model}&nbsp;?</h2>{directLinks.length > 0 && <><p>Liens directs sans affiliation, appariés à l’EAN de cette référence. Prix et disponibilité sont à vérifier sur le site vendeur ; ces liens ne prouvent aucun partenariat.</p><div class="link-cards">{directLinks.map((link) => <a data-direct-purchase-link href={link.url} target="_blank" rel="noopener noreferrer nofollow"><strong>Consulter la fiche chez {link.merchant}</strong><span>EAN {link.ean} · page repérée le {link.checkedAt.split('-').reverse().join('/')}</span><span>{link.note}</span></a>)}</div></>}{productOffers.length ? <div class="offer-list">{productOffers.map((offer) => <a href={`/go/${offer.id}`} rel="sponsored nofollow noopener"><span><strong>Voir l’offre vérifiée chez {merchants.find((item) => item.id === offer.merchantId)?.name}</strong><small>{offer.productName} · référence {offer.merchantProductId} · collectée le {new Date(offer.collectedAt).toLocaleDateString('fr-FR')} · {offer.availability}</small></span><strong>{offer.priceEur.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' })}</strong></a>)}</div> : directLinks.length ? <p>Aucun prix ni stock synchronisé sur CompatAir.</p> : <div class="status-callout product-no-offer"><strong>Aucun vendeur vérifié pour cette référence</strong><span>CompatAir ne connaît actuellement ni prix daté, ni disponibilité, ni lien marchand fiable pour ce modèle. Aucun vendeur n’est inventé. L’action « Trouver trois solutions pour mon contexte » permet de poursuivre sans masquer cette limite.</span><div class="merchant-interest-control"><button class="button" type="button" data-merchant-interest aria-pressed="false">Je cherche où acheter cette référence</button><small data-merchant-interest-status aria-live="polite">Ce signal ne transmet ni la référence ni une donnée personnelle.</small></div></div>}</section>
		<section class="editorial-section"><h2>Quelles alternatives à {compressor.model}&nbsp;?</h2><p>Cette sélection rapproche le volume de cuve et la pression maximale. L’alimentation et la mobilité restent visibles pour éviter de confondre une proximité technique avec un achat réaliste.</p><div class="link-cards">{alternatives.map((item) => <a href={`/compresseurs/${item.slug}/`}><strong>{compressorDisplayName(item)}</strong><span>{item.tankLiters} L · {item.maxPressureBar} bar · {item.voltage ?? 'alimentation non documentée'} · {item.mobility === 'portable' ? 'portable' : item.mobility === 'mobile' ? 'mobile' : item.mobility === 'fixed' ? 'fixe' : 'mobilité non documentée'} · {sourceQualityLabel(item.confidence)}</span></a>)}</div>{alternatives.length > 0 && <div class="actions"><a class="button" href={`/comparateur/#ids=${compressor.id},${alternatives[0].id}`}>Comparer côte à côte</a></div>}</section>
		<section class="sources-panel"><h2>Sources et réserves</h2>{compressor.evidence.map((evidence) => <p><a href={evidence.sourceUrl} rel="nofollow noopener" target="_blank">{evidence.sourceLabel}</a> · {sourceRoleLabel[sourceRoleForEvidence(evidence)]} · consultée le {evidence.retrievedAt.split('-').reverse().join('/')} · {sourceQualityLabel(evidence.confidence)} <small>(grade technique {evidence.confidence})</small></p>)}{compressor.notes.map((note) => <p>{note}</p>)}<p><a href={historyHref}>Voir les documents et dates vérifiés pour cette référence</a></p></section>
	</article>
</BaseLayout>
