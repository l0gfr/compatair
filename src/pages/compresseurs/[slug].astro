---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import { compressors, tools } from '../../data/catalog';
import { productSeoTitle } from '../../data/product-seo-titles';
import { evaluateCompatibility } from '../../domain/compatibility';
import { toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
import { activeOffers, merchants } from '../../data/offers';
import { latestEvidenceDate } from '../../domain/provenance';
import { offerJsonLd } from '../../domain/product-structured-data';
import { serializeJsonLd } from '../../domain/structured-data';

export function getStaticPaths() {
	return compressors.map((compressor) => ({ params: { slug: compressor.slug }, props: { compressor } }));
}

const { compressor } = Astro.props;
const variantDescription = compressor.variant ? `, variante ${compressor.variant.label}` : '';
const verifiedAt = latestEvidenceDate(compressor);
const matches = tools.map((tool) => ({ tool, result: evaluateCompatibility(compressor, tool) }));
const productOffers = activeOffers.filter((offer) => offer.productId === compressor.id);
const alternatives = compressors.filter((item) => item.id !== compressor.id).sort((a, b) => (Math.abs(a.tankLiters - compressor.tankLiters) + Math.abs(a.maxPressureBar - compressor.maxPressureBar) * 10) - (Math.abs(b.tankLiters - compressor.tankLiters) + Math.abs(b.maxPressureBar - compressor.maxPressureBar) * 10)).slice(0, 3);
const labels = { continuous: 'Continu', intermittent: 'Intermittent', incompatible: 'Incompatible', insufficient_data: 'Données insuffisantes' };
const productJsonLd = productOffers.length ? {
	'@context': 'https://schema.org', '@type': 'Product', name: `${compressor.brand} ${compressor.model}`,
	image: `https://compatair.fr${compressor.image.src}`, brand: { '@type': 'Brand', name: compressor.brand },
	model: compressor.model, ...(compressor.mpn ? { mpn: compressor.mpn } : {}),
	description: compressor.editorial.overview, url: `https://compatair.fr/compresseurs/${compressor.slug}/`,
	category: 'Compresseur d’air',
	additionalProperty: [
		{ '@type': 'PropertyValue', name: 'Volume de cuve', value: `${compressor.tankLiters} L` },
		{ '@type': 'PropertyValue', name: 'Pression maximale', value: `${compressor.maxPressureBar} bar` },
		...(compressor.fadCurve.length ? [{ '@type': 'PropertyValue', name: 'Débit restitué documenté', value: compressor.fadCurve.map((point) => `${point.litersPerMinute} L/min à ${point.pressureBar} bar`).join(', ') }] : []),
		...compressor.specifications.map((specification) => ({ '@type': 'PropertyValue', name: specification.label, value: specification.value })),
	],
	offers: productOffers.map((offer) => offerJsonLd(offer, merchants, `https://compatair.fr/compresseurs/${compressor.slug}/`)),
} : undefined;
---

<BaseLayout
	title={`${compressor.brand} ${compressor.model} : débit et compatibilité | CompatAir`}
	editorialTitle={productSeoTitle(compressor.id)}
	description={`Analyse du ${compressor.brand} ${compressor.model}${variantDescription} : cuve ${compressor.tankLiters} L, pression ${compressor.maxPressureBar} bar et débit restitué sourcé.`}
	pageType="product"
	imagePath="/social/compresseurs.png"
	imageAlt="Catalogue des compresseurs documentés par CompatAir"
	modifiedDate={new Date(verifiedAt)}
	breadcrumbs={[{ name: 'Compresseurs', path: '/compresseurs/' }, { name: `${compressor.brand} ${compressor.model}`, path: `/compresseurs/${compressor.slug}/` }]}
>
	{productJsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(productJsonLd)} />}
	<article class="container product-detail">
		<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/compresseurs/">Compresseurs</a><span>/</span><span>{compressor.brand} {compressor.model}</span></nav>
		<div class="product-hero"><div><p class="eyebrow">Fiche compresseur · sources vérifiées</p><h1>{compressor.brand} {compressor.model}</h1><p class="lead">{compressor.editorial.overview}</p><p class="product-reference">Référence {compressor.mpn ?? 'non renseignée'} · {compressor.oilType === 'oil-free' ? 'sans huile' : 'lubrifié'} · fiabilité des données {compressor.confidence}.</p></div><ProductImage image={compressor.image} eager /></div>

		<section class="spec-panel"><h2>Caractéristiques vérifiées</h2><dl class="spec-table"><div><dt>Référence fabricant</dt><dd>{compressor.mpn ?? 'Non documentée'}</dd></div><div><dt>Numéro de code-barres</dt><dd>{compressor.ean ?? compressor.gtin ?? 'Non documenté'}</dd></div><div><dt><a href="/glossaire/#cuve">Cuve</a></dt><dd>{compressor.tankLiters} L</dd></div><div><dt><a href="/glossaire/#pression-maximale">Pression maximale</a></dt><dd>{compressor.maxPressureBar} bar</dd></div><div><dt><a href="/glossaire/#debit-aspire">Débit aspiré</a></dt><dd>{compressor.intakeFlowLpm ? `${compressor.intakeFlowLpm} L/min, non utilisé pour le résultat` : 'Non publié'}</dd></div><div><dt><a href="/glossaire/#debit-restitue">Débit réellement restitué</a></dt><dd>{compressor.fadCurve.length ? compressor.fadCurve.map((point) => `${point.litersPerMinute} L/min à ${point.pressureBar} bar`).join(' · ') : 'Donnée insuffisante'}</dd></div><div><dt><a href="/glossaire/#cycle-service">Temps maximal de fonctionnement publié</a></dt><dd>{compressor.dutyCycle ? `${Math.round(compressor.dutyCycle * 100)} %` : 'Non documenté'}</dd></div><div><dt>Puissance</dt><dd>{compressor.powerKw ? `${compressor.powerKw} kW` : 'Non documentée'}</dd></div><div><dt>Alimentation</dt><dd>{compressor.voltage ?? 'Non documentée'}{compressor.phase ? ` · ${compressor.phase === 'single-phase' ? 'monophasé' : 'triphasé'}` : ''}</dd></div><div><dt>Mobilité</dt><dd>{compressor.mobility === 'portable' ? 'Portable' : compressor.mobility === 'mobile' ? 'Mobile' : compressor.mobility === 'fixed' ? 'Fixe' : 'Non documentée'}</dd></div><div><dt>Poids</dt><dd>{compressor.weightKg ? `${compressor.weightKg} kg` : 'Non documenté'}</dd></div><div><dt>Niveau sonore publié</dt><dd>{compressor.noiseDb ? `${compressor.noiseDb} dB, indicateur à vérifier dans la source` : 'Non documenté'}</dd></div>{compressor.specifications.map((specification) => <div><dt>{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl></section>

		<section class="editorial-section"><p class="eyebrow">Lecture CompatAir</p><h2>Ce que la documentation permet d’affirmer</h2><div class="evidence-grid"><div class="fact-box"><h3>Faits vérifiés</h3><ul>{compressor.editorial.verifiedFacts.map((fact) => <li>{fact}</li>)}</ul></div><div class="limit-box"><h3>Limites</h3><ul>{compressor.editorial.limitations.map((limit) => <li>{limit}</li>)}</ul></div></div></section>

		<section class="editorial-section"><h2>Lire le débit de ce compresseur</h2>{compressor.fadCurve.length ? <><p>Les points ci-dessous sont ceux publiés dans la source. CompatAir interpole uniquement entre deux points documentés et ne prolonge pas la courbe en dehors de cette plage.</p><div class="curve-table" role="table" aria-label="Points de débit restitué"><div class="curve-row head" role="row"><span role="columnheader">Pression</span><span role="columnheader">Débit restitué</span></div>{compressor.fadCurve.map((point) => <div class="curve-row" role="row"><span role="cell">{point.pressureBar} bar</span><strong role="cell">{point.litersPerMinute} L/min</strong></div>)}</div></> : <p>Aucun débit restitué à une pression de travail n’est publié dans la source consultée. Le débit aspiré ne le remplace pas.</p>}</section>

		<section class="editorial-section"><h2>Quels outils ce compresseur peut-il alimenter&nbsp;?</h2><p>CompatAir compare le <a href="/glossaire/#debit-restitue">débit réellement disponible</a> à la consommation publiée de chaque outil, à la même pression. Lorsqu’une information d’usage manque, le résultat reste «&nbsp;données insuffisantes&nbsp;».</p><div class="compatibility-table">{matches.map(({ tool, result }) => <a href={`/outils-pneumatiques/${tool.slug}/`}><span><strong>{tool.label}</strong><small>{toolDemandLabel(tool)} · {toolPressureLabel(tool)}{result.availableFadLpm !== undefined ? ` · ${Math.round(result.availableFadLpm)} L/min documentés` : ''}</small></span><strong class={`text-${result.verdict}`}>{labels[result.verdict]}</strong></a>)}</div></section>

		<section class="related-reading"><h2>Approfondir avant de choisir</h2><div class="link-cards">{compressor.phase === 'three-phase' && <a href="/guides/compresseur-triphase-ou-monophase-atelier/"><strong>Triphasé ou monophasé</strong><span>Vérifier l’alimentation de l’atelier sans la confondre avec le débit disponible.</span></a>}<a href="/guides/debit-restitue-fad-vs-debit-aspire/"><strong>Quel débit faut-il regarder&nbsp;?</strong><span>Distinguer le débit réellement disponible du chiffre commercial aspiré.</span></a><a href="/guides/choisir-volume-cuve-24-50-90-litres/"><strong>Comprendre le rôle de la cuve</strong><span>Distinguer stockage d’air et capacité de production.</span></a><a href="/methodologie/"><strong>Comment CompatAir calcule le résultat</strong><span>Voir les données utilisées et les limites du calcul.</span></a></div></section>
		<section class="editorial-section"><h2>Offres marchandes</h2>{productOffers.length ? <div class="offer-list">{productOffers.map((offer) => <a href={`/go/${offer.id}`} rel="sponsored nofollow noopener"><span><strong>{merchants.find((item) => item.id === offer.merchantId)?.name} · {offer.productName}</strong><small>Référence de l’offre {offer.merchantProductId} · collectée le {new Date(offer.collectedAt).toLocaleDateString('fr-FR')} · {offer.availability}</small></span><strong>{offer.priceEur.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' })}</strong></a>)}</div> : <div class="status-callout"><strong>Aucune offre vérifiée</strong><span>Les partenaires marchands ne sont pas encore raccordés. Aucun prix ou lien d’achat n’est inventé.</span></div>}</section>
		<section class="editorial-section"><h2>Modèles proches à comparer</h2><p>Cette sélection rapproche uniquement le volume de cuve et la pression maximale. Elle ne signifie pas que les modèles offrent les mêmes possibilités.</p><div class="link-cards">{alternatives.map((item) => <a href={`/compresseurs/${item.slug}/`}><strong>{item.brand} {item.model}</strong><span>{item.tankLiters} L · {item.maxPressureBar} bar · fiabilité des données {item.confidence}</span></a>)}</div><div class="actions"><a class="button" href={`/comparateur/#ids=${compressor.id},${alternatives[0].id}`}>Comparer côte à côte</a></div></section>
		<section class="sources-panel"><h2>Sources et réserves</h2>{compressor.evidence.map((evidence) => <p><a href={evidence.sourceUrl} rel="nofollow noopener" target="_blank">{evidence.sourceLabel}</a> · consultée le {evidence.retrievedAt.split('-').reverse().join('/')} · fiabilité {evidence.confidence}</p>)}{compressor.notes.map((note) => <p>{note}</p>)}<p><a href={`/preuves/#${compressor.id}`}>Voir les documents et dates vérifiés pour cette référence</a></p></section>
	</article>
</BaseLayout>
