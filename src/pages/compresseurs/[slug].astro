---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDecisionHero from '../../components/ProductDecisionHero.astro';
import { compressors, tools } from '../../data/catalog';
import { evidenceHistoryProductHref } from '../../data/evidence-history-directory';
import { productSeoTitle } from '../../data/product-seo-titles';
import { toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
import { activeOffers, merchants } from '../../data/offers';
import { latestEvidenceDate } from '../../domain/provenance';
import { offerJsonLd } from '../../domain/product-structured-data';
import { compressorDisplayName } from '../../domain/product-display';
import { createCompressorCompatibilitySummary } from '../../domain/seo-selection';
import { serializeJsonLd } from '../../domain/structured-data';
import { compatibilityFadLabel } from '../../domain/compatibility';
import { sourceQualityLabel } from '../../domain/source-quality';

export function getStaticPaths() {
	return compressors.map((compressor) => ({ params: { slug: compressor.slug }, props: { compressor } }));
}

const { compressor } = Astro.props;
const displayName = compressorDisplayName(compressor);
const historyHref = evidenceHistoryProductHref(compressor.id);
const verifiedAt = latestEvidenceDate(compressor);
const compatibility = createCompressorCompatibilitySummary(compressor, tools);
const staticCompatibilityResultCount = compatibility.compatibleExamples.slice(0, 3).length + compatibility.incompatibleExamples.length;
const productOffers = activeOffers.filter((offer) => offer.productId === compressor.id);
const alternatives = compressors.filter((item) => item.id !== compressor.id && (item.confidence === 'A' || item.confidence === 'B') && item.fadCurve.length > 0).sort((a, b) => (Math.abs(a.tankLiters - compressor.tankLiters) + Math.abs(a.maxPressureBar - compressor.maxPressureBar) * 10) - (Math.abs(b.tankLiters - compressor.tankLiters) + Math.abs(b.maxPressureBar - compressor.maxPressureBar) * 10)).slice(0, 3);
const verifiedDateLabel = verifiedAt.split('-').reverse().join('/');
const fadSummary = compressor.fadCurve.length
	? `${compressor.fadCurve[0].litersPerMinute} L/min à ${compressor.fadCurve[0].pressureBar} bar${compressor.fadCurve.length > 1 ? ` + ${compressor.fadCurve.length - 1} autre${compressor.fadCurve.length > 2 ? 's' : ''} point${compressor.fadCurve.length > 2 ? 's' : ''}` : ''}`
	: 'Non documenté';
const productJsonLd = productOffers.length ? {
	'@context': 'https://schema.org', '@type': 'Product', name: displayName,
	image: `https://compatair.fr${compressor.image.src}`, brand: { '@type': 'Brand', name: compressor.brand },
	model: compressor.model, ...(compressor.mpn ? { mpn: compressor.mpn } : {}),
	description: compressor.editorial.overview, url: `https://compatair.fr/compresseurs/${compressor.slug}/`,
	category: 'Compresseur d’air',
	additionalProperty: [
		{ '@type': 'PropertyValue', name: 'Volume de cuve', value: `${compressor.tankLiters} L` },
		{ '@type': 'PropertyValue', name: 'Pression maximale', value: `${compressor.maxPressureBar} bar` },
		...(compressor.fadCurve.length ? [{ '@type': 'PropertyValue', name: 'Débit restitué documenté', value: compressor.fadCurve.map((point) => `${point.litersPerMinute} L/min à ${point.pressureBar} bar`).join(', ') }] : []),
		...compressor.specifications.map((specification) => ({ '@type': 'PropertyValue', name: specification.label, value: specification.value })),
	],
	offers: productOffers.map((offer) => offerJsonLd(offer, merchants, `https://compatair.fr/compresseurs/${compressor.slug}/`)),
} : undefined;
---

<BaseLayout
	title={`${compressor.brand} ${compressor.model} : débit et compatibilité | CompatAir`}
	editorialTitle={productSeoTitle(compressor.id)}
	description={`Analyse du ${displayName} : cuve ${compressor.tankLiters} L, pression ${compressor.maxPressureBar} bar et débit restitué sourcé.`}
	pageType="product"
	imagePath="/social/compresseurs.png"
	imageAlt="Catalogue des compresseurs documentés par CompatAir"
	modifiedDate={new Date(verifiedAt)}
	breadcrumbs={[{ name: 'Compresseurs', path: '/compresseurs/' }, { name: displayName, path: `/compresseurs/${compressor.slug}/` }]}
>
	{productJsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(productJsonLd)} />}
	<article class="container product-detail" data-product-brand={compressor.brand} data-product-model={compressor.model} data-product-mpn={compressor.mpn ?? ''}>
		<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/compresseurs/">Compresseurs</a><span>/</span><span>{displayName}</span></nav>
		<ProductDecisionHero
			kind="Compresseur"
			eyebrow="Débit, pression et usages vérifiés"
			title={displayName}
			lead={compressor.editorial.overview}
			reference={`Référence ${compressor.mpn ?? 'non renseignée'} · ${compressor.oilType === 'oil-free' ? 'sans huile' : 'lubrifié'}`}
			image={compressor.image}
			qualityLabel={sourceQualityLabel(compressor.confidence)}
			verifiedDate={verifiedDateLabel}
			metrics={[
				{ label: 'Débit restitué documenté', value: fadSummary },
				{ label: 'Pression maximale', value: `${compressor.maxPressureBar} bar`, detail: `${compressor.tankLiters} L de cuve` },
				{ label: 'Outils compatibles', value: String(compatibility.counts.compatible), detail: `${compatibility.counts.incompatible} incompatibles · ${compatibility.counts.insufficient} indéterminés` },
				{ label: 'Qualité des données', value: sourceQualityLabel(compressor.confidence), detail: `Grade technique ${compressor.confidence}` },
			]}
			actions={[
				{ href: `/calculateur/#compresseur=${compressor.id}`, label: 'Vérifier avec mon outil', primary: true },
				{ href: `/comparateur/#ids=${compressor.id},${alternatives[0].id}`, label: 'Comparer ce modèle' },
			]}
		/>

		<section class="product-decision-section" data-product-decision data-static-compatibility-results data-result-count={staticCompatibilityResultCount}>
			<header class="product-section-head"><div><p class="product-decision-index">01 / Réponse utile</p><h2>Ce compresseur peut-il couvrir vos outils&nbsp;?</h2></div><p>Les résultats ci-dessous utilisent uniquement le débit restitué disponible à la pression demandée. Le débit aspiré n’entre jamais dans le verdict.</p></header>
			<div class="product-verdict-counts" aria-label="Résumé des compatibilités"><div><strong>{compatibility.counts.compatible}</strong><span>outils compatibles</span></div><div><strong>{compatibility.counts.incompatible}</strong><span>outils incompatibles</span></div><div><strong>{compatibility.counts.insufficient}</strong><span>résultats à documenter</span></div></div>
			{compatibility.counts.compatible === 0 && compatibility.counts.insufficient > 0 && <div class="product-resolution-callout"><strong>Ce modèle ne peut pas être dimensionné avec les données publiées.</strong><p>Son débit réellement restitué exploitable manque ou sa source ne permet pas de conclure. Choisissez votre outil dans le calculateur : ce modèle restera signalé comme non vérifiable et CompatAir proposera les références documentées qui couvrent le même besoin.</p><a class="button primary" href={`/calculateur/#compresseur=${compressor.id}`}>Choisir mon outil et trouver des alternatives</a></div>}
			<h3>{compatibility.compatibleExamples.length ? 'Quelques usages représentatifs compatibles' : 'Une sélection devient possible après avoir indiqué votre outil'}</h3>
			<div class="product-decision-cards">{compatibility.compatibleExamples.slice(0, 3).map(({ tool, result }, index) => <article><span>0{index + 1}</span><div><strong>{tool.label}</strong><small>{toolDemandLabel(tool)} · {toolPressureLabel(tool)}</small><p>{compatibilityFadLabel(result, tool.workingPressureBar.typical!)}</p></div><a href={`/calculateur/#outil=${tool.id}&compresseur=${compressor.id}`}>Vérifier cette configuration</a></article>)}</div>
			<div class="actions"><a class="button primary" href={`/calculateur/#compresseur=${compressor.id}`}>Tester mon propre outil</a><a class="button" href="#donnees-techniques">Voir toutes les données techniques</a></div>
		</section>

		<section class="spec-panel" id="donnees-techniques"><p class="product-decision-index">02 / Données techniques</p><h2>Caractéristiques vérifiées</h2><dl class="spec-table"><div><dt>Référence fabricant</dt><dd>{compressor.mpn ?? 'Non documentée'}</dd></div><div><dt>Numéro de code-barres</dt><dd>{compressor.ean ?? compressor.gtin ?? 'Non documenté'}</dd></div><div><dt><a href="/glossaire/#cuve">Cuve</a></dt><dd>{compressor.tankLiters} L</dd></div><div><dt><a href="/glossaire/#pression-maximale">Pression maximale</a></dt><dd>{compressor.maxPressureBar} bar</dd></div><div><dt><a href="/glossaire/#debit-aspire">Débit aspiré</a></dt><dd>{compressor.intakeFlowLpm ? `${compressor.intakeFlowLpm} L/min, non utilisé pour le résultat` : 'Non publié'}</dd></div><div><dt><a href="/glossaire/#debit-restitue">Débit réellement restitué</a></dt><dd>{compressor.fadCurve.length ? compressor.fadCurve.map((point) => `${point.litersPerMinute} L/min à ${point.pressureBar} bar`).join(' · ') : 'Donnée insuffisante'}</dd></div><div><dt><a href="/glossaire/#cycle-service">Temps maximal de fonctionnement publié</a></dt><dd>{compressor.dutyCycle ? `${Math.round(compressor.dutyCycle * 100)} %` : 'Non documenté'}</dd></div><div><dt>Puissance</dt><dd>{compressor.powerKw ? `${compressor.powerKw} kW` : 'Non documentée'}</dd></div><div><dt>Alimentation</dt><dd>{compressor.voltage ?? 'Non documentée'}{compressor.phase ? ` · ${compressor.phase === 'single-phase' ? 'monophasé' : 'triphasé'}` : ''}</dd></div><div><dt>Mobilité</dt><dd>{compressor.mobility === 'portable' ? 'Portable' : compressor.mobility === 'mobile' ? 'Mobile' : compressor.mobility === 'fixed' ? 'Fixe' : 'Non documentée'}</dd></div><div><dt>Poids</dt><dd>{compressor.weightKg ? `${compressor.weightKg} kg` : 'Non documenté'}</dd></div><div><dt>Niveau sonore publié</dt><dd>{compressor.noiseDb ? `${compressor.noiseDb} dB, indicateur à vérifier dans la source` : 'Non documenté'}</dd></div>{compressor.specifications.map((specification) => <div><dt>{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl></section>

		<section class="editorial-section"><p class="eyebrow">Lecture CompatAir</p><h2>Ce que la documentation permet d’affirmer</h2><div class="evidence-grid"><div class="fact-box"><h3>Faits vérifiés</h3><ul>{compressor.editorial.verifiedFacts.map((fact) => <li>{fact}</li>)}</ul></div><div class="limit-box"><h3>Limites</h3><ul>{compressor.editorial.limitations.map((limit) => <li>{limit}</li>)}</ul></div></div></section>

		<section class="editorial-section"><h2>Lire le débit de ce compresseur</h2>{compressor.fadCurve.length ? <><p>Les points ci-dessous sont ceux publiés dans la source. CompatAir interpole entre deux points documentés. Pour un besoin inférieur au premier point, ce point peut servir de borne conservatrice, clairement signalée ; au-dessus du dernier point, le résultat reste indéterminé.</p><div class="curve-table" role="table" aria-label="Points de débit restitué"><div class="curve-row head" role="row"><span role="columnheader">Pression</span><span role="columnheader">Débit restitué</span></div>{compressor.fadCurve.map((point) => <div class="curve-row" role="row"><span role="cell">{point.pressureBar} bar</span><strong role="cell">{point.litersPerMinute} L/min</strong></div>)}</div></> : <p>Aucun débit restitué à une pression de travail n’est publié dans la source consultée. Le débit aspiré ne le remplace pas.</p>}</section>

		<section class="editorial-section"><h2>Couverture par catégorie d’outil</h2><p>Cette synthèse décrit le corpus CompatAir, pas tous les outils du marché. L’exhaustivité des calculs reste dans le calculateur et les données publiques.</p><dl class="spec-table">{compatibility.categorySummary.map((category) => <div><dt>{category.category}</dt><dd>{category.compatible} compatible{category.compatible > 1 ? 's' : ''} · {category.incompatible} incompatible{category.incompatible > 1 ? 's' : ''} · {category.insufficient} indéterminé{category.insufficient > 1 ? 's' : ''}</dd></div>)}</dl>{compatibility.incompatibleExamples.length > 0 && <><h3>Exemples proches mais incompatibles</h3><div class="compatibility-table">{compatibility.incompatibleExamples.map(({ tool, result }) => <a href={`/calculateur/#outil=${tool.id}&compresseur=${compressor.id}`}><span><strong>{tool.label}</strong><small>{toolDemandLabel(tool)} · {toolPressureLabel(tool)} · {compatibilityFadLabel(result, tool.workingPressureBar.typical!)}</small></span><strong class="text-incompatible">Incompatible</strong></a>)}</div></>}<div class="actions"><a class="button primary" href={`/calculateur/#compresseur=${compressor.id}`}>Tester tous les outils dans le calculateur</a></div></section>

		<section class="related-reading"><h2>Approfondir avant de choisir</h2><div class="link-cards">{compressor.phase === 'three-phase' && <a href="/guides/compresseur-triphase-ou-monophase-atelier/"><strong>Triphasé ou monophasé</strong><span>Vérifier l’alimentation de l’atelier sans la confondre avec le débit disponible.</span></a>}<a href="/guides/debit-restitue-fad-vs-debit-aspire/"><strong>Quel débit faut-il regarder&nbsp;?</strong><span>Distinguer le débit réellement disponible du chiffre commercial aspiré.</span></a><a href="/guides/choisir-volume-cuve-24-50-90-litres/"><strong>Comprendre le rôle de la cuve</strong><span>Distinguer stockage d’air et capacité de production.</span></a><a href="/methodologie/"><strong>Comment CompatAir calcule le résultat</strong><span>Voir les données utilisées et les limites du calcul.</span></a></div></section>
		<section class="editorial-section"><h2>Offres marchandes</h2>{productOffers.length ? <div class="offer-list">{productOffers.map((offer) => <a href={`/go/${offer.id}`} rel="sponsored nofollow noopener"><span><strong>{merchants.find((item) => item.id === offer.merchantId)?.name} · {offer.productName}</strong><small>Référence de l’offre {offer.merchantProductId} · collectée le {new Date(offer.collectedAt).toLocaleDateString('fr-FR')} · {offer.availability}</small></span><strong>{offer.priceEur.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' })}</strong></a>)}</div> : <div class="status-callout"><strong>Aucune offre vérifiée</strong><span>Les partenaires marchands ne sont pas encore raccordés. Aucun prix ou lien d’achat n’est inventé.</span></div>}</section>
		<section class="editorial-section"><h2>Modèles documentés proches à comparer</h2><p>Cette sélection rapproche uniquement le volume de cuve et la pression maximale parmi les modèles dotés d’un FAD exploitable et d’une source A ou B. Elle ne signifie pas qu’ils couvrent votre outil : le calculateur vérifie ensuite le besoin exact.</p><div class="link-cards">{alternatives.map((item) => <a href={`/compresseurs/${item.slug}/`}><strong>{compressorDisplayName(item)}</strong><span>{item.tankLiters} L · {item.maxPressureBar} bar · {sourceQualityLabel(item.confidence)}</span></a>)}</div>{alternatives.length > 0 && <div class="actions"><a class="button" href={`/comparateur/#ids=${compressor.id},${alternatives[0].id}`}>Comparer côte à côte</a></div>}</section>
		<section class="sources-panel"><h2>Sources et réserves</h2>{compressor.evidence.map((evidence) => <p><a href={evidence.sourceUrl} rel="nofollow noopener" target="_blank">{evidence.sourceLabel}</a> · consultée le {evidence.retrievedAt.split('-').reverse().join('/')} · {sourceQualityLabel(evidence.confidence)} <small>(grade technique {evidence.confidence})</small></p>)}{compressor.notes.map((note) => <p>{note}</p>)}<p><a href={historyHref}>Voir les documents et dates vérifiés pour cette référence</a></p></section>
	</article>
</BaseLayout>
