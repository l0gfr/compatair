---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstitutionalHero from '../components/InstitutionalHero.astro';
import { documentQualityLedger } from '../data/document-quality-ledger';
const correctionsByDate = new Map<string, typeof documentQualityLedger.corrections>();
for (const correction of documentQualityLedger.corrections) correctionsByDate.set(correction.resolvedAt, [...(correctionsByDate.get(correction.resolvedAt) ?? []), correction]);
const formatDate = (date: string) => new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
---
<BaseLayout title="Journal public des corrections | CompatAir" description="Corrections de données, de calcul et de présentation publiées par CompatAir, avec leur portée et leur date." breadcrumbs={[{ name: 'Journal des corrections', path: '/corrections/' }]}>
	<InstitutionalHero eyebrow="Traçabilité éditoriale" title="Corriger sans effacer le chemin parcouru" lead="Le journal recense les corrections qui peuvent modifier la compréhension du catalogue, d’un résultat ou des engagements de CompatAir. Les versions successives des sources restent conservées séparément." primaryHref="#journal" primaryLabel="Consulter le journal" items={[{ label: 'Erreur identifiée', detail: 'Valeur, résultat ou promesse concernée' }, { label: 'Impact expliqué', detail: 'La portée de la correction est publiée' }, { label: 'Historique conservé', detail: 'Les preuves successives restent accessibles' }]} />
	<article class="container content institutional-content correction-journal" id="journal">
		<p>Les versions successives des sources sont conservées dans l’<a href="/preuves/">historique public des documents vérifiés</a>.</p>

		{[...correctionsByDate.entries()].sort(([a], [b]) => b.localeCompare(a)).map(([date, corrections]) => <><h2>{formatDate(date)}</h2><ul>{corrections.map((correction) => <li><strong>{correction.title}.</strong> {correction.summary} {correction.impact}</li>)}</ul></>)}

		<h2>Règle de publication</h2>
		<p>Une correction est ajoutée ici lorsqu’elle change une valeur, un résultat, une méthode, une promesse mesurable ou l’interprétation d’une donnée. Une simple correction typographique sans effet de sens peut rester dans l’historique technique du site.</p>
		<p>Le délai entre ouverture et publication est suivi dans l’<a href="/observatoire-qualite-documentaire/">Observatoire de la qualité documentaire</a>. Pour proposer une correction, utilisez la <a href="/contact/">page de signalement</a> et joignez la référence exacte ainsi que la source concernée.</p>
	</article>
</BaseLayout>
