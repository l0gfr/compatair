---
import BaseLayout from '../layouts/BaseLayout.astro';
import { compressors } from '../data/catalog';
---
<BaseLayout title="Comparer des compresseurs | CompatAir" description="Comparez deux ou trois compresseurs sur leurs caractéristiques et leurs limites documentaires." noindex breadcrumbs={[{ name: 'Comparateur', path: '/comparateur/' }]}>
	<section class="page-hero compact"><div class="container"><p class="eyebrow">Comparer les modèles côte à côte</p><h1>Comparer deux ou trois compresseurs</h1><p class="lead">Choisissez les modèles pour voir leurs caractéristiques au même endroit. Une information absente reste marquée «&nbsp;non documentée&nbsp;» et n’est jamais remplacée par une note commerciale.</p><p><a href="/guides/debit-restitue-fad-vs-debit-aspire/">Comprendre quel débit comparer</a> ou <a href="/calculateur/">vérifier vos propres outils</a>.</p></div></section>
	<section class="section"><div class="container compare-page"><div class="compare-selector" data-compare-selector>{compressors.map((item) => <label><input type="checkbox" value={item.id} data-compare-option /> {item.brand} {item.model}</label>)}</div><p data-compare-help>Sélectionnez deux ou trois modèles.</p><div class="compare-table-wrap" data-compare-output></div><button class="button" type="button" data-copy-comparison>Copier le lien</button><span data-copy-status role="status"></span></div></section>
	<div hidden data-compressor-data={JSON.stringify(compressors.map((item) => ({ id: item.id, slug: item.slug, brand: item.brand, model: item.model, tankLiters: item.tankLiters, maxPressureBar: item.maxPressureBar, intakeFlowLpm: item.intakeFlowLpm, fadCurve: item.fadCurve, dutyCycle: item.dutyCycle, oilType: item.oilType, noiseDb: item.noiseDb, confidence: item.confidence, status: item.status })))}></div>
	<script>
		const dataElement = document.querySelector<HTMLElement>('[data-compressor-data]'); const data = JSON.parse(dataElement?.dataset.compressorData ?? '[]'); const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-compare-option]')]; const output = document.querySelector<HTMLElement>('[data-compare-output]'); const help = document.querySelector<HTMLElement>('[data-compare-help]');
		const initial = new URLSearchParams(location.hash.slice(1)).get('ids')?.split(',') ?? []; for (const box of boxes) box.checked = initial.includes(box.value);
		function refresh() { const ids = boxes.filter((box) => box.checked).map((box) => box.value); if (ids.length > 3) { const last = boxes.findLast((box) => box.checked); if (last) last.checked = false; return refresh(); } history.replaceState(null, '', ids.length ? `#ids=${ids.join(',')}` : location.pathname); const selected = ids.map((id) => data.find((item: any) => item.id === id)).filter(Boolean); if (help) help.textContent = selected.length < 2 ? 'Sélectionnez encore un modèle.' : `${selected.length} modèles comparés`; if (!output || selected.length < 2) { output?.replaceChildren(); return; } const rows = [['Volume de cuve', (item: any) => `${item.tankLiters} L`], ['Pression maximale', (item: any) => `${item.maxPressureBar} bar`], ['Débit aspiré', (item: any) => item.intakeFlowLpm ? `${item.intakeFlowLpm} L/min, non utilisé pour le résultat` : 'Non documenté'], ['Débit réellement restitué', (item: any) => item.fadCurve.length ? item.fadCurve.map((point: any) => `${point.litersPerMinute} L/min à ${point.pressureBar} bar`).join(' · ') : 'Non documenté'], ['Temps maximal de fonctionnement', (item: any) => item.dutyCycle ? `${Math.round(item.dutyCycle * 100)} %` : 'Non documenté'], ['Lubrification', (item: any) => item.oilType === 'oil-free' ? 'Sans huile' : 'Lubrifié'], ['Bruit publié', (item: any) => item.noiseDb ? `${item.noiseDb} dB` : 'Non documenté'], ['Fiabilité des données', (item: any) => item.confidence]]; const table = document.createElement('table'); table.className = 'compare-table'; const thead = document.createElement('thead'); const hr = document.createElement('tr'); hr.append(document.createElement('th'), ...selected.map((item: any) => { const th = document.createElement('th'); const a = document.createElement('a'); a.href = `/compresseurs/${item.slug}/`; a.textContent = `${item.brand} ${item.model}`; th.append(a); return th; })); thead.append(hr); const tbody = document.createElement('tbody'); for (const [label, read] of rows as any) { const tr = document.createElement('tr'); const th = document.createElement('th'); th.textContent = label; tr.append(th, ...selected.map((item: any) => { const td = document.createElement('td'); td.textContent = read(item); return td; })); tbody.append(tr); } table.append(thead, tbody); output.replaceChildren(table); }
		for (const box of boxes) box.addEventListener('change', refresh); refresh(); document.querySelector('[data-copy-comparison]')?.addEventListener('click', async () => { await navigator.clipboard.writeText(location.href); document.querySelector<HTMLElement>('[data-copy-status]')!.textContent = 'Lien copié'; });
	</script>
</BaseLayout>
