---
import DecisionComparisonLinks from '../../components/DecisionComparisonLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compressors } from '../../data/catalog';

const documented = compressors.filter((item) => item.fadCurve.length > 0).length;
const undocumented = compressors.length - documented;
---

<BaseLayout title="Comparer les compresseurs d’air | CompatAir" description="Comparer les compresseurs à partir du débit réellement restitué, de la pression et de données constructeur identifiées." breadcrumbs={[{ name: 'Comparatifs', path: '/comparatifs/' }]}>
	<section class="page-hero compact catalog-hero" data-discovery-hub="comparatifs"><div class="container catalog-hero-grid"><div><p class="product-decision-index">Comparatifs</p><h1>Comparer des compresseurs</h1><p class="lead">Comparez le débit restitué à la pression utile, la cuve et les caractéristiques documentées.</p><div class="hero-actions"><a class="button primary" href="/comparateur/">Comparer deux ou trois modèles</a><a class="button" href="/calculateur/">Vérifier avec mes outils</a></div></div></div></section>
	<section class="catalog-summary-band comparison-summary"><div class="container"><div><strong>{compressors.length}</strong><span>compresseurs suivis</span></div><div><strong>{documented}</strong><span>avec FAD publié</span></div><div><strong>{undocumented}</strong><span>non classables par FAD</span></div><div><strong>3</strong><span>modèles maximum côte à côte</span></div></div></section>
	<section class="section comparison-paths"><div class="container"><header class="product-section-head"><div><h2>Choisir une comparaison</h2></div></header><div class="comparison-path-grid"><a href="/comparatifs/compresseurs-debit-restitue/"><span>01</span><p>Catalogue</p><h2>Comparer les débits publiés</h2><strong>{compressors.length} références</strong><small>Pression, cuve, FAD et qualité des données.</small></a><a href="/comparateur/"><span>02</span><p>Côte à côte</p><h2>Comparer deux ou trois modèles</h2><strong>Caractéristiques et unités communes</strong></a><a href="/calculateur/"><span>03</span><p>Compatibilité</p><h2>Vérifier avec mes outils</h2><strong>Besoin, débit disponible et marge</strong><small>Durée, flexible et plusieurs outils en option.</small></a></div></div></section>
	<section class="section comparison-boundary"><div class="container"><h2>Modèles sans débit restitué documenté</h2><p>Ces références restent non classables par FAD. Le débit aspiré ne permet pas de les comparer.</p><div class="actions"><a class="button" href="/methodologie/">Lire la méthode</a><a class="button" href="/sources-fiabilite/">Contrôler les sources</a></div></div></section>
	<div class="container"><DecisionComparisonLinks /></div>
</BaseLayout>
