---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogSignalVisual from '../../components/CatalogSignalVisual.astro';
import { compressors } from '../../data/catalog';

const documented = compressors.filter((item) => item.fadCurve.length > 0).length;
const undocumented = compressors.length - documented;
---

<BaseLayout title="Comparer les compresseurs d’air | CompatAir" description="Comparer les compresseurs à partir du débit réellement restitué, de la pression et de données constructeur identifiées." breadcrumbs={[{ name: 'Comparatifs', path: '/comparatifs/' }]}>
	<section class="page-hero compact catalog-hero" data-discovery-hub="comparatifs"><div class="container catalog-hero-grid"><div><p class="product-decision-index">Comparaisons techniques</p><p class="eyebrow">Comparer les données qui comptent</p><h1>Mettre les mêmes unités face à face</h1><p class="lead">CompatAir rapproche uniquement des données publiées dans des conditions comparables. Le débit aspiré ne remplace jamais le débit réellement disponible à la pression d’utilisation.</p><div class="hero-actions"><a class="button primary" href="/comparateur/">Comparer deux ou trois modèles</a><a class="button" href="/calculateur/">Vérifier avec mes outils</a></div></div><CatalogSignalVisual mode="comparison" count={compressors.length} title="compresseurs suivis" /></div></section>
	<section class="catalog-summary-band comparison-summary"><div class="container"><div><strong>{compressors.length}</strong><span>compresseurs suivis</span></div><div><strong>{documented}</strong><span>avec FAD publié</span></div><div><strong>{undocumented}</strong><span>non classables par FAD</span></div><div><strong>3</strong><span>modèles maximum côte à côte</span></div></div></section>
	<section class="section comparison-paths"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">Choisir le bon niveau</p><h2>Une comparaison répond à une question précise</h2></div><p>Un grand tableau sert à explorer le corpus. Le comparateur sert à lire les écarts entre quelques modèles. Le calculateur répond à un besoin d’usage.</p></header><div class="comparison-path-grid"><a href="/comparatifs/compresseurs-debit-restitue/"><span>01</span><p>Corpus complet</p><h2>Comparer les débits publiés</h2><strong>{compressors.length} références · recherche et pagination</strong><small>Pression, cuve, FAD et qualité documentaire.</small></a><a href="/comparateur/"><span>02</span><p>Côte à côte</p><h2>Comparer deux ou trois modèles</h2><strong>Mêmes caractéristiques · mêmes unités</strong><small>Aucun gagnant commercial imposé.</small></a><a href="/calculateur/"><span>03</span><p>Décision d’usage</p><h2>Vérifier mes propres outils</h2><strong>Besoin, débit disponible et marge</strong><small>Durée, flexible et plusieurs outils en option.</small></a></div></div></section>
	<section class="section comparison-boundary"><div class="container"><p class="product-decision-index">Frontière de confiance</p><h2>Une donnée absente reste absente.</h2><p>CompatAir n’ordonne pas une référence dépourvue de débit restitué à partir de son débit aspiré. Elle apparaît dans les références non classables jusqu’à publication d’une source exploitable.</p><div class="actions"><a class="button" href="/methodologie/">Lire la méthode</a><a class="button" href="/sources-fiabilite/">Contrôler les sources</a></div></div></section>
</BaseLayout>
