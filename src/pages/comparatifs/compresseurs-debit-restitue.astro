---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogSignalVisual from '../../components/CatalogSignalVisual.astro';
import DirectoryBrowser from '../../components/DirectoryBrowser.astro';
import { compressors, tools } from '../../data/catalog';
import { getCatalogMetrics } from '../../domain/catalog-insights';
import { compressorDisplayName } from '../../domain/product-display';
import { sourceQualityLabel } from '../../domain/source-quality';

const documented = compressors.filter((item) => item.fadCurve.length > 0);
const incomplete = compressors.filter((item) => item.fadCurve.length === 0);
const metrics = getCatalogMetrics(compressors, tools);
---

<BaseLayout title="Comparatif des compresseurs par débit restitué | CompatAir" description={`Tableau recherché et paginé des débits réellement restitués publiés pour ${compressors.length} compresseurs, avec pression et qualité documentaire.`} breadcrumbs={[{ name: 'Comparatifs', path: '/comparatifs/' }, { name: 'Débit restitué', path: '/comparatifs/compresseurs-debit-restitue/' }]}>
	<article class="fad-comparison-page" data-comparison-directory>
		<section class="page-hero compact catalog-hero"><div class="container catalog-hero-grid"><div><p class="product-decision-index">Comparatif documentaire / FAD</p><p class="eyebrow">Débit réellement disponible</p><h1>Comparer les compresseurs sans perdre la pression de vue</h1><p class="lead">Deux débits ne sont comparables que si leur pression est indiquée. Recherchez un modèle, triez les points publiés et ouvrez sa fiche pour remonter à la source.</p><div class="hero-actions"><a class="button primary" href="/comparateur/">Comparer deux ou trois modèles</a><a class="button" href="/guides/debit-restitue-fad-vs-debit-aspire/">Comprendre le FAD</a></div></div><CatalogSignalVisual mode="comparison" count={documented.length} secondaryCount={incomplete.length} title="compresseurs avec FAD" /></div></section>
		<section class="catalog-summary-band"><div class="container"><div><strong>{metrics.fadDocumentation.multiplePoints}</strong><span>plusieurs points FAD</span></div><div><strong>{metrics.fadDocumentation.singlePoint}</strong><span>un point FAD</span></div><div><strong>{metrics.fadDocumentation.withoutPoint}</strong><span>non classables</span></div><div><strong>{metrics.fixedFlowToolCount}</strong><span>outils calculables</span></div></div></section>

		<section class="section" data-directory-browser data-page-size="18"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">01 / Points documentés</p><h2>{documented.length} compresseurs avec un débit exploitable</h2></div><p>Le tri utilise les valeurs publiées. Il ne ramène pas artificiellement tous les débits à une pression commune.</p></header><div class="directory-controls"><div class="field directory-search"><label for="fad-search">Marque, modèle ou référence</label><input id="fad-search" type="search" placeholder="Ex. ABAC ou 601532000" data-directory-search /></div><div class="field"><label for="fad-sort">Trier</label><select id="fad-sort" data-directory-sort><option value="confidence">Qualité des données</option><option value="primary-asc">Débit maximal croissant</option><option value="primary-desc">Débit maximal décroissant</option><option value="name">Nom</option></select></div><button class="inline-action" type="button" data-directory-reset>Réinitialiser</button></div><p class="directory-count" data-directory-count>{documented.length} résultats</p><div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>Modèle</th><th>Cuve</th><th>Pression maximale</th><th>Débit réellement restitué</th><th>Qualité des données</th></tr></thead><tbody data-directory-grid>{documented.map((item) => <tr data-directory-card data-search={`${item.brand} ${item.model} ${item.mpn ?? ''} ${item.ean ?? ''} ${item.gtin ?? ''}`} data-sort-name={compressorDisplayName(item)} data-sort-confidence={item.confidence} data-sort-primary={Math.max(...item.fadCurve.map((point) => point.litersPerMinute))}><th><a href={`/compresseurs/${item.slug}/`}>{compressorDisplayName(item)}</a></th><td>{item.tankLiters} L</td><td>{item.maxPressureBar} bar</td><td>{item.fadCurve.map((point) => `${point.litersPerMinute} L/min à ${point.pressureBar} bar`).join(' · ')}</td><td>{sourceQualityLabel(item.confidence)}<small>Grade {item.confidence}</small></td></tr>)}</tbody></table></div><nav class="catalog-pagination" aria-label="Pagination des compresseurs avec FAD" data-directory-pagination></nav></div></section>

		<section class="section incomplete-reference-section"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">02 / Non classables</p><h2>{incomplete.length} référence{incomplete.length > 1 ? 's' : ''} sans débit restitué exploitable</h2></div><p>Ces modèles ne sont pas replacés dans le classement à partir du débit aspiré.</p></header><div class="incomplete-reference-grid">{incomplete.map((item) => <a href={`/compresseurs/${item.slug}/`}><span>{item.brand}</span><strong>{compressorDisplayName(item)}</strong><small>{sourceQualityLabel(item.confidence)} · donnée FAD manquante</small></a>)}</div></div></section>

		<section class="section tool-verdict-directory" data-directory-browser data-page-size="18"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">03 / Par outil</p><h2>Lire la couverture de chaque besoin publié</h2></div><p>Cette table résume les verdicts du corpus. La page d’usage conserve seulement quelques exemples représentatifs.</p></header><div class="directory-controls"><div class="field directory-search"><label for="tool-verdict-search">Outil ou catégorie</label><input id="tool-verdict-search" type="search" data-directory-search /></div><div class="field"><label for="tool-verdict-sort">Trier</label><select id="tool-verdict-sort" data-directory-sort><option value="primary-desc">Compatibles en continu</option><option value="primary-asc">Moins de compatibles</option><option value="name">Nom</option></select></div><button class="inline-action" type="button" data-directory-reset>Réinitialiser</button></div><p class="directory-count" data-directory-count>{metrics.toolVerdicts.length} résultats</p><div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>Outil</th><th>Compatibles en continu</th><th>Incompatibles</th><th>Données insuffisantes</th><th>Décisions calculables</th></tr></thead><tbody data-directory-grid>{metrics.toolVerdicts.map((summary) => <tr data-directory-card data-search={`${summary.tool.label} ${summary.tool.category}`} data-sort-name={summary.tool.label} data-sort-confidence="A" data-sort-primary={summary.continuous}><th><a href={`/quel-compresseur-pour/${summary.tool.slug}/`}>{summary.tool.label}</a></th><td>{summary.continuous}</td><td>{summary.incompatible}</td><td>{summary.insufficientData}</td><td>{summary.verdictable}</td></tr>)}</tbody></table></div><nav class="catalog-pagination" aria-label="Pagination de la couverture par outil" data-directory-pagination></nav><p class="comparison-editorial-link">Le <a href="/guides/comparatif-compresseurs-debit-restitue/">dossier éditorial complet</a> explique les limites de chaque comparaison.</p></div></section>
		<DirectoryBrowser />
	</article>
</BaseLayout>
