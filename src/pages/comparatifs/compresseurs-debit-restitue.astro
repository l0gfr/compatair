---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogSignalVisual from '../../components/CatalogSignalVisual.astro';
import { compressors, tools } from '../../data/catalog';
import { brandSlug } from '../../domain/brand';
import { getCatalogMetrics } from '../../domain/catalog-insights';
import { compressorDisplayName } from '../../domain/product-display';
import { serializeJsonLd } from '../../domain/structured-data';
import { sourceQualityLabel } from '../../domain/source-quality';

const documented = compressors.filter((item) => item.fadCurve.length > 0);
const incomplete = compressors.filter((item) => item.fadCurve.length === 0);
const metrics = getCatalogMetrics(compressors, tools);
const brandGroups = [...new Set(compressors.map((item) => item.brand))]
	.sort((left, right) => left.localeCompare(right, 'fr'))
	.map((brand) => {
		const items = compressors.filter((item) => item.brand === brand);
		return {
			brand,
			count: items.length,
			documented: items.filter((item) => item.fadCurve.length > 0).length,
			multiplePoints: items.filter((item) => item.fadCurve.length > 1).length,
		};
	});
const brandListJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Comparatifs de débit restitué par marque',
	itemListElement: brandGroups.map((group, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: `Débit restitué des compresseurs ${group.brand}`,
		url: `https://compatair.fr/comparatifs/compresseurs-debit-restitue/marque/${brandSlug(group.brand)}/`,
	})),
};
---

<BaseLayout
	title="Comparatif des compresseurs par débit restitué | CompatAir"
	description={`Comparez le débit réellement restitué de ${compressors.length} compresseurs dans des tableaux par marque, avec pression, source et données non classables visibles.`}
	breadcrumbs={[{ name: 'Comparatifs', path: '/comparatifs/' }, { name: 'Débit restitué', path: '/comparatifs/compresseurs-debit-restitue/' }]}
>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(brandListJsonLd)} />
	<article class="fad-comparison-page" data-comparison-directory data-directory-hub="fad-by-brand">
		<section class="page-hero compact catalog-hero">
			<div class="container catalog-hero-grid">
				<div>
					<p class="product-decision-index">Comparatif documentaire / FAD</p>
					<p class="eyebrow">Débit réellement disponible</p>
					<h1>Comparer les compresseurs sans perdre la pression de vue</h1>
					<p class="lead">Deux débits ne sont comparables que si leur pression est indiquée. Choisissez une marque pour ouvrir son tableau de points publiés et remonter à chaque fiche source.</p>
					<div class="hero-actions"><a class="button primary" href="/comparateur/">Comparer deux ou trois modèles</a><a class="button" href="/guides/debit-restitue-fad-vs-debit-aspire/">Comprendre le FAD</a></div>
				</div>
				<CatalogSignalVisual mode="comparison" count={documented.length} secondaryCount={incomplete.length} title="compresseurs avec FAD" />
			</div>
		</section>

		<section class="catalog-summary-band">
			<div class="container">
				<div><strong>{metrics.fadDocumentation.multiplePoints}</strong><span>plusieurs points FAD</span></div>
				<div><strong>{metrics.fadDocumentation.singlePoint}</strong><span>un point FAD</span></div>
				<div><strong>{metrics.fadDocumentation.withoutPoint}</strong><span>non classables</span></div>
				<div><strong>{brandGroups.length}</strong><span>tableaux par marque</span></div>
			</div>
		</section>

		<section class="section catalog-directory">
			<div class="container">
				<header class="product-section-head">
					<div><p class="product-decision-index">01 / Tableaux comparables</p><h2>Ouvrir le débit restitué par fabricant</h2></div>
					<p>Chaque tableau conserve les pressions d’origine. Aucun débit n’est ramené artificiellement à une pression commune et le débit aspiré ne remplace jamais le FAD.</p>
				</header>
				<div class="hub-intent-grid">
					{brandGroups.map((group, index) => (
						<a href={`/comparatifs/compresseurs-debit-restitue/marque/${brandSlug(group.brand)}/`}>
							<span class="hub-intent-index">{String(index + 1).padStart(2, '0')}</span>
							<p>{group.documented}/{group.count} avec FAD</p>
							<h3>{group.brand}</h3>
							<small>{group.count} compresseur{group.count > 1 ? 's' : ''} dans le corpus · {group.multiplePoints} référence{group.multiplePoints > 1 ? 's' : ''} avec plusieurs pressions publiées.</small>
							<strong>Ouvrir le tableau →</strong>
						</a>
					))}
				</div>
			</div>
		</section>

		{incomplete.length > 0 && (
			<section class="section incomplete-reference-section">
				<div class="container">
					<header class="product-section-head">
						<div><p class="product-decision-index">02 / Non classables</p><h2>{incomplete.length} référence{incomplete.length > 1 ? 's' : ''} sans débit restitué exploitable</h2></div>
						<p>Ces modèles restent publiés avec leur lacune au lieu d’être replacés dans le classement à partir du débit aspiré.</p>
					</header>
					<div class="incomplete-reference-grid">
						{incomplete.map((item) => <a href={`/compresseurs/${item.slug}/`}><span>{item.brand}</span><strong>{compressorDisplayName(item)}</strong><small>{sourceQualityLabel(item.confidence)} · donnée FAD manquante</small></a>)}
					</div>
				</div>
			</section>
		)}

		<section class="section tool-verdict-directory">
			<div class="container">
				<header class="product-section-head">
					<div><p class="product-decision-index">03 / Passer au besoin réel</p><h2>Le tableau ne remplace pas le calcul de compatibilité</h2></div>
					<p>Le débit FAD classe une documentation. Le verdict dépend aussi de la pression et de la consommation de l’outil choisi.</p>
				</header>
				<div class="actions"><a class="button primary" href="/outils-pneumatiques/">Choisir un outil par usage</a><a class="button" href="/guides/comparatif-compresseurs-debit-restitue/">Lire le dossier éditorial</a></div>
			</div>
		</section>
	</article>
</BaseLayout>
