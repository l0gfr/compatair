---
import FadBrandDirectoryPage from '../../../../components/FadBrandDirectoryPage.astro';
import { compressors } from '../../../../data/catalog';
import { brandSlug } from '../../../../domain/brand';

export function getStaticPaths() {
	return [...new Set(compressors.map((item) => item.brand))].map((brand) => ({ params: { brand: brandSlug(brand) }, props: { brand } }));
}
const { brand } = Astro.props;
---
<FadBrandDirectoryPage brand={brand} />
