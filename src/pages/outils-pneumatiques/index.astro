---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import { tools } from '../../data/catalog';
import { toolTaxonomy } from '../../data/taxonomy';
import { toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
const toolListJsonLd = {
	'@context': 'https://schema.org', '@type': 'ItemList', name: 'Outils pneumatiques documentés par CompatAir',
	itemListElement: tools.map((tool, index) => ({ '@type': 'ListItem', position: index + 1, name: tool.label, url: `https://compatair.fr/outils-pneumatiques/${tool.slug}/` })),
};
---
<BaseLayout title="Outils pneumatiques et besoins en air | CompatAir" description="Débit et pression publiés pour les outils pneumatiques documentés par CompatAir, avec source constructeur et limites explicites." breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }]}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(toolListJsonLd)} />
	<section class="page-hero compact"><div class="container"><p class="eyebrow">Profils techniques</p><h1>{tools.length} outils, des besoins vérifiés</h1><p class="lead">Chaque profil reprend la pression et la consommation publiées. Aucun rythme d’utilisation n’est ajouté lorsqu’il n’est pas documenté.</p></div></section>
	<section class="section"><div class="container product-grid">{tools.map((tool) => <article class="product-card"><a class="product-card-image" href={`/outils-pneumatiques/${tool.slug}/`} aria-label={`Voir la fiche ${tool.label}`}><ProductImage image={tool.image} compact /></a><p class="product-brand">{tool.category}</p><h2><a href={`/outils-pneumatiques/${tool.slug}/`}>{tool.label}</a></h2><dl class="spec-list"><div><dt>Besoin d’air</dt><dd>{toolDemandLabel(tool)}</dd></div><div><dt>Pression</dt><dd>{toolPressureLabel(tool)}</dd></div><div><dt>Confiance</dt><dd>{tool.confidence}</dd></div></dl></article>)}</div></section>
	<section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Taxonomie initiale</p><h2>{toolTaxonomy.length} catégories suivies</h2><p>Une catégorie peut être visible avant de disposer d’une référence exploitable. Aucun profil générique n’est publié à la place d’une fiche constructeur.</p></div><div class="taxonomy-grid">{toolTaxonomy.map((category) => { const count = tools.filter((tool) => [category.label, ...category.aliases].some((label) => tool.category.toLowerCase().includes(label.toLowerCase().replace(' orbitale', '').replace('sableuse', 'sablage')))).length; return <div><strong>{category.label}</strong><span class:list={{ documented: count > 0 }}>{count > 0 ? `${count} référence${count > 1 ? 's' : ''} documentée${count > 1 ? 's' : ''}` : 'Données à documenter'}</span></div>; })}</div></div></section>
</BaseLayout>
