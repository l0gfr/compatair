---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogSignalVisual from '../../components/CatalogSignalVisual.astro';
import DirectoryBrowser from '../../components/DirectoryBrowser.astro';
import ProductImage from '../../components/ProductImage.astro';
import { tools } from '../../data/catalog';
import { toolUsageTaxonomy } from '../../data/taxonomy';
import { toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
import { brandSlug } from '../../domain/brand';
import { serializeJsonLd } from '../../domain/structured-data';
import { sourceQualityLabel } from '../../domain/source-quality';

const brands = [...new Set(tools.map((item) => item.brand))].sort();
const usages = toolUsageTaxonomy.map((usage) => ({
	...usage,
	count: tools.filter((tool) => usage.categoryIds.includes(tool.categoryId)).length,
}));
const fixedFlowCount = tools.filter((item) => item.demandModel === 'fixed-flow').length;
const toolListJsonLd = {
	'@context': 'https://schema.org', '@type': 'ItemList', name: 'Outils pneumatiques documentés par CompatAir',
	itemListElement: tools.map((tool, index) => ({ '@type': 'ListItem', position: index + 1, name: tool.label, url: `https://compatair.fr/outils-pneumatiques/${tool.slug}/` })),
};
---

<BaseLayout title="Outils pneumatiques et besoins en air | CompatAir" description="Débit et pression publiés pour les outils pneumatiques documentés par CompatAir, avec recherche par marque, modèle, MPN ou EAN." breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }]}>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(toolListJsonLd)} />
	<section class="page-hero compact catalog-hero"><div class="container catalog-hero-grid"><div><p class="product-decision-index">Catalogue technique / Outils</p><p class="eyebrow">Besoins en air publiés</p><h1>Partir de l’outil pour dimensionner le compresseur</h1><p class="lead">Recherchez une référence exacte, lisez son débit et sa pression, puis ouvrez une sélection de compresseurs proches du besoin. Les valeurs absentes restent explicitement indéterminées.</p><div class="hero-actions"><a class="button primary" href="/scanner/">Identifier une référence</a><a class="button" href="/calculateur/">Calculer plusieurs outils</a></div></div><CatalogSignalVisual mode="tools" count={tools.length} secondaryCount={usages.length} title="outils documentés" /></div></section>
	<section class="catalog-summary-band"><div class="container"><div><strong>{fixedFlowCount}</strong><span>besoins calculables directement</span></div><div><strong>{tools.length - fixedFlowCount}</strong><span>usages à préciser</span></div><div><strong>{usages.length}</strong><span>usages documentés</span></div><div><strong>{brands.length}</strong><span>fabricants suivis</span></div></div></section>

	<section class="section catalog-directory" data-directory-browser data-page-size="9"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">Explorer le corpus</p><h2>Trouver un outil par marque, modèle, MPN ou EAN</h2></div><p>Le tri par défaut privilégie la complétude documentaire. Une consommation par action n’est jamais convertie sans votre fréquence réelle.</p></header>
		<div class="directory-controls"><header class="directory-console-head"><span>CA / Recherche</span><strong>Orienter le corpus</strong><small>4 critères</small></header><div class="field directory-search"><label for="tool-search">Référence ou modèle</label><input id="tool-search" type="search" placeholder="Ex. 4138540 ou TC-PP 220" data-directory-search /></div><div class="field"><label for="tool-brand">Marque</label><select id="tool-brand" data-directory-filter="brand"><option value="">Toutes</option>{brands.map((brand) => <option value={brand}>{brand}</option>)}</select></div><div class="field"><label for="tool-usage">Usage</label><select id="tool-usage" data-directory-filter="usage"><option value="">Tous</option>{usages.map((usage) => <option value={usage.id}>{usage.label} ({usage.count})</option>)}</select></div><div class="field"><label for="tool-sort">Trier</label><select id="tool-sort" data-directory-sort><option value="confidence">Qualité des données</option><option value="primary-asc">Besoin d’air croissant</option><option value="primary-desc">Besoin d’air décroissant</option><option value="name">Nom</option></select></div><button class="inline-action" type="button" data-directory-reset>Réinitialiser</button></div>
		<div class="catalog-toolbar"><p data-directory-count>{tools.length} résultats</p><a class="button" href="/calculateur/">Vérifier une configuration</a></div>
		<div class="product-grid directory-product-grid" data-directory-grid>{tools.map((tool, index) => <article class="product-card catalog-product-card" data-directory-card data-brand={tool.brand} data-category={tool.category} data-usage={usages.find((usage) => usage.categoryIds.includes(tool.categoryId))?.id} data-search={`${tool.brand} ${tool.model} ${tool.label} ${tool.mpn ?? ''} ${tool.ean ?? ''} ${tool.identifierAliases.map((alias) => alias.value).join(' ')}`} data-sort-name={tool.label} data-sort-confidence={tool.confidence} data-sort-primary={tool.demandModel === 'fixed-flow' ? tool.airflowLpm.typical : ''}><header class="catalog-card-register"><span>CA / O-{String(index + 1).padStart(3, '0')}</span><small>Outil documenté</small></header><a class="product-card-image" href={`/outils-pneumatiques/${tool.slug}/`} aria-label={`Voir la fiche ${tool.label}`}><ProductImage image={tool.image} compact /></a><p class="product-brand"><a href={`/marques/${brandSlug(tool.brand)}/`}>{tool.brand}</a> · {tool.category}</p><h2><a href={`/outils-pneumatiques/${tool.slug}/`}>{tool.label}</a></h2><dl class="spec-list"><div><dt>Besoin d’air</dt><dd>{toolDemandLabel(tool)}</dd></div><div><dt>Pression</dt><dd>{toolPressureLabel(tool)}</dd></div><div><dt>Source</dt><dd>{sourceQualityLabel(tool.confidence)}</dd></div></dl><p class:list={['data-status', tool.demandModel === 'fixed-flow' ? 'verified' : 'missing']}>{tool.demandModel === 'fixed-flow' ? 'Besoin par minute directement calculable' : 'Fréquence d’usage nécessaire au calcul'}</p><div class="catalog-card-actions"><a href={`/quel-compresseur-pour/${tool.slug}/`}>Voir les compresseurs</a><a href={`/calculateur/#outil=${tool.id}`}>Affiner</a></div></article>)}</div>
		<nav class="catalog-pagination" aria-label="Pagination du catalogue des outils" data-directory-pagination></nav>
	</div></section>

	<section class="section taxonomy-section"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">Couverture métier</p><h2>{toolUsageTaxonomy.length} usages documentés</h2></div><p>Les usages regroupent les technologies qui répondent au même geste métier. Chaque référence conserve sa famille précise, son besoin en air et sa source fabricant.</p></header><div class="taxonomy-grid">{toolUsageTaxonomy.map((usage, index) => { const count = tools.filter((tool) => usage.categoryIds.includes(tool.categoryId)).length; return <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{usage.label}</strong><small class:list={{ documented: count >= 5 }}>{count} références documentées</small></div>; })}</div></div></section>
	<DirectoryBrowser />
</BaseLayout>
