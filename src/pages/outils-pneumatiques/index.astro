---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogSignalVisual from '../../components/CatalogSignalVisual.astro';
import { tools } from '../../data/catalog';
import { toolUsageTaxonomy } from '../../data/taxonomy';
import { serializeJsonLd } from '../../domain/structured-data';

const brands = [...new Set(tools.map((item) => item.brand))].sort();
const usages = toolUsageTaxonomy.map((usage) => {
	const items = tools.filter((tool) => usage.categoryIds.some((categoryId) => categoryId === tool.categoryId));
	return {
		...usage,
		count: items.length,
		fixedFlowCount: items.filter((item) => item.demandModel === 'fixed-flow').length,
	};
});
const fixedFlowCount = tools.filter((item) => item.demandModel === 'fixed-flow').length;
const usageListJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Outils pneumatiques classés par usage',
	itemListElement: usages.map((usage, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: usage.seoTitle,
		url: `https://compatair.fr/outils-pneumatiques/usages/${usage.id}/`,
	})),
};
---

<BaseLayout
	title="Outils pneumatiques par usage | CompatAir"
	description={`Explorez ${tools.length} outils pneumatiques dans ${usages.length} usages : débit, pression, référence et source fabricant avant de dimensionner le compresseur.`}
	breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }]}
>
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(usageListJsonLd)} />
	<section class="page-hero compact catalog-hero">
		<div class="container catalog-hero-grid">
			<div>
				<p class="product-decision-index">Catalogue technique / Outils</p>
				<p class="eyebrow">Un répertoire par geste métier</p>
				<h1>{tools.length} outils pneumatiques, organisés en {usages.length} usages</h1>
				<p class="lead">Choisissez d’abord le geste à réaliser, puis ouvrez la fiche exacte. Chaque répertoire conserve la pression, le besoin en air et la source fabricant sans répéter toute la matrice de compatibilité.</p>
				<div class="hero-actions"><a class="button primary" href="/scanner/">Identifier une référence</a><a class="button" href="/calculateur/">Calculer plusieurs outils</a></div>
			</div>
			<CatalogSignalVisual mode="tools" count={tools.length} secondaryCount={usages.length} title="outils documentés" />
		</div>
	</section>

	<section class="catalog-summary-band">
		<div class="container">
			<div><strong>{fixedFlowCount}</strong><span>besoins calculables directement</span></div>
			<div><strong>{tools.length - fixedFlowCount}</strong><span>usages à préciser</span></div>
			<div><strong>{usages.length}</strong><span>répertoires d’usage</span></div>
			<div><strong>{brands.length}</strong><span>fabricants suivis</span></div>
		</div>
	</section>

	<section class="section catalog-directory" data-directory-hub="tools-by-usage">
		<div class="container">
			<header class="product-section-head">
				<div><p class="product-decision-index">Explorer le corpus</p><h2>Choisir un usage avant la référence</h2></div>
				<p>Les familles techniques restent distinctes dans chaque répertoire. Pour une référence exacte, la recherche globale couvre aussi les MPN, EAN/GTIN et SKU documentés.</p>
			</header>
			<form class="directory-controls brand-controls" action="/recherche/" method="get">
				<div class="field directory-search"><label for="tool-directory-search">Marque, modèle, MPN, EAN/GTIN ou SKU</label><input id="tool-directory-search" name="q" type="search" placeholder="Ex. 4138540 ou TC-PP 220" required minlength="2" /></div>
				<button class="button primary" type="submit">Rechercher la référence</button>
			</form>
			<div class="hub-intent-grid">
				{usages.map((usage, index) => (
					<a href={`/outils-pneumatiques/usages/${usage.id}/`}>
						<span class="hub-intent-index">{String(index + 1).padStart(2, '0')}</span>
						<p>{usage.count} référence{usage.count > 1 ? 's' : ''} · {usage.fixedFlowCount} besoin{usage.fixedFlowCount > 1 ? 's' : ''} minute</p>
						<h3>{usage.label}</h3>
						<small>{usage.description}</small>
						<strong>Ouvrir le répertoire →</strong>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
