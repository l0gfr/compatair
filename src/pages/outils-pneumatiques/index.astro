---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/catalog';
const usageLabels = { burst: 'par impulsions', intermittent: 'intermittent', continuous: 'continu' };
---
<BaseLayout title="Outils pneumatiques et besoins en air | CompatAir" description="Débit, pression et rythme d’utilisation documentés pour les outils pneumatiques du catalogue CompatAir.">
	<section class="page-hero compact"><div class="container"><p class="eyebrow">Profils techniques</p><h1>{tools.length} outils, des besoins vérifiés</h1><p class="lead">Chaque profil sépare pression, débit instantané et rythme d’utilisation avant toute recommandation.</p></div></section>
	<section class="section"><div class="container product-grid">{tools.map((tool) => <article class="product-card"><p class="product-brand">{tool.category}</p><h2><a href={`/outils-pneumatiques/${tool.slug}/`}>{tool.label}</a></h2><dl class="spec-list"><div><dt>Débit</dt><dd>{tool.airflowLpm.typical} L/min</dd></div><div><dt>Pression</dt><dd>{tool.workingPressureBar.typical} bar</dd></div><div><dt>Usage</dt><dd>{usageLabels[tool.usagePattern]}</dd></div></dl></article>)}</div></section>
</BaseLayout>
