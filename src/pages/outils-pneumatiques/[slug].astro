---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import { compressors, tools } from '../../data/catalog';
import { productSeoTitle } from '../../data/product-seo-titles';
import { evaluateCompatibility } from '../../domain/compatibility';
import { isFixedFlowTool, toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
import { latestEvidenceDate } from '../../domain/provenance';

export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const verifiedAt = latestEvidenceDate(tool);
const fixedFlow = isFixedFlowTool(tool);
const matches = fixedFlow ? compressors.map((compressor) => ({ compressor, result: evaluateCompatibility(compressor, tool) })) : [];
const labels = { continuous: 'Continu', intermittent: 'Intermittent', incompatible: 'Incompatible', insufficient_data: 'Données insuffisantes' };
const marginTarget = fixedFlow ? Math.round(tool.airflowLpm.typical * 1.25) : undefined;
const demandLabel = toolDemandLabel(tool);
const pressureLabel = toolPressureLabel(tool);
const guideByCategory: Record<string, string> = {
	'Ponceuse pneumatique': '/guides/compresseur-pour-ponceuse-pneumatique/',
	'Meuleuse pneumatique': '/guides/compresseur-pour-meuleuse-pneumatique/',
	'Clé à chocs': '/guides/compresseur-pour-cle-a-chocs-pneumatique/',
	'Agrafeuse et cloueuse': '/guides/compresseur-pour-agrafeuse-cloueuse-pneumatique/',
	'Gonflage': '/guides/compresseur-pour-gonfler-pneus/',
	'Pistolet à peinture HVLP': '/guides/compresseur-pour-pistolet-peinture-hvlp/',
	'Clé à cliquet pneumatique': '/guides/compresseur-pour-cle-a-cliquet-pneumatique/',
	'Visseuse pneumatique': '/guides/compresseur-pour-visseuse-pneumatique/',
};
const relatedGuide = guideByCategory[tool.category] ?? '/guides/pression-travail-6-3-bar-outils-pneumatiques/';
const productJsonLd = {
	'@context': 'https://schema.org', '@type': 'Product', name: tool.label,
	image: `https://compatair.fr${tool.image.src}`, brand: { '@type': 'Brand', name: tool.brand }, model: tool.model,
	description: tool.editorial.overview, url: `https://compatair.fr/outils-pneumatiques/${tool.slug}/`,
	category: tool.category, ...(tool.mpn ? { mpn: tool.mpn } : {}), ...(tool.ean ? { gtin13: tool.ean } : {}),
	additionalProperty: [
		{ '@type': 'PropertyValue', name: 'Besoin en air publié', value: demandLabel },
		{ '@type': 'PropertyValue', name: 'Pression publiée', value: pressureLabel },
		...tool.specifications.map((specification) => ({ '@type': 'PropertyValue', name: specification.label, value: specification.value })),
	],
};
---
<BaseLayout
	title={`${tool.label} : quel compresseur ? | CompatAir`}
	editorialTitle={productSeoTitle(tool.id)}
	description={`${tool.label} : ${demandLabel}, ${pressureLabel}. Données constructeur, compresseurs adaptés et informations manquantes.`}
	pageType="product"
	imagePath="/social/outils-pneumatiques.png"
	imageAlt="Catalogue des outils pneumatiques documentés par CompatAir"
	modifiedDate={new Date(verifiedAt)}
	breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }, { name: tool.label, path: `/outils-pneumatiques/${tool.slug}/` }]}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
	<article class="container product-detail">
		<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/outils-pneumatiques/">Outils pneumatiques</a><span>/</span><span>{tool.label}</span></nav>
		<div class="product-hero"><div><p class="eyebrow">Fiche outil pneumatique · sources vérifiées</p><h1>{tool.label}</h1><p class="lead">{tool.editorial.overview}</p><p class="product-reference">Besoin publié : {demandLabel} · {pressureLabel} · fiabilité des données {tool.confidence}.</p></div><ProductImage image={tool.image} eager /></div>

		<section class="spec-panel"><h2>Besoin en air publié</h2><dl class="spec-table"><div><dt>Consommation d’air</dt><dd>{demandLabel}</dd></div><div><dt><a href="/glossaire/#pression-travail">Pression d’utilisation</a></dt><dd>{pressureLabel}</dd></div><div><dt>Façon de l’utiliser</dt><dd>{tool.usagePattern === 'burst' ? 'Par courtes actions' : tool.usagePattern === 'intermittent' ? 'Avec des pauses' : tool.usagePattern === 'continuous' ? 'En continu' : 'Non documentée'}</dd></div><div><dt>Temps d’utilisation publié</dt><dd>{tool.dutyFactor ? `${Math.round(tool.dutyFactor * 100)} %` : 'Non documenté'}</dd></div><div><dt>Raccordement</dt><dd>{tool.connectorSize ?? 'Non documenté dans la fiche consultée'}</dd></div><div><dt>Flexible recommandé</dt><dd>{tool.recommendedHose ? `${tool.recommendedHose.innerDiameterMm ?? '?'} mm intérieur${tool.recommendedHose.maximumLengthMeters ? `, ${tool.recommendedHose.maximumLengthMeters} m maximum` : ''}` : 'Non documenté'}</dd></div><div><dt>Filtration</dt><dd>{tool.filtrationRequirement ?? 'Non documentée'}</dd></div><div><dt>Lubrification</dt><dd>{tool.lubricationRequirement ?? 'Non documentée'}</dd></div><div><dt>Référence fabricant</dt><dd>{tool.mpn ?? 'Non documentée'}</dd></div><div><dt>Numéro de code-barres</dt><dd>{tool.ean ?? 'Non documenté'}</dd></div><div><dt><a href="/glossaire/#marge-compatair">Réserve de 25 % proposée par CompatAir</a></dt><dd>{marginTarget !== undefined ? `${marginTarget} L/min, soit la consommation publiée + 25 %` : 'Non calculée sans débit minute documenté'}</dd></div>{tool.specifications.map((specification) => <div><dt>{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl></section>

		<section class="editorial-section"><p class="eyebrow">Lecture CompatAir</p><h2>Ce que la documentation permet d’affirmer</h2><div class="evidence-grid"><div class="fact-box"><h3>Faits vérifiés</h3><ul>{tool.editorial.verifiedFacts.map((fact) => <li>{fact}</li>)}</ul></div><div class="limit-box"><h3>Limites</h3><ul>{tool.editorial.limitations.map((limit) => <li>{limit}</li>)}</ul></div></div></section>

		{fixedFlow ? <>
			<section class="editorial-section"><h2>Quel débit le compresseur doit-il fournir&nbsp;?</h2><p>Le premier seuil est la consommation publiée de <strong>{tool.airflowLpm.typical} L/min à {tool.workingPressureBar.typical} bar</strong>. Un compresseur n’est déclaré compatible en continu que si son <a href="/glossaire/#debit-restitue">débit réellement disponible</a> couvre cette valeur à la même pression.</p><p>CompatAir affiche aussi une réserve à <strong>{marginTarget} L/min</strong>. Cette majoration de 25 % est un repère proposé par CompatAir, pas une exigence du fabricant.</p><div class="actions"><a class="button primary" href={`/calculateur/?outil=${tool.id}`}>Vérifier les compresseurs</a></div></section>
			<section class="editorial-section"><h2>Résultats sur les compresseurs documentés</h2><div class="compatibility-table">{matches.map(({ compressor, result }) => <a href={`/compresseurs/${compressor.slug}/`}><span><strong>{compressor.brand} {compressor.model}</strong><small>{result.availableFadLpm !== undefined ? `${Math.round(result.availableFadLpm)} L/min disponibles à la pression demandée` : 'Débit non documenté à la pression demandée'}</small></span><strong class={`text-${result.verdict}`}>{labels[result.verdict]}</strong></a>)}</div></section>
		</> : <section class="editorial-section"><h2>Informations nécessaires pour calculer le besoin</h2><p>{tool.demandModel === 'per-action' ? `La documentation exprime la consommation par ${tool.actionLabel}. Le calculateur multiplie cette valeur par le nombre d’actions réellement saisi pour obtenir une moyenne par minute. Il ne prétend pas deviner le besoin exact au déclenchement.` : tool.demandExplanation}</p><p>Attribuer un débit par minute sans ces informations reviendrait à l’inventer. Les fiches indiquent donc «&nbsp;données insuffisantes&nbsp;», tandis que le calculateur vous permet de renseigner votre usage.</p><div class="actions"><a class="button primary" href={`/calculateur/?outil=${tool.id}`}>Renseigner mon usage</a></div></section>}

		<section class="related-reading"><h2>Guides liés à cet outil</h2><div class="link-cards"><a href={relatedGuide}><strong>Choisir un compresseur pour cet outil</strong><span>Lire le guide correspondant à son besoin en air.</span></a><a href="/guides/diametre-longueur-flexible-air-comprime/"><strong>Flexible et raccords</strong><span>Comprendre pourquoi le réseau peut réduire la pression disponible.</span></a><a href="/guides/debit-restitue-fad-vs-debit-aspire/"><strong>Débit restitué ou aspiré</strong><span>Comparer le bon chiffre à la consommation publiée.</span></a></div></section>

		<section class="sources-panel"><h2>Source et réserves</h2>{tool.evidence.map((evidence) => <p><a href={evidence.sourceUrl} rel="nofollow noopener" target="_blank">{evidence.sourceLabel}</a> · consultée le {evidence.retrievedAt.split('-').reverse().join('/')} · fiabilité {evidence.confidence}</p>)}{tool.notes.map((note) => <p>{note}</p>)}<p><a href={`/preuves/#${tool.id}`}>Voir les documents et dates vérifiés pour cette référence</a></p></section>
	</article>
</BaseLayout>
