---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import { compressors, tools } from '../../data/catalog';
import { evaluateCompatibility } from '../../domain/compatibility';

export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const matches = compressors.map((compressor) => ({ compressor, result: evaluateCompatibility(compressor, tool) }));
const labels = { continuous: 'Continu', incompatible: 'Incompatible', insufficient_data: 'Données insuffisantes' };
const marginTarget = Math.round(tool.airflowLpm.typical * 1.25);
const relatedGuide = tool.category === 'Ponceuse pneumatique' ? '/guides/compresseur-pour-ponceuse-pneumatique/' : '/guides/pression-travail-6-3-bar-outils-pneumatiques/';
const productJsonLd = {
	'@context': 'https://schema.org', '@type': 'Product', name: tool.label,
	image: `https://compatair.fr${tool.image.src}`, brand: { '@type': 'Brand', name: tool.brand }, model: tool.model,
	description: tool.editorial.overview, url: `https://compatair.fr/outils-pneumatiques/${tool.slug}/`,
	category: tool.category,
	additionalProperty: [
		{ '@type': 'PropertyValue', name: 'Consommation d’air publiée', value: `${tool.airflowLpm.typical} L/min` },
		{ '@type': 'PropertyValue', name: 'Pression de travail publiée', value: `${tool.workingPressureBar.typical} bar` },
	],
};
---
<BaseLayout
	title={`${tool.label} : quel compresseur ? | CompatAir`}
	description={`${tool.label} nécessite ${tool.airflowLpm.typical} L/min à ${tool.workingPressureBar.typical} bar. Calculez le compresseur adapté.`}
	pageType="product"
	imagePath={tool.image.src}
	imageAlt={tool.image.alt}
	breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }, { name: tool.label, path: `/outils-pneumatiques/${tool.slug}/` }]}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
	<article class="container product-detail">
		<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/outils-pneumatiques/">Outils pneumatiques</a><span>/</span><span>{tool.label}</span></nav>
		<div class="product-hero"><div><p class="eyebrow">Données constructeur · confiance {tool.confidence}</p><h1>{tool.label}</h1><p class="lead">{tool.editorial.overview}</p><p class="product-reference">Besoin nominal documenté : {tool.airflowLpm.typical} L/min à {tool.workingPressureBar.typical} bar.</p></div><ProductImage image={tool.image} eager /></div>

		<section class="spec-panel"><h2>Profil de consommation publié</h2><dl class="spec-table"><div><dt>Plage de débit</dt><dd>{tool.airflowLpm.min === tool.airflowLpm.max ? `${tool.airflowLpm.typical} L/min` : `${tool.airflowLpm.min} à ${tool.airflowLpm.max} L/min`}</dd></div><div><dt>Pression publiée</dt><dd>{tool.workingPressureBar.min === tool.workingPressureBar.max ? `${tool.workingPressureBar.typical} bar` : `${tool.workingPressureBar.min} à ${tool.workingPressureBar.max} bar, point par défaut ${tool.workingPressureBar.typical} bar`}</dd></div><div><dt>Raccordement</dt><dd>{tool.connectorSize ?? 'Non documenté dans la fiche consultée'}</dd></div><div><dt>Seuil interne CompatAir</dt><dd>{marginTarget} L/min, soit la consommation publiée + 25 %</dd></div></dl></section>

		<section class="editorial-section"><p class="eyebrow">Lecture CompatAir</p><h2>Ce que la documentation permet d’affirmer</h2><div class="evidence-grid"><div class="fact-box"><h3>Faits vérifiés</h3><ul>{tool.editorial.verifiedFacts.map((fact) => <li>{fact}</li>)}</ul></div><div class="limit-box"><h3>Limites</h3><ul>{tool.editorial.limitations.map((limit) => <li>{limit}</li>)}</ul></div></div></section>

		<section class="editorial-section"><h2>Comment dimensionner le compresseur</h2><p>Le premier seuil est la consommation nominale de <strong>{tool.airflowLpm.typical} L/min à {tool.workingPressureBar.typical} bar</strong>. Un compresseur n’est déclaré compatible en continu que si son débit restitué documenté couvre cette valeur à la même pression.</p><p>CompatAir affiche aussi un seuil de <strong>{marginTarget} L/min</strong>. Cette majoration de 25 % est une convention interne destinée à rendre visible une réserve de dimensionnement. Elle n’est pas attribuée au fabricant de l’outil.</p><div class="actions"><a class="button primary" href={`/calculateur/?outil=${tool.id}`}>Comparer les compresseurs</a></div></section>

		<section class="editorial-section"><h2>Résultats sur les compresseurs documentés</h2><div class="compatibility-table">{matches.map(({ compressor, result }) => <a href={`/compresseurs/${compressor.slug}/`}><span><strong>{compressor.brand} {compressor.model}</strong><small>{result.availableFadLpm !== undefined ? `${Math.round(result.availableFadLpm)} L/min disponibles à la pression demandée` : 'Débit non documenté à la pression demandée'}</small></span><strong class={`text-${result.verdict}`}>{labels[result.verdict]}</strong></a>)}</div></section>

		<section class="related-reading"><h2>Guides liés à cet outil</h2><div class="link-cards"><a href={relatedGuide}><strong>Dimensionnement pratique</strong><span>Lire le dossier correspondant au besoin de cet outil.</span></a><a href="/guides/diametre-longueur-flexible-air-comprime/"><strong>Flexible et raccords</strong><span>Comprendre pourquoi le réseau peut réduire la pression disponible.</span></a><a href="/guides/debit-restitue-fad-vs-debit-aspire/"><strong>Débit restitué ou aspiré</strong><span>Comparer le bon chiffre à la consommation publiée.</span></a></div></section>

		<section class="sources-panel"><h2>Source et réserves</h2>{tool.evidence.map((evidence) => <p><a href={evidence.sourceUrl} rel="nofollow noopener" target="_blank">{evidence.sourceLabel}</a> · consultée le {evidence.retrievedAt.split('-').reverse().join('/')} · niveau {evidence.confidence}</p>)}{tool.notes.map((note) => <p>{note}</p>)}</section>
	</article>
</BaseLayout>
