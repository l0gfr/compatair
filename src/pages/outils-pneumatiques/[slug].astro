---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDecisionHero from '../../components/ProductDecisionHero.astro';
import { compressors, tools } from '../../data/catalog';
import { evidenceHistoryProductHref } from '../../data/evidence-history-directory';
import { activeOffers } from '../../data/offers';
import { productSeoTitle } from '../../data/product-seo-titles';
import { toolGuidePath } from '../../data/tool-guide-links';
import { compressorDisplayName } from '../../domain/product-display';
import { createToolCompatibilitySummary } from '../../domain/seo-selection';
import { isFixedFlowTool, toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';
import { latestEvidenceDate } from '../../domain/provenance';
import { compatibilityFadLabel } from '../../domain/compatibility';
import { sourceQualityLabel } from '../../domain/source-quality';

export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const historyHref = evidenceHistoryProductHref(tool.id);
const verifiedAt = latestEvidenceDate(tool);
const fixedFlow = isFixedFlowTool(tool);
const availableProductIds = new Set(activeOffers.map((offer) => offer.productId));
const compatibility = fixedFlow ? createToolCompatibilitySummary(compressors, tool, { availableProductIds }) : undefined;
const marginTarget = fixedFlow ? Math.round(tool.airflowLpm.typical * 1.25) : undefined;
const demandLabel = toolDemandLabel(tool);
const pressureLabel = toolPressureLabel(tool);
const relatedGuide = toolGuidePath(tool);
const usageLabel = tool.usagePattern === 'burst' ? 'Par courtes actions' : tool.usagePattern === 'intermittent' ? 'Avec des pauses' : tool.usagePattern === 'continuous' ? 'En continu' : 'Non documentée';
const verifiedDateLabel = verifiedAt.split('-').reverse().join('/');
---
<BaseLayout
	title={`${tool.label} : quel compresseur ? | CompatAir`}
	editorialTitle={productSeoTitle(tool.id)}
	description={`${tool.label} : ${demandLabel}, ${pressureLabel}. Caractéristiques, sources, limites et besoin en air documenté.`}
	pageType="product"
	imagePath="/social/outils-pneumatiques.png"
	imageAlt="Catalogue des outils pneumatiques documentés par CompatAir"
	modifiedDate={new Date(verifiedAt)}
	breadcrumbs={[{ name: 'Outils pneumatiques', path: '/outils-pneumatiques/' }, { name: tool.label, path: `/outils-pneumatiques/${tool.slug}/` }]}
>
	<article class="container product-detail">
		<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/outils-pneumatiques/">Outils pneumatiques</a><span>/</span><span>{tool.label}</span></nav>
		<ProductDecisionHero
			kind="Outil pneumatique"
			eyebrow="Besoin en air et pression vérifiés"
			title={tool.label}
			lead={tool.editorial.overview}
			reference={`Référence ${tool.mpn ?? 'non renseignée'} · ${tool.category}`}
			image={tool.image}
			qualityLabel={sourceQualityLabel(tool.confidence)}
			verifiedDate={verifiedDateLabel}
			metrics={[
				{ label: 'Besoin publié', value: demandLabel },
				{ label: 'Pression d’utilisation', value: pressureLabel },
				{ label: 'Réserve proposée', value: marginTarget !== undefined ? `${marginTarget} L/min` : 'À calculer selon l’usage', detail: marginTarget !== undefined ? 'Consommation publiée + 25 %' : usageLabel },
				{ label: 'Qualité des données', value: sourceQualityLabel(tool.confidence), detail: `Grade technique ${tool.confidence}` },
			]}
			actions={fixedFlow ? [
				{ href: `/quel-compresseur-pour/${tool.slug}/`, label: 'Voir les compresseurs proches du besoin', primary: true },
				{ href: `/calculateur/#outil=${tool.id}`, label: 'Affiner avec mon usage' },
			] : [
				{ href: `/calculateur/#outil=${tool.id}`, label: 'Renseigner mon usage', primary: true },
				{ href: relatedGuide, label: 'Lire le guide métier' },
			]}
		/>

		{fixedFlow ? <section class="product-decision-section" data-product-decision>
			<header class="product-section-head"><div><p class="product-decision-index">01 / Réponse utile</p><h2>Trois compresseurs compatibles les plus proches du besoin</h2></div><p>Le classement privilégie la compatibilité, la qualité des données et le débit suffisant le plus proche. Il ne constitue pas un classement commercial absolu.</p></header>
			<div class="product-verdict-counts" aria-label="Résumé des compatibilités"><div><strong>{compatibility!.counts.compatible}</strong><span>compresseurs compatibles</span></div><div><strong>{compatibility!.counts.incompatible}</strong><span>compresseurs incompatibles</span></div><div><strong>{compatibility!.counts.insufficient}</strong><span>résultats à documenter</span></div></div>
			<div class="product-decision-cards">{compatibility!.compatibleSelection.slice(0, 3).map(({ compressor, result }, index) => <article><span>0{index + 1}</span><div><strong>{compressorDisplayName(compressor)}</strong><small>{sourceQualityLabel(compressor.confidence)}</small><p>{compatibilityFadLabel(result, tool.workingPressureBar.typical)}</p></div><a href={`/calculateur/#outil=${tool.id}&compresseur=${compressor.id}`}>Vérifier le modèle</a></article>)}</div>
			<div class="actions"><a class="button primary" href={`/quel-compresseur-pour/${tool.slug}/`}>Voir l’analyse de sélection</a><a class="button" href={`/comparateur/#ids=${compatibility!.compatibleSelection.slice(0, 3).map(({ compressor }) => compressor.id).join(',')}`}>Comparer ces trois modèles</a></div>
		</section> : <section class="product-decision-section is-limited"><header class="product-section-head"><div><p class="product-decision-index">01 / Donnée nécessaire</p><h2>Votre rythme d’utilisation manque pour conclure.</h2></div><p>CompatAir ne transforme pas une consommation par action en débit par minute sans connaître le nombre d’actions réellement prévu.</p></header><div class="actions"><a class="button primary" href={`/calculateur/#outil=${tool.id}`}>Renseigner mon usage</a></div></section>}

		<section class="spec-panel" id="donnees-techniques"><p class="product-decision-index">02 / Données techniques</p><h2>Besoin en air publié</h2><dl class="spec-table"><div><dt>Consommation d’air</dt><dd>{demandLabel}</dd></div><div><dt><a href="/glossaire/#pression-travail">Pression d’utilisation</a></dt><dd>{pressureLabel}</dd></div><div><dt>Façon de l’utiliser</dt><dd>{tool.usagePattern === 'burst' ? 'Par courtes actions' : tool.usagePattern === 'intermittent' ? 'Avec des pauses' : tool.usagePattern === 'continuous' ? 'En continu' : 'Non documentée'}</dd></div><div><dt>Temps d’utilisation publié</dt><dd>{tool.dutyFactor ? `${Math.round(tool.dutyFactor * 100)} %` : 'Non documenté'}</dd></div><div><dt>Raccordement</dt><dd>{tool.connectorSize ?? 'Non documenté dans la fiche consultée'}</dd></div><div><dt>Flexible recommandé</dt><dd>{tool.recommendedHose ? `${tool.recommendedHose.innerDiameterMm ?? '?'} mm intérieur${tool.recommendedHose.maximumLengthMeters ? `, ${tool.recommendedHose.maximumLengthMeters} m maximum` : ''}` : 'Non documenté'}</dd></div><div><dt>Filtration</dt><dd>{tool.filtrationRequirement ?? 'Non documentée'}</dd></div><div><dt>Lubrification</dt><dd>{tool.lubricationRequirement ?? 'Non documentée'}</dd></div><div><dt>Référence fabricant</dt><dd>{tool.mpn ?? 'Non documentée'}</dd></div><div><dt>Numéro de code-barres</dt><dd>{tool.ean ?? 'Non documenté'}</dd></div><div><dt><a href="/glossaire/#marge-compatair">Réserve de 25 % proposée par CompatAir</a></dt><dd>{marginTarget !== undefined ? `${marginTarget} L/min, soit la consommation publiée + 25 %` : 'Non calculée sans débit minute documenté'}</dd></div>{tool.specifications.map((specification) => <div><dt>{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl></section>

		<section class="editorial-section"><p class="eyebrow">Lecture CompatAir</p><h2>Ce que la documentation permet d’affirmer</h2><div class="evidence-grid"><div class="fact-box"><h3>Faits vérifiés</h3><ul>{tool.editorial.verifiedFacts.map((fact) => <li>{fact}</li>)}</ul></div><div class="limit-box"><h3>Limites</h3><ul>{tool.editorial.limitations.map((limit) => <li>{limit}</li>)}</ul></div></div></section>

		{fixedFlow ? <section class="editorial-section"><h2>Comment dimensionner le compresseur</h2><p>Le premier seuil est la consommation publiée de <strong>{tool.airflowLpm.typical} L/min à {tool.workingPressureBar.typical} bar</strong>. Un compresseur n’est déclaré compatible en continu que si son <a href="/glossaire/#debit-restitue">débit réellement disponible</a> couvre cette valeur. Une mesure FAD à pression supérieure peut servir de borne conservatrice, avec sa pression d’origine affichée.</p><p>CompatAir affiche aussi une réserve à <strong>{marginTarget} L/min</strong>. Cette majoration de 25 % est un repère proposé par CompatAir, pas une exigence du fabricant.</p><div class="actions"><a class="button primary" href={`/calculateur/#outil=${tool.id}`}>Affiner avec ma durée, mon flexible ou plusieurs outils</a></div></section> : <section class="editorial-section"><h2>Informations nécessaires pour calculer le besoin</h2><p>{tool.demandModel === 'per-action' ? `La documentation exprime la consommation par ${tool.actionLabel}. Le calculateur multiplie cette valeur par le nombre d’actions réellement saisi pour obtenir une moyenne par minute. Il ne prétend pas deviner le besoin exact au déclenchement.` : tool.demandExplanation}</p><p>Attribuer un débit par minute sans ces informations reviendrait à l’inventer. Le calculateur demande donc la seule donnée d’usage manquante, puis affiche les compresseurs dont les caractéristiques permettent réellement de conclure.</p><div class="actions"><a class="button primary" href={`/calculateur/#outil=${tool.id}`}>Renseigner mon usage et voir les solutions</a></div></section>}

		<section class="related-reading"><h2>Guides liés à cet outil</h2><div class="link-cards"><a href={`/quel-compresseur-pour/${tool.slug}/`}><strong>Quel compresseur pour {tool.model}&nbsp;?</strong><span>Consulter la page d’usage calculée pour cette référence.</span></a><a href={relatedGuide}><strong>Guide d’usage associé</strong><span>Approfondir le besoin en air de cette catégorie d’outil.</span></a><a href="/guides/diametre-longueur-flexible-air-comprime/"><strong>Flexible et raccords</strong><span>Comprendre pourquoi le réseau peut réduire la pression disponible.</span></a><a href="/guides/debit-restitue-fad-vs-debit-aspire/"><strong>Débit restitué ou aspiré</strong><span>Comparer le bon chiffre à la consommation publiée.</span></a></div></section>

		<section class="sources-panel"><h2>Source et réserves</h2>{tool.evidence.map((evidence) => <p><a href={evidence.sourceUrl} rel="nofollow noopener" target="_blank">{evidence.sourceLabel}</a> · consultée le {evidence.retrievedAt.split('-').reverse().join('/')} · {sourceQualityLabel(evidence.confidence)} <small>(grade technique {evidence.confidence})</small></p>)}{tool.notes.map((note) => <p>{note}</p>)}<p><a href={historyHref}>Voir les documents et dates vérifiés pour cette référence</a></p></section>
	</article>
</BaseLayout>
