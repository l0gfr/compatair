---
import ToolUsageDirectoryPage from '../../../components/ToolUsageDirectoryPage.astro';
import { toolUsageTaxonomy } from '../../../data/taxonomy';

export function getStaticPaths() {
	return toolUsageTaxonomy.map((usage) => ({ params: { usage: usage.id }, props: { usage } }));
}

const { usage } = Astro.props;
---
<ToolUsageDirectoryPage usage={usage} />
