---
import Calculator from '../components/Calculator.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Calculateur de compresseur pneumatique | CompatAir" description="Calculez le débit restitué nécessaire à votre outil et comparez-le à des compresseurs dont les performances sont sourcées.">
	<section class="page-hero compact">
		<div class="container">
			<p class="eyebrow">Calculateur CompatAir 0.2</p>
			<h1>Quel compresseur pour votre outil&nbsp;?</h1>
			<p class="lead">Sélectionnez un outil et votre flexible. Le moteur compare le besoin à une courbe de débit restitué, jamais au seul débit aspiré.</p>
		</div>
	</section>
	<section class="section calculator-section">
		<div class="container"><Calculator /></div>
	</section>
</BaseLayout>

