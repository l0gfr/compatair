---
import Calculator from '../components/Calculator.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Calculateur de compresseur pneumatique | CompatAir" description="Calculez un débit continu, un besoin moyen par tir ou un gonflage à partir de paramètres explicites, puis vérifiez le FAD documenté du compresseur.">
	<section class="page-hero compact">
		<div class="container">
			<p class="eyebrow">Calculateur CompatAir 1.1</p>
			<h1>Dimensionner une configuration complète</h1>
			<p class="lead">Combinez débits continus, consommations par tir et gonflages paramétrés, puis vérifiez un compresseur existant. Chaque hypothèse et chaque donnée manquante restent visibles.</p>
		</div>
	</section>
	<section class="section calculator-section">
		<div class="container"><Calculator /></div>
	</section>
</BaseLayout>
