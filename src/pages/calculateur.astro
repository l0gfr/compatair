---
import Calculator from '../components/Calculator.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Calculateur de compresseur pneumatique | CompatAir" description="Dimensionnez un ou plusieurs outils, leur simultanéité, leur fréquence et le compresseur à vérifier avec des hypothèses explicites.">
	<section class="page-hero compact">
		<div class="container">
			<p class="eyebrow">Calculateur CompatAir 1.0</p>
			<h1>Dimensionner une configuration complète</h1>
			<p class="lead">Combinez plusieurs outils, leur fréquence, le réseau et un compresseur existant. Chaque hypothèse et chaque donnée manquante restent visibles.</p>
		</div>
	</section>
	<section class="section calculator-section">
		<div class="container"><Calculator /></div>
	</section>
</BaseLayout>
