---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechnicalHero from '../components/TechnicalHero.astro';
import TechnicalSurfaceNav from '../components/TechnicalSurfaceNav.astro';
import { versionCompatibility } from '../data/version-compatibility';
import '../styles/mcp-reference.css';
---

<BaseLayout title="Versions CompatAir : matrice de compatibilité" description="Matrice unique des versions du produit, du serveur MCP, du moteur de calcul, de la méthode et des schémas publics CompatAir." canonicalPath="/compatibilite-versions/">
	<TechnicalHero eyebrow="Contrats publics" title="Une version, une frontière précise" lead="Le numéro du dépôt, celui du serveur MCP, le moteur de calcul et les schémas ne décrivent pas la même chose. Cette matrice indique ce que chaque version engage et évite de déduire une compatibilité à partir d’un numéro voisin." facts={[{ label: 'MCP', value: '3.0.0' }, { label: 'Moteur', value: '1.3.0' }, { label: 'Méthode', value: '2026.07' }, { label: 'Verdicts', value: '2.0.0' }]} actions={[{ href: '/data/version-compatibility.json', label: 'Lire le JSON', primary: true }, { href: '/mcp-documentation/', label: 'Documentation MCP' }]} flow={['Identifier la surface', 'Lire sa version', 'Vérifier sa compatibilité']} />
	<TechnicalSurfaceNav current="mcp" />
	<article class="container content api-documentation">
		<h2>Interfaces publiques</h2>
		<div class="mcp-table-wrap"><table><thead><tr><th>Interface</th><th>Version</th><th>Frontière de compatibilité</th></tr></thead><tbody>{versionCompatibility.interfaces.map((item) => <tr><td>{item.name}</td><td><code>{item.version}</code></td><td>{item.compatibility}</td></tr>)}</tbody></table></div>
		<h2>Décision et preuve</h2>
		<div class="mcp-table-wrap"><table><thead><tr><th>Contrat</th><th>Version</th><th>Portée</th></tr></thead><tbody>{versionCompatibility.decisionContracts.map((item) => <tr><td>{item.name}</td><td><code>{item.version}</code></td><td>{item.compatibility}</td></tr>)}</tbody></table></div>
		<h2>Profils MCP</h2>
		<div class="mcp-table-wrap"><table><thead><tr><th>Profil</th><th>Endpoint</th><th>Tools</th><th>Usage</th></tr></thead><tbody>{versionCompatibility.mcpProfiles.map((item) => <tr><td><code>{item.profile}</code></td><td><code>{item.endpoint}</code></td><td>{item.tools}</td><td>{item.purpose}</td></tr>)}</tbody></table></div>
		<h2>Runtime de référence</h2>
		<div class="mcp-principles">{Object.entries(versionCompatibility.runtime).map(([name, item]) => <article><strong>{name}</strong><p><code>{item.version}</code><br />{item.scope}</p></article>)}</div>
		<h2>Licence des contrats</h2>
		<p><strong>{versionCompatibility.licensing.current}</strong> {versionCompatibility.licensing.meaning}</p>
		<p>{versionCompatibility.licensing.decisionRequired}</p>
	</article>
</BaseLayout>
