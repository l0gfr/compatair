---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { compressors, tools } from '../data/catalog';
import { glossaryTerms } from '../data/glossary';

const allGuides = await getCollection('guides');
const featuredGuides = allGuides
	.filter((guide) => guide.data.featured)
	.sort((a, b) => b.data.readingTime - a.data.readingTime)
	.slice(0, 4);
const [leadGuide, ...secondaryGuides] = featuredGuides;
const comparisonCount = tools.length * compressors.length;
---

<BaseLayout title="Quel compresseur pour vos outils pneumatiques ? | CompatAir" description="Comparez la consommation d’air publiée de vos outils au débit restitué documenté d’un compresseur, à la même pression de travail.">
	<div class="home-canvas">
		<section class="home-hero">
			<div class="container">
				<header class="home-kicker-row">
					<p>CompatAir · vérifier un compresseur pour ses outils</p>
					<p>{compressors.length} compresseurs <strong>documentés</strong></p>
				</header>

				<div class="home-hero-layout">
					<div class="home-hero-copy">
						<h1>Vérifiez quel compresseur peut alimenter vos <em>outils pneumatiques.</em></h1>
						<p class="home-lead">CompatAir étudie les compresseurs d’air à partir de documents constructeur, puis vérifie lesquels peuvent alimenter vos outils à leur pression d’utilisation. Explorez les références, vérifiez votre installation et voyez immédiatement ce qui est confirmé ou encore inconnu.</p>
						<div class="actions home-primary-actions">
							<a class="button primary home-identify-cta" href="/scanner/"><span><strong>Identifier une référence</strong><small>Outil ou compresseur : saisissez le numéro de l’étiquette</small></span><b aria-hidden="true">→</b></a>
							<a class="button" href="/calculateur/">Vérifier une configuration</a>
						</div>
						<a class="home-professional-entry" href="/guides/professionnels/"><span>Vous équipez un atelier&nbsp;?</span> Ouvrir les parcours professionnels <b aria-hidden="true">→</b></a>
					</div>

					<aside class="home-command-center" data-home-command-center aria-label="Poste de contrôle CompatAir">
						<header>
							<div><span class="home-live-dot" aria-hidden="true"></span><strong>CompatAir / Décision</strong></div>
							<small>Identifier → vérifier → comparer</small>
						</header>
						<a class="home-command-primary" href="/scanner/">
							<span class="home-command-code">01 / Point de départ recommandé</span>
							<strong>Identifier la référence exacte</strong>
							<p>Recopiez le numéro de l’étiquette. Outil ou compresseur, la fiche et ses compatibilités apparaissent sans choisir de catégorie.</p>
							<footer><span>MPN · EAN · GTIN · photo locale</span><b aria-hidden="true">→</b></footer>
						</a>
						<nav class="home-command-grid" aria-label="Parcours de décision CompatAir">
							<a href="/calculateur/"><span>02 / Dimensionner</span><strong>Vérifier mon besoin</strong><small>Usage, marge, flexible et plusieurs outils</small><b aria-hidden="true">↗</b></a>
							<a href="/comparateur/"><span>03 / Rapprocher</span><strong>Comparer 2 ou 3 modèles</strong><small>Caractéristiques et sources côte à côte</small><b aria-hidden="true">↗</b></a>
							<a href="/graphe-preuve/"><span>04 / Prouver</span><strong>Remonter aux documents</strong><small>Verdict → champ → source datée</small><b aria-hidden="true">↗</b></a>
							<a href="/guides/"><span>05 / Comprendre</span><strong>Guides de terrain</strong><small>Métiers, usages et méthode</small><b aria-hidden="true">↗</b></a>
						</nav>
						<footer class="home-command-status">
							<div><small>Corpus</small><strong>{comparisonCount.toLocaleString('fr-FR')}</strong><span>couples auditables</span></div>
							<div><small>Décision</small><strong>4</strong><span>verdicts explicites</span></div>
							<div><small>Boîte noire</small><strong>0</strong><span>score commercial</span></div>
						</footer>
					</aside>
				</div>

				<div class="home-equation" aria-label="Comment CompatAir obtient le résultat">
					<p>Comment la réponse est obtenue</p>
					<div><small>Besoin</small><strong>Consommation de l’outil</strong><span>à sa pression de travail</span></div>
					<b aria-hidden="true">→</b>
					<div><small>Disponible</small><strong>Débit restitué du compresseur</strong><span>à cette même pression</span></div>
					<b aria-hidden="true">→</b>
					<div><small>Résultat</small><strong>Compatibilité et limites</strong><span>sans donnée inventée</span></div>
				</div>

				<dl class="home-facts" aria-label="Contenu documenté par CompatAir">
					<div><dt>{compressors.length}</dt><dd>compresseurs<br />documentés</dd></div>
					<div><dt>{tools.length}</dt><dd>outils<br />pneumatiques</dd></div>
					<div><dt>{comparisonCount.toLocaleString('fr-FR')}</dt><dd>comparaisons outil<br />et compresseur possibles</dd></div>
					<div><dt>{allGuides.length}</dt><dd>guides<br />techniques</dd></div>
				</dl>
			</div>
		</section>

		<section class="home-paths">
			<div class="container home-section-grid">
				<header class="home-section-intro">
					<p class="home-index">01 / Commencer</p>
					<h2>Partir de votre question,<br />pas d’un rayon produit.</h2>
					<p>Un achat pertinent dépend d’abord de l’usage, de la pression et du temps de fonctionnement. Choisissez le point d’entrée qui correspond à ce que vous savez déjà.</p>
				</header>

				<div class="home-path-list">
					<a href="/calculateur/">
						<span>01</span>
						<div><strong>J’ai un outil et un compresseur</strong><small>Comparez deux références ou saisissez vos propres valeurs.</small></div>
						<b aria-hidden="true">↗</b>
					</a>
					<a href="/guides/">
						<span>02</span>
						<div><strong>Je pars d’un usage ou d’un métier</strong><small>Peinture, sablage, mécanique, réseau d’atelier : posez d’abord le besoin.</small></div>
						<b aria-hidden="true">↗</b>
					</a>
					<a href="/compresseurs/">
						<span>03</span>
						<div><strong>Je veux examiner les références</strong><small>Consultez les caractéristiques, leurs sources et les données manquantes.</small></div>
						<b aria-hidden="true">↗</b>
					</a>
				</div>
			</div>
		</section>

		<section class="home-engine">
			<div class="container home-section-grid">
				<header class="home-section-intro home-section-intro-light">
					<p class="home-index">02 / Comprendre</p>
					<h2>Chaque réponse est expliquée.</h2>
					<p>CompatAir n’affiche pas un résultat sans explication. Les données utilisées, les calculs appliqués et la raison du résultat restent consultables.</p>
					<a class="home-inline-link light" href="/methodologie/">Voir comment nous vérifions</a>
					<div class="home-verification-list" aria-label="Ce que CompatAir vérifie">
						<p>Ce que CompatAir vérifie</p>
						<ol>
							<li><span>01</span><strong>Besoin de l’outil</strong><small>Débit et pression</small></li>
							<li><span>02</span><strong><a href="/glossaire/#fad">Débit réellement restitué</a></strong><small>Jamais le <a href="/glossaire/#debit-aspire">débit aspiré</a></small></li>
							<li><span>03</span><strong>Usage réellement couvert</strong><small>Ou donnée insuffisante</small></li>
						</ol>
					</div>
				</header>

				<div class="home-ledger">
					<header><span>Étapes de la comparaison</span><strong>Données et règles visibles</strong></header>
					<div class="home-ledger-row"><span>01</span><div><strong>Lire le besoin publié</strong><small>Consommation et pression de travail de l’outil</small></div><b>Source</b></div>
					<div class="home-ledger-row"><span>02</span><div><strong>Lire le <a href="/glossaire/#debit-restitue">débit réellement restitué</a></strong><small>Une <a href="/glossaire/#interpolation">valeur intermédiaire</a> n’est calculée qu’entre deux mesures publiées</small></div><b>Calcul</b></div>
					<div class="home-ledger-row"><span>03</span><div><strong>Appliquer la marge choisie</strong><small>Affichée séparément, jamais confondue avec une mesure</small></div><b>Choix</b></div>
					<div class="home-ledger-row"><span>04</span><div><strong>Énoncer ce que les données permettent</strong><small>Continu, intermittent, incompatible ou données insuffisantes</small></div><b>Résultat</b></div>
					<footer><span>Aucune commission d’affiliation n’entre dans le calcul.</span><a href="/affiliation/">Indépendance éditoriale →</a></footer>
				</div>
			</div>
		</section>

		<section class="home-reading">
			<div class="container">
				<header class="home-reading-head">
					<div><p class="home-index">03 / Approfondir</p><h2>Guides de terrain,<br />sources à l’appui.</h2></div>
					<p>Choisir, installer et utiliser un système d’air comprimé sans transformer une hypothèse en certitude.</p>
				</header>

				<div class="home-reading-layout">
					{leadGuide && <article class="home-lead-story">
						<p>{leadGuide.data.category} · {leadGuide.data.readingTime} min</p>
						<h3><a href={`/guides/${leadGuide.id}/`}>{leadGuide.data.title}</a></h3>
						<p>{leadGuide.data.description}</p>
						<a href={`/guides/${leadGuide.id}/`}>Lire le guide <span aria-hidden="true">→</span></a>
					</article>}

					<div class="home-story-list">
						{secondaryGuides.map((guide, index) => <article>
							<span>0{index + 2}</span>
							<div><p>{guide.data.category} · {guide.data.readingTime} min</p><h3><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3></div>
						</article>)}
						<a class="home-all-guides" href="/guides/">Voir les {allGuides.length} guides <span aria-hidden="true">→</span></a>
					</div>
				</div>

				<a class="home-glossary-line" href="/glossaire/">
					<span>Glossaire sourcé</span>
					<strong>{glossaryTerms.length} notions pour lire les fiches techniques sans ambiguïté</strong>
					<small>Débit disponible · pression · temps de fonctionnement · humidité</small>
					<b aria-hidden="true">↗</b>
				</a>
			</div>
		</section>

		<section class="home-catalog-proof">
			<div class="container home-section-grid">
				<header class="home-section-intro">
					<p class="home-index">04 / Examiner</p>
					<h2>Des fiches reliées à leurs documents.</h2>
					<p>Une fiche n’est pas complète parce qu’elle affiche beaucoup de chiffres. Elle l’est lorsque les caractéristiques qui changent le résultat sont identifiées, sourcées et datées.</p>
				</header>

				<nav class="home-catalog-links" aria-label="Explorer les données CompatAir">
					<a href="/compresseurs/"><span>Compresseurs</span><strong>{compressors.length} références</strong><b>→</b></a>
					<a href="/outils-pneumatiques/"><span>Outils pneumatiques</span><strong>{tools.length} références</strong><b>→</b></a>
					<a href="/sources-fiabilite/"><span>Fiabilité</span><strong>Origine et qualité des données</strong><b>→</b></a>
					<a href="/observatoire-qualite-documentaire/"><span>Observatoire</span><strong>Corrections, références et contradictions</strong><b>→</b></a>
					<a href="/radar-contradictions/"><span>Radar</span><strong>Valeurs concurrentes et donnée retenue</strong><b>→</b></a>
					<a href="/barometre-transparence/"><span>Transparence</span><strong>Données publiées par marque</strong><b>→</b></a>
					<a href="/professionnels/"><span>Professionnels</span><strong>Améliorer et intégrer votre catalogue</strong><b>→</b></a>
				</nav>
			</div>
		</section>

		<section class="home-closing">
			<div class="container">
				<p aria-hidden="true">“</p>
				<blockquote>
					<p>Le volume de cuve stocke de l’air. Il ne remplace jamais un débit restitué insuffisant.</p>
					<footer>Une règle simple qui évite beaucoup de mauvais achats.</footer>
				</blockquote>
				<a href="/calculateur/">Tester votre besoin <span aria-hidden="true">→</span></a>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.home-canvas { --home-paper: #f3f0e8; --home-ink: #102a20; --home-line: rgba(16,42,32,.18); overflow: hidden; background: var(--home-paper); }
	.home-hero { position: relative; padding: clamp(3.2rem, 7vw, 6.5rem) 0 0; background: radial-gradient(circle at 15% 4%, rgba(211,235,86,.16), transparent 24rem), linear-gradient(110deg, #f7f4ec 0 66%, #ecefe5 66%); }
	.home-hero::after { position: absolute; right: max(1rem, calc((100vw - 1160px) / 2)); top: 0; width: 1px; height: 100%; background: rgba(16,42,32,.09); content: ""; }
	.home-kicker-row { display: flex; justify-content: space-between; gap: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--home-line); color: #426053; font: 780 .68rem/1.3 ui-monospace, monospace; letter-spacing: .11em; text-transform: uppercase; }
	.home-kicker-row p { margin: 0; }
	.home-kicker-row strong { color: var(--brand); }
	.home-hero-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(370px, .9fr); gap: clamp(2.5rem, 6vw, 6rem); padding: clamp(3rem, 7vw, 6.5rem) 0 clamp(3.5rem, 6vw, 5.5rem); }
	.home-hero-copy h1 { max-width: 820px; color: var(--home-ink); font-size: clamp(2.8rem, 4.2vw, 4.35rem); font-weight: 480; line-height: .98; letter-spacing: -.035em; }
	.home-hero-copy h1 em { color: var(--brand); font-weight: inherit; }
	.home-lead { max-width: 730px; margin: 2rem 0 0; color: #455c51; font-size: clamp(1.04rem, 1.55vw, 1.25rem); line-height: 1.72; }
	.home-lead a { text-decoration-color: #86a08e; text-underline-offset: .2em; }
	.home-inline-link { align-self: center; color: var(--home-ink); font-size: .88rem; font-weight: 780; text-decoration-thickness: 1px; text-underline-offset: .35em; }
	.home-inline-link.light { display: inline-block; margin-top: 1.2rem; color: #e7eee9; }
	.home-command-center { position: relative; align-self: end; overflow: hidden; border: 1px solid rgba(211,235,86,.38); border-radius: 1.15rem; color: #f3f7f2; background: radial-gradient(circle at 100% 0, rgba(211,235,86,.16), transparent 15rem), #0b2118; box-shadow: 0 26px 55px rgba(17,40,30,.2); }
	.home-command-center::before { position: absolute; inset: 0; opacity: .14; background-image: linear-gradient(rgba(211,235,86,.18) 1px, transparent 1px), linear-gradient(90deg, rgba(211,235,86,.18) 1px, transparent 1px); background-size: 22px 22px; mask-image: linear-gradient(135deg, transparent 20%, black); content: ""; pointer-events: none; }
	.home-command-center > * { position: relative; z-index: 1; }
	.home-command-center > header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid rgba(255,255,255,.12); font: 760 .6rem/1.3 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	.home-command-center > header div { display: flex; align-items: center; gap: .55rem; }
	.home-command-center > header small { color: #92a99e; font-size: .55rem; }
	.home-live-dot { width: .48rem; height: .48rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 .22rem rgba(211,235,86,.1), 0 0 1rem rgba(211,235,86,.55); }
	.home-command-primary { display: grid; gap: .35rem; padding: 1.25rem; border-bottom: 1px solid rgba(255,255,255,.14); color: white; background: linear-gradient(115deg, rgba(211,235,86,.11), rgba(255,255,255,.02)); text-decoration: none; transition: background-color .18s ease; }
	.home-command-primary:hover { background-color: rgba(211,235,86,.08); }
	.home-command-code, .home-command-grid a > span { color: var(--accent); font: 800 .57rem/1.3 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	.home-command-primary > strong { font: 520 clamp(1.35rem, 2vw, 1.8rem)/1.08 "Newsreader Variable", Georgia, serif; }
	.home-command-primary > p { max-width: 36rem; margin: .15rem 0 .25rem; color: #b5c7bd; font-size: .74rem; line-height: 1.5; }
	.home-command-primary footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: #e4ebdf; font-size: .65rem; font-weight: 760; }
	.home-command-primary footer b { color: var(--accent); font-size: 1.1rem; }
	.home-command-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.home-command-grid a { position: relative; display: grid; min-height: 8rem; gap: .18rem; align-content: start; padding: 1rem; border-bottom: 1px solid rgba(255,255,255,.11); color: #f1f5ef; text-decoration: none; transition: background-color .18s ease; }
	.home-command-grid a:nth-child(odd) { border-right: 1px solid rgba(255,255,255,.11); }
	.home-command-grid a:hover { background: rgba(211,235,86,.08); }
	.home-command-grid strong { margin-top: .25rem; font-size: .78rem; }
	.home-command-grid small { max-width: 12rem; color: #8fa59a; font-size: .61rem; line-height: 1.45; }
	.home-command-grid b { position: absolute; right: .8rem; bottom: .65rem; color: #759184; font-size: .8rem; }
	.home-command-status { display: grid; grid-template-columns: repeat(3, 1fr); }
	.home-command-status div { display: grid; gap: .05rem; padding: .75rem; border-right: 1px solid rgba(255,255,255,.11); }
	.home-command-status div:last-child { border-right: 0; }
	.home-command-status small { color: #82988d; font: 760 .5rem/1.3 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	.home-command-status strong { color: var(--accent); font: 520 1.05rem/1.1 "Newsreader Variable", Georgia, serif; }
	.home-command-status span { color: #93a79d; font-size: .52rem; line-height: 1.35; }
	.home-equation { display: grid; grid-template-columns: .62fr 1fr auto 1fr auto 1fr; align-items: stretch; border-block: 1px solid var(--home-line); }
	.home-equation > p { margin: 0; padding: 1.2rem 1.2rem 1.2rem 0; color: #596e63; font: 780 .66rem/1.45 ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }
	.home-equation > div { display: grid; gap: .12rem; padding: 1rem 1.2rem; border-left: 1px solid var(--home-line); }
	.home-equation small { color: var(--brand); font-size: .64rem; font-weight: 820; letter-spacing: .08em; text-transform: uppercase; }
	.home-equation strong { font-size: .82rem; }
	.home-equation span { color: #65786e; font-size: .7rem; }
	.home-equation > b { display: grid; place-items: center; color: #7f9288; font-weight: 500; }
	.home-facts { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; }
	.home-facts div { display: flex; gap: .8rem; align-items: center; padding: 1.6rem 1.2rem; border-left: 1px solid var(--home-line); }
	.home-facts div:first-child { padding-left: 0; border-left: 0; }
	.home-facts dt { color: var(--home-ink); font: 520 clamp(2rem, 3vw, 3.1rem)/1 "Newsreader Variable", Georgia, serif; }
	.home-facts dd { margin: 0; color: #65776d; font-size: .7rem; line-height: 1.4; }
	.home-paths, .home-catalog-proof { padding: clamp(5rem, 9vw, 8.5rem) 0; background: #f9f7f1; }
	.home-section-grid { display: grid; grid-template-columns: minmax(280px, .7fr) minmax(0, 1.3fr); gap: clamp(3rem, 9vw, 9rem); }
	.home-section-intro h2 { max-width: 540px; margin: .3rem 0 1.5rem; color: var(--home-ink); font-size: clamp(2.5rem, 4.8vw, 4.4rem); font-weight: 480; line-height: .98; }
	.home-section-intro > p:last-child { max-width: 490px; color: #5b6d64; }
	.home-index { margin: 0 0 1.3rem; color: var(--brand); font: 820 .69rem/1.3 ui-monospace, monospace; letter-spacing: .11em; text-transform: uppercase; }
	.home-path-list { border-top: 1px solid var(--home-ink); }
	.home-path-list > a { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1.2rem; align-items: center; padding: 1.65rem 0; border-bottom: 1px solid var(--home-line); text-decoration: none; transition: padding .2s ease, color .2s ease; }
	.home-path-list > a:hover { padding-left: .75rem; color: var(--brand); }
	.home-path-list > a > span { color: #52665c; font: 780 .68rem/1 ui-monospace, monospace; }
	.home-path-list > a div { display: grid; gap: .28rem; }
	.home-path-list strong { font: 530 clamp(1.35rem, 2.3vw, 2rem)/1.15 "Newsreader Variable", Georgia, serif; }
	.home-path-list small { color: #586b61; font-size: .78rem; }
	.home-path-list b { font-size: 1.3rem; font-weight: 400; }
	.home-engine { padding: clamp(5rem, 9vw, 8rem) 0; color: white; background: #0b2017; }
	.home-section-intro-light h2 { color: #f5f4ed; }
	.home-section-intro-light > p:last-of-type { color: #aebfb6; }
	.home-section-intro-light .home-index { color: var(--accent); }
	.home-verification-list { margin-top: 2rem; border-top: 1px solid rgba(255,255,255,.35); }
	.home-verification-list > p { margin: 0; padding: .7rem 0; color: var(--accent); font: 780 .6rem/1.3 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	.home-verification-list ol { margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,.1); list-style: none; }
	.home-verification-list li { display: grid; grid-template-columns: 1.7rem 1fr; gap: .15rem .55rem; padding: .7rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
	.home-verification-list li > span { grid-row: 1 / 3; padding-top: .15rem; color: #718b7e; font: 760 .56rem/1 ui-monospace, monospace; }
	.home-verification-list strong { color: #f4f5ef; font-size: .75rem; }
	.home-verification-list small { color: #8fa49a; font-size: .65rem; }
	.home-verification-list a { display: inline-flex; min-height: 24px; align-items: center; color: inherit; text-underline-offset: .2em; }
	.home-ledger { border-top: 1px solid rgba(255,255,255,.5); }
	.home-ledger > header, .home-ledger > footer { display: flex; justify-content: space-between; gap: 1rem; padding: .9rem 0; color: #91a69b; font: 750 .64rem/1.4 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
