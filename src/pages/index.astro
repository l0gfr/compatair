---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { compressors, tools } from '../data/catalog';
import { glossaryTerms } from '../data/glossary';
import { CALCULATION_VERSION } from '../domain/sizing';

const allGuides = await getCollection('guides');
const featuredGuides = allGuides.filter((guide) => guide.data.featured).sort((a, b) => b.data.readingTime - a.data.readingTime).slice(0, 4);

---

<BaseLayout title="CompatAir : comparer compresseurs et outils pneumatiques" description="Comparez la consommation publiée d’un outil au débit restitué documenté d’un compresseur, à la même pression de travail.">
	<section class="hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">Compatibilité d’air comprimé, sans approximation commerciale</p>
				<h1>Le bon débit.<br /><span>À la bonne pression.</span></h1>
				<p class="lead">CompatAir compare la consommation publiée d’un outil au débit restitué documenté d’un compresseur, à la même pression de travail. Une donnée absente produit «&nbsp;données insuffisantes&nbsp;».</p>
				<div class="actions">
					<a class="button primary" href="/calculateur/">Tester une compatibilité <span aria-hidden="true">→</span></a>
					<a class="button subtle" href="/methodologie/">Voir notre méthode</a>
				</div>
			</div>
			<div class="hero-instrument" aria-label="Principes de calcul CompatAir">
				<div class="instrument-top"><span>CompatAir Engine</span><strong>v{CALCULATION_VERSION}</strong></div>
				<div class="gauge" aria-hidden="true"><div class="gauge-face"><span class="tick t1"></span><span class="tick t2"></span><span class="tick t3"></span><span class="gauge-hand"></span><span class="gauge-hub"></span><div class="gauge-value"><strong>+25 %</strong><small>marge interne</small></div></div></div>
				<div class="instrument-legend"><span><i class="signal green"></i><strong>FAD</strong><small>documenté</small></span><span><i class="signal lime"></i><strong>bar</strong><small>pression égale</small></span><span><i class="signal orange"></i><strong>0</strong><small>donnée inventée</small></span></div>
			</div>
		</div>
	</section>

	<section class="section home-calculator">
		<div class="container callout">
			<div><p class="eyebrow">Le calculateur est ouvert</p><h2>Testez {tools.length} outils sur {compressors.length} compresseurs documentés.</h2><p>CompatAir compare les valeurs publiées et affiche séparément une marge interne de 25&nbsp;%. Les pertes du réseau ne sont pas estimées sans données documentées.</p><div class="actions"><a class="button primary inverse" href="/calculateur/">Lancer le calcul</a><a class="button inverse-outline" href="/compresseurs/">Voir les produits</a></div></div>
			<div class="metric"><strong>{tools.length} × {compressors.length}</strong><span>profils disponibles dans le moteur {CALCULATION_VERSION}, avec saisie obligatoire lorsque le besoin dépend de l’usage</span></div>
		</div>
	</section>

	<section class="section editorial-home">
		<div class="container">
			<div class="section-head split-head"><div><p class="eyebrow">{allGuides.length} guides techniques</p><h2>Des dossiers qui vont jusqu’au bout du calcul</h2></div><p>Chaque dossier sépare données constructeur, calculs reproductibles et hypothèses CompatAir. Une donnée absente reste absente.</p></div>
			<a class="home-glossary" href="/glossaire/"><span><small>Glossaire technique</small><strong>{glossaryTerms.length} notions définies et sourcées</strong></span><span>FAD · bar · point de rosée · ISO 8573-1</span><b aria-hidden="true">→</b></a>
			<div class="guide-grid">{featuredGuides.map((guide) => <article class="guide-card"><p class="guide-meta">{guide.data.category} · {guide.data.readingTime} min</p><h3><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3><p>{guide.data.description}</p><a class="text-link" href={`/guides/${guide.id}/`}>Lire le dossier</a></article>)}</div>
			<div class="actions"><a class="button" href="/guides/">Tous les guides</a></div>
		</div>
	</section>

	<div class="proof-strip">
		<div class="container">
			<span><strong>FAD prioritaire</strong> plutôt que débit aspiré</span>
			<span><strong>Sources affichées</strong> par donnée critique</span>
			<span><strong>Calcul reproductible</strong> sans recommandation générative</span>
		</div>
	</div>

	<section class="section" id="fonctionnement">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Le moteur CompatAir</p>
				<h2>Une réponse technique en trois étapes</h2>
			</div>
			<div class="grid">
				<article class="card"><p class="step">01</p><h3>Choisissez un outil</h3><p>Le moteur utilise sa consommation et sa pression de travail publiées.</p></article>
				<article class="card"><p class="step">02</p><h3>Choisissez un compresseur</h3><p>Le débit restitué est lu ou interpolé entre deux points constructeur documentés.</p></article>
				<article class="card"><p class="step">03</p><h3>Lisez le résultat</h3><p>Débit disponible, besoin publié, marge CompatAir et limites sont affichés séparément.</p></article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container callout">
			<div>
				<p class="eyebrow">La donnée qui change tout</p>
				<h2>Le volume de cuve ne suffit pas.</h2>
				<p>Le volume de la cuve stocke de l’air, mais ne remplace pas un débit restitué insuffisant. Le calculateur ne déduit donc pas une compatibilité du seul nombre de litres.</p>
			</div>
			<div class="metric"><strong>4 verdicts</strong><span>continu · intermittent · incompatible · données insuffisantes</span></div>
		</div>
	</section>
</BaseLayout>
