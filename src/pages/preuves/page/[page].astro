---
import EvidenceHistoryDirectory from '../../../components/EvidenceHistoryDirectory.astro';
import { evidenceHistoryDirectoryTotalPages } from '../../../data/evidence-history-directory';

export function getStaticPaths() {
	return Array.from({ length: Math.max(0, evidenceHistoryDirectoryTotalPages - 1) }, (_, index) => ({ params: { page: String(index + 2) }, props: { currentPage: index + 2 } }));
}

interface Props { currentPage: number }
const { currentPage } = Astro.props;
---
<EvidenceHistoryDirectory currentPage={currentPage} />
