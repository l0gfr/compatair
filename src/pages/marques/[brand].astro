---
import { decisionComparisons } from '../../data/decision-comparisons';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogSignalVisual from '../../components/CatalogSignalVisual.astro';
import DirectoryBrowser from '../../components/DirectoryBrowser.astro';
import ProductImage from '../../components/ProductImage.astro';
import { compressors, tools } from '../../data/catalog';
import { brandSlug } from '../../domain/brand';
import { createBrandInsights } from '../../domain/brand-insights';
import { compressorDisplayName } from '../../domain/product-display';
import { formatFrenchDate } from '../../domain/provenance';
import { sourceQualityLabel } from '../../domain/source-quality';
import { toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';

export function getStaticPaths() {
	const values = [...new Set([...compressors.map((item) => item.brand), ...tools.map((item) => item.brand)])];
	return values.map((brand) => ({ params: { brand: brandSlug(brand) }, props: { brand } }));
}

const { brand } = Astro.props;
const brandCompressors = compressors.filter((item) => item.brand === brand);
const brandTools = tools.filter((item) => item.brand === brand);
const brandDirectoryLimit = 48;
const latestEvidenceAt = (item: (typeof compressors)[number] | (typeof tools)[number]) =>
	item.evidence.reduce((latest, evidence) => evidence.retrievedAt > latest ? evidence.retrievedAt : latest, '');
const visibleBrandCompressors = [...brandCompressors]
	.sort((left, right) => latestEvidenceAt(right).localeCompare(latestEvidenceAt(left)) || compressorDisplayName(left).localeCompare(compressorDisplayName(right), 'fr'))
	.slice(0, brandDirectoryLimit);
const visibleBrandTools = [...brandTools]
	.sort((left, right) => latestEvidenceAt(right).localeCompare(latestEvidenceAt(left)) || left.label.localeCompare(right.label, 'fr'))
	.slice(0, brandDirectoryLimit);
const insights = createBrandInsights(brandCompressors, brandTools);
const total = brandCompressors.length + brandTools.length;
---

<BaseLayout title={`${brand} : compresseurs et outils documentés | CompatAir`} description={`Couverture documentaire ${brand} : débits restitués, besoins en air, identifiants, sources et principales lacunes.`} imagePath="/social/marques.png" imageAlt="Fabricants documentés par CompatAir" breadcrumbs={[{ name: 'Marques', path: '/marques/' }, { name: brand, path: `/marques/${brandSlug(brand)}/` }]}>
	<section class="page-hero compact brand-hero"><div class="container catalog-hero-grid"><div><p class="product-decision-index">Couverture documentaire / {brand}</p><p class="eyebrow">Fabricant suivi par CompatAir</p><h1>{brand} : ce que le catalogue permet réellement de vérifier</h1><p class="lead">{brandCompressors.length} compresseur{brandCompressors.length > 1 ? 's' : ''} et {brandTools.length} outil{brandTools.length > 1 ? 's' : ''} disposent actuellement d’une fiche sourcée. Cette page mesure le corpus, pas la qualité commerciale de la marque.</p><div class="hero-actions"><a class="button primary" href="#references">Explorer les références</a><a class="button" href="/professionnels/">Améliorer ce catalogue</a></div></div><CatalogSignalVisual mode="brands" count={total} secondaryCount={insights.identifiers.documented} title={`références ${brand}`} /></div></section>
	<section class="brand-answer-strip"><div class="container"><div><strong>{insights.fad.percentage === null ? 'N/A' : `${insights.fad.percentage} %`}</strong><span>FAD documenté</span></div><div><strong>{insights.identifiers.percentage} %</strong><span>identifiants couverts</span></div><div><strong>{insights.phases.singlePhase + insights.phases.threePhase}</strong><span>alimentations publiées</span></div><div><strong>{formatFrenchDate(insights.latestVerifiedAt)}</strong><span>dernière vérification</span></div></div></section>

	<section class="section brand-insights"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">01 / Qualité du corpus</p><h2>Ce que les documents disponibles permettent d’affirmer</h2></div><p>Chaque taux est recalculé depuis les fiches publiées. Une donnée manquante ne reçoit aucune valeur moyenne.</p></header><div class="brand-insight-grid"><article><span>FAD</span><strong>{insights.fad.documented}/{insights.fad.total}</strong><p>compresseurs avec au moins un point de débit réellement restitué.</p></article><article><span>Identifiants</span><strong>{insights.identifiers.documented}/{insights.identifiers.total}</strong><p>références reliées à un MPN, EAN ou GTIN exploitable.</p></article><article><span>Monophasé</span><strong>{insights.phases.singlePhase}</strong><p>compresseurs dont l’alimentation monophasée est publiée.</p></article><article><span>Triphasé</span><strong>{insights.phases.threePhase}</strong><p>compresseurs dont l’alimentation triphasée est publiée.</p></article></div>{insights.gaps.length > 0 ? <div class="brand-gap-panel"><div><p class="product-decision-index">Lacunes prioritaires</p><h3>Ce qu’il faut encore documenter</h3></div><ul>{insights.gaps.map((gap) => <li>{gap}</li>)}</ul></div> : <div class="fact-box"><h3>Champs suivis couverts</h3><p>Aucune lacune n’est détectée sur le FAD, les identifiants et le type d’alimentation dans ce corpus.</p></div>}<div class="actions"><a class="button" href="/barometre-transparence/">Voir le baromètre</a><a class="button" href="/observatoire-qualite-documentaire/">Voir l’observatoire</a></div></div></section>

	<div id="references">
	{brandCompressors.length > 0 && <section class="section brand-products" data-directory-browser data-page-size="9"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">02 / Compresseurs</p><h2>Compresseurs {brand}</h2></div><p>{brandCompressors.length > visibleBrandCompressors.length ? 'Le répertoire affiche les références vérifiées le plus récemment. La recherche complète couvre tout le corpus.' : 'Recherchez une référence exacte et triez les modèles sans confondre débit aspiré et débit restitué.'}</p></header><div class="directory-controls"><div class="field directory-search"><label for={`compressor-search-${brandSlug(brand)}`}>Modèle, MPN, EAN/GTIN ou SKU</label><input id={`compressor-search-${brandSlug(brand)}`} type="search" data-directory-search /></div><div class="field"><label for={`compressor-sort-${brandSlug(brand)}`}>Trier</label><select id={`compressor-sort-${brandSlug(brand)}`} data-directory-sort><option value="confidence">Qualité des données</option><option value="primary-asc">Cuve croissante</option><option value="primary-desc">Cuve décroissante</option><option value="name">Nom</option></select></div><button type="button" class="inline-action" data-directory-reset>Réinitialiser</button></div><p class="directory-count" data-directory-count>{visibleBrandCompressors.length} {brandCompressors.length > visibleBrandCompressors.length ? `références affichées sur ${brandCompressors.length}` : 'résultats'}</p><div class="product-grid directory-product-grid" data-directory-grid>{visibleBrandCompressors.map((item) => <article class="product-card catalog-product-card" data-directory-card data-search={`${item.brand} ${item.model} ${item.mpn ?? ''} ${item.ean ?? ''} ${item.gtin ?? ''} ${item.distributorSkus.map((identifier) => identifier.sku).join(' ')}`} data-sort-name={compressorDisplayName(item)} data-sort-confidence={item.confidence} data-sort-primary={item.tankLiters}><a class="product-card-image" href={`/compresseurs/${item.slug}/`} aria-label={`Voir la fiche ${compressorDisplayName(item)}`}><ProductImage image={item.image} compact /></a><p class="product-brand">{item.brand}</p><h3><a href={`/compresseurs/${item.slug}/`}>{compressorDisplayName(item)}</a></h3><dl class="spec-list"><div><dt>Cuve</dt><dd>{item.tankLiters} L</dd></div><div><dt>Pression</dt><dd>{item.maxPressureBar} bar</dd></div><div><dt>Source</dt><dd>{sourceQualityLabel(item.confidence)}</dd></div></dl><p class:list={['data-status', item.fadCurve.length ? 'verified' : 'missing']}>{item.fadCurve.length ? `${item.fadCurve.length} point${item.fadCurve.length > 1 ? 's' : ''} FAD publié${item.fadCurve.length > 1 ? 's' : ''}` : 'Débit FAD à documenter'}</p></article>)}</div><nav class="catalog-pagination" aria-label={`Pagination des compresseurs ${brand}`} data-directory-pagination></nav>{brandCompressors.length > visibleBrandCompressors.length && <div class="actions"><a class="button" href={`/recherche/?q=${encodeURIComponent(brand)}`}>Rechercher dans les {brandCompressors.length} compresseurs</a></div>}</div></section>}
	{brandTools.length > 0 && <section class="section brand-products alternate" data-directory-browser data-page-size="9"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">03 / Outils</p><h2>Outils {brand}</h2></div><p>{brandTools.length > visibleBrandTools.length ? 'Le répertoire affiche les références vérifiées le plus récemment. La recherche complète couvre tout le corpus.' : 'Chaque fiche distingue le besoin constructeur des paramètres ajoutés par l’utilisateur dans le calculateur. La sélection de compresseurs reste accessible depuis la fiche, sans dupliquer ici tout le parcours.'}</p></header><div class="directory-controls"><div class="field directory-search"><label for={`tool-search-${brandSlug(brand)}`}>Modèle, MPN, EAN/GTIN ou SKU</label><input id={`tool-search-${brandSlug(brand)}`} type="search" data-directory-search /></div><div class="field"><label for={`tool-sort-${brandSlug(brand)}`}>Trier</label><select id={`tool-sort-${brandSlug(brand)}`} data-directory-sort><option value="confidence">Qualité des données</option><option value="primary-asc">Besoin croissant</option><option value="primary-desc">Besoin décroissant</option><option value="name">Nom</option></select></div><button type="button" class="inline-action" data-directory-reset>Réinitialiser</button></div><p class="directory-count" data-directory-count>{visibleBrandTools.length} {brandTools.length > visibleBrandTools.length ? `références affichées sur ${brandTools.length}` : 'résultats'}</p><div class="product-grid directory-product-grid" data-directory-grid>{visibleBrandTools.map((item) => <article class="product-card catalog-product-card" data-directory-card data-search={`${item.brand} ${item.model} ${item.mpn ?? ''} ${item.ean ?? ''} ${item.gtin ?? ''} ${item.distributorSkus.map((identifier) => identifier.sku).join(' ')}`} data-sort-name={item.label} data-sort-confidence={item.confidence} data-sort-primary={item.demandModel === 'fixed-flow' ? item.airflowLpm.typical : ''}><a class="product-card-image" href={`/outils-pneumatiques/${item.slug}/`}><ProductImage image={item.image} compact /></a><p class="product-brand">{item.category}</p><h3><a href={`/outils-pneumatiques/${item.slug}/`}>{item.model}</a></h3><dl class="spec-list"><div><dt>Besoin</dt><dd>{toolDemandLabel(item)}</dd></div><div><dt>Pression</dt><dd>{toolPressureLabel(item)}</dd></div><div><dt>Source</dt><dd>{sourceQualityLabel(item.confidence)}</dd></div></dl><div class="catalog-card-actions"><a href={`/calculateur/#outil=${item.id}`}>Calculer cette configuration</a></div></article>)}</div><nav class="catalog-pagination" aria-label={`Pagination des outils ${brand}`} data-directory-pagination></nav>{brandTools.length > visibleBrandTools.length && <div class="actions"><a class="button" href={`/recherche/?q=${encodeURIComponent(brand)}`}>Rechercher dans les {brandTools.length} outils</a></div>}</div></section>}
	</div>
	{['Einhell', 'Metabo'].includes(brand) && <section class="section"><div class="container"><h2>Comparer {brand} pour un usage précis</h2><div class="link-cards">{decisionComparisons.map((page) => <a href={`/comparatifs/${page.slug}/`}><strong>{page.question}</strong><span>{page.description}</span></a>)}</div></div></section>}
	<DirectoryBrowser />
</BaseLayout>
