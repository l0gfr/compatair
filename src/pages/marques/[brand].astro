---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import { compressors, tools } from '../../data/catalog';
import { brandSlug } from '../../domain/brand';
import { createBrandInsights } from '../../domain/brand-insights';
import { compressorDisplayName } from '../../domain/product-display';
import { formatFrenchDate } from '../../domain/provenance';
import { toolDemandLabel, toolPressureLabel } from '../../domain/tool-demand';

export function getStaticPaths() {
	const values = [...new Set([...compressors.map((item) => item.brand), ...tools.map((item) => item.brand)])];
	return values.map((brand) => ({ params: { brand: brandSlug(brand) }, props: { brand } }));
}

const { brand } = Astro.props;
const brandCompressors = compressors.filter((item) => item.brand === brand);
const brandTools = tools.filter((item) => item.brand === brand);
const insights = createBrandInsights(brandCompressors, brandTools);
---

<BaseLayout title={`${brand} : compresseurs et outils documentés | CompatAir`} description={`Fiches techniques ${brand} sourcées par CompatAir : débits restitués, consommations, pressions et limites connues.`} imagePath="/social/marques.png" imageAlt="Fabricants documentés par CompatAir" breadcrumbs={[{ name: 'Marques', path: '/marques/' }, { name: brand, path: `/marques/${brandSlug(brand)}/` }]}>
	<section class="page-hero compact"><div class="container"><p class="eyebrow">Documentation par marque</p><h1>{brand} sur CompatAir</h1><p class="lead">{brandCompressors.length} compresseur{brandCompressors.length > 1 ? 's' : ''} et {brandTools.length} outil{brandTools.length > 1 ? 's' : ''} disposent actuellement d’une fiche sourcée.</p></div></section>
	<section class="section"><div class="container"><p class="eyebrow">Couverture du corpus</p><h2>Ce que les données disponibles permettent de mesurer</h2><dl class="spec-table"><div><dt>Débit FAD documenté</dt><dd>{insights.fad.percentage === null ? 'Aucun compresseur étudié' : `${insights.fad.documented}/${insights.fad.total} références, soit ${insights.fad.percentage} %`}</dd></div><div><dt>Identifiants couverts</dt><dd>{insights.identifiers.documented}/{insights.identifiers.total} références, soit {insights.identifiers.percentage} %</dd></div><div><dt>Alimentation des compresseurs</dt><dd>{insights.phases.singlePhase} monophasé{insights.phases.singlePhase > 1 ? 's' : ''} · {insights.phases.threePhase} triphasé{insights.phases.threePhase > 1 ? 's' : ''} · {insights.phases.unknown} non documenté{insights.phases.unknown > 1 ? 's' : ''}</dd></div><div><dt>Dernière vérification</dt><dd>{formatFrenchDate(insights.latestVerifiedAt)}</dd></div></dl>{insights.tankDistribution.length > 0 && <><h3>Distribution des cuves étudiées</h3><dl class="spec-table">{insights.tankDistribution.map((bucket) => <div><dt>{bucket.label}</dt><dd>{bucket.count} référence{bucket.count > 1 ? 's' : ''}</dd></div>)}</dl></>}{insights.gaps.length > 0 ? <div class="limit-box"><h3>Principales lacunes documentaires</h3><ul>{insights.gaps.map((gap) => <li>{gap}</li>)}</ul></div> : <div class="fact-box"><h3>Champs suivis couverts</h3><p>Aucune lacune n’est détectée sur le FAD, les identifiants et le type d’alimentation dans ce corpus.</p></div>}<div class="actions"><a class="button" href="/barometre-transparence/">Voir le baromètre de transparence</a><a class="button" href="/observatoire-qualite-documentaire/">Voir l’observatoire documentaire</a></div></div></section>
	{brandCompressors.length > 0 && <section class="section"><div class="container"><h2>Compresseurs {brand}</h2><div class="product-grid">{brandCompressors.map((item) => <article class="product-card"><a class="product-card-image" href={`/compresseurs/${item.slug}/`} aria-label={`Voir la fiche ${compressorDisplayName(item)}`}><ProductImage image={item.image} compact /></a><p class="product-brand">{item.brand}</p><h3><a href={`/compresseurs/${item.slug}/`}>{compressorDisplayName(item)}</a></h3><p>{item.tankLiters} L · {item.maxPressureBar} bar · fiabilité des données {item.confidence}</p></article>)}</div></div></section>}
	{brandTools.length > 0 && <section class="section"><div class="container"><h2>Outils {brand}</h2><div class="product-grid">{brandTools.map((item) => <article class="product-card"><a class="product-card-image" href={`/outils-pneumatiques/${item.slug}/`}><ProductImage image={item.image} compact /></a><p class="product-brand">{item.category}</p><h3><a href={`/outils-pneumatiques/${item.slug}/`}>{item.model}</a></h3><p>{toolDemandLabel(item)} · {toolPressureLabel(item)}</p></article>)}</div></div></section>}
</BaseLayout>
