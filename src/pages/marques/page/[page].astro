---
import BrandDirectoryPage from '../../../components/BrandDirectoryPage.astro';
import { brandDirectoryTotalPages } from '../../../data/brand-directory';

export function getStaticPaths() {
	return Array.from({ length: brandDirectoryTotalPages - 1 }, (_, index) => ({
		params: { page: String(index + 2) },
		props: { currentPage: index + 2 },
	}));
}

interface Props { currentPage: number }
const { currentPage } = Astro.props;
---
<BrandDirectoryPage currentPage={currentPage} />
