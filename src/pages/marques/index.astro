---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { compressors, tools } from '../../data/catalog';
const brands = [...new Set([...compressors.map((item) => item.brand), ...tools.map((item) => item.brand)])].sort(); const slugify = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<BaseLayout title="Marques documentées | CompatAir" description="Accédez aux compresseurs et outils pneumatiques classés par marque, avec données techniques sourcées." breadcrumbs={[{ name: 'Marques', path: '/marques/' }]}><section class="page-hero compact"><div class="container"><p class="eyebrow">Index des fabricants</p><h1>Marques documentées</h1><p class="lead">Une marque apparaît uniquement lorsqu’au moins une fiche s’appuie sur une source identifiée.</p></div></section><section class="section"><div class="container guide-grid">{brands.map((brand) => <a class="guide-card" href={`/marques/${slugify(brand)}/`}><p class="guide-meta">Fabricant</p><h2>{brand}</h2><p>{compressors.filter((item) => item.brand === brand).length} compresseurs · {tools.filter((item) => item.brand === brand).length} outils</p></a>)}</div></section></BaseLayout>
