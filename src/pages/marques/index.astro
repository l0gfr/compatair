---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogSignalVisual from '../../components/CatalogSignalVisual.astro';
import DirectoryBrowser from '../../components/DirectoryBrowser.astro';
import { compressors, tools } from '../../data/catalog';
import { brandSlug } from '../../domain/brand';

const brands = [...new Set([...compressors.map((item) => item.brand), ...tools.map((item) => item.brand)])].sort().map((brand) => {
	const brandCompressors = compressors.filter((item) => item.brand === brand);
	const brandTools = tools.filter((item) => item.brand === brand);
	const documentedFad = brandCompressors.filter((item) => item.fadCurve.length > 0).length;
	return { brand, compressors: brandCompressors.length, tools: brandTools.length, documentedFad, total: brandCompressors.length + brandTools.length };
});
---

<BaseLayout title="Marques documentées | CompatAir" description="Fabricants de compresseurs et d’outils classés par couverture documentaire, avec débits FAD et identifiants sourcés." breadcrumbs={[{ name: 'Marques', path: '/marques/' }]}>
	<section class="page-hero compact catalog-hero"><div class="container catalog-hero-grid"><div><p class="product-decision-index">Index documentaire / Fabricants</p><p class="eyebrow">Marques documentées</p><h1>Mesurer la qualité des catalogues, marque par marque</h1><p class="lead">Une marque apparaît uniquement lorsqu’au moins une référence repose sur une source identifiée. La quantité de fiches ne vaut pas automatiquement qualité documentaire.</p><div class="hero-actions"><a class="button primary" href="/barometre-transparence/">Voir le baromètre</a><a class="button" href="/professionnels/">Espace professionnels</a></div></div><CatalogSignalVisual mode="brands" count={brands.length} secondaryCount={compressors.length + tools.length} title="fabricants suivis" /></div></section>
	<section class="catalog-summary-band"><div class="container"><div><strong>{brands.length}</strong><span>fabricants documentés</span></div><div><strong>{compressors.length}</strong><span>compresseurs suivis</span></div><div><strong>{tools.length}</strong><span>outils suivis</span></div><div><strong>{compressors.filter((item) => item.fadCurve.length > 0).length}</strong><span>FAD documentés</span></div></div></section>
	<section class="section brand-directory" data-directory-browser data-page-size="12"><div class="container"><header class="product-section-head"><div><p class="product-decision-index">Explorer le corpus</p><h2>Comparer la couverture, pas la notoriété</h2></div><p>Le classement repose uniquement sur les références présentes dans CompatAir et ne constitue ni une note de qualité produit ni un palmarès commercial.</p></header><div class="directory-controls brand-controls"><div class="field directory-search"><label for="brand-search">Rechercher une marque</label><input id="brand-search" type="search" placeholder="Ex. Einhell" data-directory-search /></div><div class="field"><label for="brand-sort">Trier</label><select id="brand-sort" data-directory-sort><option value="primary-desc">Nombre de références</option><option value="name">Nom</option></select></div><button class="inline-action" type="button" data-directory-reset>Réinitialiser</button></div><p class="directory-count" data-directory-count>{brands.length} résultats</p><div class="brand-card-grid" data-directory-grid>{brands.map((item, index) => <a class="brand-data-card" href={`/marques/${brandSlug(item.brand)}/`} data-directory-card data-search={item.brand} data-sort-name={item.brand} data-sort-confidence="A" data-sort-primary={item.total}><span>0{index + 1}</span><p>Fabricant documenté</p><h2>{item.brand}</h2><dl><div><dt>Compresseurs</dt><dd>{item.compressors}</dd></div><div><dt>Outils</dt><dd>{item.tools}</dd></div><div><dt>FAD publiés</dt><dd>{item.documentedFad}/{item.compressors}</dd></div></dl><strong>Voir la couverture →</strong></a>)}</div><nav class="catalog-pagination" aria-label="Pagination des marques" data-directory-pagination></nav></div></section>
	<DirectoryBrowser />
</BaseLayout>
